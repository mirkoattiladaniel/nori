// Loop interchange with `schedule { order ... }`.
//
// The body is written in the natural `i j k` order, but that makes the inner loop stride b[k,j] by
// N, which is terrible for cache lines and unvectorizable. `order i k j` rebuilds the nest so the inner loop
// is over `j`: now c[i,j] and b[k,j] are unit-stride and the loop vectorizes. On a 1024^3 i64 matmul
// this is ~20x faster than the naive order and matches a hand-written `ikj` loop, a win that
// neither clang -O3 nor the stock MLIR affine passes deliver (interchange isn't an mlir-opt pass).
//
// Legality is asserted by the user, as with `parallel`: you are promising the permutation preserves
// the result. You can add `tile N` to the same block.
//
// Build:  noric --build examples/matmul_order.nori /tmp/mm compiler/runtime.nori --import-root . && /tmp/mm   # -> 6144
schedule mm { order i k j }

fn mm() -> Int {
    var a = fill2(1024, 1024, 2)
    var b = fill2(1024, 1024, 3)
    var c = fill2(1024, 1024, 0)
    foreach i in 0..1024 {
        foreach j in 0..1024 {
            foreach k in 0..1024 {
                c[i, j] = c[i, j] + a[i, k] * b[k, j]
            }
        }
    }
    return copy c[0, 0]
}
fn main() -> Int { printl(mm())  return 0 }
