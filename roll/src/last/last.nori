// roll: `roll last`, the previous `roll run`, as a filterable table.
//
// One directory module of roll (see src/main.nori for the layout). It reaches the others through
// their aliases below, and only what another module uses is `pub`. The modules import each other
// freely (`cmds` and `deps` call in both directions); cycles between directory modules are fine.

import "std/os" as os
import "../ui" as ui
import "../util" as util

use ui::*
use util::*

pub fn last_index_of(s: Str, ch: Int) -> Int {
    var i = s.len() - 1
    while i >= 0 {
        if ord(s.at(i)) == ch {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}
// ---- `roll last`: the previous `roll run` as a queryable table ----
// The runtime captured every printl/trap as "seq \t kind \t loc \t text" (build/run.log). `roll last
// [FILTER]` prints the records (FILTER = substring on any field, e.g. a file:line); a record whose
// text contained newlines continues on unnumbered lines, shown indented, following its record's
// fate. `roll last --diff` compares against the run before (build/run.prev.log), ignoring seq.
pub fn last_lines(s: Str) -> Vec<Str> {
    var out: Vec<Str> = vec()
    let n = s.len()
    var start = 0
    var i = 0
    while i <= n {
        if i == n || ord(s.at(i)) == 10 {
            if !(i == n && start == n) {
                out.push(s.slice(start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}
fn last_is_record(line: Str) -> Bool {
    // does the line start a record (digits then TAB)?
    var i = 0
    let n = line.len()
    while i < n && ord(line.at(i)) >= 48 && ord(line.at(i)) <= 57 {
        i = i + 1
    }
    return i > 0 && i < n && ord(line.at(i)) == 9
}
fn last_strip_seq(line: Str) -> Str {
    // the record without its seq field (--diff compares these)
    var i = 0
    let n = line.len()
    while i < n && ord(line.at(i)) != 9 {
        i = i + 1
    }
    if i < n {
        return line.slice(i + 1, n)
    }
    return copy line
}
fn last_paint(line: Str) -> Str {
    // traps/fails red, output plain
    var red = find_substr(line, (chr(9) + ("trap" + chr(9)))) >= 0
    if find_substr(line, (chr(9) + ("fail" + chr(9)))) >= 0 {
        red = true
    }
    if red {
        return(chr(27) + ("[1;31m" + (line + (chr(27) + "[0m"))))
    }
    return copy line
}
pub fn last_cmd() -> Int {
    var diff = false
    var filter = ""
    var k = 1
    while k < argc() {
        if(arg(k) == "--diff") {
            diff = true
        }
        else {
            if !starts_with(arg(k), "-") {
                filter = arg(k)
            }
        }
        k = k + 1
    }
    if !os::path_exists("build/run.log") {
        eprintl("roll last: no captured run — `roll run` first")
        return 1
    }
    let cur = read_file("build/run.log")
    if diff {
        if !os::path_exists("build/run.prev.log") {
            eprintl("roll last --diff: only one captured run so far")
            return 1
        }
        let a = last_lines(read_file("build/run.prev.log"))
        let b = last_lines(cur)
        var bset: Map<Str, Int> = map()
        var i = 0
        while i < b.len() {
            if last_is_record(b[i]) {
                bset.put(last_strip_seq(b[i]), 1)
            }
            i = i + 1
        }
        var aset: Map<Str, Int> = map()
        i = 0
        while i < a.len() {
            if last_is_record(a[i]) {
                aset.put(last_strip_seq(a[i]), 1)
            }
            i = i + 1
        }
        i = 0
        while i < a.len() {
            if last_is_record(a[i]) {
                if !bset.has(last_strip_seq(a[i])) {
                    printl(("- " + a[i]))
                }
            }
            i = i + 1
        }
        i = 0
        while i < b.len() {
            if last_is_record(b[i]) {
                if !aset.has(last_strip_seq(b[i])) {
                    printl(("+ " + b[i]))
                }
            }
            i = i + 1
        }
        return 0
    }
    let lines = last_lines(cur)
    var shown = 0
    var inmatch = false
    var i = 0
    while i < lines.len() {
        let ln = lines[i]
        if last_is_record(ln) {
            inmatch = (filter == "") || find_substr(ln, filter) >= 0
            if inmatch {
                printl(last_paint(ln))
                shown = shown + 1
            }
        } else {
            if inmatch {
                if !(ln == "") {
                    printl(("    " + ln))
                }
            }
        }
        i = i + 1
    }
    if shown == 0 {
        if(filter == "") {
            printl("run produced no records")
        } else {
            printl(("no records match `" + (filter + "`")))
        }
    }
    return 0
}
