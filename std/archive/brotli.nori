fn parse_ints(s: Str) -> Vec<Int> {
    var v: Vec<Int> = vec()
    var i = 0 var n = s.len() var cur = 0 var have = false
    while i < n {
        let c = ord(s.at(i))
        if c == 44 {
            v.push(cur)
            cur = 0
            have = false
        }
        else {
            cur = cur * 10 + (c - 48)
            have = true
        }
        i = i + 1
    }
    if have {
        v.push(cur)
    }
    return v
}
fn parse_ctx_table() -> Vec<Int> {
    return parse_ints(ctx_table_str())
}
fn lit_context(tab: Vec<Int>, p1: Int, p2: Int, mode: Int) -> Int {
    let base = (mode << 9)
    return(tab[base + p1] | tab[base + 256 + p2])
}

