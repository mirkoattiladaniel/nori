//! std/archive: a Brotli decoder (RFC 7932), for WOFF2 web fonts (which Brotli-compress the
//! SFNT table data). Built in layers: bit reader + prefix codes, then meta-block
//! decode (literals/commands/distances + context modeling), then the static dictionary. WOFF2's table
//! directory + glyf/loca transform reversal live in std/font.
//!
//! Brotli reads bits LSB-first; its prefix codes are canonical Huffman read low-bit-first, so a code's
//! bits are the reverse of the DEFLATE-style canonical code. We build a flat lookup table indexed by the
//! next `maxlen` bits (with the reversed code filled across all high-bit combinations): the standard
//! constant-time Brotli symbol decode.

// ── bit reader (LSB-first, accumulating buffer) ──────────────────────────────────────────────────────
struct BR {
    d: view Str,
    n: Int,
    pos: Int,
    buf: Int,
    cnt: Int
}
fn br_new(data: Str) -> BR {
    return BR { d: data, n: data.len(), pos: 0, buf: 0, cnt: 0 }
}
fn br_ensure(inout b: BR, k: Int) {
    while b.cnt < k {
        var byte = 0
        if b.pos < b.n {
            byte = ord(b.d.at(b.pos))
            b.pos = b.pos + 1
        }
        b.buf = (b.buf | (byte << b.cnt))
        b.cnt = b.cnt + 8
    }
}
/// read `k` bits LSB-first (k <= 24).
fn br_take(inout b: BR, k: Int) -> Int {
    if k == 0 {
        return 0
    }
    br_ensure(b, k)
    let v = (b.buf & (1 << k) - 1)
    b.buf = (b.buf >> k)
    b.cnt = b.cnt - k
    return v
}
fn br_bit(inout b: BR) -> Int {
    return br_take(b, 1)
}

// ── prefix (canonical Huffman) codes, decoded low-bit-first ──────────────────────────────────────────
struct Prefix {
    sym: Vec<Int>,
    len: Vec<Int>,
    maxlen: Int
}
fn rev_bits(x: Int, n: Int) -> Int {
    var r = 0
    var i = 0
    while i < n {
        r = ((r << 1) | ((x >> i) & 1))
        i = i + 1
    }
    return r
}
// build a decode table from per-symbol code lengths (0 = symbol absent). Canonical code assignment,
// filled at the bit-reversed code so decode reads the code low-bit-first.
fn prefix_build(lengths: Vec<Int>, n: Int) -> Prefix {
    var maxlen = 0
    var i = 0
    while i < n {
        if lengths[i] > maxlen {
            maxlen = lengths[i]
        }
        i = i + 1
    }
    if maxlen == 0 {
        var s: Vec<Int> = vec()
        s.push(0)
        var l: Vec<Int> = vec()
        l.push(0)
        return Prefix { sym: s, len: l, maxlen: 0 }
    }
    let size = (1 << maxlen)
    var sym: Vec<Int> = vec() var lentab: Vec<Int> = vec()
    i = 0 while i < size { sym.push(0) lentab.push(0) i = i + 1 }
    var blcount: Vec<Int> = vec() i = 0 while i <= maxlen { blcount.push(0) i = i + 1 }
    i = 0 while i < n { if lengths[i] > 0 { blcount[lengths[i]] = blcount[lengths[i]] + 1 } i = i + 1 }
    var nextcode: Vec<Int> = vec() i = 0 while i <= maxlen { nextcode.push(0) i = i + 1 }
    var code = 0 var bl = 1
    while bl <= maxlen {
        code = (code + blcount[bl - 1] << 1)
        nextcode[bl] = code
        bl = bl + 1
    }
    i = 0
    while i < n {
        let ln = lengths[i]
        if ln > 0 {
            let c = nextcode[ln]
            nextcode[ln] = c + 1
            let rev = rev_bits(c, ln)
            let step = (1 << ln)
            var j = rev
            while j < size {
                sym[j] = i
                lentab[j] = ln
                j = j + step
            }
        }
        i = i + 1
    }
    return Prefix { sym: sym, len: lentab, maxlen: maxlen }
}
/// decode one symbol (constant time: peek maxlen bits, look up, consume the code's length).
fn prefix_decode(inout b: BR, p: Prefix) -> Int {
    if p.maxlen == 0 {
        return p.sym[0]
    }
    br_ensure(b, p.maxlen)
    let idx = (b.buf & (1 << p.maxlen) - 1)
    let ln = p.len[idx]
    b.buf = (b.buf >> ln)
    b.cnt = b.cnt - ln
    return p.sym[idx]
}

// ── RFC 7932 constant tables (length/block prefix codes: base + extra bits) ──────────────────────────
fn tbl(a: Int, b: Int, c: Int, dd: Int, e: Int, f: Int, g: Int, h: Int) -> Vec<Int> {
    var v: Vec<Int> = vec()
    v.push(a)
    v.push(b)
    v.push(c)
    v.push(dd)
    v.push(e)
    v.push(f)
    v.push(g)
    v.push(h)
    return v
}
fn vext(inout dst: Vec<Int>, src: Vec<Int>) {
    var i = 0
    while i < src.len() {
        dst.push(src[i])
        i = i + 1
    }
}
fn ins_base() -> Vec<Int> {
    var v = tbl(0, 1, 2, 3, 4, 5, 6, 8)
    vext(v, tbl(10, 14, 18, 26, 34, 50, 66, 98))
    vext(v, tbl(130, 194, 322, 578, 1090, 2114, 6210, 22594))
    return v
}
fn ins_extra() -> Vec<Int> {
    var v = tbl(0, 0, 0, 0, 0, 0, 1, 1)
    vext(v, tbl(2, 2, 3, 3, 4, 4, 5, 5))
    vext(v, tbl(6, 7, 8, 9, 10, 12, 14, 24))
    return v
}
fn cpy_base() -> Vec<Int> {
    var v = tbl(2, 3, 4, 5, 6, 7, 8, 9)
    vext(v, tbl(10, 12, 14, 18, 22, 30, 38, 54))
    vext(v, tbl(70, 102, 134, 198, 326, 582, 1094, 2118))
    return v
}
fn cpy_extra() -> Vec<Int> {
    var v = tbl(0, 0, 0, 0, 0, 0, 0, 0)
    vext(v, tbl(1, 1, 2, 2, 3, 3, 4, 4))
    vext(v, tbl(5, 5, 6, 7, 8, 9, 10, 24))
    return v
}
fn blk_base() -> Vec<Int> {
    var v = tbl(1, 5, 9, 13, 17, 25, 33, 41)
    vext(v, tbl(49, 65, 81, 97, 113, 145, 177, 209))
    vext(v, tbl(241, 305, 369, 497, 753, 1265, 2289, 4337))
    vext(v, tbl(8433, 16625, 0, 0, 0, 0, 0, 0))
    var r: Vec<Int> = vec()
    var i = 0
    while i < 26 {
        r.push(v[i])
        i = i + 1
    }
    return r
}
fn blk_extra() -> Vec<Int> {
    var v = tbl(2, 2, 2, 2, 3, 3, 3, 3)
    vext(v, tbl(4, 4, 4, 4, 5, 5, 5, 5))
    vext(v, tbl(6, 6, 7, 8, 9, 10, 11, 12))
    vext(v, tbl(13, 24, 0, 0, 0, 0, 0, 0))
    var r: Vec<Int> = vec()
    var i = 0
    while i < 26 {
        r.push(v[i])
        i = i + 1
    }
    return r
}
// code-length code order (18): {1,2,3,4,0,5,17,6,16,7,8,9,10,11,12,13,14,15}
fn clc_order() -> Vec<Int> {
    var v = tbl(1, 2, 3, 4, 0, 5, 17, 6)
    vext(v, tbl(16, 7, 8, 9, 10, 11, 12, 13))
    v.push(14)
    v.push(15)
    return v
}

fn bitlen(x: Int) -> Int {
    var n = 0
    var v = x
    while v > 0 {
        n = n + 1
        v = (v >> 1)
    }
    return n
}
fn prefix_single(v: Int) -> Prefix {
    var s: Vec<Int> = vec()
    s.push(v)
    var l: Vec<Int> = vec()
    l.push(0)
    return Prefix { sym: s, len: l, maxlen: 0 }
}

// read a prefix code from the stream (RFC 3.4/3.5): a simple code (1-4 explicit symbols) or a complex
// code (code-length code + RLE-coded symbol lengths).
fn prefix_read(inout b: BR, alphabet_size: Int) -> Prefix {
    let hdr = br_take(b, 2)
    if hdr == 1 {
        // simple code
        let abits = bitlen(alphabet_size - 1)
        let nsym = br_take(b, 2) + 1
        var syms: Vec<Int> = vec()
        var i = 0
        while i < nsym {
            syms.push(br_take(b, abits))
            i = i + 1
        }
        if nsym == 1 {
            return prefix_single(syms[0])
        }
        var tsel = 0
        if nsym == 4 {
            tsel = br_take(b, 1)
        }
        var lens: Vec<Int> = vec()
        i = 0 while i < alphabet_size { lens.push(0) i = i + 1 }
        if nsym == 2 {
            lens[syms[0]] = 1
            lens[syms[1]] = 1
        }
        else if nsym == 3 {
            lens[syms[0]] = 1
            lens[syms[1]] = 2
            lens[syms[2]] = 2
        }
        else {
            if tsel == 0 {
                lens[syms[0]] = 2
                lens[syms[1]] = 2
                lens[syms[2]] = 2
                lens[syms[3]] = 2
            } else {
                lens[syms[0]] = 1
                lens[syms[1]] = 2
                lens[syms[2]] = 3
                lens[syms[3]] = 3
            }
        }
        return prefix_build(lens, alphabet_size)
    }
    // complex code: hskip = hdr (0, 2, 3)
    var fx: Vec<Int> = vec() fx.push(2) fx.push(4) fx.push(3) fx.push(2) fx.push(2) fx.push(4) // fixed code for the 6 code-length-code lengths
    let fixed = prefix_build(fx, 6)
    let order = clc_order()
    var clcl: Vec<Int> = vec() var i = 0 while i < 18 { clcl.push(0) i = i + 1 }
    var space = 32
    i = hdr
    while i < 18 && space > 0 {
        let v = prefix_decode(b, fixed)
        clcl[order[i]] = v
        if v != 0 {
            space = space - (32 >> v)
        }
        i = i + 1
    }
    let clh = prefix_build(clcl, 18)
    var lens: Vec<Int> = vec() i = 0 while i < alphabet_size { lens.push(0) i = i + 1 }
    var sym = 0 var prev = 8 var rep = 0 var repLen = 0 var sp = 32768
    while sym < alphabet_size && sp > 0 {
        let cl = prefix_decode(b, clh)
        if cl < 16 {
            lens[sym] = cl sym = sym + 1
            if cl != 0 {
                prev = cl
                sp = sp - (32768 >> cl)
            }
            rep = 0
        } else {
            var extra = 3 var newlen = 0
            if cl == 16 {
                newlen = prev
                extra = 2
            }
            if repLen != newlen {
                rep = 0
                repLen = newlen
            }
            let old = rep
            if rep > 0 {
                rep = (rep - 2 << extra)
            }
            rep = rep + br_take(b, extra) + 3
            let delta = rep - old
            var k = 0
            while k < delta && sym < alphabet_size {
                lens[sym] = newlen sym = sym + 1
                if newlen != 0 {
                    sp = sp - (32768 >> newlen)
                }
                k = k + 1
            }
        }
    }
    return prefix_build(lens, alphabet_size)
}

// ── output buffer (grows; byte-addressed for backward copies) ────────────────────────────────────────
extern fn malloc(Int) -> Int
extern fn free(Int)
struct Out {
    p: Int,
    len: Int,
    cap: Int
}
fn out_new() -> Out {
    var o = Out { p: 0, len: 0, cap: 65536 }
    unsafe {
        o.p = malloc(65536)
    }
    return o
}
fn out_byte(inout o: Out, byte: Int) {
    if o.len >= o.cap {
        let nc = o.cap * 2
        var np = 0
        unsafe {
            np = malloc(nc)
            var i = 0
            while i < o.len {
                poke8(np + i, peek8(o.p + i))
                i = i + 1
            }
            free(o.p)
        }
        o.p = np o.cap = nc
    }
    unsafe {
        poke8(o.p + o.len, byte)
    }
    o.len = o.len + 1
}
fn out_at(o: Out, i: Int) -> Int {
    var v = 0
    unsafe {
        v = peek8(o.p + i)
    }
    return v
}

// ── command-code decomposition LUTs (RFC 7932 §5, 11 ranges) ─────────────────────────────────────────
fn ins_range_lut() -> Vec<Int> {
    var v = tbl(0, 0, 0, 0, 8, 8, 0, 16)
    v.push(8)
    v.push(16)
    v.push(16)
    return v
}
fn cpy_range_lut() -> Vec<Int> {
    var v = tbl(0, 8, 0, 8, 0, 8, 16, 0)
    v.push(16)
    v.push(8)
    v.push(16)
    return v
}

fn read_wbits(inout b: BR) -> Int {
    if br_take(b, 1) == 0 {
        return 16
    }
    let n = br_take(b, 3)
    if n != 0 {
        return 17 + n
    }
    let n2 = br_take(b, 3)
    if n2 == 0 {
        return 17
    }
    return 8 + n2
}
fn decode_varlen(inout b: BR) -> Int {
    // DecodeVarLenUint8
    if br_take(b, 1) == 0 {
        return 0
    }
    let nbits = br_take(b, 3)
    if nbits == 0 {
        return 1
    }
    return(1 << nbits) + br_take(b, nbits)
}
// literal context id via the 2 KB RFC lookup table: context = LUT[p1] | LUT[256+p2] where LUT is the
