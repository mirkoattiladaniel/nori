fn b64_val(c: Int) -> Int {
    if c >= 65 && c <= 90 {
        return c - 65
    }
    if c >= 97 && c <= 122 {
        return c - 97 + 26
    }
    if c >= 48 && c <= 57 {
        return c - 48 + 52
    }
    if c == 43 {
        return 62
    }
    if c == 47 {
        return 63
    }
    return 0 - 1
}
fn b64_decode(s: Str) -> Str {
    var o = out_new()
    var acc = 0 var bits = 0
    var i = 0 var n = s.len()
    while i < n {
        let v = b64_val(ord(s.at(i)))
        if v >= 0 {
            acc = ((acc << 6) | v)
            bits = bits + 6
            if bits >= 8 {
                bits = bits - 8
                out_byte(o, ((acc >> bits) & 255))
            }
        }
        i = i + 1
    }
    var r = ""
    unsafe {
        r = str_from_buf(o.p, o.len)
        free(o.p)
    }
    return r
}

// lazily-built dictionary state (the 122 KB data is only decoded if a stream actually references it).
struct Dict {
    ready: Bool,
    data: Str,
    offs: Vec<Int>,
    sbits: Vec<Int>,
    psfx: Vec<Int>,
    pmap: Vec<Int>,
    tdata: Vec<Int>
}
fn dict_new() -> Dict {
    return Dict { ready: false, data: "", offs: vec(), sbits: vec(), psfx: vec(), pmap: vec(), tdata: vec() }
}
fn dict_ensure(inout d: Dict) {
    if d.ready {
        return
    }
    d.data = b64_decode(brotli_dict_b64())
    d.offs = dict_offsets() d.sbits = dict_sbits()
    d.psfx = tf_prefixsuffix() d.pmap = tf_map() d.tdata = tf_data()
    d.ready = true
}

fn out_set(o: Out, i: Int, byte: Int) {
    unsafe {
        poke8(o.p + i, byte)
    }
}
// uppercase one UTF-8 char in place at out[p]; returns its byte length (RFC's simplified model).
fn to_upper_at(o: Out, p: Int) -> Int {
    let c0 = out_at(o, p)
    if c0 < 192 {
        if c0 >= 97 && c0 <= 122 {
            out_set(o, p, (c0 ^ 32))
        }
        return 1
    }
    if c0 < 224 {
        out_set(o, p + 1, (out_at(o, p + 1) ^ 32))
        return 2
    }
    out_set(o, p + 2, (out_at(o, p + 2) ^ 5)) return 3
}

// emit a transformed dictionary word to the output buffer; returns bytes emitted, or -1 on a bad ref.
fn apply_transform(inout o: Out, d: Dict, woff: Int, wlen0: Int, tidx: Int) -> Int {
    let prefix_id = d.tdata[tidx * 3]
    let ttype = d.tdata[tidx * 3 + 1]
    let suffix_id = d.tdata[tidx * 3 + 2]
    var emitted = 0
    let poff = d.pmap[prefix_id]
    let plen = d.psfx[poff]
    var i = 0
    while i < plen {
        out_byte(o, d.psfx[poff + 1 + i])
        emitted = emitted + 1
        i = i + 1
    }
    var wlen = wlen0 var wstart = woff
    if ttype <= 9 {
        wlen = wlen - ttype
    }
    else if ttype >= 12 && ttype <= 20 {
        let skip = ttype - 11
        wstart = wstart + skip
        wlen = wlen - skip
    }
    if wlen < 0 {
        return 0 - 1
    }
    let wreg = o.len
    i = 0
    while i < wlen {
        out_byte(o, ord(d.data.at(wstart + i)))
        emitted = emitted + 1
        i = i + 1
    }
    if ttype == 10 {
        if wlen > 0 {
            to_upper_at(o, wreg)
        }
    }
    else if ttype == 11 {
        var q = wreg
        var rem = wlen
        while rem > 0 {
            let stp = to_upper_at(o, q)
            q = q + stp
            rem = rem - stp
        }
    }
    let soff = d.pmap[suffix_id]
    let slen = d.psfx[soff]
    i = 0
    while i < slen {
        out_byte(o, d.psfx[soff + 1 + i])
        emitted = emitted + 1
        i = i + 1
    }
    return emitted
}
fn emit_dict_word(inout o: Out, distance: Int, length: Int, d: Dict) -> Int {
    if length < 4 || length > 24 {
        return 0 - 1
    }
    let address = distance - o.len - 1 // max_distance = min(out.len, window) = out.len
    let shift = d.sbits[length]
    if shift == 0 {
        return 0 - 1
    }
    let word_idx = (address & (1 << shift) - 1)
    let tidx = (address >> shift)
    if tidx >= 121 {
        return 0 - 1
    }
    return apply_transform(o, d, d.offs[length] + word_idx * length, length, tidx)
}
// inverse move-to-front over an (up to 256-symbol) context map.
fn imtf(inout v: Vec<Int>) {
    var mtf: Vec<Int> = vec()
    var i = 0
    while i < 256 {
        mtf.push(i)
        i = i + 1
    }
    i = 0
    while i < v.len() {
        let idx = v[i]
        let val = mtf[idx]
        v[i] = val
        var j = idx
        while j > 0 {
            mtf[j] = mtf[j - 1]
            j = j - 1
        }
        mtf[0] = val
        i = i + 1
    }
}
fn read_context_map(inout b: BR, size: Int, ntrees: Int) -> Vec<Int> {
    var cm: Vec<Int> = vec()
    var i = 0
    while i < size {
        cm.push(0)
        i = i + 1
    }
    if ntrees < 2 {
        return cm
    }
    var rlemax = 0
    if br_take(b, 1) == 1 {
        rlemax = br_take(b, 4) + 1
    }
    let code = prefix_read(b, ntrees + rlemax)
    i = 0
    while i < size {
        let sym = prefix_decode(b, code)
        if sym == 0 {
            cm[i] = 0
            i = i + 1
        }
        else if sym <= rlemax {
            var reps = (1 << sym) + br_take(b, sym)
            while reps > 0 && i < size {
                cm[i] = 0
                i = i + 1
                reps = reps - 1
            }
        }
        else {
            cm[i] = sym - rlemax
            i = i + 1
        }
    }
    if br_take(b, 1) == 1 {
        imtf(cm)
    }
    return cm
}

// block-splitting state for one category (literals / commands / distances).
struct Blk {
    ntypes: Int,
    cur: Int,
    prev: Int,
    count: Int,
    tt: Prefix,
    ct: Prefix
}
fn read_blk(inout b: BR, ntypes: Int, bbase: Vec<Int>, bextra: Vec<Int>) -> Blk {
    var bk = Blk { ntypes: ntypes, cur: 0, prev: 1, count: 268435456, tt: prefix_single(0), ct: prefix_single(0) }
    if ntypes >= 2 {
        bk.tt = prefix_read(b, ntypes + 2)
        bk.ct = prefix_read(b, 26)
        let sym = prefix_decode(b, bk.ct)
        bk.count = bbase[sym] + br_take(b, bextra[sym])
    }
    return bk
}
fn blk_switch(inout b: BR, inout bk: Blk, bbase: Vec<Int>, bextra: Vec<Int>) {
    let code = prefix_decode(b, bk.tt)
    var nt = code - 2
    if code == 0 {
        nt = bk.prev
    } else if code == 1 {
        nt = (bk.cur + 1) % bk.ntypes
    }
    bk.prev = bk.cur bk.cur = nt
    let sym = prefix_decode(b, bk.ct)
    bk.count = bbase[sym] + br_take(b, bextra[sym])
}

/// decompress a raw Brotli stream to its bytes. A stream that needs a static dictionary word
/// is resolved against the embedded RFC 7932 dictionary.
pub fn brotli_decode(data: Str) -> Str {
    var b = br_new(data)
    var out = out_new()
    let _wbits = read_wbits(b)
    var dist_rb: Vec<Int> = vec() dist_rb.push(16) dist_rb.push(15) dist_rb.push(11) dist_rb.push(4)
    var dist_rb_idx = 0
    let ctxtab = parse_ctx_table()
    var dict = dict_new() // dictionary decoded lazily on first ref
    let iB = ins_base() let iE = ins_extra() let cB = cpy_base() let cE = cpy_extra()
    let bB = blk_base() let bE = blk_extra() let iLut = ins_range_lut() let cLut = cpy_range_lut()
    var failed = false
    var done = false
    while !done && !failed {
        let is_last = br_take(b, 1)
        var empty = false
        if is_last == 1 {
            if br_take(b, 1) == 1 {
                empty = true
            }
        }
        if empty {
            done = true
        }
        else {
            let nib = br_take(b, 2)
            if nib == 3 {
                // metadata block: skip its bytes
                br_take(b, 1)
                let mnib = br_take(b, 2)
                var mlen = 0 var i = 0
                while i < mnib {
                    mlen = (mlen | (br_take(b, 8) << i * 8))
                    i = i + 1
                }
                if mnib > 0 {
                    mlen = mlen + 1
                }
                if(b.cnt & 7) != 0 {
                    br_take(b, (b.cnt & 7))
                }
                // byte align
                i = 0 while i < mlen { br_take(b, 8) i = i + 1 }
                if is_last == 1 {
                    done = true
                }
            } else {
                let nibbles = nib + 4
                var mlen = 0 var i = 0
                while i < nibbles {
                    mlen = (mlen | (br_take(b, 4) << i * 4))
                    i = i + 1
                }
                mlen = mlen + 1
                var uncompressed = 0
                if is_last == 0 {
                    uncompressed = br_take(b, 1)
                }
                if uncompressed == 1 {
                    if(b.cnt & 7) != 0 {
                        br_take(b, (b.cnt & 7))
                    }
                    i = 0 while i < mlen { out_byte(out, br_take(b, 8)) i = i + 1 }
                    if is_last == 1 {
                        done = true
                    }
                } else {
                    // ── compressed meta-block header ──
                    var blkL = read_blk(b, decode_varlen(b) + 1, bB, bE)
                    var blkI = read_blk(b, decode_varlen(b) + 1, bB, bE)
                    var blkD = read_blk(b, decode_varlen(b) + 1, bB, bE)
                    let npostfix = br_take(b, 2)
                    let ndirect = (br_take(b, 4) << npostfix)
                    var cmodes: Vec<Int> = vec()
                    i = 0 while i < blkL.ntypes { cmodes.push(br_take(b, 2)) i = i + 1 }
                    let ntreesL = decode_varlen(b) + 1
                    let cmapL = read_context_map(b, blkL.ntypes * 64, ntreesL)
                    let ntreesD = decode_varlen(b) + 1
                    let cmapD = read_context_map(b, blkD.ntypes * 4, ntreesD)
                    var htL: Vec<Prefix> = vec() i = 0 while i < ntreesL { htL.push(prefix_read(b, 256)) i = i + 1 }
                    var htI: Vec<Prefix> = vec() i = 0 while i < blkI.ntypes { htI.push(prefix_read(b, 704)) i = i + 1 }
                    let numDist = 16 + ndirect + (48 << npostfix)
                    var htD: Vec<Prefix> = vec() i = 0 while i < ntreesD { htD.push(prefix_read(b, numDist)) i = i + 1 }
                    // ── command loop ──
                    var produced = 0
                    while produced < mlen && !failed {
                        if blkI.count == 0 {
                            blk_switch(b, blkI, bB, bE)
                        }
                        blkI.count = blkI.count - 1
                        let cmd = prefix_decode(b, htI[blkI.cur])
                        let range = (cmd >> 6)
                        let sub = (cmd & 63)
                        let insCode = iLut[range] + ((sub >> 3) & 7)
                        let cpyCode = cLut[range] + (sub & 7)
                        let distZero = range < 2
                        let insLen = iB[insCode] + br_take(b, iE[insCode])
                        let cpyLen = cB[cpyCode] + br_take(b, cE[cpyCode])
                        var k = 0
                        while k < insLen {
                            if blkL.count == 0 {
                                blk_switch(b, blkL, bB, bE)
                            }
                            blkL.count = blkL.count - 1
                            var p1 = 0 var p2 = 0
                            if out.len > 0 {
                                p1 = out_at(out, out.len - 1)
                            }
                            if out.len > 1 {
                                p2 = out_at(out, out.len - 2)
                            }
                            let ctx = lit_context(ctxtab, p1, p2, cmodes[blkL.cur])
                            let tree = cmapL[blkL.cur * 64 + ctx]
                            out_byte(out, prefix_decode(b, htL[tree]))
                            produced = produced + 1
                            k = k + 1
                        }
                        if produced >= mlen {
                            failed = failed
                        }
                        // last command: no copy
                        else {
                            var distance = 0
                            if distZero {
                                dist_rb_idx = dist_rb_idx - 1
                                distance = dist_rb[(dist_rb_idx & 3)]
                            }
                            // implicit: reuse last distance (copy below re-pushes it)
                            else {
                                if blkD.count == 0 {
                                    blk_switch(b, blkD, bB, bE)
                                }
                                blkD.count = blkD.count - 1
                                var dctx = 3
                                if cpyLen < 5 {
                                    dctx = cpyLen - 2
                                }
                                let dtree = cmapD[blkD.cur * 4 + dctx]
                                let dsym = prefix_decode(b, htD[dtree])
                                if dsym < 16 {
                                    if dsym <= 3 {
                                        let dc = (1 >> dsym)
                                        distance = dist_rb[(dist_rb_idx - (dsym - 3) & 3)]
                                        dist_rb_idx = dist_rb_idx - dc
                                    }
                                    else {
                                        var idelta = 3
                                        var base = dsym - 4
                                        if dsym >= 10 {
                                            idelta = 2
                                            base = dsym - 10
                                        }
                                        let delta = ((6312258 >> 4 * base) & 15) - 3
                                        distance = dist_rb[(dist_rb_idx + idelta & 3)] + delta
                                    }
                                } else {
                                    let dcode = dsym - 16
                                    if dcode < ndirect {
                                        distance = dcode + 1
                                    }
                                    else {
                                        let dc2 = dcode - ndirect
                                        let postfix = (dc2 & (1 << npostfix) - 1)
                                        let hcode = (dc2 >> npostfix)
                                        let nbits = (hcode >> 1) + 1
                                        let offset = (2 + (hcode & 1) << nbits) - 4
                                        distance = (offset + br_take(b, nbits) << npostfix) + postfix + ndirect + 1
                                    }
                                }
                            }
                            let src = out.len - distance
                            if src < 0 {
                                // distance past output start → dictionary word
                                dict_ensure(dict) // dict refs do not push to the distance ring buffer
                                let em = emit_dict_word(out, distance, cpyLen, dict)
                                if em < 0 {
                                    failed = true
                                } else {
                                    produced = produced + em
                                }
                            }
                            else {
                                dist_rb[(dist_rb_idx & 3)] = distance
                                dist_rb_idx = dist_rb_idx + 1
                                var c = 0
                                while c < cpyLen {
                                    out_byte(out, out_at(out, src + c))
                                    produced = produced + 1
                                    c = c + 1
                                }
                            }
                        }
                    }
                    if is_last == 1 {
                        done = true
                    }
                }
            }
        }
    }
    if failed {
        unsafe {
            free(out.p)
        }
        return ""
    }
    var s = ""
    unsafe {
        s = str_from_buf(out.p, out.len)
        free(out.p)
    }
    return s
}
