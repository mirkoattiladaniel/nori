fn m3_c2afill_i(n: Int) -> Vec<Int> { var c2ai: Vec<Int> = vec()  var c2ki = 0  while c2ki < n { c2ai.push(0)  c2ki = c2ki + 1 }  return c2ai }
fn m3_c2afill_f(n: Int) -> Vec<Float> { var c2af: Vec<Float> = vec()  var c2kf = 0  while c2kf < n { c2af.push(0.0)  c2kf = c2kf + 1 }  return c2af }
fn m3_c2aset_i(inout a: Vec<Int>, v: Int, n: Int) -> Int { var c2si = 0  while c2si < n && c2si < a.len() { a[c2si] = v  c2si = c2si + 1 }  return 0 }
fn m3_c2amove_i(inout d: Vec<Int>, doff: Int, s: Vec<Int>, soff: Int, n: Int) -> Int { var c2mi = 0  while c2mi < n { if doff + c2mi < d.len() && soff + c2mi < s.len() { d[doff + c2mi] = s[soff + c2mi] }  c2mi = c2mi + 1 }  return 0 }
fn m3_c2aset_off_i(inout a: Vec<Int>, o: Int, v: Int, n: Int) -> Int { var c2so = 0  while c2so < n && o + c2so < a.len() { a[o + c2so] = v  c2so = c2so + 1 }  return 0 }
fn m3_c2aset_off_f(inout a: Vec<Float>, o: Int, v: Float, n: Int) -> Int { var c2sp = 0  while c2sp < n && o + c2sp < a.len() { a[o + c2sp] = v  c2sp = c2sp + 1 }  return 0 }
fn m3_c2amove_f(inout d: Vec<Float>, doff: Int, s: Vec<Float>, soff: Int, n: Int) -> Int { var c2mj = 0  while c2mj < n { if doff + c2mj < d.len() && soff + c2mj < s.len() { d[doff + c2mj] = s[soff + c2mj] }  c2mj = c2mj + 1 }  return 0 }
fn m3_c2amove1_f(inout b: Vec<Float>, doff: Int, soff: Int, n: Int) -> Int { if doff < soff { var c2mg = 0  while c2mg < n { if doff + c2mg < b.len() && soff + c2mg < b.len() { b[doff + c2mg] = b[soff + c2mg] }  c2mg = c2mg + 1 } } else { var c2mh = n - 1  while c2mh >= 0 { if doff + c2mh < b.len() && soff + c2mh < b.len() { b[doff + c2mh] = b[soff + c2mh] }  c2mh = c2mh - 1 } }  return 0 }
// C truncates on assignment to a narrow integer type, and the wrap is part of the algorithm
// wherever a difference of two bytes is stored back into one (qoi.h's DIFF opcode is exactly that).
fn m3_c_i8(v: Int) -> Int { let x = v & 255  if x >= 128 { return x - 256 }  return x }
fn m3_c_u8(v: Int) -> Int { return v & 255 }
fn m3_c_i16(v: Int) -> Int { let x = v & 65535  if x >= 32768 { return x - 65536 }  return x }
fn m3_c_u16(v: Int) -> Int { return v & 65535 }
fn m3_c_i32(v: Int) -> Int { let x = v & 4294967295  if x >= 2147483648 { return x - 4294967296 }  return x }
fn m3_c_u32(v: Int) -> Int { return v & 4294967295 }
// C's `float` is 32 bits of arithmetic, not only of storage. Nori has F32 and computes there,
// but promotes in a mixed expression, so each operand arrives already narrowed. A parameter
// narrows, which is what makes this one function the conversion Nori has no builtin for.
fn m3_c_f32(x: Float) -> F32 { var y: F32 = x  return y }
fn m3_c_f64(x: F32) -> Float { var y: Float = x  return y }
// C's `>>` on a signed type is an arithmetic shift: it keeps the sign, so (-7) >> 1 is -4.
// Nori's `>>` is logical on a 64-bit Int, which would answer 9223372036854775804.
fn m3_c_sar(v: Int, n: Int) -> Int {
    if v >= 0 { return v >> n }
    return 0 - ((((0 - v) + ((1 << n) - 1))) >> n)
}
// Raw loads and stores at a C scalar's own width. Nori has peek8/peek32/peek but no 16-bit
// access, so the 2-byte pair is assembled from bytes, little-endian like the target. peek8/peek32
// zero-extend, so a signed load puts the sign bit back; otherwise a stored -5 reads as 4294967291.
fn m3_c_rd8s(a: Int) -> Int { unsafe { let x = peek8(a)  if x >= 128 { return x - 256 }  return x } }
fn m3_c_rd16u(a: Int) -> Int { unsafe { return peek8(a) | (peek8(a + 1) << 8) } }
fn m3_c_rd16s(a: Int) -> Int { let x = m3_c_rd16u(a)  if x >= 32768 { return x - 65536 }  return x }
fn m3_c_rd32s(a: Int) -> Int { unsafe { let x = peek32(a)  if x >= 2147483648 { return x - 4294967296 }  return x } }
fn m3_c_wr16(a: Int, v: Int) { unsafe { poke8(a, v & 255)  poke8(a + 1, (v >> 8) & 255) } }
// `static` locals: one object each, initialised once, outliving the call
