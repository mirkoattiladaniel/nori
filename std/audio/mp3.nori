struct m3_mp3dec_frame_info_t { frame_bytes: Int, frame_offset: Int, channels: Int, hz: Int, layer: Int, bitrate_kbps: Int }

struct m3_mp3dec_t { mdct_overlap: Vec<Float>, qmf_state: Vec<Float>, reserv: Int, free_format_bytes: Int, header: Vec<Int>, reserv_buf: Vec<Int> }




struct m3_bs_t { buf: view Vec<Int>, buf_c2o: Int, pos: Int, limit: Int }

struct m3_L12_scale_info { scf: Vec<Float>, total_bands: Int, stereo_bands: Int, bitalloc: Vec<Int>, scfcod: Vec<Int> }

struct m3_L12_subband_alloc_t { tab_offset: Int, code_tab_width: Int, band_count: Int }

struct m3_L3_gr_info_t { sfbtab: view Vec<Int>, sfbtab_c2o: Int, part_23_length: Int, big_values: Int, scalefac_compress: Int, global_gain: Int, block_type: Int, mixed_block_flag: Int, n_long_sfb: Int, n_short_sfb: Int, table_select: Vec<Int>, region_count: Vec<Int>, subblock_gain: Vec<Int>, preflag: Int, scalefac_scale: Int, count1_table: Int, scfsi: Int }

struct m3_mp3dec_scratch_t { bs: m3_bs_t, maindata: Vec<Int>, gr_info: Vec<m3_L3_gr_info_t>, grbuf: Vec<Float>, scf: Vec<Float>, syn: Vec<Float>, ist_pos: Vec<Int> }

fn m3_bs_init(inout bs: m3_bs_t, data: Vec<Int>, data_c2o: Int, bytes: Int) {
    bs.buf = data
    bs.buf_c2o = data_c2o
    bs.pos = 0
    bs.limit = (bytes * 8)
    return 0
}

fn m3_get_bits(inout bs: m3_bs_t, n: Int) -> Int {
    var next = 0
    var cache = 0
    var s = m3_c_u32((bs.pos & 7))
    var shl = m3_c_i32(m3_c_u32((n + s)))
    var p_c2o = (bs.buf_c2o + ((bs.pos >> 3)))
    bs.pos = (bs.pos + (n))
    if ((bs.pos) > bs.limit) {
        return 0
    }
    let c2t1 = p_c2o
    p_c2o = p_c2o + 1
    next = m3_c_u32((bs.buf[c2t1] & ((255 >> s))))
    while true {
