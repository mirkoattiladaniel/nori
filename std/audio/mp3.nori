// ══ the public API ════════════════════════════════════════════════════════════════════════════
// Everything above this line is translated from the C original. Everything below is hand-written.

global m3_ready: Int = 0

fn m3_ensure() {
    if m3_ready == 1 { return }
    m3_tables_init()
    m3_ready = 1
}

/// What the decoder learned about the stream it just read.
pub struct Mp3Info { rate: Int, channels: Int, layer: Int, bitrate_kbps: Int, frames: Int, error: Str }

/// Decode a whole MP3 file, with a diagnostic. `sound.rate == 0` means nothing decoded and `error`
/// says why. A file that decodes partly (a truncated download) returns what it got, with `error`
/// empty; the frame count and duration tell you how much.
pub fn mp3_decode_info(bytes: Str) -> Mp3Info {
    var s = mp3_decode(bytes)
    return m3_last_info(s)
}

// The per-call results the last decode produced. Kept as Ints in globals rather than threaded
// through a struct because the decode loop below is the only writer and Nori globals may not carry
// a Str initialiser (so the error text is rebuilt from a code).
global m3_i_rate: Int = 0
global m3_i_ch: Int = 0
global m3_i_layer: Int = 0
global m3_i_kbps: Int = 0
global m3_i_frames: Int = 0
global m3_i_err: Int = 0            // 0 ok, 1 empty input, 2 no frame found

fn m3_last_info(s: Sound) -> Mp3Info {
    var e = ""
    if m3_i_err == 1 { e = "empty input" }
    if m3_i_err == 2 { e = "no MPEG audio frame found in " + to_str(m3_i_frames) + " bytes" }
    return Mp3Info { rate: m3_i_rate, channels: m3_i_ch, layer: m3_i_layer, bitrate_kbps: m3_i_kbps, frames: m3_i_frames, error: e }
}

/// Decode a whole MP3 file to S16 interleaved PCM. Returns a Sound with `rate == 0` if no frame
/// decoded; `mp3_decode_info` after the call explains why.
pub fn mp3_decode(bytes: Str) -> Sound {
    m3_ensure()
    m3_i_rate = 0  m3_i_ch = 0  m3_i_layer = 0  m3_i_kbps = 0  m3_i_frames = 0  m3_i_err = 0
    let n = bytes.len()
    if n < 4 { m3_i_err = 1  return Sound { rate: 0, channels: 0, data: "" } }
    // The safe port indexes a Vec<Int> of bytes (that is what --safe means: no raw pointers), so the
    // input is widened once here. 8 bytes per input byte is the price of the bounds-checked port.
    var buf: Vec<Int> = vec()
    var i = 0
    while i < n { buf.push(ord(bytes.at(i)))  i = i + 1 }

    var dec = m3_mp3dec_t { mdct_overlap: m3_c2vfill_f(576), qmf_state: m3_c2vfill_f(960), reserv: 0, free_format_bytes: 0, header: m3_c2vfill_i(4), reserv_buf: m3_c2vfill_i(511) }
    var info = m3_mp3dec_frame_info_t { frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0 }
    var pcm: Vec<Int> = m3_c2afill_i(2304)          // MINIMP3_MAX_SAMPLES_PER_FRAME
    m3_mp3dec_init(dec)

    var out = by_new(n * 8 + 64)                    // ~8x is the usual expansion at 128 kbps
    var off = 0
    var nframes = 0
    var stop = false
    while !stop && off < n {
        let got = m3_mp3dec_decode_frame(dec, buf, off, n - off, pcm, 0, info)
        if info.frame_bytes == 0 { stop = true }
        if !stop {
            if got > 0 {
                if nframes == 0 { m3_i_rate = info.hz  m3_i_ch = info.channels  m3_i_layer = info.layer  m3_i_kbps = info.bitrate_kbps }
                var k = 0
                let total = got * info.channels
                while k < total { by_s16(out, pcm[k])  k = k + 1 }
                nframes = nframes + 1
            }
            off = off + info.frame_bytes
        }
    }
    let data = by_take(out)
    m3_i_frames = nframes
    if nframes == 0 { m3_i_err = 2  m3_i_frames = n  return Sound { rate: 0, channels: 0, data: "" } }
    return Sound { rate: m3_i_rate, channels: m3_i_ch, data: data }
}

/// Read only the first frame's header: sample rate, channel count, layer, bitrate, without
/// decoding any audio. Returns `rate == 0` if there is no frame.
pub fn mp3_probe(bytes: Str) -> Mp3Info {
    m3_ensure()
    m3_i_rate = 0  m3_i_ch = 0  m3_i_layer = 0  m3_i_kbps = 0  m3_i_frames = 0  m3_i_err = 0
    let n = bytes.len()
    if n < 4 { m3_i_err = 1  return m3_last_info(Sound { rate: 0, channels: 0, data: "" }) }
    var buf: Vec<Int> = vec()
    var i = 0
    while i < n { buf.push(ord(bytes.at(i)))  i = i + 1 }
    var dec = m3_mp3dec_t { mdct_overlap: m3_c2vfill_f(576), qmf_state: m3_c2vfill_f(960), reserv: 0, free_format_bytes: 0, header: m3_c2vfill_i(4), reserv_buf: m3_c2vfill_i(511) }
    var info = m3_mp3dec_frame_info_t { frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0 }
    var pcm: Vec<Int> = m3_c2afill_i(2304)
    m3_mp3dec_init(dec)
    let got = m3_mp3dec_decode_frame(dec, buf, 0, n, pcm, 0, info)
    if info.frame_bytes == 0 || got == 0 { m3_i_err = 2  m3_i_frames = n  return m3_last_info(Sound { rate: 0, channels: 0, data: "" }) }
    m3_i_rate = info.hz  m3_i_ch = info.channels  m3_i_layer = info.layer  m3_i_kbps = info.bitrate_kbps  m3_i_frames = 1
    return m3_last_info(Sound { rate: 0, channels: 0, data: "" })
}
