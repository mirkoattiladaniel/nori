//! std/audio/mp3: an MP3 (MPEG-1/2 Layer I/II/III) decoder.
//!
//!   let s = audio::mp3_decode(read_file("music.mp3"))     // -> Sound (S16 interleaved)
//!
//! Provenance: this is lieff/minimp3 (`minimp3.h`, CC0), translated to Nori in a
//! safe style: every C pointer became a `Vec` plus an index, so there is no raw memory access
//! anywhere below and every array read is bounds-checked by Nori.
//!
//! Limits: whole-buffer decode only: `mp3_decode` takes the entire file and returns the entire
//! Sound. There is no streaming/incremental API and no seek (minimp3's `mp3dec_ex` layer, which
//! provides both, is not included). ID3v2 tags are skipped; anything else non-audio is
//! resynchronised past by minimp3's own frame finder.

// translated from C
fn m3_c2sfill_bs_t(n: Int) -> Vec<m3_bs_t> { var c2sa: Vec<m3_bs_t> = vec()  var c2sk = 0  while c2sk < n { c2sa.push(m3_bs_t { buf: vec(), buf_c2o: 0, pos: 0, limit: 0 })  c2sk = c2sk + 1 }  return c2sa }
fn m3_c2sfill_L12_scale_info(n: Int) -> Vec<m3_L12_scale_info> { var c2sa: Vec<m3_L12_scale_info> = vec()  var c2sk = 0  while c2sk < n { c2sa.push(m3_L12_scale_info { scf: m3_c2vfill_f(192), total_bands: 0, stereo_bands: 0, bitalloc: m3_c2vfill_i(64), scfcod: m3_c2vfill_i(64) })  c2sk = c2sk + 1 }  return c2sa }
global m3_c2p_L12_subband_alloc_t: Vec<m3_L12_subband_alloc_t>
fn m3_c2new_L12_subband_alloc_t() -> Int { m3_c2p_L12_subband_alloc_t.push(m3_L12_subband_alloc_t { tab_offset: 0, code_tab_width: 0, band_count: 0 })  return m3_c2p_L12_subband_alloc_t.len() - 1 }
// %s on a safe char buffer: read to the NUL, as C does. A buffer with no NUL in it
// reads to its end rather than off it, which is the point of the safe model.
// C string literals: one NUL-terminated array each, which is a literal's lifetime in C
// %u / %lu: C renders these bits as an unsigned 64-bit number. Nori has one signed Int, so a
// value past 2^63 prints negative unless it is divided out unsigned first.
fn m3_c2vfill_i(n: Int) -> Vec<Int> { var c2vi: Vec<Int> = vec()  var c2ki = 0  while c2ki < n { c2vi.push(0)  c2ki = c2ki + 1 }  return c2vi }
fn m3_c2vfill_f(n: Int) -> Vec<Float> { var c2vf: Vec<Float> = vec()  var c2kf = 0  while c2kf < n { c2vf.push(0.0)  c2kf = c2kf + 1 }  return c2vf }
// The element loop each of those uses. Its accumulator is named per element type: an indexed
// local's element type is tracked by name across the whole program, so one shared spelling would
// collapse the three and read two of them at the wrong width.
fn m3_c2vcp_i(c2s: Vec<Int>) -> Vec<Int> { var c2ci: Vec<Int> = vec()  var c2ni = 0  while c2ni < c2s.len() { c2ci.push(c2s[c2ni])  c2ni = c2ni + 1 }  return c2ci }
fn m3_c2vcp_f(c2s: Vec<Float>) -> Vec<Float> { var c2cf: Vec<Float> = vec()  var c2nf = 0  while c2nf < c2s.len() { c2cf.push(c2s[c2nf])  c2nf = c2nf + 1 }  return c2cf }
fn m3_c2vcp_s_L3_gr_info_t(c2s: Vec<m3_L3_gr_info_t>) -> Vec<m3_L3_gr_info_t> { var c2cs: Vec<m3_L3_gr_info_t> = vec()  var c2ns = 0  while c2ns < c2s.len() { c2cs.push(m3_c2cp_L3_gr_info_t(c2s[c2ns]))  c2ns = c2ns + 1 }  return c2cs }
fn m3_c2vfill_s_L3_gr_info_t(n: Int) -> Vec<m3_L3_gr_info_t> { var c2fs: Vec<m3_L3_gr_info_t> = vec()  var c2nf5 = 0  while c2nf5 < n { c2fs.push(m3_L3_gr_info_t { sfbtab: vec(), sfbtab_c2o: 0, part_23_length: 0, big_values: 0, scalefac_compress: 0, global_gain: 0, block_type: 0, mixed_block_flag: 0, n_long_sfb: 0, n_short_sfb: 0, table_select: m3_c2vfill_i(3), region_count: m3_c2vfill_i(3), subblock_gain: m3_c2vfill_i(3), preflag: 0, scalefac_scale: 0, count1_table: 0, scfsi: 0 })  c2nf5 = c2nf5 + 1 }  return c2fs }
fn m3_c2cp_mp3dec_t(c2s: m3_mp3dec_t) -> m3_mp3dec_t {
    return m3_mp3dec_t { mdct_overlap: m3_c2vcp_f(c2s.mdct_overlap), qmf_state: m3_c2vcp_f(c2s.qmf_state), reserv: c2s.reserv, free_format_bytes: c2s.free_format_bytes, header: m3_c2vcp_i(c2s.header), reserv_buf: m3_c2vcp_i(c2s.reserv_buf) }
}
fn m3_c2cp_L12_scale_info(c2s: m3_L12_scale_info) -> m3_L12_scale_info {
    return m3_L12_scale_info { scf: m3_c2vcp_f(c2s.scf), total_bands: c2s.total_bands, stereo_bands: c2s.stereo_bands, bitalloc: m3_c2vcp_i(c2s.bitalloc), scfcod: m3_c2vcp_i(c2s.scfcod) }
}
fn m3_c2cp_L3_gr_info_t(c2s: m3_L3_gr_info_t) -> m3_L3_gr_info_t {
    return m3_L3_gr_info_t { sfbtab: c2s.sfbtab, sfbtab_c2o: c2s.sfbtab_c2o, part_23_length: c2s.part_23_length, big_values: c2s.big_values, scalefac_compress: c2s.scalefac_compress, global_gain: c2s.global_gain, block_type: c2s.block_type, mixed_block_flag: c2s.mixed_block_flag, n_long_sfb: c2s.n_long_sfb, n_short_sfb: c2s.n_short_sfb, table_select: m3_c2vcp_i(c2s.table_select), region_count: m3_c2vcp_i(c2s.region_count), subblock_gain: m3_c2vcp_i(c2s.subblock_gain), preflag: c2s.preflag, scalefac_scale: c2s.scalefac_scale, count1_table: c2s.count1_table, scfsi: c2s.scfsi }
}
fn m3_c2cp_mp3dec_scratch_t(c2s: m3_mp3dec_scratch_t) -> m3_mp3dec_scratch_t {
    return m3_mp3dec_scratch_t { bs: copy c2s.bs, maindata: m3_c2vcp_i(c2s.maindata), gr_info: m3_c2vcp_s_L3_gr_info_t(c2s.gr_info), grbuf: m3_c2vcp_f(c2s.grbuf), scf: m3_c2vcp_f(c2s.scf), syn: m3_c2vcp_f(c2s.syn), ist_pos: m3_c2vcp_i(c2s.ist_pos) }
}
