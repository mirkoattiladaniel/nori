// ══ the public API ════════════════════════════════════════════════════════════════════════════
// Everything above this line is translated from the C original. Everything below is hand-written.

extern fn malloc(Int) -> Int
extern fn free(Int)

global ov_ready: Int = 0

fn ov_ensure() {
    if ov_ready == 1 { return }
    unsafe { ov_tables_init() }
    ov_ready = 1
}

/// Decode a whole Ogg Vorbis file to S16 interleaved PCM. Returns a Sound with `rate == 0` if the
/// bytes are not a Vorbis stream this can read.
pub fn ogg_decode(bytes: Str) -> Sound {
    ov_ensure()
    let n = bytes.len()
    if n < 4 { return Sound { rate: 0, channels: 0, data: "" } }
    var s = Sound { rate: 0, channels: 0, data: "" }
    unsafe {
        // stb_vorbis wants a plain byte buffer; copy the Str into one. (nori_str_ptr would avoid
        // the copy, but stb_vorbis_decode_memory is documented as taking ownership of nothing and
        // reading freely around its input, and a Str's buffer is GC-visible memory.)
        let mem = malloc(n + 1)
        var i = 0
        while i < n { poke8(mem + i, ord(bytes.at(i)))  i = i + 1 }
        var ch = 0
        let ratep = malloc(8)
        poke32(ratep, 0)
        var outp = 0
        let got = ov_stb_vorbis_decode_memory(mem, n, ch, ratep, outp)
        let rate = peek32(ratep)
        if got > 0 && ch > 0 {
            // `outp` is a malloc'd short* of got*ch samples. str_from_buf takes the byte range
            // whole — NULs included, which PCM is full of — so this is one copy, not a loop.
            s = Sound { rate: rate, channels: ch, data: str_from_buf(outp, got * ch * 2) }
        }
        if outp != 0 { free(outp) }
        free(ratep)
        free(mem)
    }
    return s
}

/// Rate and channel count of an Ogg Vorbis stream, without keeping the PCM. Returns `rate == 0` if
/// it is not readable. (It still decodes: stb_vorbis's one-call API is all that is exposed here.)
pub fn ogg_probe(bytes: Str) -> Sound {
    let s = ogg_decode(bytes)
    return Sound { rate: s.rate, channels: s.channels, data: "" }
}
