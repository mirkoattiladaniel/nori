//! std/audio/vorbis: an Ogg Vorbis decoder.
//!
//!   let s = audio::ogg_decode(read_file("music.ogg"))     // -> Sound (S16 interleaved)
//!
//! Provenance: this is nothings/stb_vorbis (`stb_vorbis.c`, public domain / MIT), translated to Nori
//! in an unsafe style. The C pointers stayed pointers: this code
//! callocs, pokes and peeks raw memory where the C did, including a `pokef32` union type-pun
//! and `alloca` scoping. It is a C decoder running in Nori with C's memory model, inside `unsafe`.
//!
//! Limits: whole-buffer decode only (`stb_vorbis_decode_memory`): the file goes in, the Sound comes
//! out. stb_vorbis's streaming, seeking and pushdata APIs are all present in the code below but are
//! not exposed, because nothing in std needs them.

// translated from C
extern fn calloc(Int, Int) -> Int
extern fn malloc(Int) -> Int
extern fn realloc(Int, Int) -> Int
extern fn free(Int)
fn ov_c_ld_CRCscan(a: Int) -> ov_CRCscan {
    unsafe {
        return ov_CRCscan { goal_crc: peek32(a + 0), bytes_left: ov_c_rd32s(a + 4), crc_so_far: peek32(a + 8), bytes_done: ov_c_rd32s(a + 12), sample_loc: peek32(a + 16) }
    }
}
fn ov_c_st_CRCscan(a: Int, v: ov_CRCscan) {
    unsafe {
        poke32(a + 0, v.goal_crc)
        poke32(a + 4, v.bytes_left)
        poke32(a + 8, v.crc_so_far)
        poke32(a + 12, v.bytes_done)
        poke32(a + 16, v.sample_loc)
    }
}
// memset: bytes, as C's
fn ov_c_memset(d: Int, v: Int, n: Int) -> Int {
    unsafe {
        var i = 0
        while i < n { poke8(d + i, v)  i = i + 1 }
    }
    return d
}
// %u / %lu: C renders these bits as an unsigned 64-bit number. Nori has one signed Int, so a
// value past 2^63 prints negative unless it is divided out unsigned first.
// C truncates on assignment to a narrow integer type, and the wrap is part of the algorithm
// wherever a difference of two bytes is stored back into one (qoi.h's DIFF opcode is exactly that).
fn ov_c_i8(v: Int) -> Int { let x = v & 255  if x >= 128 { return x - 256 }  return x }
fn ov_c_u8(v: Int) -> Int { return v & 255 }
fn ov_c_i16(v: Int) -> Int { let x = v & 65535  if x >= 32768 { return x - 65536 }  return x }
fn ov_c_u16(v: Int) -> Int { return v & 65535 }
fn ov_c_i32(v: Int) -> Int { let x = v & 4294967295  if x >= 2147483648 { return x - 4294967296 }  return x }
fn ov_c_u32(v: Int) -> Int { return v & 4294967295 }
// C's `float` is 32 bits of arithmetic, not only of storage. Nori has F32 and computes there,
// but promotes in a mixed expression, so each operand arrives already narrowed. A parameter
// narrows, which is what makes this one function the conversion Nori has no builtin for.
fn ov_c_f32(x: Float) -> F32 { var y: F32 = x  return y }
fn ov_c_f64(x: F32) -> Float { var y: Float = x  return y }
// C's `>>` on a signed type is an arithmetic shift: it keeps the sign, so (-7) >> 1 is -4.
// Nori's `>>` is logical on a 64-bit Int, which would answer 9223372036854775804.
fn ov_c_sar(v: Int, n: Int) -> Int {
    if v >= 0 { return v >> n }
    return 0 - ((((0 - v) + ((1 << n) - 1))) >> n)
}
// Raw loads and stores at a C scalar's own width. Nori has peek8/peek32/peek but no 16-bit
// access, so the 2-byte pair is assembled from bytes, little-endian like the target. peek8/peek32
// zero-extend, so a signed load puts the sign bit back; otherwise a stored -5 reads as 4294967291.
fn ov_c_rd8s(a: Int) -> Int { unsafe { let x = peek8(a)  if x >= 128 { return x - 256 }  return x } }
fn ov_c_rd16u(a: Int) -> Int { unsafe { return peek8(a) | (peek8(a + 1) << 8) } }
fn ov_c_rd16s(a: Int) -> Int { let x = ov_c_rd16u(a)  if x >= 32768 { return x - 65536 }  return x }
fn ov_c_rd32s(a: Int) -> Int { unsafe { let x = peek32(a)  if x >= 2147483648 { return x - 4294967296 }  return x } }
fn ov_c_wr16(a: Int, v: Int) { unsafe { poke8(a, v & 255)  poke8(a + 1, (v >> 8) & 255) } }
// memcpy: bytes, as C's (the regions must not overlap, as in C)
fn ov_c_memcpy(d: Int, s: Int, n: Int) -> Int {
    unsafe {
        var i = 0
        while i < n { poke8(d + i, peek8(s + i))  i = i + 1 }
    }
    return d
}
// struct assignment: C copies exactly n bytes
fn ov_c_scopy(dst: Int, src: Int, n: Int) {
    unsafe {
        var i = 0
        while i + 8 <= n { poke(dst + i, peek(src + i))  i = i + 8 }
        while i < n { poke8(dst + i, peek8(src + i))  i = i + 1 }
    }
}
extern fn abort() -> Int
// `alloca`: storage that lives until the calling function returns. C takes it from the stack;
// here it comes from a bump arena, with a mark taken at the top of every function that calls one
// and released at each of that function's returns. The discipline is the same either way: the
// blocks come back in the reverse of the order they were taken, so releasing is moving the top.
// The arena does not grow, because growing would move blocks the caller is still holding. It is
// sized once and aborts when full, rather than handing back storage that overlaps a live block.
global ov_c2al_buf: Int = 0
global ov_c2al_top: Int = 0
global ov_c2al_cap: Int = 0
fn ov_c_alloca_mark() -> Int { return ov_c2al_top }
fn ov_c_alloca_release(m: Int) { ov_c2al_top = m }
fn ov_c_alloca(n: Int) -> Int {
    if ov_c2al_buf == 0 { ov_c2al_cap = 16777216  ov_c2al_buf = calloc(ov_c2al_cap, 1) }
    let need = ((n + 15) / 16) * 16
    if ov_c2al_top + need > ov_c2al_cap { let junk_al = abort() }
    let p = ov_c2al_buf + ov_c2al_top
    ov_c2al_top = ov_c2al_top + need
    return p
}
// qsort: C's, through the comparator it was handed. A stable insertion sort: C leaves the
// order of equal elements unspecified, so a deterministic order is used. Elements move as bytes,
// because their type is `void` here as it is there.
fn ov_c_qsort(base: Int, n: Int, sz: Int, cmp: Int) {
    unsafe {
        var i = 1
        while i < n {
            var j = i
            while j > 0 {
                let a = base + (j - 1) * sz
                let b = base + j * sz
                if call_ptr(cmp, a, b) <= 0 { break }
                var k = 0
                while k < sz { let t = peek8(a + k)  poke8(a + k, peek8(b + k))  poke8(b + k, t)  k = k + 1 }
                j = j - 1
            }
            i = i + 1
        }
    }
}
// assert: aborts, as C's does. It prints nothing (C's message goes to stderr).
fn ov_c_assert(ok: Bool) { if !ok { let junk_ab = abort() } }
// <stdlib.h>'s integer abs. C leaves abs(INT_MIN) undefined; this wraps, as the
// negation of a two's-complement minimum does on every target it runs on.
fn ov_c_abs(v: Int) -> Int { if v < 0 { return 0 - v }  return v }
// ldexp takes an `int` exponent, not a double; it is the one <math.h> entry that cannot
// ride the all-double declaration below.
extern fn ldexp(Float, Int) -> Float
// <math.h>: bound straight to libm, at C's own double signature
extern fn log(Float) -> Float
extern fn exp(Float) -> Float
extern fn floor(Float) -> Float
extern fn pow(Float, Float) -> Float
extern fn cos(Float) -> Float
extern fn sin(Float) -> Float
// memcmp: C's, byte for byte
fn ov_c_memcmp(a: Int, b: Int, n: Int) -> Int {
    unsafe {
        var i = 0
        while i < n {
            let x = peek8(a + i)
            let y = peek8(b + i)
            if x != y { return x - y }
            i = i + 1
        }
    }
    return 0
}
// `static` locals: one object each, initialised once, outliving the call
global ov_c2s_ilog_log2_4: Int = 0
global ov_c2s_vorbis_validate_vorbis: Int = 0
global ov_c2s_vorbis_decode_packet_rest_range_list: Int = 0
global ov_c2s_convert_samples_short_channel_selector: Int = 0
struct ov_stb_vorbis_alloc { alloc_buffer: Int, alloc_buffer_length_in_bytes: Int }


struct ov_stb_vorbis_info { sample_rate: Int, channels: Int, setup_memory_required: Int, setup_temp_memory_required: Int, temp_memory_required: Int, max_frame_size: Int }

struct ov_stb_vorbis_comment { vendor: Int, comment_list_length: Int, comment_list: Int }




































struct ov_Residue { begin: Int, end: Int, part_size: Int, classifications: Int, classbook: Int, classdata: Int, residue_books: Int }

struct ov_MappingChannel { magnitude: Int, angle: Int, mux: Int }


struct ov_Mode { blockflag: Int, mapping: Int, windowtype: Int, transformtype: Int }

struct ov_CRCscan { goal_crc: Int, bytes_left: Int, crc_so_far: Int, bytes_done: Int, sample_loc: Int }

struct ov_ProbedPage { page_start: Int, page_end: Int, last_decoded_sample: Int }



fn ov_error(f: Int, e: Int) -> Int {
    unsafe {
    poke32((f) + 140, e)
    if ((ov_c_rd32s((f) + 136) == 0) && (e != 1)) {
        poke32((f) + 140, e)
    }
    return 0
    }
}

fn ov_make_block_array(mem: Int, count: Int, size: Int) -> Int {
    unsafe {
    var i = 0
    var p = mem
    var q = ((p + ((count) * 8)))
    i = 0
    while (i < count) {
        poke(p + (i) * 8, q)
        q = (q + (size))
        i = i + 1
    }
    return p
    }
}

fn ov_setup_malloc(f: Int, sz_c2p: Int) -> Int {
    unsafe {
    var sz = sz_c2p
    sz = (((sz + 7)) & (~7))
    poke32((f) + 8, (peek32((f) + 8) + (sz)))
    if (peek((f) + 112) != 0) {
        var p = (peek((f) + 112) + ov_c_rd32s((f) + 128))
        if ((ov_c_rd32s((f) + 128) + sz) > ov_c_rd32s((f) + 132)) {
            return 0
        }
        poke32((f) + 128, (ov_c_rd32s((f) + 128) + (sz)))
        return p
    }
    return (if (sz != 0) { malloc(sz) } else { 0 })
    }
}

fn ov_setup_free(f: Int, p: Int) {
    unsafe {
    if (peek((f) + 112) != 0) {
        return
    }
    free(p)
    }
    return 0
}

fn ov_setup_temp_malloc(f: Int, sz_c2p: Int) -> Int {
    unsafe {
    var sz = sz_c2p
    sz = (((sz + 7)) & (~7))
    if (peek((f) + 112) != 0) {
        if ((ov_c_rd32s((f) + 132) - sz) < ov_c_rd32s((f) + 128)) {
            return 0
        }
        poke32((f) + 132, (ov_c_rd32s((f) + 132) - (sz)))
        return (peek((f) + 112) + ov_c_rd32s((f) + 132))
    }
    return malloc(sz)
    }
}

fn ov_setup_temp_free(f: Int, p: Int, sz: Int) {
    unsafe {
    if (peek((f) + 112) != 0) {
        poke32((f) + 132, (ov_c_rd32s((f) + 132) + ((((sz + 7)) & (~7)))))
        return
    }
    free(p)
    }
    return 0
}

global ov_crc_table: Int = 0

fn ov_crc32_init() {
    unsafe {
    var i = 0
    var j = 0
    var s = 0
    i = 0
    while (i < 256) {
        s = ov_c_u32((ov_c_u32(i) << 24))
        j = 0
        while (j < 8) {
            s = ov_c_u32(((ov_c_u32((s << 1))) ^ ((if (s >= (ov_c_u32((1 << 31)))) { 79764919 } else { 0 }))))
            j = j + 1
        }
        poke32(ov_crc_table + (i) * 4, s)
        i = i + 1
    }
    }
    return 0
}

fn ov_crc32_update(crc: Int, byte: Int) -> Int {
    unsafe {
    return ov_c_u32((((crc << 8)) ^ peek32(ov_crc_table + ((byte ^ ((crc >> 24)))) * 4)))
    }
}

fn ov_bit_reverse(n_c2p: Int) -> Int {
    var n = n_c2p
    n = ov_c_u32((((((n & 2863311530)) >> 1)) | (ov_c_u32((((n & 1431655765)) << 1)))))
    n = ov_c_u32((((((n & 3435973836)) >> 2)) | (ov_c_u32((((n & 858993459)) << 2)))))
    n = ov_c_u32((((((n & 4042322160)) >> 4)) | (ov_c_u32((((n & 252645135)) << 4)))))
    n = ov_c_u32((((((n & 4278255360)) >> 8)) | (ov_c_u32((((n & 16711935)) << 8)))))
    return ov_c_u32((((n >> 16)) | (ov_c_u32((n << 16)))))
}

fn ov_square(x: F32) -> F32 {
    return (x * x)
}

fn ov_ilog(n: Int) -> Int {
    
    if (n < 0) {
        return 0
    }
    if (n < ((1 << 14))) {
        if (n < ((1 << 4))) {
            return (0 + ov_c_rd8s(ov_c2s_ilog_log2_4 + n))
        }
        else {
            if (n < ((1 << 9))) {
                return (5 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 5)))
            }
            else {
                return (10 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 10)))
            }
        }
    }
    else {
        if (n < ((1 << 24))) {
            if (n < ((1 << 19))) {
                return (15 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 15)))
            }
            else {
                return (20 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 20)))
            }
        }
        else {
            if (n < ((1 << 29))) {
                return (25 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 25)))
            }
            else {
                return (30 + ov_c_rd8s(ov_c2s_ilog_log2_4 + ov_c_sar(n, 30)))
            }
        }
    }
    return 0
}

fn ov_float32_unpack(x: Int) -> F32 {
    var mantissa = ov_c_u32((x & 2097151))
    var sign = ov_c_u32((x & 2147483648))
    var exp = ov_c_u32((((x & 2145386496)) >> 21))
    var res = (if (sign != 0) { (-(to_float(mantissa))) } else { to_float(mantissa) })
    return ov_c_f32(ldexp(ov_c_f64(ov_c_f32(res)), (ov_c_i32(exp) - 788)))
}

fn ov_add_entry(c: Int, huff_code: Int, symbol: Int, count: Int, len: Int, values: Int) {
    unsafe {
    if (peek8((c) + 27) == 0) {
        poke32((peek((c) + 40)) + ((symbol) * 4), huff_code)
    }
    else {
        poke32((peek((c) + 40)) + ((count) * 4), huff_code)
        poke8((peek((c) + 8)) + count, len)
        poke32(values + (count) * 4, symbol)
    }
    }
    return 0
}

fn ov_compute_codewords(c: Int, len: Int, n: Int, values: Int) -> Int {
    unsafe {
    var i = 0
    var k = 0
    var m = 0
    var available = calloc(32, 4)
    ov_c_memset(available, 0, 128)
    k = 0
    while (k < n) {
        if (peek8(len + k) < 255) {
            break
        }
        k = k + 1
    }
    if (k == n) {
        ov_c_assert(((if (ov_c_rd32s((c) + 2112) == 0) { 1 } else { 0 }) != 0))
        return 1
    }
    ov_c_assert(((if (peek8(len + k) < 32) { 1 } else { 0 }) != 0))
    let c2t1 = m
    m = m + 1
    ov_add_entry(c, 0, k, c2t1, peek8(len + k), values)
    i = 1
    while (i <= peek8(len + k)) {
        poke32(available + (i) * 4, ov_c_u32((1 << ((32 - i)))))
        i = i + 1
    }
    i = (k + 1)
    while (i < n) {
        var res = 0
        var z = peek8(len + i)
    var y = 0
        if (z == 255) {
            i = i + 1
            continue
        }
        ov_c_assert(((if (z < 32) { 1 } else { 0 }) != 0))
        while ((z > 0) && (peek32(available + (z) * 4) == 0)) {
            z = z - 1
        }
        if (z == 0) {
            return 0
        }
        res = ov_c_u32(peek32(available + (z) * 4))
        poke32(available + (z) * 4, 0)
        let c2t2 = m
        m = m + 1
        ov_add_entry(c, ov_bit_reverse(res), i, c2t2, peek8(len + i), values)
        if (z != peek8(len + i)) {
            y = peek8(len + i)
            while (y > z) {
                ov_c_assert(((if (peek32(available + (y) * 4) == 0) { 1 } else { 0 }) != 0))
                poke32(available + (y) * 4, ov_c_u32((res + ((1 << ((32 - y)))))))
                y = y - 1
            }
        }
        i = i + 1
    }
    return 1
    }
}

fn ov_compute_accelerated_huffman(c: Int) {
    unsafe {
    var i = 0
    var len = 0
    i = 0
    while (i < ((1 << 10))) {
        ov_c_wr16(((c) + 48) + ((i) * 2), (0 - 1))
        i = i + 1
    }
    len = (if (peek8((c) + 27) != 0) { ov_c_rd32s((c) + 2112) } else { ov_c_rd32s((c) + 4) })
    if (len > 32767) {
        len = 32767
    }
    i = 0
    while (i < len) {
        if (peek8((peek((c) + 8)) + i) <= 10) {
            var z = ov_c_u32((if (peek8((c) + 27) != 0) { ov_bit_reverse(peek32((peek((c) + 2096)) + ((i) * 4))) } else { peek32((peek((c) + 40)) + ((i) * 4)) }))
            while (z < ((1 << 10))) {
                ov_c_wr16(((c) + 48) + ((z) * 2), i)
                z = ov_c_u32((z + ((1 << peek8((peek((c) + 8)) + i)))))
            }
        }
        i = i + 1
    }
    }
    return 0
}

fn ov_uint32_compare(p: Int, q: Int) -> Int {
    unsafe {
    var x = ov_c_u32(peek32(p))
    var y = ov_c_u32(peek32(q))
    return (if (x < y) { (0 - 1) } else { (x > y) })
    }
}

fn ov_include_in_sort(c: Int, len: Int) -> Int {
    unsafe {
    if (peek8((c) + 27) != 0) {
        ov_c_assert(((if (len != 255) { 1 } else { 0 }) != 0))
        return 1
    }
    if (len == 255) {
        return 0
    }
    if (len > 10) {
        return 1
    }
    return 0
    }
}

fn ov_compute_sorted_huffman(c: Int, lengths: Int, values: Int) {
    unsafe {
    var i = 0
    var len = 0
    if (peek8((c) + 27) == 0) {
        var k = 0
        i = 0
        while (i < ov_c_rd32s((c) + 4)) {
            if (ov_include_in_sort(c, peek8(lengths + i)) != 0) {
                let c2t3 = k
                k = k + 1
                poke32((peek((c) + 2096)) + ((c2t3) * 4), ov_bit_reverse(peek32((peek((c) + 40)) + ((i) * 4))))
            }
            i = i + 1
        }
        ov_c_assert(((if (k == ov_c_rd32s((c) + 2112)) { 1 } else { 0 }) != 0))
    }
    else {
        i = 0
        while (i < ov_c_rd32s((c) + 2112)) {
            poke32((peek((c) + 2096)) + ((i) * 4), ov_bit_reverse(peek32((peek((c) + 40)) + ((i) * 4))))
            i = i + 1
        }
    }
    ov_c_qsort(peek((c) + 2096), ov_c_rd32s((c) + 2112), 4, fn_addr(ov_uint32_compare))
    poke32((peek((c) + 2096)) + ((ov_c_rd32s((c) + 2112)) * 4), 4294967295)
    len = (if (peek8((c) + 27) != 0) { ov_c_rd32s((c) + 2112) } else { ov_c_rd32s((c) + 4) })
    i = 0
    while (i < len) {
        var huff_len = (if (peek8((c) + 27) != 0) { peek8(lengths + peek32(values + (i) * 4)) } else { peek8(lengths + i) })
        if (ov_include_in_sort(c, huff_len) != 0) {
            var code = ov_c_u32(ov_bit_reverse(peek32((peek((c) + 40)) + ((i) * 4))))
            var x = 0
    var n = ov_c_rd32s((c) + 2112)
            while (n > 1) {
                var m = (x + (ov_c_sar(n, 1)))
                if (peek32((peek((c) + 2096)) + ((m) * 4)) <= code) {
                    x = m
                    n = (n - ((ov_c_sar(n, 1))))
                }
                else {
                    n = ov_c_sar(n, 1)
                }
            }
            ov_c_assert(((if (peek32((peek((c) + 2096)) + ((x) * 4)) == code) { 1 } else { 0 }) != 0))
            if (peek8((c) + 27) != 0) {
                poke32((peek((c) + 2104)) + ((x) * 4), peek32(values + (i) * 4))
                poke8((peek((c) + 8)) + x, huff_len)
            }
            else {
                poke32((peek((c) + 2104)) + ((x) * 4), i)
            }
        }
        i = i + 1
    }
    }
    return 0
}

fn ov_vorbis_validate(data: Int) -> Int {
    
    return (if (ov_c_memcmp(data, ov_c2s_vorbis_validate_vorbis, 6) == 0) { 1 } else { 0 })
}

fn ov_lookup1_values(entries: Int, dim: Int) -> Int {
    var r = to_int(floor(exp(ov_c_f64((ov_c_f32(log(ov_c_f64(ov_c_f32(to_float(entries))))) / ov_c_f32(to_float(dim)))))))
    if (to_int(floor(pow(ov_c_f64((ov_c_f32(to_float(r)) + ov_c_f32(to_float(1)))), to_float(dim)))) <= entries) {
        r = r + 1
    }
    if (pow(ov_c_f64((ov_c_f32(to_float(r)) + ov_c_f32(to_float(1)))), to_float(dim)) <= to_float(entries)) {
        return (0 - 1)
    }
    if (to_int(floor(pow(ov_c_f64(ov_c_f32(to_float(r))), to_float(dim)))) > entries) {
        return (0 - 1)
    }
    return r
}

fn ov_compute_twiddle_factors(n: Int, A: Int, B: Int, C: Int) {
    unsafe {
    var n4 = ov_c_sar(n, 2)
    var n8 = ov_c_sar(n, 3)
    var k = 0
    var k2 = 0
    k2 = 0
    k = k2
