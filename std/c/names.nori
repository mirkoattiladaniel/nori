// the fixed names every unit interns first, in this order, so each has a known id
fn cnm_fixed() -> Str {
    return ""
        + " ("
        + " )"
        + " ,"
        + " #"
        + " ##"
        + " ..."
        + " ;"
        + " {"
        + " }"
        + " ["
        + " ]"
        + " *"
        + " ="
        + " :"
        + " ?"
        + " !"
        + " ~"
        + " -"
        + " +"
        + " /"
        + " %"
        + " <<"
        + " >>"
        + " <"
        + " >"
        + " <="
        + " >="
        + " =="
        + " !="
        + " &"
        + " ^"
        + " |"
        + " &&"
        + " ||"
        + " ."
        + " ->"
        + " 0"
        + " 1"
        + " define"
        + " undef"
        + " include"
        + " include_next"
        + " if"
        + " ifdef"
        + " ifndef"
        + " elif"
        + " else"
        + " endif"
        + " elifdef"
        + " elifndef"
        + " pragma"
        + " error"
        + " warning"
        + " line"
        + " once"
        + " defined"
        + " __VA_ARGS__"
        + " __VA_OPT__"
        + " __has_include"
        + " __has_include_next"
        + " __has_attribute"
        + " __has_builtin"
        + " __has_feature"
        + " __has_extension"
        + " __has_c_attribute"
        + " __has_cpp_attribute"
        + " __has_warning"
        + " __FILE__"
        + " __LINE__"
        + " __COUNTER__"
        + " __DATE__"
        + " __TIME__"
        + " __BASE_FILE__"
        + " __is_identifier"
        + " pack"
        + " push"
        + " pop"
        + " import"
        + " ident"
        + " sccs"
        + " assert"
        + " unassert"
        + " typedef"
        + " extern"
        + " static"
        + " auto"
        + " register"
        + " inline"
        + " __inline"
        + " __inline__"
        + " _Noreturn"
        + " _Thread_local"
        + " __thread"
        + " thread_local"
        + " constexpr"
        + " const"
        + " __const"
        + " __const__"
        + " volatile"
        + " __volatile"
        + " __volatile__"
        + " restrict"
        + " __restrict"
        + " __restrict__"
        + " _Atomic"
        + " _Nullable"
        + " _Nonnull"
        + " _Null_unspecified"
        + " __auto_type"
        + " void"
        + " char"
        + " short"
        + " int"
        + " long"
        + " signed"
        + " __signed"
        + " __signed__"
        + " unsigned"
        + " float"
        + " double"
        + " _Bool"
        + " bool"
        + " __int128"
        + " __int128_t"
        + " __uint128_t"
        + " _Float128"
        + " __float128"
        + " _Float64x"
        + " _Float80"
        + " __float80"
        + " _Float128x"
        + " __ibm128"
        + " _Float32"
        + " _Float64"
        + " _Float32x"
        + " _Float16"
        + " _Complex"
        + " __complex__"
        + " __builtin_va_list"
        + " struct"
        + " union"
        + " enum"
        + " __attribute__"
        + " __attribute"
        + " __extension__"
        + " __asm__"
        + " __asm"
        + " asm"
        + " _Static_assert"
        + " static_assert"
        + " __typeof__"
        + " __typeof"
        + " typeof"
        + " __typeof_unqual__"
        + " typeof_unqual"
        + " _Alignas"
        + " alignas"
        + " sizeof"
        + " _Alignof"
        + " __alignof__"
        + " alignof"
        + " __alignof"
        + " packed"
        + " __packed__"
        + " aligned"
        + " __aligned__"
        + " mode"
        + " __mode__"
        + " __builtin_offsetof"
        + " true"
        + " false"
        + " nullptr"
        + " _Generic"
        + " vector_size"
        + " __vector_size__"
        + " QI"
        + " HI"
        + " SI"
        + " DI"
        + " TI"
        + " word"
        + " pointer"
        + " __QI__"
        + " __HI__"
        + " __SI__"
        + " __DI__"
        + " __TI__"
        + " __word__"
        + " __pointer__"
        + " unused"
}
