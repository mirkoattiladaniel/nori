    eq("derive_key len 7168", tohex(crypto::blake3_derive_key(tv_ctx(), tv(7168), 32)), "11c37a112765370c94a51415d0d651190c288566e295d505defdad895dae2237")
    eq("derive_key len 8192", tohex(crypto::blake3_derive_key(tv_ctx(), tv(8192), 32)), "ad01d7ae4ad059b0d33baa3c01319dcf8088094d0359e5fd45d6aeaa8b2d0c3d")
    eq("derive_key len 8193", tohex(crypto::blake3_derive_key(tv_ctx(), tv(8193), 32)), "af1e0346e389b17c23200270a64aa4e1ead98c61695d917de7d5b00491c9b0f1")
    eq("derive_key len 16384", tohex(crypto::blake3_derive_key(tv_ctx(), tv(16384), 32)), "160e18b5878cd0df1c3af85eb25a0db5344d43a6fbd7a8ef4ed98d0714c3f7e1")
