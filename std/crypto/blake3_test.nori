// .nori tests for BLAKE3, run with
//   noric --test std/crypto/blake3_test.nori compiler/runtime.nori --import-root .
//
// The vectors below are the official ones, from the BLAKE3 reference repository's
// `test_vectors/test_vectors.json`: the input of length n is the byte sequence
// `i % 251` for i in 0..n, the key is the 32-byte ASCII string "whats the Elvish word for
// friend", and the derive-key context is "BLAKE3 2019-12-27 16:29:52 test vectors context".
// They were re-derived with the `blake3` PyO3 binding (blake3 1.0.8, which
// wraps the reference Rust crate) and cross-checked against two real exported
// scene files, whose 64-byte headers carry a BLAKE3-256 checksum of their payload written by
// a completely independent implementation.
//
// The length table is the core of the test. A BLAKE3 validated only on short inputs has
// exercised the compression function and nothing of the algorithm above it. The interesting
// lengths are the ones that change the shape of the tree:
//
//   0        the empty input: one chunk of one empty block, not zero blocks
//   1..64    one block, so CHUNK_START|CHUNK_END|ROOT all land on the same compression
//   1023     the last chunk block is short and the tree is still a single chunk
//   1024     one full chunk, still no parent node at all
//   1025     the first input with a parent node: two chunks, the second holding one byte
//   2048     two full chunks, a balanced tree of depth 1
//   2049     three chunks: the first unbalanced tree, where a left subtree of two chunks is
//            merged with a lone right chunk. This is the case a stack-merge off-by-one gets
//            wrong while every power-of-two length still passes.
//   3072/3073/4096/4097/5120/6144/7168/8192/8193/16384/16385/31744
//            depths 2 and 3, both balanced and ragged, including 31744 = 31 chunks whose
//            tree is maximally lopsided at every level.
//
// The XOF cases matter separately: the output stream past 64 bytes is produced by a second
// root compression with the output-block counter at 1, and an implementation that never asks
// for more than 32 bytes has never run that path.
import "std/crypto" as crypto

fn hexv(c: Byte) -> Int {
    let o = ord(c)
    if o >= 97 { return (o - 87) }
    if o >= 65 { return (o - 55) }
    return (o - 48)
}
fn unhex(h: Str) -> Str {
    var out = ""
    var i = 0
    while i < h.len() { out = (out + chr(((hexv(h.at(i)) << 4) | hexv(h.at(i + 1)))))  i = i + 2 }
    return out
}

/// the official test-vector input: byte `i` is `i % 251`. 251 is prime and just under 256, so
/// the pattern's period shares no factor with the 64-byte block or the 1024-byte chunk, and a
/// block or chunk mixed up with its neighbour cannot coincidentally agree.
fn tv(n: Int) -> Str {
    var out = ""
    var i = 0
    while i < n { out = (out + chr(i % 251))  i = i + 1 }
    return out
}

fn tohex(s: Str) -> Str {
    let d = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < s.len() {
        let b = ord(s.at(i))
        out = (out + d.slice((b >> 4) & 15, ((b >> 4) & 15) + 1))
        out = (out + d.slice(b & 15, (b & 15) + 1))
        i = i + 1
    }
    return out
}

fn tv_key() -> Str { return "whats the Elvish word for friend" }
fn tv_ctx() -> Str { return "BLAKE3 2019-12-27 16:29:52 test vectors context" }

/// `assert_eq` is Int-only in Nori, so digests go through `assert_streq`. The `name` is printed
/// only on failure, which turns "some digest is wrong" into "length 2049 is wrong", and with a
/// table this size that is the difference between a diagnosis and a hunt.
fn eq(name: Str, got: Str, want: Str) {
    if got != want { printl("MISMATCH " + name) }
    assert_streq(got, want)
}

fn test_blake3_official_vectors_unkeyed() {
    eq("blake3 len 0", crypto::blake3(tv(0)), "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")
    eq("blake3 len 1", crypto::blake3(tv(1)), "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213")
    eq("blake3 len 2", crypto::blake3(tv(2)), "7b7015bb92cf0b318037702a6cdd81dee41224f734684c2c122cd6359cb1ee63")
    eq("blake3 len 3", crypto::blake3(tv(3)), "e1be4d7a8ab5560aa4199eea339849ba8e293d55ca0a81006726d184519e647f")
