fn test_blake3_official_vectors_derive_key() {
    eq("derive_key len 0", tohex(crypto::blake3_derive_key(tv_ctx(), tv(0), 32)), "2cc39783c223154fea8dfb7c1b1660f2ac2dcbd1c1de8277b0b0dd39b7e50d7d")
    eq("derive_key len 1", tohex(crypto::blake3_derive_key(tv_ctx(), tv(1), 32)), "b3e2e340a117a499c6cf2398a19ee0d29cca2bb7404c73063382693bf66cb06c")
    eq("derive_key len 2", tohex(crypto::blake3_derive_key(tv_ctx(), tv(2), 32)), "1f166565a7df0098ee65922d7fea425fb18b9943f19d6161e2d17939356168e6")
    eq("derive_key len 3", tohex(crypto::blake3_derive_key(tv_ctx(), tv(3), 32)), "440aba35cb006b61fc17c0529255de438efc06a8c9ebf3f2ddac3b5a86705797")
    eq("derive_key len 4", tohex(crypto::blake3_derive_key(tv_ctx(), tv(4), 32)), "f46085c8190d69022369ce1a18880e9b369c135eb93f3c63550d3e7630e91060")
    eq("derive_key len 5", tohex(crypto::blake3_derive_key(tv_ctx(), tv(5), 32)), "1f24eda69dbcb752847ec3ebb5dd42836d86e58500c7c98d906ecd82ed9ae47f")
    eq("derive_key len 6", tohex(crypto::blake3_derive_key(tv_ctx(), tv(6), 32)), "be96b30b37919fe4379dfbe752ae77b4f7e2ab92f7ff27435f76f2f065f6a5f4")
    eq("derive_key len 7", tohex(crypto::blake3_derive_key(tv_ctx(), tv(7), 32)), "dc3b6485f9d94935329442916b0d059685ba815a1fa2a14107217453a7fc9f0e")
