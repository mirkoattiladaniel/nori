    eq("blake3 len 5", crypto::blake3(tv(5)), "b40b44dfd97e7a84a996a91af8b85188c66c126940ba7aad2e7ae6b385402aa2")
    eq("blake3 len 6", crypto::blake3(tv(6)), "06c4e8ffb6872fad96f9aaca5eee1553eb62aed0ad7198cef42e87f6a616c844")
    eq("blake3 len 7", crypto::blake3(tv(7)), "3f8770f387faad08faa9d8414e9f449ac68e6ff0417f673f602a646a891419fe")
    eq("blake3 len 8", crypto::blake3(tv(8)), "2351207d04fc16ade43ccab08600939c7c1fa70a5c0aaca76063d04c3228eaeb")
    eq("blake3 len 63", crypto::blake3(tv(63)), "e9bc37a594daad83be9470df7f7b3798297c3d834ce80ba85d6e207627b7db7b")
    eq("blake3 len 64", crypto::blake3(tv(64)), "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98")
    eq("blake3 len 65", crypto::blake3(tv(65)), "de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee")
    eq("blake3 len 127", crypto::blake3(tv(127)), "d81293fda863f008c09e92fc382a81f5a0b4a1251cba1634016a0f86a6bd640d")
    eq("blake3 len 128", crypto::blake3(tv(128)), "f17e570564b26578c33bb7f44643f539624b05df1a76c81f30acd548c44b45ef")
