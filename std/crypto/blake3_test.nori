    eq("blake3 len 1023", crypto::blake3(tv(1023)), "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11")
    eq("blake3 len 1024", crypto::blake3(tv(1024)), "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7")
    eq("blake3 len 1025", crypto::blake3(tv(1025)), "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444")
    eq("blake3 len 2048", crypto::blake3(tv(2048)), "e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a")
    eq("blake3 len 2049", crypto::blake3(tv(2049)), "5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030")
    eq("blake3 len 3072", crypto::blake3(tv(3072)), "b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2")
    eq("blake3 len 3073", crypto::blake3(tv(3073)), "7124b49501012f81cc7f11ca069ec9226cecb8a2c850cfe644e327d22d3e1cd3")
