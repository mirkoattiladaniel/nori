// SHA-512 and SHA-384 (FIPS 180-4), and HMAC over both.
//
// The same shape as the SHA-256 in crypto.nori, widened: 64-bit words, 80 rounds, a 128-byte
// block, and a 128-bit length field. It is a separate file rather than a generalisation of the
// existing code because the two share no constant, no rotation amount and no word width, and
// merging them would mean threading a width through every helper to save nothing.
//
// SHA-384 is SHA-512 under a different initial value, truncated to 48 bytes. The truncation
// matters: with part of the state hidden, SHA-384 resists the
// length-extension attack that SHA-512 (and SHA-256) are open to.
//
// 64-bit words live in Int, which is i64, so these are the same bits an unsigned word would
// hold, and every operation used here (add, xor, and, not, shift) agrees with the unsigned
// reading. Nothing below compares or divides a word, which is where that equivalence would end.

frozen global K512: [Int] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

// SHA-512's initial value: the fractional halves of the square roots of the first eight primes.
frozen global IV512: [Int] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
]
// SHA-384's: the ninth through sixteenth primes, so that a SHA-384 digest cannot be a truncated
// SHA-512 one. Sharing an initial value would make the truncation useless.
frozen global IV384: [Int] = [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
]

// rotate right within 64 bits. `n` is never 0 in SHA-512, which matters: a rotation by zero would
// shift left by 64 and that is undefined, not a no-op.
fn s5_rotr(x: Int, n: Int) -> Int { return ((x >> n) | (x << (64 - n))) }

fn s5_ch(e: Int, f: Int, g: Int) -> Int { return ((e & f) ^ ((~ e) & g)) }
fn s5_maj(a: Int, b: Int, c: Int) -> Int { return (((a & b) ^ (a & c)) ^ (b & c)) }
fn s5_bsig0(a: Int) -> Int { return ((s5_rotr(a, 28) ^ s5_rotr(a, 34)) ^ s5_rotr(a, 39)) }
fn s5_bsig1(e: Int) -> Int { return ((s5_rotr(e, 14) ^ s5_rotr(e, 18)) ^ s5_rotr(e, 41)) }
fn s5_ssig0(x: Int) -> Int { return ((s5_rotr(x, 1) ^ s5_rotr(x, 8)) ^ (x >> 7)) }
fn s5_ssig1(x: Int) -> Int { return ((s5_rotr(x, 19) ^ s5_rotr(x, 61)) ^ (x >> 6)) }

// byte j of the padded message: data ++ 0x80 ++ zeros ++ a 128-bit big-endian bit length.
//
// The length field is sixteen bytes wide but only the low eight can be non-zero here, because a
// message long enough to reach the ninth would not fit in memory. The high half is written as
// zeros rather than computed: shifting an i64 by 64 or more is undefined, so asking for those
// bytes arithmetically is a real bug and not a pedantic one.
fn s5_pad_byte(data: Str, n: Int, ln: Int, j: Int) -> Int {
    if j < n { return ord(data.at(j)) }
    if j == n { return 0x80 }
    if j >= (ln - 16) {
        let b = ((ln - 1) - j)
        if b >= 8 { return 0 }
        return (((n * 8) >> (8 * b)) & 0xff)
    }
    return 0
}

// the eight state words of SHA-512 over `data`, started from `iv`. SHA-384 differs only in `iv`
// and in how much of the result its caller keeps.
fn s5_core(data: Str, iv: [Int]) -> Vec<Int> {
    let n = data.len()
    let ln = ((((n + 16) / 128) + 1) * 128)     // smallest multiple of 128 >= n + 17
    var h0 = iv[0] var h1 = iv[1] var h2 = iv[2] var h3 = iv[3]
    var h4 = iv[4] var h5 = iv[5] var h6 = iv[6] var h7 = iv[7]
    var blk = 0
    while blk < (ln / 128) {
        var w: Vec<Int> = vec()
        var t = 0
        while t < 16 {
            let p = ((blk * 128) + (t * 8))
            var wv = 0
            var k = 0
            while k < 8 { wv = ((wv << 8) | s5_pad_byte(data, n, ln, (p + k)))  k = k + 1 }
            w.push(wv)
            t = t + 1
        }
        while t < 80 {
            // Wrapping, every one of them. SHA-512 is defined on 64-bit words modulo 2^64, so an
            // addition that carries past the top is not an error, it is the algorithm. With
            // overflow checks on, the plain `+` would trap. SHA-256 above is
            // unaffected only because its words are 32 bits wide and their sums fit an Int.
            w.push(wrapping_add(wrapping_add(wrapping_add(s5_ssig1(w[t - 2]), w[t - 7]), s5_ssig0(w[t - 15])), w[t - 16]))
            t = t + 1
        }
        var a = h0 var b = h1 var c = h2 var d = h3
        var e = h4 var f = h5 var g = h6 var hh = h7
        var i = 0
        while i < 80 {
            let t1 = wrapping_add(wrapping_add(wrapping_add(wrapping_add(hh, s5_bsig1(e)), s5_ch(e, f, g)), K512[i]), w[i])
            let t2 = wrapping_add(s5_bsig0(a), s5_maj(a, b, c))
            hh = g  g = f  f = e  e = wrapping_add(d, t1)  d = c  c = b  b = a  a = wrapping_add(t1, t2)
            i = i + 1
        }
        h0 = wrapping_add(h0, a)  h1 = wrapping_add(h1, b)
        h2 = wrapping_add(h2, c)  h3 = wrapping_add(h3, d)
        h4 = wrapping_add(h4, e)  h5 = wrapping_add(h5, f)
        h6 = wrapping_add(h6, g)  h7 = wrapping_add(h7, hh)
        blk = blk + 1
    }
    var out: Vec<Int> = vec()
    out.push(h0) out.push(h1) out.push(h2) out.push(h3)
    out.push(h4) out.push(h5) out.push(h6) out.push(h7)
    return out
}

// the big-endian bytes of a full 64-bit word, appended to `out`.
fn s5_be64_bytes(x: Int, sink out: Str) -> Str {
    var i = 7
    while i >= 0 { out = (out + chr(((x >> (i * 8)) & 255)))  i = i - 1 }
    return out
}
fn s5_hex16(x: Int) -> Str {
    let digs = "0123456789abcdef"
    var out = ""
    var i = 15
    while i >= 0 { out = (out + digs.at(((x >> (i * 4)) & 0xf)))  i = i - 1 }
    return out
}
// the first `nbytes` of a state, raw.
fn s5_take(h: Vec<Int>, nbytes: Int) -> Str {
    var out = ""
    var i = 0
    while i < ((nbytes + 7) / 8) { out = s5_be64_bytes(h[i], out)  i = i + 1 }
    return out.slice(0, nbytes)
}

/// SHA-512 as 64 raw bytes.
pub fn sha512_raw(data: Str) -> Str { return s5_take(s5_core(data, IV512), 64) }
/// SHA-512 of an arbitrary byte string, as lowercase hex (128 chars).
pub fn sha512(data: Str) -> Str { return hex_of(sha512_raw(data)) }
/// SHA-384 as 48 raw bytes.
pub fn sha384_raw(data: Str) -> Str { return s5_take(s5_core(data, IV384), 48) }
/// SHA-384 of an arbitrary byte string, as lowercase hex (96 chars).
pub fn sha384(data: Str) -> Str { return hex_of(sha384_raw(data)) }

// HMAC (RFC 2104) over a 128-byte block. The block is the compression function's, not the
// digest's: SHA-384 emits 48 bytes but still consumes 128 at a time, and using 48 here would
// produce something that looks like an HMAC and agrees with no other implementation.
fn s5_hmac(key: Str, msg: Str, is384: Bool) -> Str {
    var k = key
    if k.len() > 128 {
        if is384 { k = sha384_raw(k) } else { k = sha512_raw(k) }
    }
    var ipad = ""
    var opad = ""
    var i = 0
    while i < 128 {
        var kb = 0
        if i < k.len() { kb = ord(k.at(i)) }
        ipad = (ipad + chr((kb ^ 0x36)))
        opad = (opad + chr((kb ^ 0x5c)))
        i = i + 1
    }
    if is384 { return sha384_raw((opad + sha384_raw((ipad + msg)))) }
    return sha512_raw((opad + sha512_raw((ipad + msg))))
}

/// HMAC-SHA512(key, msg) -> the 64 raw bytes.
pub fn hmac_sha512_raw(key: Str, msg: Str) -> Str { return s5_hmac(key, msg, false) }
/// HMAC-SHA512(key, msg) -> lowercase hex.
pub fn hmac_sha512(key: Str, msg: Str) -> Str { return hex_of(hmac_sha512_raw(key, msg)) }
/// HMAC-SHA384(key, msg) -> the 48 raw bytes. TLS 1.3's SHA-384 cipher suites key their whole
/// schedule with this, so it is a protocol primitive and not only a convenience.
pub fn hmac_sha384_raw(key: Str, msg: Str) -> Str { return s5_hmac(key, msg, true) }
/// HMAC-SHA384(key, msg) -> lowercase hex.
pub fn hmac_sha384(key: Str, msg: Str) -> Str { return hex_of(hmac_sha384_raw(key, msg)) }
