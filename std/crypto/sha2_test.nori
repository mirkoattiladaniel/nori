// .nori tests for SHA-512, SHA-384 and HMAC over both, run with
//   noric --test std/crypto/sha2_test.nori compiler/runtime.nori --import-root .
//
// The digests below are the FIPS 180-4 published examples (the one-block "abc", both multi-block
// examples, and the million-`a` long message) plus lengths chosen to sit on the padding boundary.
// The HMAC answers are the RFC 4231 vectors, which exist for these two hashes.
//
// The boundary lengths are the point of the length table. SHA-512 pads to 128 bytes and reserves
// sixteen of them for the length, so a message of 111 bytes still fits one block and 112 does not;
// an off-by-one there is invisible for short inputs and wrong for everything past the edge.
import "std/crypto" as crypto

fn hexv(c: Byte) -> Int {
    let o = ord(c)
    if o >= 97 { return (o - 87) }
    if o >= 65 { return (o - 55) }
    return (o - 48)
}
fn unhex(h: Str) -> Str {
    var out = ""
    var i = 0
    while i < h.len() { out = (out + chr(((hexv(h.at(i)) << 4) | hexv(h.at(i + 1)))))  i = i + 2 }
    return out
}
// a repeatable non-uniform byte pattern of length n: any fixed pattern does, so long as the
// reference and this agree on it.
fn pat(n: Int) -> Str {
    var out = ""
    var i = 0
    while i < n { out = (out + chr((((i * 7) + 3) & 0xff)))  i = i + 1 }
    return out
}
fn rep(b: Int, n: Int) -> Str {
    var out = ""
    var i = 0
    while i < n { out = (out + chr(b))  i = i + 1 }
    return out
}

fn test_sha512_published_examples() {
    // the empty message
    assert_streq(crypto::sha512(""), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    assert_streq(crypto::sha384(""), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
    // FIPS 180-4 one-block example
    assert_streq(crypto::sha512("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    assert_streq(crypto::sha384("abc"), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    // FIPS 180-4 two-block example
    assert_streq(crypto::sha512("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")
    assert_streq(crypto::sha384("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b")
    // FIPS 180-4 112-byte example
    assert_streq(crypto::sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
    assert_streq(crypto::sha384("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
}

// The padding edge: 111 bytes is the last that shares a block with the 16-byte length field.
fn test_sha512_length_boundaries() {
    assert_streq(crypto::sha512(pat(1)), "e45bf5817ddf94aa2f7a407071f0eedc6beb98f768b4cd33d1176d44d1563a45a5d7212290eb7670c6786b13591aedac86478993895e8b24e612014abaa6ba04")
    assert_streq(crypto::sha384(pat(1)), "8a6c69af6fb6247635f837958446fb8f10e39bd5fbc244f7e635176339a3be614f6394247f01dbe1126c178c7bd48cb5")
    assert_streq(crypto::sha512(pat(55)), "14fd424b1fcadee624da946ab03f7e1def7c0d6e00f689594319881a26ff30b875ba4c622ac13100c8cc784c9c2eb23159aecbb4a02e3999062f551193e2b256")
    assert_streq(crypto::sha384(pat(55)), "fc2728f452750d08b5dbad1aea53202e7fc19c06894d13e36c433b0444a899277c49f16e0577c03db0f0605578836ef6")
    assert_streq(crypto::sha512(pat(63)), "ecd42a703a4e93e163d60d55e3785b1a763838b0351bc2e6f7c94b4bfb24f9aa15da5d744ebcebe11f0fc4315d45ba3a047b6e60e07448357f2795bf34b73502")
    assert_streq(crypto::sha384(pat(63)), "be67a9a1162c1d97f183980dc811f4f4f835b8b850eb32ecbf87397b26369bc6646a8f2234940dcff142b627c8e21ebb")
    assert_streq(crypto::sha512(pat(64)), "8f3cc30b3fb5bf963688a46488249248ac2c67f0f85a145233c6c1e3c16dcd1df634c07d1d31da02576f65b9cf64e1c3fdb318b689b8a14e2e9552bcf30fb133")
    assert_streq(crypto::sha384(pat(64)), "99d26430f561864c2f7d90b68650b960c86c85d6bf7f54ceeee404bdd59663a7f05588b5c750b862a2a24f6a9ad4c050")
    assert_streq(crypto::sha512(pat(110)), "a915c6b13dc3bcb70211a6b7913896b606740d7e2341257db7db9b4a5aa3f0e650116aa3f56ad7e97c218da1a9c74043331631d747036d88cdcdb5c21fffcdb5")
    assert_streq(crypto::sha384(pat(110)), "632778628f59b233252fd41d30012eebc7b7eb367e431971d9353d8242340b55b8c7daa9c0cf6d2daa4a186d05f95851")
    assert_streq(crypto::sha512(pat(111)), "68cffa6d0d76f309c9ce0d35280939f8e25990c43b7b086ccdf709be35b07d4ddba599541ff2b1c19d34ea49aeafb9659adb7ac3c0b078bb30a22d57fc6687ef")
    assert_streq(crypto::sha384(pat(111)), "341388a9dc2275074e90cf394323761919761c805fd9e370977c9966a0e8c81a52135f02577670b0071638a4a26dbc31")
    assert_streq(crypto::sha512(pat(112)), "d0865c524d1dddf7c23b799c413f5adcd7caefd3f66a9b49750ec81066012c25a8bcf94ddea6dc525691673097ca40e0101e897fc97218cfdb0704084e2bef4b")
    assert_streq(crypto::sha384(pat(112)), "619cc5d06138526d70659eccf602d197e63e1050e22039a7feb40a30a5b2b08fb03729e291df12f8c576e6f1cd8af22a")
    assert_streq(crypto::sha512(pat(113)), "606314353bd419f9f7720e8297f2af8a9ed5f0bb0bed29b716bf18e34577623ae7effa46f496bd4282134e7e895284a4760a910d2ad8ec11e9dd75863058cd9c")
    assert_streq(crypto::sha384(pat(113)), "484a92d02b61b620ccae687fce4cd073eb995294a777d5deb5356bc8c1e2ce984f63f16420058ac5da666fda410a4feb")
    assert_streq(crypto::sha512(pat(127)), "e0b6a20f1c0c88970a9340152cd5a1c1ecf3d3b8de55102741879438079473540133b812706e5dbec322c8c9523b6fc8c6d16ee626e87ad5fe3d2916afedc369")
    assert_streq(crypto::sha384(pat(127)), "f8234ab81f5f9641c656680825a9bbb3c2616bcc80b65d5e479a4d96742e1b8742330c9e8256ef5f03caa932487044ca")
    assert_streq(crypto::sha512(pat(128)), "99b16f17aa0b969a5b8f08f367719d516e330ccd2660b6f0688ec031dbc783de50a1cd185a2568dba75070a2403d17d4741d163578515dfd2ff756ddfe4d47b1")
    assert_streq(crypto::sha384(pat(128)), "e8480e9c4dd90f88104a79cbaccec48edbd798a142b4f241d726dc252f1502350e824c7d18dadd59d7d716919fb8f9bf")
    assert_streq(crypto::sha512(pat(129)), "a1556e29185778aa5991e34b8884c840d589f0fbb4b8ed590e51e9ac4eb03a008125000db2671f8fe7f485b59a77b518670078ecb41a54b4cd02a7f1d2ca4c6d")
    assert_streq(crypto::sha384(pat(129)), "430173387764874661acba1e914e50f6d0fbac534809e859b1da4396fad3d5f24c25c6a2d02486d8fbda3994713d981a")
    assert_streq(crypto::sha512(pat(200)), "cca3c0276046ef9f2897bdfc3ec330f77f4959914b1462bd581b232ddb3e9aa98acf5f5a2b21c7f49d2e43721daa61a2b5cee6af6052dfeb766e66ddb0d1719c")
    assert_streq(crypto::sha384(pat(200)), "8deb83535fa35d2f493c6c3695b1057b19232d2f531a0d398d2b958413855aa1594b6bcca0ddcbd24a981330a7ff1cc1")
    assert_streq(crypto::sha512(pat(255)), "c2e3bb67012f9eb526202efa59997933f7d3e75e7ded738818bc27d94977f4573afddb1b2793745701e62affa3b7a1c8262c992a321f488a6b1942a4795bab98")
    assert_streq(crypto::sha384(pat(255)), "15f3347894a150a64eb82a7044bb5ec8b1d33488716fce4932ba73beb97eabd1ad796bc0a569129ba98120ae1ed7edce")
    assert_streq(crypto::sha512(pat(256)), "e49c208e41556e859d1a52d14784a061c2d5ae2c8690a5360e9f9344f60861c1362a9ec05a9f08a4167b3da41bdd122a387413dd06976470e4beff5053f2ac71")
    assert_streq(crypto::sha384(pat(256)), "23f0634552ba15289fa02c8a37e3a391e79e230dca05db03a7696630c5ba3a3352d1624f52832e4d6183c0eb70198e9a")
    assert_streq(crypto::sha512(pat(1000)), "00e36fccf193e59697a92b5ab24666ce6326d7fa16bf10832d0991ddc591112e9dfa6a636950ed9c4d67344a760654c2ff7785e1d60094d651038735b5dccabd")
    assert_streq(crypto::sha384(pat(1000)), "94c38db521ca733b8904c2d14b6e82d33dcfcc26e1318c579dbee1fc2f472019034e792263b9d46e90e700de2f6e7e91")
}

// The published long-message answer. Slow, but it is the only vector here that crosses many
// thousands of blocks, and a carry that only shows up at scale would survive everything else.
fn test_sha512_million_a() {
    assert_streq(crypto::sha512(rep(97, 1000000)), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")
    assert_streq(crypto::sha384(rep(97, 1000000)), "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985")
}

// RFC 4231. Cases 6 and 7 use a 131-byte key, which is longer than the 128-byte block and so
// must be hashed first, the one branch in HMAC that a short-key test never reaches.
fn test_hmac_rfc4231() {
    // case 1
    assert_streq(crypto::hmac_sha512(rep(11, 20), "Hi There"), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    assert_streq(crypto::hmac_sha384(rep(11, 20), "Hi There"), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
    // case 2
    assert_streq(crypto::hmac_sha512("Jefe", "what do ya want for nothing?"), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
    assert_streq(crypto::hmac_sha384("Jefe", "what do ya want for nothing?"), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    // case 3
    assert_streq(crypto::hmac_sha512(rep(170, 20), rep(221, 50)), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb")
    assert_streq(crypto::hmac_sha384(rep(170, 20), rep(221, 50)), "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27")
    // case 4
    assert_streq(crypto::hmac_sha512(unhex("0102030405060708090a0b0c0d0e0f10111213141516171819"), rep(205, 50)), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")
    assert_streq(crypto::hmac_sha384(unhex("0102030405060708090a0b0c0d0e0f10111213141516171819"), rep(205, 50)), "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb")
    // case 5
    assert_streq(crypto::hmac_sha512(rep(12, 20), "Test With Truncation"), "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b")
    assert_streq(crypto::hmac_sha384(rep(12, 20), "Test With Truncation"), "3abf34c3503b2a23a46efc619baef897f4c8e42c934ce55ccbae9740fcbc1af4ca62269e2a37cd88ba926341efe4aeea")
    // case 6
    assert_streq(crypto::hmac_sha512(rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")
    assert_streq(crypto::hmac_sha384(rep(170, 131), "Test Using Larger Than Block-Size Key - Hash Key First"), "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")
    // case 7
    assert_streq(crypto::hmac_sha512(rep(170, 131), "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")
    assert_streq(crypto::hmac_sha384(rep(170, 131), "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."), "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e")
}

// SHA-384 must not be a truncated SHA-512. They start from different initial values, and this is
// what that buys: the shorter digest is not a prefix of the longer one, so nothing learns half a
// SHA-512 state by asking for a SHA-384.
fn test_sha384_is_not_truncated_sha512() {
    assert_true(!(crypto::sha384("abc") == crypto::sha512("abc").slice(0, 96)))
    assert_true(!(crypto::sha384("") == crypto::sha512("").slice(0, 96)))
}

fn test_sha512_shapes() {
    assert_eq(crypto::sha512("abc").len(), 128)
    assert_eq(crypto::sha384("abc").len(), 96)
    assert_eq(crypto::sha512_raw("abc").len(), 64)
    assert_eq(crypto::sha384_raw("abc").len(), 48)
    assert_eq(crypto::hmac_sha512_raw("k", "m").len(), 64)
    assert_eq(crypto::hmac_sha384_raw("k", "m").len(), 48)
}
