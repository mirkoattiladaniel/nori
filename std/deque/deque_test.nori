import "std/deque" as deque
fn test_fifo() {
    var d = deque::new()
    deque::push_back(d, 1) deque::push_back(d, 2) deque::push_back(d, 3)
    assert_eq(deque::size(d), 3)
    assert_eq(deque::pop_front(d), 1)
    assert_eq(deque::pop_front(d), 2)
    assert_eq(deque::peek_back(d), 3)
}
fn test_both_ends() {
    var d = deque::new()
    deque::push_front(d, 2) deque::push_front(d, 1) deque::push_back(d, 3)
    assert_eq(deque::pop_front(d), 1)
    assert_eq(deque::pop_back(d), 3)
    assert_eq(deque::pop_front(d), 2)
    assert_true(deque::is_empty(d))
}
fn test_slack_reuse() {
    var d = deque::new()
    deque::push_back(d, 5)
    assert_eq(deque::pop_front(d), 5)
    deque::push_front(d, 9)
    assert_eq(deque::peek_front(d), 9)
    assert_eq(deque::size(d), 1)
}

// ---- laws: deque order invariants (fuzzed by `noric --fuzz-laws` / `roll law`) ----
law deque_push_back_is_fifo(v: Vec<Int>) {
    var d = deque::new()
    var i = 0
    while i < v.len() {
        deque::push_back(d, v[i])
        i = i + 1
    }
    assert(deque::size(d) == v.len())
    i = 0
    while i < v.len() {
        assert(deque::pop_front(d) == v[i])
        i = i + 1
    }
    // same order in, out
}
law deque_push_front_reverses(v: Vec<Int>) {
    var d = deque::new()
    var i = 0
    while i < v.len() {
        deque::push_front(d, v[i])
        i = i + 1
    }
    i = v.len() - 1
    while i >= 0 {
        assert(deque::pop_front(d) == v[i])
        i = i - 1
    }
    // front-pushes pop out reversed
}
