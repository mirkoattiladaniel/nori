//! std/encoding: byte <-> text codecs: lowercase hex and standard Base64 (RFC 4648).
//! A "byte string" is an ordinary Nori `Str` (each `char_at` is one 0..255 byte). Encoders take bytes and
//! return ASCII text; decoders take that text and return the original bytes.
//!   import "std/encoding" as enc
//!   enc::hex_encode("Hi")     // "4869"
//!   enc::b64_encode("Hi")     // "SGk="
//!   enc::b64_decode("SGk=")   // "Hi"
//! (For a single integer in hex, std/fmt::to_hex already exists; this is for byte arrays + decoding.)

/// the 1-char substring of `s` at `i`.
fn at1(s: Str, i: Int) -> Str {
    return s.slice(i, i + 1)
}
/// the lowercase-hex / Base64 alphabets (functions, since Nori has no top-level string constants).
fn hexd_tab() -> Str {
    return "0123456789abcdef"
}
fn b64_tab() -> Str {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

/// the numeric value of a hex digit (0..15); 0 for a non-hex byte.
fn hexval(c: Int) -> Int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    // 0-9
    if c >= 97 && c <= 102 {
        return c - 87
    }
    // a-f
    if c >= 65 && c <= 70 {
        return c - 55
    }
    // A-F
    return 0
}

/// encode bytes as lowercase hex ("Hi" -> "4869").
pub fn hex_encode(s: Str) -> Str {
    let H = hexd_tab()
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let b = ord(s.at(i))
        out = (out + at1(H, (b >> 4)))
        out = (out + at1(H, (b & 15)))
        i = i + 1
    }
    return out
}

/// is every non-whitespace character of `s` a hex digit, and is there an even number of them?
pub fn is_hex(s: Str) -> Bool {
    var count = 0
    var i = 0
    let n = s.len()
    while i < n {
        let c = ord(s.at(i))
        if c != 32 && c != 9 && c != 10 && c != 13 {
            let d = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
            if !d { return false }
            count = count + 1
        }
        i = i + 1
    }
    return count % 2 == 0
}

/// decode a hex string back to bytes, or Err when it is not one.
///
/// Prefer this one. Hex is how keys, hashes and digests are written down, and `hex_decode` maps an
/// unrecognised character to the digit 0, so a mistyped key does not fail, it quietly becomes a
/// different key. Anything that decodes secret or identifying material wants the strict form.
pub fn try_hex_decode(s: Str) -> Result<Str> {
    if !is_hex(s) { return Result::Err("not a hex string (non-hex character, or an odd number of digits)") }
    return Result::Ok(hex_decode(s))
}

/// decode a hex string back to bytes, leniently: whitespace is ignored, an odd trailing digit is
/// dropped, and any character that is not a hex digit is read as 0.
///
/// That last one is silent and lossy: "zz" decodes to a NUL byte rather than failing, so invalid
/// input produces plausible bytes instead of an error. Use `try_hex_decode` unless you specifically
/// want the lenient behaviour.
pub fn hex_decode(s: Str) -> Str {
    var digits: Vec<Int> = vec()
    var i = 0
    let n = s.len()
    while i < n {
        let c = ord(s.at(i))
        if c != 32 && c != 9 && c != 10 && c != 13 {
            digits.push(hexval(c))
        }
        i = i + 1
    }
    var out = ""
    var j = 0
    while j + 1 < digits.len() {
        // each pair of digits -> one byte (odd trailing digit dropped)
        out = (out + chr(digits[j] * 16 + digits[j + 1]))
        j = j + 2
    }
    return out
}

/// the 6-bit value of a Base64 character; -1 for padding/whitespace/invalid.
fn b64val(c: Int) -> Int {
    if c >= 65 && c <= 90 {
        return c - 65
    }
    // A-Z
    if c >= 97 && c <= 122 {
        return c - 71
    }
    // a-z
    if c >= 48 && c <= 57 {
        return c + 4
    }
    // 0-9
    if c == 43 {
        return 62
    }
    // +
    if c == 47 {
        return 63
    }
    // /
    return 0 - 1
}

/// encode bytes as standard Base64 with `=` padding ("Hi" -> "SGk=").
pub fn b64_encode(s: Str) -> Str {
    let A = b64_tab()
    var out = ""
    let n = s.len()
    var i = 0
    while i < n {
        let b0 = ord(s.at(i))
        var b1 = 0
        var b2 = 0
        let have1 = i + 1 < n
        let have2 = i + 2 < n
        if have1 {
            b1 = ord(s.at(i + 1))
        }
        if have2 {
            b2 = ord(s.at(i + 2))
        }
        let c0 = (b0 >> 2)
        let c1 = (((b0 & 3) << 4) | (b1 >> 4))
        let c2 = (((b1 & 15) << 2) | (b2 >> 6))
        let c3 = (b2 & 63)
        out = (out + at1(A, c0))
        out = (out + at1(A, c1))
        if have1 {
            out = (out + at1(A, c2))
        } else {
            out = (out + "=")
        }
        if have2 {
            out = (out + at1(A, c3))
        } else {
            out = (out + "=")
        }
        i = i + 3
    }
    return out
}

/// decode standard Base64 back to bytes (padding/whitespace ignored).
/// encode bytes as base64url (RFC 4648 §5) with no padding.
///
/// The URL-safe alphabet swaps `+/` for `-_`, and padding is dropped because `=` has
/// to be escaped in a query string and carries no information (the length of the
/// input is recoverable without it). This is the encoding tokens, JWTs and webhook
/// signatures use; standard base64 in a URL breaks as soon as a token contains a `/`.
pub fn b64url_encode(s: Str) -> Str {
    let std = b64_encode(s)
    var out = ""
    var i = 0
    while i < std.len() {
        let c = ord(std.at(i))
        if c == 43 { out = out + "-" }                  // '+'
        else if c == 47 { out = out + "_" }             // '/'
        else if c == 61 { out = out }                   // '=' is dropped
        else { out = out + std.at(i) }
        i = i + 1
    }
    return out
}

/// decode base64url back to bytes. Accepts input with or without `=` padding, and
/// accepts the standard alphabet too, since being strict about which one arrived buys
/// nothing when the mapping is unambiguous.
pub fn b64url_decode(s: Str) -> Str {
    var std = ""
    var i = 0
    while i < s.len() {
        let c = ord(s.at(i))
        if c == 45 { std = std + "+" }                  // '-'
        else if c == 95 { std = std + "/" }             // '_'
        else { std = std + s.at(i) }
        i = i + 1
    }
    return b64_decode(std)
}

/// decode standard base64. Characters outside the alphabet, including newlines and padding,
/// are skipped rather than rejected, so wrapped MIME input decodes as-is.
pub fn b64_decode(s: Str) -> Str {
    var vals: Vec<Int> = vec()
    var i = 0
    let n = s.len()
    while i < n {
        let v = b64val(ord(s.at(i)))
        if v >= 0 {
            vals.push(v)
        }
        i = i + 1
    }
    var out = ""
    var j = 0
    let m = vals.len()
    while j + 1 < m {
        // need at least 2 sextets for 1 output byte
        let v0 = vals[j]
        let v1 = vals[j + 1]
        out = (out + chr(((v0 << 2) | (v1 >> 4))))
        if j + 2 < m {
            let v2 = vals[j + 2]
            out = (out + chr((((v1 << 4) | (v2 >> 2)) & 255)))
            if j + 3 < m {
                let v3 = vals[j + 3]
                out = (out + chr((((v2 << 6) | v3) & 255)))
            }
        }
        j = j + 4
    }
    return out
}
