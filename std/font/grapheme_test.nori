// Native tests for std/font's grapheme clusters (UAX #29): run with
//   noric --test std/font/grapheme_test.nori compiler/runtime.nori --import-root .
//
// GraphemeBreakTest.txt (Unicode 16, committed zstd-compressed) is run whole.
import "std/font" as font
import "std/strutil" as su
import "std/archive" as ar

fn hexnum(h: Str) -> Int {
    var v = 0
    var k = 0
    while k < h.len() {
        let c = ord(h.at(k))
        var n = 0
        if c >= 48 && c <= 57 { n = c - 48 } else if c >= 97 && c <= 102 { n = c - 87 } else if c >= 65 && c <= 70 { n = c - 55 }
        v = v * 16 + n
        k = k + 1
    }
    return v
}

fn test_grapheme_break_test() {
    let text = ar::zstd_decompress(read_file("std/font/testdata/GraphemeBreakTest.txt.zst"))
    assert_true(text.len() > 50000)
    var pos = 0
    var cases = 0
    var fails = 0
    var shown = 0
    while pos < text.len() {
        var e = pos
        while e < text.len() && text.at(e) != '\n' { e = e + 1 }
        let line = text.slice(pos, e)
        pos = e + 1
        if line.len() == 0 || line.at(0) == '#' { continue }
        var hash = 0
        while hash < line.len() && line.at(hash) != '#' { hash = hash + 1 }
        let body = su::trim(line.slice(0, hash))
        let toks = su::split(body, " ")
        var cps: Vec<Int> = vec()
        var want: Vec<Int> = vec()
        var t = 0
        while t < toks.len() {
            let tk = toks[t]
            if tk.len() == 0 { t = t + 1  continue }
            if tk == "×" { want.push(0) } else if tk == "÷" { want.push(1) } else { cps.push(hexnum(tk)) }
            t = t + 1
        }
        let got = font::grapheme_breaks(cps)
        var ok = got.len() == want.len()
        var i = 0
        while ok && i < want.len() { if got[i] != want[i] { ok = false }  i = i + 1 }
        cases = cases + 1
        if !ok {
            fails = fails + 1
            if shown < 15 { printl("FAIL ${line}")  shown = shown + 1 }
        }
    }
    printl("GraphemeBreakTest: ${cases} cases, ${fails} failures")
    assert_true(cases > 1000)
    assert_eq(fails, 0)
}

fn test_grapheme_offsets() {
    // e + combining acute, x: two clusters
    let o = font::grapheme_offsets("éx")
    assert_eq(o.len(), 3)
    assert_eq(o[0], 0)
    assert_eq(o[1], 3)
    assert_eq(o[2], 4)
    // a Devanagari conjunct (GB9c) is one cluster: क्ष
    let d = font::grapheme_offsets("क्ष")
    assert_eq(d.len(), 2)
    // a family emoji ZWJ sequence and a flag
    assert_eq(font::grapheme_offsets("👨‍👩‍👧").len(), 2)
    assert_eq(font::grapheme_offsets("🇭🇺🇭🇺").len(), 3)
    assert_eq(font::grapheme_offsets("").len(), 1)
}
