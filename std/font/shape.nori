// std/font: text shaping: HarfBuzz's OpenType shaping pipeline.
//
//   let gs = font::shape(f, "مرحبا", "Arab", font::DIR_RTL(), "ar", "")
//   // gs[i].gid, .cluster (UTF-8 byte offset into the text), .x_advance, .x_offset, .y_offset
//
// Text in; glyph ids with cluster indices and positions (font units) out, in visual order (an RTL
// run comes out right to left). The steps are HarfBuzz's, in its order, because matching its output
// glyph for glyph is the goal:
//   Unicode properties and grapheme clusters -> native direction -> mirroring -> normalization
//   (decompose, reorder marks, recompose against what the font has) -> masks (fractions, the
//   shaper's: Arabic joining forms, Indic syllables) -> cmap -> GSUB by stages -> advances ->
//   GPOS (or the `kern` table) -> mark widths -> attachment offsets -> hiding default ignorables.
//
// Shapers: default (Latin, Cyrillic, Greek, CJK, emoji, ...), Arabic (and the other joining
// scripts), Hebrew, Hangul, Indic.

/// one shaped glyph: its glyph id, the cluster (UTF-8 byte offset of the first character it
/// came from), and its advance and offset in font units (scale by px / units_per_em).
pub struct ShapedGlyph { gid: Int, cluster: Int, x_advance: Int, y_advance: Int, x_offset: Int, y_offset: Int }

/// direction: pick from the script (right to left for Arabic, Hebrew, ...)
pub fn DIR_AUTO() -> Int { return 0 }
/// direction: left to right
pub fn DIR_LTR() -> Int { return 1 }
/// direction: right to left
pub fn DIR_RTL() -> Int { return 2 }

// normalization modes
fn NORM_NONE() -> Int { return 0 }
fn NORM_COMPOSED() -> Int { return 1 }            // composed diacritics (the default)
fn NORM_COMPOSED_NO_SHORT() -> Int { return 2 }   // composed diacritics, no short circuit (Indic)

/// does `script` (ISO 15924) run right to left?
pub fn script_is_rtl(script: Int) -> Bool {
    let c = script_code(script)
    let rtl = "Arab,Hebr,Syrc,Thaa,Cprt,Khar,Phnx,Nkoo,Lydi,Avst,Armi,Phli,Prti,Sarb,Orkh,Samr,Mand,Merc,Mero,"
        + "Mani,Mend,Nbat,Narb,Palm,Phlp,Hatr,Adlm,Rohg,Sogo,Sogd,Elym,Chrs,Yezi,Ougr,Gara,"
    var i = 0
    while i + 4 <= rtl.len() { if rtl.slice(i, i + 4) == c { return true }  i = i + 5 }
    return false
}

/// the script of a text: the first character's script that is neither Common nor Inherited
/// (Zyyy, "Common", when there is none).
pub fn text_script(text: Str) -> Int {
    let cps = utf8_codepoints(text)
    var i = 0
    while i < cps.len() {
        let s = ucd_script(cps[i])
        if s != SC_Zyyy() && s != SC_Zinh() && s != SC_Zzzz() { return s }
        i = i + 1
    }
    return SC_Zyyy()
}

// ── input ────────────────────────────────────────────────────────────────────────────────────────

// decode UTF-8 into the buffer; each character's cluster is its byte offset. A malformed sequence
// becomes U+FFFD for its first byte, as HarfBuzz decodes.
fn buf_add_utf8(inout b: Buf, text: Str) {
    let n = text.len()
    var i = 0
    while i < n {
        let b0 = rd_u8(text, i)
        var cp = 65533
        var len = 1
        if b0 < 128 { cp = b0 }
        else if b0 >= 194 && b0 <= 223 {
            let b1 = rd_u8(text, i + 1)
            if i + 1 < n && (b1 & 192) == 128 { cp = ((b0 & 31) << 6) | (b1 & 63)  len = 2 }
        } else if b0 >= 224 && b0 <= 239 {
            let b1 = rd_u8(text, i + 1)
            let b2 = rd_u8(text, i + 2)
            if i + 2 < n && (b1 & 192) == 128 && (b2 & 192) == 128 {
                let v = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
                if v >= 2048 && (v < 55296 || v > 57343) { cp = v  len = 3 }
            }
        } else if b0 >= 240 && b0 <= 244 {
            let b1 = rd_u8(text, i + 1)
            let b2 = rd_u8(text, i + 2)
            let b3 = rd_u8(text, i + 3)
            if i + 3 < n && (b1 & 192) == 128 && (b2 & 192) == 128 && (b3 & 192) == 128 {
                let v = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
                if v >= 65536 && v <= 1114111 { cp = v  len = 4 }
            }
        }
        buf_add(b, cp, i)
        i = i + len
    }
}

// ── Unicode properties and clusters ──────────────────────────────────────────────────────────────

// HarfBuzz's default-ignorable set (it keeps U+115F/1160/3164/FFA0 visible, as Uniscribe does)
fn hb_is_default_ignorable(ch: Int) -> Bool {
    let plane = ch >> 16
    if plane == 0 {
        let page = ch >> 8
        if page == 0 { return ch == 173 }
        if page == 3 { return ch == 847 }
        if page == 6 { return ch == 1564 }
        if page == 23 { return ch == 6068 || ch == 6069 }
        if page == 24 { return ch >= 6155 && ch <= 6159 }
        if page == 32 { return (ch >= 8203 && ch <= 8207) || (ch >= 8234 && ch <= 8238) || (ch >= 8288 && ch <= 8303) }
        if page == 254 { return (ch >= 65024 && ch <= 65039) || ch == 65279 }
        if page == 255 { return ch >= 65520 && ch <= 65528 }
        return false
    }
    if plane == 1 { return ch >= 119155 && ch <= 119162 }
    if plane == 14 { return ch >= 917504 && ch <= 921599 }
    return false
}
fn is_variation_selector(cp: Int) -> Bool {
    return (cp >= 65024 && cp <= 65039) || (cp >= 917760 && cp <= 917999) || (cp >= 6155 && cp <= 6157) || cp == 6159
}
fn is_regional_indicator(cp: Int) -> Bool { return cp >= 127462 && cp <= 127487 }

global g_mcc_tab: Vec<Int>
global g_mcc_on: Int = 0
// HarfBuzz's modified combining class: reorders a few classes (Hebrew per SBL, Arabic shadda first,
// Telugu/Thai/Tibetan quirks).
fn modified_ccc(u: Int) -> Int {
    if u == 6752 { return 254 }                                          // U+1A60
    if u == 4038 { return 254 }                                          // U+0FC6
    if u == 3897 { return 127 }                                          // U+0F39
    let c = ucd_ccc(u)
    if c >= 10 && c <= 35 {
        // Hebrew 10..26 in SBL order, Arabic 27..35 with shadda first
        if g_mcc_on == 0 {
            g_mcc_tab = [22, 15, 16, 17, 23, 18, 19, 20, 21, 14, 24, 12, 25, 13, 10, 11, 26, 28, 29, 30, 31, 32, 33, 27, 34, 35]
            g_mcc_on = 1
        }
        return g_mcc_tab[c - 10]
    }
    if c == 84 { return 4 }
    if c == 91 { return 5 }
    if c == 103 { return 3 }
    if c == 130 { return 132 }
    if c == 132 { return 131 }
    return c
}

// the unicode-props word for code point u
fn unicode_props(inout b: Buf, u: Int) -> Int {
    let gc = ucd_gc(u)
    var props = gc
    if u >= 128 {
        b.scratch = b.scratch | SF_HAS_NON_ASCII()
        if hb_is_default_ignorable(u) {
            b.scratch = b.scratch | SF_HAS_DEFAULT_IGNORABLES()
            props = props | UP_IGNORABLE()
            if u == 8204 { props = props | UP_ZWNJ() }
            else if u == 8205 { props = props | UP_ZWJ() }
            else if (u >= 6155 && u <= 6157) || u == 6159 { props = props | UP_HIDDEN() }
            else if u >= 917536 && u <= 917631 { props = props | UP_HIDDEN() }
            else if u == 847 { b.scratch = b.scratch | SF_HAS_CGJ()  props = props | UP_HIDDEN() }
        }
        if gc_is_mark(gc) {
            props = props | UP_CONTINUATION()
            props = props | (modified_ccc(u) << 16)
        }
    }
    return props
}

fn set_unicode_props(inout b: Buf) {
    var i = 0
    while i < b.len {
        let u = bi(b, i, F_CP())
        bset(b, i, F_UP(), unicode_props(b, u))
        let gc = up_gc(bi(b, i, F_UP()))
        if gc == GC_Ll() || gc == GC_Lu() || gc == GC_Lt() || gc == GC_Lo() || gc == GC_Zs() { i = i + 1  continue }
        if gc == GC_Sk() && u >= 127995 && u <= 127999 {                  // emoji skin tone modifiers
            bset(b, i, F_UP(), bi(b, i, F_UP()) | UP_CONTINUATION())
        } else if i > 0 && is_regional_indicator(u) {
            if is_regional_indicator(bi(b, i - 1, F_CP())) && (bi(b, i - 1, F_UP()) & UP_CONTINUATION()) == 0 {
                bset(b, i, F_UP(), bi(b, i, F_UP()) | UP_CONTINUATION())
            }
        } else if (bi(b, i, F_UP()) & UP_ZWJ()) != 0 {
            bset(b, i, F_UP(), bi(b, i, F_UP()) | UP_CONTINUATION())
            if i + 1 < b.len && ucd_is_extended_pictographic(bi(b, i + 1, F_CP())) {
                i = i + 1
                bset(b, i, F_UP(), unicode_props(b, bi(b, i, F_CP())) | UP_CONTINUATION())
            }
        } else if (u >= 65438 && u <= 65439) || (u >= 917536 && u <= 917631) {
            bset(b, i, F_UP(), bi(b, i, F_UP()) | UP_CONTINUATION())
        }
        i = i + 1
    }
}
fn is_continuation(b: Buf, i: Int) -> Bool { return (bi(b, i, F_UP()) & UP_CONTINUATION()) != 0 }

// merge each grapheme (a base and its continuations) into one cluster
fn form_clusters(inout b: Buf) {
    var start = 0
    while start < b.len {
        var end = start + 1
        while end < b.len && is_continuation(b, end) { end = end + 1 }
        merge_clusters(b, start, end)
        start = end
    }
}

// reverse the buffer but keep each grapheme's internal order (for a run shaped against its script's
// native direction)
fn reverse_graphemes(inout b: Buf) {
    var start = 0
    while start < b.len {
        var end = start + 1
        while end < b.len && is_continuation(b, end) { end = end + 1 }
        buf_reverse_range(b, start, end)
        start = end
    }
    buf_reverse(b)
}

// ── normalization ────────────────────────────────────────────────────────────────────────────────

fn is_unicode_mark(b: Buf, i: Int) -> Bool { return up_is_mark(bi(b, i, F_UP())) }
fn info_cc(b: Buf, i: Int) -> Int { if is_unicode_mark(b, i) { return up_mcc(bi(b, i, F_UP())) }  return 0 }
fn out_cc(b: Buf, i: Int) -> Int { let up = bo(b, i, F_UP())  if up_is_mark(up) { return up_mcc(up) }  return 0 }

fn shaper_decompose(p: Plan, ab: Int, inout out: Vec<Int>) -> Bool {
    if p.shaper == SHAPER_INDIC() { return indic_decompose(ab, out) }
    return ucd_decompose(ab, out)
}
fn shaper_compose(p: Plan, a: Int, b: Int) -> Int {
    if p.shaper == SHAPER_HEBREW() { return hebrew_compose(p, a, b) }
    if p.shaper == SHAPER_INDIC() { return indic_compose(a, b) }
    return ucd_compose(a, b)
}

fn output_char(inout b: Buf, u: Int, g: Int) {
    cur_set(b, F_GI(), g)
    output_glyph(b, u)
    let o = b.out_len - 1
    boset(b, o, F_UP(), unicode_props(b, u))
}
fn next_char(inout b: Buf, g: Int) {
    cur_set(b, F_GI(), g)
    next_glyph(b)
}

// decompose `ab` into the output when the font has the pieces; the number of characters output
fn decompose_rec(f: Font, p: Plan, inout b: Buf, shortest: Bool, ab: Int) -> Int {
    var pr: Vec<Int> = vec()
    if !shaper_decompose(p, ab, pr) { return 0 }
    let a = pr[0]
    let bb = pr[1]
    var b_glyph = 0
    if bb != 0 {
        b_glyph = font_glyph_index(f, bb)
        if b_glyph == 0 { return 0 }
    }
    let a_glyph = font_glyph_index(f, a)
    let has_a = a_glyph != 0
    if shortest && has_a {
        output_char(b, a, a_glyph)
        if bb != 0 { output_char(b, bb, b_glyph)  return 2 }
        return 1
    }
    let ret = decompose_rec(f, p, b, shortest, a)
    if ret > 0 {
        if bb != 0 { output_char(b, bb, b_glyph)  return ret + 1 }
        return ret
    }
    if has_a {
        output_char(b, a, a_glyph)
        if bb != 0 { output_char(b, bb, b_glyph)  return 2 }
        return 1
    }
    return 0
}

// HarfBuzz's space fallback types
fn space_fallback_type(u: Int) -> Int {
    if u == 32 || u == 160 { return 18 }
    if u == 8192 || u == 8194 { return 2 }
    if u == 8193 || u == 8195 || u == 12288 { return 1 }
    if u == 8196 { return 3 }
    if u == 8197 { return 4 }
    if u == 8198 { return 6 }
    if u == 8199 { return 19 }
    if u == 8200 { return 20 }
    if u == 8201 { return 5 }
    if u == 8202 { return 16 }
    if u == 8239 { return 21 }
    if u == 8287 { return 17 }
    return 0
}

fn decompose_current_character(f: Font, p: Plan, inout b: Buf, shortest: Bool) {
    let u = cur(b, F_CP())
    var glyph = 0
    if shortest {
        glyph = font_glyph_index(f, u)
        if glyph != 0 { next_char(b, glyph)  return }
    }
    if decompose_rec(f, p, b, shortest, u) > 0 { skip_glyph(b)  return }
    if !shortest {
        glyph = font_glyph_index(f, u)
        if glyph != 0 { next_char(b, glyph)  return }
    }
    if up_gc(cur(b, F_UP())) == GC_Zs() {
        let st = space_fallback_type(u)
        let sg = font_glyph_index(f, 32)
        if st != 0 && sg != 0 {
            cur_set(b, F_SPC(), st)
            next_char(b, sg)
            b.scratch = b.scratch | SF_HAS_SPACE_FALLBACK()
            return
        }
    }
    if u == 8209 {                                                        // U+2011 -> U+2010
        let og = font_glyph_index(f, 8208)
        if og != 0 { next_char(b, og)  return }
    }
    next_char(b, glyph)
}

fn handle_variation_selector_cluster(f: Font, inout b: Buf, end: Int) {
    while b.idx < end - 1 {
        if is_variation_selector(bi(b, b.idx + 1, F_CP())) {
            let vg = font_variation_glyph(f, cur(b, F_CP()), bi(b, b.idx + 1, F_CP()))
            if vg > 0 {
                cur_set(b, F_GI(), vg)
                // replace_glyphs(2, 1, &unicode): merge the two clusters, output the base
                let u = cur(b, F_CP())
                merge_clusters(b, b.idx, b.idx + 2)
                output_glyph(b, u)
                b.idx = b.idx + 2
            } else {
                cur_set(b, F_GI(), font_glyph_index(f, cur(b, F_CP())))
                next_glyph(b)
                cur_set(b, F_GI(), font_glyph_index(f, cur(b, F_CP())))
                next_glyph(b)
            }
            while b.idx < end && is_variation_selector(cur(b, F_CP())) {
                cur_set(b, F_GI(), font_glyph_index(f, cur(b, F_CP())))
                next_glyph(b)
            }
        } else {
            cur_set(b, F_GI(), font_glyph_index(f, cur(b, F_CP())))
            next_glyph(b)
        }
    }
    if b.idx < end {
        cur_set(b, F_GI(), font_glyph_index(f, cur(b, F_CP())))
        next_glyph(b)
    }
}

fn normalize(f: Font, p: Plan, inout b: Buf, mode: Int) {
    if b.len == 0 { return }
    let always_short = mode == NORM_NONE()
    let might_short = always_short || mode == NORM_COMPOSED()
    // first round: decompose
    var all_simple = true
    buf_clear_output(b)
    let count = b.len
    b.idx = 0
    while b.idx < count {
        var end = b.idx + 1
        while end < count && !is_unicode_mark(b, end) { end = end + 1 }
        if end < count { end = end - 1 }                                  // leave one base for the marks
        if might_short {
            while b.idx < end {
                let g = font_glyph_index(f, cur(b, F_CP()))
                if g == 0 { break }
                next_char(b, g)
            }
        }
        while b.idx < end { decompose_current_character(f, p, b, might_short) }
        if b.idx == count { break }
        all_simple = false
        end = b.idx + 1
        while end < count && is_unicode_mark(b, end) { end = end + 1 }
        if b.idx + 1 == end { decompose_current_character(f, p, b, might_short) }
        else {
            var has_vs = false
            var k = b.idx
            while k < end { if is_variation_selector(bi(b, k, F_CP())) { has_vs = true }  k = k + 1 }
            if has_vs { handle_variation_selector_cluster(f, b, end) }
            else { while b.idx < end { decompose_current_character(f, p, b, always_short) } }
        }
    }
    buf_sync(b)
    // second round: reorder marks by (modified) combining class
    if !all_simple {
        var i = 0
        while i < b.len {
            if info_cc(b, i) == 0 { i = i + 1  continue }
            var end = i + 1
            while end < b.len && info_cc(b, end) != 0 { end = end + 1 }
            if end - i <= 32 {
                // stable insertion sort with cluster merging (HarfBuzz's buffer sort)
                var s = i + 1
                while s < end {
                    var j = s
                    let cs = info_cc(b, s)
                    while j > i && info_cc(b, j - 1) > cs { j = j - 1 }
                    if j != s {
                        merge_clusters(b, j, s + 1)
                        buf_move_back(b, s, j)
                    }
                    s = s + 1
                }
                if p.shaper == SHAPER_ARABIC() { arabic_reorder_marks(b, i, end) }
                if p.shaper == SHAPER_HEBREW() { hebrew_reorder_marks(b, i, end) }
            }
            i = end
        }
    }
    if (b.scratch & SF_HAS_CGJ()) != 0 {
        var i = 1
        while i + 1 < b.len {
            if bi(b, i, F_CP()) == 847 && (info_cc(b, i + 1) == 0 || info_cc(b, i - 1) <= info_cc(b, i + 1)) {
                bset(b, i, F_UP(), bi(b, i, F_UP()) & (0 - 1 - UP_HIDDEN()))
            }
            i = i + 1
        }
    }
    // third round: recompose
    if !all_simple && (mode == NORM_COMPOSED() || mode == NORM_COMPOSED_NO_SHORT()) {
        buf_clear_output(b)
        let n = b.len
        var starter = 0
        next_glyph(b)
        while b.idx < n {
            if is_unicode_mark(b, b.idx) {
                if starter == b.out_len - 1 || out_cc(b, b.out_len - 1) < info_cc(b, b.idx) {
                    let composed = shaper_compose(p, bo(b, starter, F_CP()), cur(b, F_CP()))
                    if composed != 0 {
                        let g = font_glyph_index(f, composed)
                        if g != 0 {
                            next_glyph(b)
                            merge_out_clusters(b, starter, b.out_len)
                            b.out_len = b.out_len - 1
                            boset(b, starter, F_CP(), composed)
                            boset(b, starter, F_GI(), g)
                            boset(b, starter, F_UP(), unicode_props(b, composed))
                            continue
                        }
                    }
                }
            }
            next_glyph(b)
            if out_cc(b, b.out_len - 1) == 0 { starter = b.out_len - 1 }
        }
        buf_sync(b)
    }
}

// ── Hebrew ───────────────────────────────────────────────────────────────────────────────────────

fn hebrew_compose(p: Plan, a: Int, b: Int) -> Int {
    let c = ucd_compose(a, b)
    if c != 0 || p.has_gpos_mark { return c }
    // presentation forms excluded from normalization but wanted by old fonts without GPOS marks
    if b == 1460 && a == 1497 { return 64285 }
    if b == 1463 { if a == 1522 { return 64287 }  if a == 1488 { return 64302 } }
    if b == 1464 && a == 1488 { return 64303 }
    if b == 1465 && a == 1493 { return 64331 }
    if b == 1468 {
        if a >= 1488 && a <= 1514 {
            let dag: Vec<Int> = [64304, 64305, 64306, 64307, 64308, 64309, 64310, 0, 64312, 64313, 64314, 64315, 64316, 0,
                64318, 0, 64320, 64321, 0, 64323, 64324, 0, 64326, 64327, 64328, 64329, 64330]
            return dag[a - 1488]
        }
        if a == 64298 { return 64300 }
        if a == 64299 { return 64301 }
    }
    if b == 1471 { if a == 1489 { return 64332 }  if a == 1499 { return 64333 }  if a == 1508 { return 64334 } }
    if b == 1473 { if a == 1513 { return 64298 }  if a == 64329 { return 64300 } }
    if b == 1474 { if a == 1513 { return 64299 }  if a == 64329 { return 64301 } }
    return 0
}
fn hebrew_reorder_marks(inout b: Buf, start: Int, end: Int) {
    var i = start + 2
    while i < end {
        let c0 = info_cc(b, i - 2)
        let c1 = info_cc(b, i - 1)
        let c2 = info_cc(b, i)
        if (c0 == 20 || c0 == 21) && (c1 == 22 || c1 == 23) && (c2 == 25 || c2 == 220) {
            merge_clusters(b, i - 1, i + 1)
            buf_swap(b, i - 1, i)
            return
        }
        i = i + 1
    }
}

// ── Thai and Lao ─────────────────────────────────────────────────────────────────────────────────
// HarfBuzz's Thai shaper (the part every font needs, with or without Thai GSUB): SARA AM decomposes
// into NIKHAHIT + SARA AA, and the NIKHAHIT moves back over the above-base marks before it:
// <0E14 0E4B 0E33> becomes <0E14 0E4D 0E4B 0E32>. Lao is the same 0x80 higher. (The PUA fallback
// for old fonts without Thai GSUB is not implemented.)
fn thai_is_above_mark(u: Int) -> Bool {
    let x = u & (0 - 1 - 128)
    return (x >= 3636 && x <= 3639) || (x >= 3655 && x <= 3662) || x == 3633 || x == 3643
}
fn thai_preprocess(inout b: Buf) {
    buf_clear_output(b)
    let count = b.len
    b.idx = 0
    while b.idx < count {
        let u = cur(b, F_CP())
        if (u & (0 - 1 - 128)) != 3635 { next_glyph(b)  continue }      // not SARA AM
        output_glyph(b, u - 3635 + 3661)                                  // NIKHAHIT
        let ni = b.out_len - 1
        boset(b, ni, F_UP(), bo(b, ni, F_UP()) | UP_CONTINUATION())
        replace_glyph(b, u - 1)                                           // SARA AA
        let end = b.out_len
        let up = bo(b, end - 2, F_UP())
        boset(b, end - 2, F_UP(), (up - (up & 31)) | GC_Mn())
        var start = end - 2
        while start > 0 && thai_is_above_mark(bo(b, start - 1, F_CP())) { start = start - 1 }
        if start + 2 < end {
            merge_out_clusters(b, start, end)
            // move the NIKHAHIT (end - 2) to `start`
            var t: Vec<Int> = vec()
            var k = 0
            while k < K() { t.push(bo(b, end - 2, k))  k = k + 1 }
            var j = end - 2
            while j > start {
                k = 0
                while k < K() { boset(b, j, k, bo(b, j - 1, k))  k = k + 1 }
                j = j - 1
            }
            k = 0
            while k < K() { boset(b, start, k, t[k])  k = k + 1 }
        } else if start > 0 {
            merge_out_clusters(b, start - 1, end)
        }
    }
    buf_sync(b)
}

// ── masks ────────────────────────────────────────────────────────────────────────────────────────

fn setup_masks_fraction(p: Plan, inout b: Buf) {
    if (b.scratch & SF_HAS_NON_ASCII()) == 0 { return }
    if p.frac_mask == 0 && (p.numr_mask == 0 || p.dnom_mask == 0) { return }
    var pre = p.numr_mask | p.frac_mask
    var post = p.frac_mask | p.dnom_mask
    if b.rtl { pre = p.frac_mask | p.dnom_mask  post = p.numr_mask | p.frac_mask }
    var i = 0
    while i < b.len {
        if bi(b, i, F_CP()) == 8260 {
            var start = i
            var end = i + 1
            while start > 0 && up_gc(bi(b, start - 1, F_UP())) == GC_Nd() { start = start - 1 }
            while end < b.len && up_gc(bi(b, end, F_UP())) == GC_Nd() { end = end + 1 }
            if start == i || end == i + 1 { i = i + 1  continue }
            var j = start
            while j < i { bset(b, j, F_MASK(), bi(b, j, F_MASK()) | pre)  j = j + 1 }
            bset(b, i, F_MASK(), bi(b, i, F_MASK()) | p.frac_mask)
            j = i + 1
            while j < end { bset(b, j, F_MASK(), bi(b, j, F_MASK()) | post)  j = j + 1 }
            i = end
        } else { i = i + 1 }
    }
}

// ── substitution ─────────────────────────────────────────────────────────────────────────────────

fn run_pause(f: Font, p: Plan, inout b: Buf, pfn: Int) {
    if pfn == PAUSE_INDIC_INITIAL() { indic_initial_reorder(f, p, b) }
    else if pfn == PAUSE_INDIC_FINAL() { indic_final_reorder(f, p, b) }
    else if pfn == PAUSE_CLEAR_SYLLABLES() { var i = 0  while i < b.len { bset(b, i, F_SYL(), 0)  i = i + 1 } }
    else if pfn == PAUSE_INDIC_SETUP_SYLLABLES() { indic_setup_syllables(f, p, b) }
    // PAUSE_ARABIC_STCH records 'stch' results for Syriac stretching; PAUSE_ARABIC_FALLBACK
    // synthesizes joining forms from presentation-form code points for fonts with no GSUB forms.
    // Neither is implemented; both are no-ops for fonts that carry their own features.
}

fn substitute(f: Font, p: Plan, inout b: Buf) {
    // glyph props from GDEF, or synthesized from the Unicode categories
    var i = 0
    while i < b.len {
        bset(b, i, F_GP(), gdef_glyph_props(f, bi(b, i, F_CP())))
        bset(b, i, F_LIG(), 0)
        i = i + 1
    }
    if p.fallback_glyph_classes {
        i = 0
        while i < b.len {
            let up = bi(b, i, F_UP())
            if up_gc(up) != GC_Mn() || info_is_default_ignorable(b, i) { bset(b, i, F_GP(), GP_BASE()) }
            else { bset(b, i, F_GP(), GP_MARK()) }
            i = i + 1
        }
    }
    if f.gsub_off < 0 && p.sp0.len() == 0 { return }
    var c = ctx_new(0, b.rtl, font_has_glyph_classes(f))
    var li = 0
    var st = 0
    while st < p.se0.len() {
        while li < p.se0[st] {
            c.lookup_mask = p.lm0[li]
            c.auto_zwnj = (p.lf0[li] & LF_AUTO_ZWNJ()) != 0
            c.auto_zwj = (p.lf0[li] & LF_AUTO_ZWJ()) != 0
            c.random = (p.lf0[li] & LF_RANDOM()) != 0
            c.per_syllable = (p.lf0[li] & LF_PER_SYLLABLE()) != 0
            if f.gsub_off >= 0 { apply_string(f, c, b, p.lk0[li], p.lc0[li]) }
            li = li + 1
        }
        run_pause(f, p, b, p.sp0[st])
        st = st + 1
    }
}

// ── positioning ──────────────────────────────────────────────────────────────────────────────────

fn fallback_spaces(f: Font, inout b: Buf) {
    let upem = f.units_per_em
    var i = 0
    while i < b.len {
        let t = bi(b, i, F_SPC())
        if up_gc(bi(b, i, F_UP())) == GC_Zs() && t != 0 && (bi(b, i, F_GP()) & GP_LIGATED()) == 0 {
            if (t >= 1 && t <= 6) || t == 16 { bpset(b, i, P_XA(), (upem + t / 2) / t) }
            else if t == 17 { bpset(b, i, P_XA(), upem * 4 / 18) }
            else if t == 19 {
                var u = 48
                while u <= 57 { let g = font_glyph_index(f, u)  if g != 0 { bpset(b, i, P_XA(), to_int(font_h_advance(f, g)))  u = 100 }  u = u + 1 }
            } else if t == 20 {
                var g = font_glyph_index(f, 46)
                if g == 0 { g = font_glyph_index(f, 44) }
                if g != 0 { bpset(b, i, P_XA(), to_int(font_h_advance(f, g))) }
            } else if t == 21 { bpset(b, i, P_XA(), bp(b, i, P_XA()) / 2) }
        }
        i = i + 1
    }
}

fn zero_mark_widths(inout b: Buf, adjust: Bool) {
    var i = 0
    while i < b.len {
        if gp_is_mark(bi(b, i, F_GP())) {
            if adjust {
                bpadd(b, i, P_XO(), 0 - bp(b, i, P_XA()))
                bpadd(b, i, P_YO(), 0 - bp(b, i, P_YA()))
            }
            bpset(b, i, P_XA(), 0)
            bpset(b, i, P_YA(), 0)
        }
        i = i + 1
    }
}

// the `kern` table, applied as HarfBuzz applies it: pairs found with the skipping iterator (marks
// ignored), the value split between the two glyphs
fn apply_kern_table(f: Font, p: Plan, inout b: Buf) {
    if p.kern_mask == 0 { return }
    var c = ctx_new(1, b.rtl, font_has_glyph_classes(f))
    c.lookup_mask = p.kern_mask
    c.lookup_props = 8
    var idx = 0
    while idx < b.len {
        if (bi(b, idx, F_MASK()) & p.kern_mask) == 0 { idx = idx + 1  continue }
        var it = iter_new(c, b, false)
        it.idx = idx
        it.end = b.len
        if !iter_next(f, it, b) { idx = idx + 1  continue }
        let i = idx
        let j = it.idx
        let k = to_int(font_kern(f, bi(b, i, F_CP()), bi(b, j, F_CP())))
        if k != 0 {
            let k1 = k >> 1
            let k2 = k - k1
            bpadd(b, i, P_XA(), k1)
            bpadd(b, j, P_XA(), k2)
            bpadd(b, j, P_XO(), k2)
        }
        idx = j
    }
}

fn position(f: Font, p: Plan, inout b: Buf) {
    // default advances
    while b.pos.len() > 0 { b.pos.pop() }
    var i = 0
    while i < b.len {
        b.pos.push(to_int(font_h_advance(f, bi(b, i, F_CP()))))
        b.pos.push(0)  b.pos.push(0)  b.pos.push(0)  b.pos.push(0)  b.pos.push(0)
        i = i + 1
    }
    if (b.scratch & SF_HAS_SPACE_FALLBACK()) != 0 { fallback_spaces(f, b) }
    let adjust = p.adjust_mark_when_zeroing && !b.rtl
    if p.apply_gpos {
        var c = ctx_new(1, b.rtl, font_has_glyph_classes(f))
        var li = 0
        var st = 0
        while st < p.se1.len() {
            while li < p.se1[st] {
                c.lookup_mask = p.lm1[li]
                c.auto_zwnj = (p.lf1[li] & LF_AUTO_ZWNJ()) != 0
                c.auto_zwj = (p.lf1[li] & LF_AUTO_ZWJ()) != 0
                c.random = (p.lf1[li] & LF_RANDOM()) != 0
                c.per_syllable = false
                apply_string(f, c, b, p.lk1[li], p.lc1[li])
                li = li + 1
            }
            st = st + 1
        }
    }
    if p.apply_kern { apply_kern_table(f, p, b) }
    if p.zero_marks { zero_mark_widths(b, adjust) }
    // zero default ignorables
    if (b.scratch & SF_HAS_DEFAULT_IGNORABLES()) != 0 {
        i = 0
        while i < b.len {
            if info_is_default_ignorable(b, i) {
                bpset(b, i, P_XA(), 0)  bpset(b, i, P_YA(), 0)  bpset(b, i, P_XO(), 0)  bpset(b, i, P_YO(), 0)
            }
            i = i + 1
        }
    }
    // attachment offsets
    if (b.scratch & SF_HAS_GPOS_ATTACHMENT()) != 0 {
        i = 0
        while i < b.len { propagate_attachment_offsets(b, i, 64)  i = i + 1 }
    }
    if b.rtl { buf_reverse(b) }
}

// replace default ignorables with the space glyph at zero advance, or delete them when the font has
// no space glyph (HarfBuzz's hide_default_ignorables)
fn hide_default_ignorables(f: Font, inout b: Buf) {
    if (b.scratch & SF_HAS_DEFAULT_IGNORABLES()) == 0 { return }
    let inv = font_glyph_index(f, 32)
    if inv != 0 {
        var i = 0
        while i < b.len { if info_is_default_ignorable(b, i) { bset(b, i, F_CP(), inv) }  i = i + 1 }
        return
    }
    // delete in place, merging clusters as delete_glyph does
    var j = 0
    var i = 0
    let count = b.len
    while i < count {
        if info_is_default_ignorable(b, i) {
            let cl = bi(b, i, F_CL())
            if i + 1 < count && cl == bi(b, i + 1, F_CL()) { i = i + 1  continue }
            if j > 0 {
                if cl < bi(b, j - 1, F_CL()) {
                    let old = bi(b, j - 1, F_CL())
                    var k = j
                    while k > 0 && bi(b, k - 1, F_CL()) == old { bset(b, k - 1, F_CL(), cl)  k = k - 1 }
                }
                i = i + 1
                continue
            }
            if i + 1 < count { merge_clusters(b, i, i + 2) }
            i = i + 1
            continue
        }
        if j != i {
            var fld = 0
            while fld < K() { bset(b, j, fld, bi(b, i, fld))  fld = fld + 1 }
            fld = 0
            while fld < P() { bpset(b, j, fld, bp(b, i, fld))  fld = fld + 1 }
        }
        j = j + 1
        i = i + 1
    }
    b.len = j
}

// ── the pipeline ─────────────────────────────────────────────────────────────────────────────────

fn shaper_norm_mode(p: Plan) -> Int {
    if p.shaper == SHAPER_HANGUL() { return NORM_NONE() }
    if p.shaper == SHAPER_INDIC() { return NORM_COMPOSED_NO_SHORT() }
    return NORM_COMPOSED()
}

fn shape_buffer(f: Font, p: Plan, inout b: Buf) {
    // masks, properties, clusters
    var i = 0
    while i < b.len { bset(b, i, F_MASK(), p.global_mask)  i = i + 1 }
    set_unicode_props(b)
    form_clusters(b)
    // native direction
    let target_rtl = b.rtl
    var horiz_rtl = script_is_rtl(p.script)
    if horiz_rtl && !b.rtl {
        var num = false  var letter = false  var ri = false
        i = 0
        while i < b.len {
            let gc = up_gc(bi(b, i, F_UP()))
            if gc == GC_Nd() { num = true }
            else if gc == GC_Lu() || gc == GC_Ll() || gc == GC_Lt() || gc == GC_Lm() || gc == GC_Lo() { letter = true  break }
            else if is_regional_indicator(bi(b, i, F_CP())) { ri = true }
            i = i + 1
        }
        if (num || ri) && !letter { horiz_rtl = false }
    }
    if horiz_rtl != b.rtl {
        reverse_graphemes(b)
        b.rtl = !b.rtl
    }
    if p.shaper == SHAPER_INDIC() { indic_preprocess(f, p, b) }
    if p.shaper == SHAPER_THAI() { thai_preprocess(b) }
    // mirroring
    if b.rtl {
        i = 0
        while i < b.len {
            let u = bi(b, i, F_CP())
            let m = ucd_mirror(u)
            if m != u && font_glyph_index(f, m) != 0 { bset(b, i, F_CP(), m) }
            else { bset(b, i, F_MASK(), bi(b, i, F_MASK()) | p.rtlm_mask) }
            i = i + 1
        }
    }
    normalize(f, p, b, shaper_norm_mode(p))
    setup_masks_fraction(p, b)
    if p.shaper == SHAPER_ARABIC() { arabic_setup_masks(p, b) }
    if p.shaper == SHAPER_INDIC() { indic_setup_masks(f, p, b) }
    // glyphs
    i = 0
    while i < b.len { bset(b, i, F_CP(), bi(b, i, F_GI()))  i = i + 1 }
    substitute(f, p, b)
    position(f, p, b)
    hide_default_ignorables(f, b)
    b.rtl = target_rtl
}

/// shape `text` with face `f`: `script` is an ISO 15924 code ("Latn", "Arab", "Deva"; "" picks the
/// text's own), `dir` DIR_LTR/DIR_RTL/DIR_AUTO, `lang` a BCP 47 tag ("" for none), `features` in
/// HarfBuzz's syntax ("-kern,+smcp,aalt=2"; "" for the defaults). The glyphs come out in visual
/// order, clusters are UTF-8 byte offsets into `text`, positions are in font units.
pub fn shape(f: Font, text: Str, script: Str, dir: Int, lang: Str, features: Str) -> Vec<ShapedGlyph> {
    var sc = 0
    if script.len() == 0 { sc = text_script(text) } else { sc = script_from_code(script) }
    var rtl = false
    if dir == DIR_RTL() { rtl = true } else if dir == DIR_AUTO() { rtl = script_is_rtl(sc) }
    let pi = plan_get(f, sc, rtl, lang, features)
    var b = buf_new()
    b.rtl = rtl
    buf_add_utf8(b, text)
    shape_buffer(f, g_plans[pi], b)
    var out: Vec<ShapedGlyph> = vec()
    var i = 0
    while i < b.len {
        out.push(ShapedGlyph { gid: bi(b, i, F_CP()), cluster: bi(b, i, F_CL()), x_advance: bp(b, i, P_XA()),
            y_advance: bp(b, i, P_YA()), x_offset: bp(b, i, P_XO()), y_offset: bp(b, i, P_YO()) })
        i = i + 1
    }
    return out
}
