// std/font: the shape plan: which lookups run, in what order, under which glyph masks.
//
// This is HarfBuzz's hb_ot_map builder: the shaper and the caller ask for features (with flags and
// values), pauses split GSUB into stages, and compiling the plan finds each feature in the font's
// chosen script and language, gives it mask bits, and collects its lookups. Within a stage lookups
// run in LookupList order, which is the OpenType rule, and why the order features are asked for in
// matters only through the stages.
//
// A plan depends on the face, script, direction, language and features, never on the text, so it is
// built once and cached.

// feature flags
fn FF_GLOBAL() -> Int { return 1 }
fn FF_HAS_FALLBACK() -> Int { return 2 }
fn FF_MANUAL_ZWNJ() -> Int { return 4 }
fn FF_MANUAL_ZWJ() -> Int { return 8 }
fn FF_MANUAL_JOINERS() -> Int { return 12 }
fn FF_GLOBAL_SEARCH() -> Int { return 16 }
fn FF_RANDOM() -> Int { return 32 }
fn FF_PER_SYLLABLE() -> Int { return 64 }

// lookup flags kept per collected lookup
fn LF_AUTO_ZWNJ() -> Int { return 1 }
fn LF_AUTO_ZWJ() -> Int { return 2 }
fn LF_RANDOM() -> Int { return 4 }
fn LF_PER_SYLLABLE() -> Int { return 8 }

// the shapers
fn SHAPER_DEFAULT() -> Int { return 0 }
fn SHAPER_ARABIC() -> Int { return 1 }
fn SHAPER_HEBREW() -> Int { return 2 }
fn SHAPER_HANGUL() -> Int { return 3 }
fn SHAPER_INDIC() -> Int { return 4 }
fn SHAPER_THAI() -> Int { return 5 }

// pause functions run between GSUB stages
fn PAUSE_NONE() -> Int { return 0 }
fn PAUSE_ARABIC_STCH() -> Int { return 1 }
fn PAUSE_ARABIC_FALLBACK() -> Int { return 2 }
fn PAUSE_INDIC_INITIAL() -> Int { return 3 }
fn PAUSE_INDIC_FINAL() -> Int { return 4 }
fn PAUSE_CLEAR_SYLLABLES() -> Int { return 5 }
fn PAUSE_INDIC_SETUP_SYLLABLES() -> Int { return 6 }

fn GLOBAL_BIT() -> Int { return 2147483648 }      // 1 << 31
fn GLOBAL_SHIFT() -> Int { return 31 }
fn MAX_VALUE() -> Int { return 255 }

// the feature requests, before compiling
struct FB {
    tag: Vec<Int>, seq: Vec<Int>, maxv: Vec<Int>, flags: Vec<Int>, defv: Vec<Int>, st0: Vec<Int>, st1: Vec<Int>,
    cur0: Int, cur1: Int,
    pidx0: Vec<Int>, pfn0: Vec<Int>, pidx1: Vec<Int>, pfn1: Vec<Int>
}
fn fb_new() -> FB {
    var a: Vec<Int> = vec()  var b: Vec<Int> = vec()  var c: Vec<Int> = vec()  var d: Vec<Int> = vec()
    var e: Vec<Int> = vec()  var g: Vec<Int> = vec()  var h: Vec<Int> = vec()
    var i: Vec<Int> = vec()  var j: Vec<Int> = vec()  var k: Vec<Int> = vec()  var l: Vec<Int> = vec()
    return FB { tag: a, seq: b, maxv: c, flags: d, defv: e, st0: g, st1: h, cur0: 0, cur1: 0, pidx0: i, pfn0: j, pidx1: k, pfn1: l }
}
fn fb_add(inout fb: FB, tag: Str, flags: Int, value: Int) {
    fb.tag.push(ot_tag(tag))
    fb.seq.push(fb.tag.len())
    fb.maxv.push(value)
    fb.flags.push(flags)
    if (flags & FF_GLOBAL()) != 0 { fb.defv.push(value) } else { fb.defv.push(0) }
    fb.st0.push(fb.cur0)
    fb.st1.push(fb.cur1)
}
fn fb_enable(inout fb: FB, tag: Str, flags: Int) { fb_add(fb, tag, flags | FF_GLOBAL(), 1) }
fn fb_gsub_pause(inout fb: FB, pfn: Int) { fb.pidx0.push(fb.cur0)  fb.pfn0.push(pfn)  fb.cur0 = fb.cur0 + 1 }
fn fb_gpos_pause(inout fb: FB, pfn: Int) { fb.pidx1.push(fb.cur1)  fb.pfn1.push(pfn)  fb.cur1 = fb.cur1 + 1 }

struct Plan {
    key: Str,
    shaper: Int,
    script: Int,
    rtl: Bool,
    chosen0: Int, chosen1: Int,            // the script tags GSUB and GPOS were read under
    // collected lookups (table 0 = GSUB, 1 = GPOS): lookup index, mask, LF_* flags
    lk0: Vec<Int>, lm0: Vec<Int>, lf0: Vec<Int>,
    lk1: Vec<Int>, lm1: Vec<Int>, lf1: Vec<Int>,
    // per collected lookup: where its glyph-coverage bitset starts in g_lcov (see lookup_coverage_set)
    lc0: Vec<Int>, lc1: Vec<Int>,
    // stages: one past each stage's last lookup, and the pause run after it
    se0: Vec<Int>, sp0: Vec<Int>, se1: Vec<Int>, sp1: Vec<Int>,
    // features that made it into the plan
    ftag: Vec<Int>, fmask: Vec<Int>, fshift: Vec<Int>, ffallback: Vec<Int>, fstage0: Vec<Int>,
    global_mask: Int,
    apply_gpos: Bool, apply_kern: Bool, zero_marks: Bool, adjust_mark_when_zeroing: Bool,
    fallback_mark_positioning: Bool, fallback_glyph_classes: Bool, has_gpos_mark: Bool,
    kern_mask: Int, rtlm_mask: Int, frac_mask: Int, numr_mask: Int, dnom_mask: Int,
    shaper_masks: Vec<Int>                 // per-shaper: arabic's action masks, indic's feature masks
}

/// the mask of feature `tag` in the plan (0 when the plan does not have it)
fn plan_mask(p: Plan, tag: Int) -> Int {
    var i = 0
    while i < p.ftag.len() { if p.ftag[i] == tag { return p.fmask[i] }  i = i + 1 }
    return 0
}
fn plan_shift(p: Plan, tag: Int) -> Int {
    var i = 0
    while i < p.ftag.len() { if p.ftag[i] == tag { return p.fshift[i] }  i = i + 1 }
    return 0
}
// the mask for value 1 of `tag` (its lowest bit)
fn plan_1_mask(p: Plan, tag: Int) -> Int {
    var i = 0
    while i < p.ftag.len() { if p.ftag[i] == tag { return (1 << p.fshift[i]) & p.fmask[i] }  i = i + 1 }
    return 0
}
// the GSUB stage feature `tag` was put in, or -1 when the plan does not have it
fn plan_feature_stage(p: Plan, tag: Int) -> Int {
    var i = 0
    while i < p.ftag.len() { if p.ftag[i] == tag { return p.fstage0[i] }  i = i + 1 }
    return 0 - 1
}
fn plan_needs_fallback(p: Plan, tag: Int) -> Bool {
    var i = 0
    while i < p.ftag.len() { if p.ftag[i] == tag { return p.ffallback[i] == 1 }  i = i + 1 }
    return false
}

// ── user features: HarfBuzz's string syntax ──────────────────────────────────────────────────────
// "kern", "+kern", "-liga", "liga=0", "aalt=2", comma or space separated. Ranges ("[3:5]") are not
// supported; a feature always applies to the whole run.
fn parse_features(s: Str, inout tags: Vec<Str>, inout vals: Vec<Int>) {
    var i = 0
    while i < s.len() {
        while i < s.len() && (s.at(i) == ',' || s.at(i) == ' ') { i = i + 1 }
        if i >= s.len() { return }
        var v = 1
        if s.at(i) == '-' { v = 0  i = i + 1 } else if s.at(i) == '+' { i = i + 1 }
        var t = ""
        while i < s.len() && s.at(i) != ',' && s.at(i) != ' ' && s.at(i) != '=' && s.at(i) != '[' { t = t + s.slice(i, i + 1)  i = i + 1 }
        if i < s.len() && s.at(i) == '[' { while i < s.len() && s.at(i) != ']' { i = i + 1 }  i = i + 1 }
        if i < s.len() && s.at(i) == '=' {
            i = i + 1
            var n = 0
            var any = false
            while i < s.len() && ord(s.at(i)) >= 48 && ord(s.at(i)) <= 57 { n = n * 10 + ord(s.at(i)) - 48  i = i + 1  any = true }
            if !any {
                // "=on"/"=off"/"=true"/"=false"
                var w = ""
                while i < s.len() && s.at(i) != ',' && s.at(i) != ' ' { w = w + s.slice(i, i + 1)  i = i + 1 }
                if w == "off" || w == "false" { n = 0 } else { n = 1 }
            }
            v = n
        }
        if t.len() > 0 && t.len() <= 4 { tags.push(t)  vals.push(v) }
        while i < s.len() && s.at(i) != ',' && s.at(i) != ' ' { i = i + 1 }
    }
}

// ── script selection and the shaper ──────────────────────────────────────────────────────────────

// select the script in GSUB (table 0) or GPOS (1): the script's own tags, then DFLT, dflt, latn.
// Returns the Script table offset; `chosen[0]` gets its tag (0 when none).
fn select_script(f: Font, table: Int, script: Int, inout chosen: Vec<Int>) -> Int {
    let d = f.d
    let t = otl_table(f, table)
    chosen[0] = 0
    if t < 0 { return 0 - 1 }
    var tags: Vec<Int> = vec()
    ot_script_tags(script, tags)
    var i = 0
    while i < tags.len() {
        let s = otl_find_script(d, t, tags[i])
        if s >= 0 { chosen[0] = tags[i]  return s }
        i = i + 1
    }
    let fallbacks = "DFLTdfltlatn"
    var k = 0
    while k < 3 {
        let tg = ot_tag(fallbacks.slice(k * 4, k * 4 + 4))
        let s = otl_find_script(d, t, tg)
        if s >= 0 { chosen[0] = tg  return s }
        k = k + 1
    }
    return 0 - 1
}
fn select_langsys(f: Font, s: Int, lang: Str) -> Int {
    if s < 0 { return 0 - 1 }
    var tags: Vec<Int> = vec()
    ot_language_tags(lang, tags)
    var i = 0
    while i < tags.len() {
        let ls = otl_find_langsys(f.d, s, tags[i])
        if ls >= 0 { return ls }
        i = i + 1
    }
    let dl = otl_find_langsys(f.d, s, ot_tag("dflt"))
    if dl >= 0 { return dl }
    return otl_default_langsys(f.d, s)
}

fn choose_shaper(script: Int, chosen_gsub: Int) -> Int {
    let code = script_code(script)
    if code == "Arab" || code == "Syrc" || code == "Mong" || code == "Nkoo" || code == "Phag" || code == "Mand"
        || code == "Mani" || code == "Phlp" || code == "Adlm" || code == "Rohg" || code == "Sogd" || code == "Chrs" || code == "Ougr" {
        if chosen_gsub != ot_tag("DFLT") || code == "Arab" { return SHAPER_ARABIC() }
        return SHAPER_DEFAULT()
    }
    if code == "Hebr" { return SHAPER_HEBREW() }
    if code == "Thai" || code == "Laoo" { return SHAPER_THAI() }
    if code == "Hang" { return SHAPER_HANGUL() }
    if code == "Deva" || code == "Beng" || code == "Gujr" || code == "Guru" || code == "Knda" || code == "Mlym"
        || code == "Orya" || code == "Taml" || code == "Telu" {
        if chosen_gsub == ot_tag("DFLT") || chosen_gsub == ot_tag("latn") || chosen_gsub == 0 { return SHAPER_DEFAULT() }
        // a 'dev3'-style tag means the font was made for the Universal Shaping Engine, which this
        // engine does not have; the Indic shaper is the nearest thing and handles Devanagari fonts.
        return SHAPER_INDIC()
    }
    return SHAPER_DEFAULT()
}

// ── collecting features ──────────────────────────────────────────────────────────────────────────

fn collect_features(inout fb: FB, shaper: Int, script: Int, rtl: Bool, utags: Vec<Str>, uvals: Vec<Int>) {
    fb_enable(fb, "rvrn", 0)
    fb_gsub_pause(fb, PAUSE_NONE())
    if rtl { fb_enable(fb, "rtla", 0)  fb_add(fb, "rtlm", 0, 1) }
    else { fb_enable(fb, "ltra", 0)  fb_enable(fb, "ltrm", 0) }
    fb_add(fb, "frac", 0, 1)
    fb_add(fb, "numr", 0, 1)
    fb_add(fb, "dnom", 0, 1)
    fb_add(fb, "rand", FF_GLOBAL() | FF_RANDOM(), MAX_VALUE())
    fb_enable(fb, "trak", FF_HAS_FALLBACK())
    fb_enable(fb, "Harf", 0)
    fb_enable(fb, "HARF", 0)
    if shaper == SHAPER_ARABIC() { arabic_collect_features(fb, script) }
    else if shaper == SHAPER_HANGUL() { fb_add(fb, "ljmo", 0, 1)  fb_add(fb, "vjmo", 0, 1)  fb_add(fb, "tjmo", 0, 1) }
    else if shaper == SHAPER_INDIC() { indic_collect_features(fb) }
    fb_enable(fb, "Buzz", 0)
    fb_enable(fb, "BUZZ", 0)
    // common
    fb_enable(fb, "abvm", 0)
    fb_enable(fb, "blwm", 0)
    fb_enable(fb, "ccmp", 0)
    fb_enable(fb, "locl", 0)
    fb_enable(fb, "mark", FF_MANUAL_JOINERS())
    fb_enable(fb, "mkmk", FF_MANUAL_JOINERS())
    fb_enable(fb, "rlig", 0)
    // horizontal
    fb_enable(fb, "calt", 0)
    fb_enable(fb, "clig", 0)
    fb_enable(fb, "curs", 0)
    fb_enable(fb, "dist", 0)
    fb_enable(fb, "kern", FF_HAS_FALLBACK())
    fb_enable(fb, "liga", 0)
    fb_enable(fb, "rclt", 0)
    var i = 0
    while i < utags.len() { fb_add(fb, utags[i], FF_GLOBAL(), uvals[i])  i = i + 1 }
    if shaper == SHAPER_HANGUL() { fb_add(fb, "calt", FF_GLOBAL(), 0) }   // Uniscribe does not apply calt to Hangul
    if shaper == SHAPER_INDIC() { indic_override_features(fb) }
}

// add the lookups of feature `fi` with `mask` to the table's list
fn add_lookups(f: Font, table: Int, fi: Int, mask: Int, lflags: Int, inout lk: Vec<Int>, inout lm: Vec<Int>, inout lf: Vec<Int>) {
    let d = f.d
    let t = otl_table(f, table)
    let ft = otl_feature(d, t, fi)
    if ft < 0 { return }
    let nl = otl_lookup_count(d, t)
    let n = rd_u16(d, ft + 2)
    var i = 0
    while i < n {
        let li = rd_u16(d, ft + 4 + i * 2)
        if li < nl { lk.push(li)  lm.push(mask)  lf.push(lflags) }
        i = i + 1
    }
}
// sort [from, end) of the collected lookups by index and merge duplicates (masks OR, joiner flags AND)
fn sort_merge_lookups(inout lk: Vec<Int>, inout lm: Vec<Int>, inout lf: Vec<Int>, from: Int) {
    let n = lk.len()
    if n - from < 2 { return }
    var i = from + 1
    while i < n {                                                         // insertion sort, stable
        let a = lk[i]  let b = lm[i]  let c = lf[i]
        var j = i
        while j > from && lk[j - 1] > a { lk[j] = lk[j - 1]  lm[j] = lm[j - 1]  lf[j] = lf[j - 1]  j = j - 1 }
        lk[j] = a  lm[j] = b  lf[j] = c
        i = i + 1
    }
    var w = from
    i = from + 1
    while i < n {
        if lk[i] != lk[w] { w = w + 1  lk[w] = lk[i]  lm[w] = lm[i]  lf[w] = lf[i] }
        else {
            lm[w] = lm[w] | lm[i]
            // auto_zwnj and auto_zwj are ANDed together; random/per-syllable from the first
            let keep = lf[w] & (LF_AUTO_ZWNJ() | LF_AUTO_ZWJ())
            let other = lf[i] & (LF_AUTO_ZWNJ() | LF_AUTO_ZWJ())
            lf[w] = (lf[w] & (LF_RANDOM() | LF_PER_SYLLABLE())) | (keep & other)
        }
        i = i + 1
    }
    while lk.len() > w + 1 { lk.pop()  lm.pop()  lf.pop() }
}

// compile the feature requests against the font into a Plan
fn plan_compile(f: Font, inout fb: FB, inout p: Plan, gsub_ls: Int, gpos_ls: Int) {
    let d = f.d
    let n = fb.tag.len()
    // sort by (tag, seq) and merge duplicates
    var order: Vec<Int> = vec()
    var i = 0
    while i < n { order.push(i)  i = i + 1 }
    i = 1
    while i < n {
        let a = order[i]
        var j = i
        while j > 0 && (fb.tag[order[j - 1]] > fb.tag[a] || (fb.tag[order[j - 1]] == fb.tag[a] && fb.seq[order[j - 1]] > fb.seq[a])) {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = a
        i = i + 1
    }
    var mtag: Vec<Int> = vec()  var mmax: Vec<Int> = vec()  var mflags: Vec<Int> = vec()  var mdef: Vec<Int> = vec()
    var ms0: Vec<Int> = vec()  var ms1: Vec<Int> = vec()
    i = 0
    while i < n {
        let k = order[i]
        let last = mtag.len() - 1
        if last >= 0 && mtag[last] == fb.tag[k] {
            if (fb.flags[k] & FF_GLOBAL()) != 0 {
                mflags[last] = mflags[last] | FF_GLOBAL()
                mmax[last] = fb.maxv[k]
                mdef[last] = fb.defv[k]
            } else {
                if (mflags[last] & FF_GLOBAL()) != 0 { mflags[last] = mflags[last] - FF_GLOBAL() }
                if fb.maxv[k] > mmax[last] { mmax[last] = fb.maxv[k] }
            }
            mflags[last] = mflags[last] | (fb.flags[k] & FF_HAS_FALLBACK())
            if fb.st0[k] < ms0[last] { ms0[last] = fb.st0[k] }
            if fb.st1[k] < ms1[last] { ms1[last] = fb.st1[k] }
        } else {
            mtag.push(fb.tag[k])  mmax.push(fb.maxv[k])  mflags.push(fb.flags[k])  mdef.push(fb.defv[k])
            ms0.push(fb.st0[k])  ms1.push(fb.st1[k])
        }
        i = i + 1
    }
    let req0 = otl_langsys_required(d, gsub_ls)
    let req1 = otl_langsys_required(d, gpos_ls)
    var reqst0 = 0
    var reqst1 = 0
    if req0 >= 0 { let rt = otl_feature_tag(d, f.gsub_off, req0)  var q = 0  while q < mtag.len() { if mtag[q] == rt { reqst0 = ms0[q] }  q = q + 1 } }
    if req1 >= 0 { let rt = otl_feature_tag(d, f.gpos_off, req1)  var q = 0  while q < mtag.len() { if mtag[q] == rt { reqst1 = ms1[q] }  q = q + 1 } }
    // allocate mask bits
    var next_bit = 1
    p.global_mask = GLOBAL_BIT()
    var fidx0: Vec<Int> = vec()  var fidx1: Vec<Int> = vec()  var fst0: Vec<Int> = vec()  var fst1: Vec<Int> = vec()  var flf: Vec<Int> = vec()
    i = 0
    while i < mtag.len() {
        var bits = 0
        if !((mflags[i] & FF_GLOBAL()) != 0 && mmax[i] == 1) {
            var v = mmax[i]
            while v > 0 { bits = bits + 1  v = v >> 1 }
            if bits > 8 { bits = 8 }
        }
        if mmax[i] != 0 && next_bit + bits < GLOBAL_SHIFT() {
            var fi0 = otl_langsys_find_feature(d, f.gsub_off, gsub_ls, mtag[i])
            var fi1 = otl_langsys_find_feature(d, f.gpos_off, gpos_ls, mtag[i])
            var found = fi0 >= 0 || fi1 >= 0
            if !found && (mflags[i] & FF_GLOBAL_SEARCH()) != 0 {
                fi0 = otl_table_find_feature(d, f.gsub_off, mtag[i])
                fi1 = otl_table_find_feature(d, f.gpos_off, mtag[i])
                found = fi0 >= 0 || fi1 >= 0
            }
            if found || (mflags[i] & FF_HAS_FALLBACK()) != 0 {
                p.ftag.push(mtag[i])
                var mask = 0
                var shift = 0
                if (mflags[i] & FF_GLOBAL()) != 0 && mmax[i] == 1 { shift = GLOBAL_SHIFT()  mask = GLOBAL_BIT() }
                else {
                    shift = next_bit
                    mask = (1 << (next_bit + bits)) - (1 << next_bit)
                    next_bit = next_bit + bits
                    p.global_mask = p.global_mask | ((mdef[i] << shift) & mask)
                }
                p.fmask.push(mask)
                p.fshift.push(shift)
                if found { p.ffallback.push(0) } else { p.ffallback.push(1) }
                fidx0.push(fi0)  fidx1.push(fi1)  fst0.push(ms0[i])  fst1.push(ms1[i])
                p.fstage0.push(ms0[i])
                var lflags = 0
                if (mflags[i] & FF_MANUAL_ZWNJ()) == 0 { lflags = lflags | LF_AUTO_ZWNJ() }
                if (mflags[i] & FF_MANUAL_ZWJ()) == 0 { lflags = lflags | LF_AUTO_ZWJ() }
                if (mflags[i] & FF_RANDOM()) != 0 { lflags = lflags | LF_RANDOM() }
                if (mflags[i] & FF_PER_SYLLABLE()) != 0 { lflags = lflags | LF_PER_SYLLABLE() }
                flf.push(lflags)
            }
        }
        i = i + 1
    }
    // the final pauses
    fb_gsub_pause(fb, PAUSE_NONE())
    fb_gpos_pause(fb, PAUSE_NONE())
    // collect lookups, stage by stage
    var table = 0
    while table < 2 {
        var stage_i = 0
        var last_n = 0
        let nst = if table == 0 { fb.cur0 } else { fb.cur1 }
        var stage = 0
        while stage < nst {
            if table == 0 {
                if req0 >= 0 && reqst0 == stage { add_lookups(f, 0, req0, GLOBAL_BIT(), LF_AUTO_ZWNJ() | LF_AUTO_ZWJ(), p.lk0, p.lm0, p.lf0) }
                var q = 0
                while q < p.ftag.len() {
                    if fst0[q] == stage && fidx0[q] >= 0 { add_lookups(f, 0, fidx0[q], p.fmask[q], flf[q], p.lk0, p.lm0, p.lf0) }
                    q = q + 1
                }
                sort_merge_lookups(p.lk0, p.lm0, p.lf0, last_n)
                last_n = p.lk0.len()
                if stage_i < fb.pidx0.len() && fb.pidx0[stage_i] == stage {
                    p.se0.push(last_n)
                    p.sp0.push(fb.pfn0[stage_i])
                    stage_i = stage_i + 1
                }
            } else {
                if req1 >= 0 && reqst1 == stage { add_lookups(f, 1, req1, GLOBAL_BIT(), LF_AUTO_ZWNJ() | LF_AUTO_ZWJ(), p.lk1, p.lm1, p.lf1) }
                var q = 0
                while q < p.ftag.len() {
                    if fst1[q] == stage && fidx1[q] >= 0 { add_lookups(f, 1, fidx1[q], p.fmask[q], flf[q], p.lk1, p.lm1, p.lf1) }
                    q = q + 1
                }
                sort_merge_lookups(p.lk1, p.lm1, p.lf1, last_n)
                last_n = p.lk1.len()
                if stage_i < fb.pidx1.len() && fb.pidx1[stage_i] == stage {
                    p.se1.push(last_n)
                    p.sp1.push(fb.pfn1[stage_i])
                    stage_i = stage_i + 1
                }
            }
            stage = stage + 1
        }
        table = table + 1
    }
}

global g_plans: Vec<Plan>
global g_plans_on: Int = 0

fn plan_empty(sink key: Str) -> Plan {
    var a: Vec<Int> = vec()  var b: Vec<Int> = vec()  var c: Vec<Int> = vec()  var d: Vec<Int> = vec()
    var e: Vec<Int> = vec()  var g: Vec<Int> = vec()  var h: Vec<Int> = vec()  var i: Vec<Int> = vec()
    var j: Vec<Int> = vec()  var k: Vec<Int> = vec()  var l: Vec<Int> = vec()  var m: Vec<Int> = vec()
    var n: Vec<Int> = vec()  var o: Vec<Int> = vec()  var q: Vec<Int> = vec()  var s: Vec<Int> = vec()

    return Plan { key: key, shaper: 0, script: 0, rtl: false, chosen0: 0, chosen1: 0,
        lk0: a, lm0: b, lf0: c, lk1: d, lm1: e, lf1: g, lc0: vec(), lc1: vec(), se0: h, sp0: i, se1: j, sp1: k,
        ftag: l, fmask: m, fshift: n, ffallback: o, fstage0: s, global_mask: 0,
        apply_gpos: false, apply_kern: false, zero_marks: false, adjust_mark_when_zeroing: false,
        fallback_mark_positioning: false, fallback_glyph_classes: false, has_gpos_mark: false,
        kern_mask: 0, rtlm_mask: 0, frac_mask: 0, numr_mask: 0, dnom_mask: 0, shaper_masks: q }
}

/// the index of the cached plan for this face/script/direction/language/features, building it on
/// first use. Plans live in a global list and are never freed: there are few of them (one per
/// distinct font x script x direction x language x feature set a program shapes with).
fn plan_get(f: Font, script: Int, rtl: Bool, lang: Str, features: Str) -> Int {
    if g_plans_on == 0 { g_plans = vec()  g_plans_on = 1 }
    var dir = "L"
    if rtl { dir = "R" }
    let key = to_str(font_disc(f)) + "/" + to_str(f.d.len()) + "/" + to_str(script) + dir + "/" + lang + "/" + features
    var i = 0
    while i < g_plans.len() { if g_plans[i].key == key { return i }  i = i + 1 }
    var p = plan_empty(copy key)
    p.script = script
    p.rtl = rtl
    var ch: Vec<Int> = vec()
    ch.push(0)
    let s0 = select_script(f, 0, script, ch)
    p.chosen0 = ch[0]
    let s1 = select_script(f, 1, script, ch)
    p.chosen1 = ch[0]
    let ls0 = select_langsys(f, s0, lang)
    let ls1 = select_langsys(f, s1, lang)
    p.shaper = choose_shaper(script, p.chosen0)
    var utags: Vec<Str> = vec()
    var uvals: Vec<Int> = vec()
    parse_features(features, utags, uvals)
    var fb = fb_new()
    collect_features(fb, p.shaper, script, rtl, utags, uvals)
    plan_compile(f, fb, p, ls0, ls1)
    // positioning decisions (hb_ot_shape_plan_t::init0)
    let kern = ot_tag("kern")
    var has_gpos_kern = false
    var q = 0
    while q < p.ftag.len() { if p.ftag[q] == kern && p.ffallback[q] == 0 && gpos_has_feature(f, ls1, kern) { has_gpos_kern = true }  q = q + 1 }
    var disable_gpos = false
    if p.shaper == SHAPER_HEBREW() && p.chosen1 != ot_tag("hebr") { disable_gpos = true }
    p.apply_gpos = !disable_gpos && f.gpos_off >= 0 && otl_lookup_count(f.d, f.gpos_off) > 0
    if !has_gpos_kern || !p.apply_gpos {
        if f.kern_off >= 0 { p.apply_kern = true }
    }
    let script_zero_marks = p.shaper != SHAPER_HANGUL() && p.shaper != SHAPER_INDIC()
    let script_fallback = p.shaper != SHAPER_HANGUL() && p.shaper != SHAPER_INDIC() && p.shaper != SHAPER_THAI()
    p.zero_marks = script_zero_marks
    p.has_gpos_mark = plan_1_mask(p, ot_tag("mark")) != 0
    p.adjust_mark_when_zeroing = !p.apply_gpos
    p.fallback_mark_positioning = p.adjust_mark_when_zeroing && script_fallback
    p.fallback_glyph_classes = !font_has_glyph_classes(f)
    p.kern_mask = plan_mask(p, kern)
    p.rtlm_mask = plan_mask(p, ot_tag("rtlm"))
    p.frac_mask = plan_1_mask(p, ot_tag("frac"))
    p.numr_mask = plan_1_mask(p, ot_tag("numr"))
    p.dnom_mask = plan_1_mask(p, ot_tag("dnom"))
    var q2 = 0
    while q2 < p.lk0.len() { p.lc0.push(lookup_coverage_set(f, 0, p.lk0[q2]))  q2 = q2 + 1 }
    q2 = 0
    while q2 < p.lk1.len() { p.lc1.push(lookup_coverage_set(f, 1, p.lk1[q2]))  q2 = q2 + 1 }
    if p.shaper == SHAPER_ARABIC() { arabic_plan_masks(p) }
    if p.shaper == SHAPER_INDIC() { indic_plan_masks(p) }
    g_plans.push(sink p)
    return g_plans.len() - 1
}
// is `tag` a feature of GPOS under LangSys `ls`?
fn gpos_has_feature(f: Font, ls: Int, tag: Int) -> Bool {
    return otl_langsys_find_feature(f.d, f.gpos_off, ls, tag) >= 0
}

// ── lookup coverage sets ─────────────────────────────────────────────────────────────────────────
// A lookup can only act on a glyph its subtables' first coverage holds (for a mark attachment, the
// mark's coverage; for a context rule, the first input's). Each plan lookup gets a bitset of those
// glyphs, made once, so a lookup that cannot touch any glyph in the buffer skips its whole pass.
// HarfBuzz's digests serve the same end. Bits are 32 to an Int (no sign games with >>).
global g_lcov: Vec<Int>
global g_lcov_on: Int = 0
global g_lcov_idx: Map<Str, Int>

fn lcov_words(f: Font) -> Int { return (f.num_glyphs + 32) / 32 }

fn lookup_coverage_set(f: Font, table: Int, li: Int) -> Int {
    if g_lcov_on == 0 { g_lcov = vec()  var m: Map<Str, Int> = map()  g_lcov_idx = m  g_lcov_on = 1 }
    let key = to_str(font_disc(f)) + "/" + to_str(f.d.len()) + "/" + to_str(table) + "/" + to_str(li)
    if g_lcov_idx.has(key) { return g_lcov_idx.get(key) }
    let base = g_lcov.len()
    let nw = lcov_words(f)
    var k = 0
    while k < nw { g_lcov.push(0)  k = k + 1 }
    let d = f.d
    let t = otl_table(f, table)
    let lk = otl_lookup(d, t, li)
    if lk >= 0 {
        let typ = rd_u16(d, lk)
        let n = rd_u16(d, lk + 4)
        var i = 0
        while i < n {
            var st = lk + rd_u16(d, lk + 6 + i * 2)
            var ty = typ
            if (table == 0 && ty == 7) || (table == 1 && ty == 9) { ty = rd_u16(d, st + 2)  st = st + rd_u32(d, st + 4) }
            let fmt = rd_u16(d, st)
            var cov = 0 - 1
            var all = false
            if (table == 0 && ty == 5) || (table == 1 && ty == 7) {
                if fmt == 3 { cov = st + rd_u16(d, st + 6) } else { cov = st + rd_u16(d, st + 2) }
            } else if (table == 0 && ty == 6) || (table == 1 && ty == 8) {
                if fmt == 3 { let bc = rd_u16(d, st + 2)  cov = st + rd_u16(d, st + 4 + bc * 2 + 2) } else { cov = st + rd_u16(d, st + 2) }
            } else if ty >= 1 && ty <= 8 { cov = st + rd_u16(d, st + 2) }
            else { all = true }
            if all { k = 0  while k < nw { g_lcov[base + k] = 4294967295  k = k + 1 } }
            else { coverage_into(d, cov, base, nw) }
            i = i + 1
        }
    }
    g_lcov_idx.put(key, base)
    return base
}
fn lcov_set(base: Int, nw: Int, g: Int) {
    if g < 0 || (g >> 5) >= nw { return }
    let w = base + (g >> 5)
    g_lcov[w] = g_lcov[w] | (1 << (g & 31))
}
fn coverage_into(d: Str, off: Int, base: Int, nw: Int) {
    if off <= 0 { return }
    let fmt = rd_u16(d, off)
    let n = rd_u16(d, off + 2)
    if fmt == 1 {
        var i = 0
        while i < n { lcov_set(base, nw, rd_u16(d, off + 4 + i * 2))  i = i + 1 }
    } else if fmt == 2 {
        var i = 0
        while i < n {
            let a = rd_u16(d, off + 4 + i * 6)
            var b = rd_u16(d, off + 6 + i * 6)
            if b >= nw * 32 { b = nw * 32 - 1 }
            var g = a
            while g <= b { lcov_set(base, nw, g)  g = g + 1 }
            i = i + 1
        }
    }
}
// may lookup set `base` act on glyph `g`?
fn lcov_has(base: Int, g: Int) -> Bool {
    if base < 0 { return true }
    let w = base + (g >> 5)
    if g < 0 || w >= g_lcov.len() { return false }
    return ((g_lcov[w] >> (g & 31)) & 1) != 0
}
