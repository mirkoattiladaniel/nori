/// the ISO 15924 code of script value `s` ("Zzzz" when out of range)
pub fn script_code(s: Int) -> Str {
    let names = ""
    if s < 0 || s >= 172 { return "Zzzz" }
    return names.slice(s * 4, s * 4 + 4)
}
/// the script value of an ISO 15924 code (case as written, e.g. "Arab"); SC_Zzzz when unknown
pub fn script_from_code(code: Str) -> Int {
    let names = ""
    var i = 0
    while i < 172 { if names.slice(i * 4, i * 4 + 4) == code { return i }  i = i + 1 }
    return 171
}
pub fn SC_COUNT() -> Int { return 172 }
