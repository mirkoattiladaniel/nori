//! std/http: HTTP(S) client + a minimal HTTP/1.1 server.
//!   import "std/http" as http
//!
//! Client (std/tls for the handshake, std/net/dns.nori for resolution):
//!   http::http_get("https://example.com/x", "/tmp/x")   // 0 = ok
//!
//! Server (over std/net, no extra native deps):
//!   struct Site {}
//!   impl http::Handler for Site {
//!       fn handle(self, req: Request) -> Response {
//!           if req.path == "/" { return http::html("<h1>hi</h1>") }
//!           return http::not_found()
//!       }
//!   }
//!   fn main() -> Int { return http::serve(http::loopback(), 8080, Site {}) }
//!
//! The handler is a `Handler` trait object (not a closure) because struct types do not carry
//! through an `Fn(...)` parameter, while a trait carries them cleanly. Each connection is
//! read, handled and answered in its own task, and every task gets a `copy` of your handler, so the
//! handler struct's fields must be scalars and Strs (see 16_concurrency, "What may cross into a task").
//! For full control (streaming, custom status lines) use listen/accept/recv_request + send_response.
//! `serve` answers a HEAD with the head its handler's response would have and no body; `serve_limited`
//! takes the limits a request must keep to (`Limits`: head and body sizes, and how long the whole
//! request may take to arrive), and what breaks one is answered 431, 413, 501, 400 or 408.
//!
//! Routing, cookies, forms and static files:
//!
//!   let r = http::route(req, "GET", "/videos/:id")     // also `*rest`; "" method = any
//!   if r.ok { let id = http::param(r, "id") }
//!   let sid = http::req_cookie(req, "session")
//!   resp = http::set_cookie(resp, http::Cookie { name: "session", value: sid, max_age: 2592000 })
//!   let who = http::form_get(req, "username")          // urlencoded body, decoded
//!   return http::file_response("web", rel)             // content-type + traversal refused
import "std/net" as net
import "std/strutil" as su
import "std/io" as io
import "std/os" as os
import "std/time" as time


/// a completed fetch: `rc` (0 = ok) and the URL the client landed on after redirects.
pub struct Fetched { rc: Int, url: Str }

/// download `url` into file `dest`, returning the result code and the effective URL after redirects
/// (so callers can resolve relative links against the final host, e.g. google.com -> www.google.com).
///
/// Nori's own HTTP and TLS all the way down: client.nori frames the request, std/tls does the
/// handshake and validates the chain, std/net/dns.nori resolves the name. No libcurl, no C TLS
/// stack, and no separate certificate-store logic: the trust store is loaded by the same code on
/// every platform.
pub fn http_fetch(url: Str, dest: Str) -> Fetched { return http_fetch_hdr(url, dest, "") }

/// Same, with extra request headers (CRLF-terminated lines), e.g. a `User-Agent:` of your own.
pub fn http_fetch_hdr(url: Str, dest: Str, extra: Str) -> Fetched {
    // file:// is answered locally. Callers rely on it, and it never
    // involves the network in the first place.
    if url.len() > 7 {
        if url.slice(0, 7) == "file://" {
            let path = url.slice(7, url.len())
            if !os::path_exists(path) { return Fetched { rc: 37, url: copy url } }
            write_file(dest, read_file(path))
            return Fetched { rc: 0, url: copy url }
        }
    }
    let r = fetch_hdr(url, default_max_body(), extra)
    if r.err.len() > 0 { return Fetched { rc: 1, url: copy url } }
    // A 4xx or 5xx is a failure rather than a body to keep, which is
    // what every caller here already assumes: rc != 0 means there is nothing to read.
    if r.status >= 400 { return Fetched { rc: 22, url: copy r.final_url } }
    write_file(dest, r.body)
    return Fetched { rc: 0, url: copy r.final_url }
}
/// download `url` into file `dest`. 0 on success, non-zero on any transport/HTTP error (HTTP >= 400 fails).
/// Follows redirects; supports https://, http:// and file://. The TLS handshake is std/tls's.
pub fn http_get(url: Str, dest: Str) -> Int { return http_fetch(url, dest).rc }
/// Same, with extra request headers (CRLF-terminated lines).
pub fn http_get_hdr(url: Str, dest: Str, extra: Str) -> Int { return http_fetch_hdr(url, dest, extra).rc }

// ============================================================================
// Server side: a minimal HTTP/1.1 server over std/net.
// ============================================================================

/// A parsed HTTP request. `query` and `headers` are lowercase-keyed maps (use req_query / req_header).
pub struct Request {
    method: Str,
    path: Str,
    raw_query: Str,
    query: Map<Str, Str>,
    headers: Map<Str, Str>,
    body: Str,
}

/// An HTTP response: a status, a Content-Type, any extra header lines, and a (possibly binary) body.
pub struct Response {
    status: Int,
    ctype: Str,
    extra: Vec<Str>,      // additional header lines, e.g. "Location: /" or "Content-Range: bytes ..."
    body: Str,
}

/// Implement `Handler` and pass it to `serve`; `handle` is called once per request.
pub trait Handler {
    /// turn a request into a response.
    fn handle(self, req: Request) -> Response
}

// ---- small string helper (substring search from an offset) ----
fn hfind(s: Str, sub: Str, from: Int) -> Int {
    let n = s.len()
    let m = sub.len()
    if m == 0 { return from }
    var i = from
    if i < 0 { i = 0 }
    while i + m <= n {
        var j = 0
        while j < m && s.at(i + j) == sub.at(j) { j = j + 1 }
        if j == m { return i }
        i = i + 1
    }
    return 0 - 1
}

// ---- URL + HTML coding ----
fn hex2(b: Int) -> Str {
    let hi = (b >> 4)
    let lo = (b & 15)
    var s = ""
    if hi < 10 { s = s + chr(48 + hi) } else { s = s + chr(55 + hi) }
    if lo < 10 { s = s + chr(48 + lo) } else { s = s + chr(55 + lo) }
    return s
}
fn unhex(c: Int) -> Int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return 0
}
fn unreserved(c: Int) -> Bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 45 || c == 95 || c == 46 || c == 126 { return true }   // - _ . ~
    return false
}
/// percent-encode a string for use inside a URL query value (space -> %20).
pub fn url_encode(s: Str) -> Str {
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let c = ord(s.at(i))
        if unreserved(c) { out = out + chr(c) } else { out = out + ("%" + hex2(c)) }
        i = i + 1
    }
    return out
}
/// percent-decode a URL query value ('+' -> space, %XX -> byte).
pub fn url_decode(s: Str) -> Str {
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let c = ord(s.at(i))
        if c == 37 && i + 2 < n {                      // '%'
            out = out + chr(unhex(ord(s.at(i + 1))) * 16 + unhex(ord(s.at(i + 2))))
            i = i + 3
        } else if c == 43 { out = out + " "  i = i + 1 }
        else { out = out + chr(c)  i = i + 1 }
    }
    return out
}
/// escape a string for safe inclusion in HTML text / attribute values.
pub fn html_escape(s: Str) -> Str {
    var t = su::replace(s, "&", "&amp;")
    t = su::replace(t, "<", "&lt;")
    t = su::replace(t, ">", "&gt;")
    t = su::replace(t, "\"", "&quot;")
    return t
}

// ---- request parsing ----
/// parse a URL query string (`a=1&b=two`, no leading `?`) into a map, percent-decoding both
/// halves. A key with no `=` maps to the empty string; a repeated key keeps the last value.
pub fn parse_query(rq: Str) -> Map<Str, Str> {
    var q: Map<Str, Str> = map()
    if rq.len() == 0 { return q }
    let parts = su::split(rq, "&")
    var i = 0
    while i < parts.len() {
        let p = parts[i]
        let eq = hfind(p, "=", 0)
        if eq >= 0 {
            q.put(url_decode(p.slice(0, eq)), url_decode(p.slice(eq + 1, p.len())))
        } else if p.len() > 0 { q.put(url_decode(p), "") }
        i = i + 1
    }
    return q
}

/// index where the next line ends (the start of its terminator), or -1.
///
/// Accepts CRLF and a bare LF. RFC 7230 lets a recipient recognise a lone LF, and
/// plenty of things emit one: proxies, hand-rolled clients, and Nori's own
/// line-based readers. A parser that insists on CRLF does not fail loudly on those:
/// it finds no line breaks at all and reports one enormous request line.
fn find_eol(s: Str, from: Int) -> Int {
    var i = from
    if i < 0 { i = 0 }
    while i < s.len() {
        if ord(s.at(i)) == 10 {
            if i > 0 { if ord(s.at(i - 1)) == 13 { return i - 1 } }
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// length of the terminator starting at `at` (2 for CRLF, 1 for a bare LF)
fn eol_len(s: Str, at: Int) -> Int {
    if at + 1 < s.len() { if ord(s.at(at)) == 13 { if ord(s.at(at + 1)) == 10 { return 2 } } }
    return 1
}

/// parse a raw HTTP request (request line + headers + optional body) into a Request.
pub fn parse_request(raw: Str) -> Request {
    let n = raw.len()
    var le = find_eol(raw, 0)
    if le < 0 { le = n }
    let line = raw.slice(0, le)
    var method = ""
    var path = "/"
    var rq = ""
    let sp1 = hfind(line, " ", 0)
    if sp1 >= 0 {
        method = line.slice(0, sp1)
        let sp2 = hfind(line, " ", sp1 + 1)
        var target = ""
        if sp2 < 0 { target = line.slice(sp1 + 1, line.len()) } else { target = line.slice(sp1 + 1, sp2) }
        let qm = hfind(target, "?", 0)
        if qm >= 0 { path = target.slice(0, qm)  rq = target.slice(qm + 1, target.len()) } else { path = copy target }
    }
    var hd: Map<Str, Str> = map()
    var body = ""
    var pos = n
    if le < n { pos = le + eol_len(raw, le) }
    var done = 0
    while done == 0 && pos <= n {
        var he = find_eol(raw, pos)
        if he < 0 { he = n }
        if he == pos {                                  // blank line -> body follows
            // clamp: a head with no terminating blank line ends with pos == n, and
            // slicing past the end traps, which would kill the process on a partial request,
            // something any client can send.
            var skip = 1
            if he < n { skip = eol_len(raw, he) }
            if pos + skip <= n { body = raw.slice(pos + skip, n) }
            done = 1
        } else {
            let hl = raw.slice(pos, he)
            let co = hfind(hl, ":", 0)
            if co >= 0 {
                hd.put(su::to_lower(su::trim(hl.slice(0, co))), su::trim(hl.slice(co + 1, hl.len())))
            }
            if he >= n { done = 1 } else { pos = he + eol_len(raw, he) }
        }
    }
    return Request { method: method, path: copy path, raw_query: copy rq, query: parse_query(copy rq), headers: hd, body: body }
}

/// a query parameter (percent-decoded), or "" if absent.
pub fn req_query(req: Request, key: Str) -> Str {
    if req.query.has(key) { return copy req.query.get(key) }
    return ""
}
/// a request header by (case-insensitive) name, or "" if absent.
pub fn req_header(req: Request, key: Str) -> Str {
    let k = su::to_lower(copy key)          // `copy`: to_lower sinks and rewrites in place, and `key` is the caller's
    if req.headers.has(k) { return copy req.headers.get(k) }
    return ""
}

// ---- responses ----
fn reason(code: Int) -> Str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 206 { return "Partial Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 408 { return "Request Timeout" }
    if code == 413 { return "Content Too Large" }
    if code == 414 { return "URI Too Long" }
    if code == 416 { return "Range Not Satisfiable" }
    if code == 429 { return "Too Many Requests" }
    if code == 431 { return "Request Header Fields Too Large" }
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    // An unknown code gets no phrase rather than a wrong one (a missing entry would otherwise
    // send "405 OK"). The phrase is optional on the wire (RFC 9112 §4); the code decides.
    return ""
}

/// a status whose response never has a body (RFC 9110 §6.4.1): 1xx, 204 and 304
fn no_body_status(code: Int) -> Bool {
    if code >= 100 && code < 200 { return true }
    return code == 204 || code == 304
}

/// build a Response with an explicit status, Content-Type, and body.
pub fn response(status: Int, ctype: Str, body: Str) -> Response {
    return Response { status: status, ctype: copy ctype, extra: vec(), body: copy body }
}
/// 200 text/html.
pub fn html(body: Str) -> Response { return response(200, "text/html; charset=utf-8", body) }
/// 200 text/plain.
pub fn text(body: Str) -> Response { return response(200, "text/plain; charset=utf-8", body) }
/// 200 application/json.
pub fn json(body: Str) -> Response { return response(200, "application/json; charset=utf-8", body) }
/// 404 Not Found with a tiny HTML body.
pub fn not_found() -> Response { return response(404, "text/html; charset=utf-8", "<h1>404 Not Found</h1>") }
/// 303 See Other, redirecting to `loc`.
pub fn redirect(loc: Str) -> Response {
    var r = response(303, "text/html; charset=utf-8", "")
    r.extra.push("Location: " + loc)
    return r
}
/// add a raw header line ("Name: Value") to a Response, returning it.
pub fn with_header(inout r: Response, name: Str, value: Str) -> Response {
    r.extra.push(name + ": " + value)
    return copy r
}

// the status line + headers (no body), terminated by the blank line. A status that has no
// body (304, 204, 1xx) gets no Content-Type or Content-Length either: a 304's would have to
// describe the 200 it stands for, and a 0 there contradicts it.
fn head_bytes(r: Response, clen: Int) -> Str {
    var h = "HTTP/1.1 " + to_str(r.status) + (" " + (reason(r.status) + "\r\n"))
    let bodiless = no_body_status(r.status)
    if !bodiless { h = h + ("Content-Type: " + (r.ctype + "\r\n")) }
    var i = 0
    while i < r.extra.len() { h = h + (r.extra[i] + "\r\n")  i = i + 1 }
    if !bodiless { h = h + ("Content-Length: " + (to_str(clen) + "\r\n")) }
    h = h + "Connection: close\r\n\r\n"
    return h
}
/// the full wire form of a Response (head + body) as one Str; a 304, 204 or 1xx never carries a body.
pub fn response_bytes(r: Response) -> Str {
    if no_body_status(r.status) { return head_bytes(r, 0) }
    return head_bytes(r, r.body.len()) + r.body
}
/// a Response's status code.
pub fn resp_status(r: Response) -> Int { return r.status }
/// a Response's body.
pub fn resp_body(r: Response) -> Str { return copy r.body }

// ================= cookies =================
// Cookies are easy to get subtly wrong: the parse has to tolerate the space after `;`, and the
// defaults on the way out decide whether a session cookie is readable by script or sent on
// cross-site requests.

/// a cookie sent by the browser, or "" if absent
pub fn req_cookie(req: Request, name: Str) -> Str {
    let line = req_header(req, "cookie")
    if line.len() == 0 { return "" }
    var start = 0
    var i = 0
    while i <= line.len() {
        if i == line.len() || ord(line.at(i)) == 59 {          // ';'
            var pair = line.slice(start, i)
            while pair.len() > 0 && ord(pair.at(0)) == 32 { pair = pair.slice(1, pair.len()) }
            let eq = hfind(pair, "=", 0)
            if eq > 0 { if (pair.slice(0, eq) == name) { return pair.slice(eq + 1, pair.len()) } }
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

/// A cookie to send. The defaults are the safe ones: readable only by the server, not
/// sent on cross-site requests (which is also the CSRF defence for form posts), and
/// scoped to the whole site. `max_age` of -1 means a session cookie (no Max-Age).
/// Turn on `secure` once you are on https: a Secure cookie is silently dropped over
/// plain http, which makes a local test look like a broken login.
pub struct Cookie {
    name: Str,
    value: Str,
    path: Str = "/",
    max_age: Int = 0 - 1,
    http_only: Bool = true,
    secure: Bool = false,
    same_site: Str = "Lax"
}

/// the Set-Cookie header value for `c`
pub fn cookie_header(c: Cookie) -> Str {
    var out = c.name + ("=" + c.value)
    if c.path.len() > 0 { out = out + ("; Path=" + c.path) }
    if c.max_age >= 0 { out = out + ("; Max-Age=" + to_str(c.max_age)) }
    if c.http_only { out = out + "; HttpOnly" }
    if c.same_site.len() > 0 { out = out + ("; SameSite=" + c.same_site) }
    if c.secure { out = out + "; Secure" }
    return out
}

/// attach a Set-Cookie to a response
pub fn set_cookie(inout r: Response, c: Cookie) -> Response {
    r.extra.push("Set-Cookie: " + cookie_header(c))
    return copy r
}

/// expire a cookie in the browser (same name, empty value, Max-Age 0)
pub fn clear_cookie(inout r: Response, name: Str, secure: Bool) -> Response {
    return set_cookie(r, Cookie { name: copy name, value: "", max_age: 0, secure: secure })
}

// ================= form bodies =================

/// is this a urlencoded form post?
pub fn is_form(req: Request) -> Bool {
    let ct = su::to_lower(copy req_header(req, "content-type"))
    return hfind(ct, "application/x-www-form-urlencoded", 0) >= 0
}

/// every field of a urlencoded body, percent-decoded (`+` is a space)
pub fn req_form(req: Request) -> Map<Str, Str> { return parse_query(req.body) }

/// one form field, or "" if absent
pub fn form_get(req: Request, key: Str) -> Str {
    let f = parse_query(req.body)
    if f.has(key) { return copy f.get(key) }
    return ""
}

// ================= routing =================
// Not a dispatch table: without closures that can cross into a task, a map of handler
// functions cannot be built, and a chain of `if` reads fine anyway. What is needed is
// matching: the method, and path parameters:
//
//     let r = http::route(req, "GET", "/videos/:id")
//     if r.ok { return show(http::param(r, "id")) }
//
// `:name` captures one segment; `*name` captures the rest of the path, slashes and
// all, and must come last.

/// the outcome of matching one route: whether it matched, and what it captured
pub struct Route { ok: Bool, params: Map<Str, Str> }

fn route_no() -> Route { var m: Map<Str, Str> = map()  return Route { ok: false, params: m } }

/// match `req` against a method and a path pattern ("" method = any)
pub fn route(req: Request, method: Str, pattern: Str) -> Route {
    if !(method == "") { if !(req.method == method) { return route_no() } }
    return route_path(req.path, pattern)
}

/// match a path against a pattern, ignoring the method
pub fn route_path(path: Str, pattern: Str) -> Route {
    var params: Map<Str, Str> = map()
    let ps = split_segments(pattern)
    let xs = split_segments(path)
    var i = 0
    while i < ps.len() {
        let seg = ps[i]
        if seg.len() > 0 && ord(seg.at(0)) == 42 {              // '*rest'
            var rest = ""
            var j = i
            while j < xs.len() {
                if rest.len() > 0 { rest = rest + "/" }
                rest = rest + xs[j]
                j = j + 1
            }
            params.put(seg.slice(1, seg.len()), rest)
            return Route { ok: true, params: params }
        }
        if i >= xs.len() { return route_no() }
        if seg.len() > 0 && ord(seg.at(0)) == 58 {              // ':name'
            params.put(seg.slice(1, seg.len()), url_decode(xs[i]))
        } else if !(seg == xs[i]) { return route_no() }
        i = i + 1
    }
    if xs.len() != ps.len() { return route_no() }               // the path had extra segments
    return Route { ok: true, params: params }
}

/// a captured path parameter, or "" if this route did not capture it
pub fn param(r: Route, name: Str) -> Str {
    if r.params.has(name) { return copy r.params.get(name) }
    return ""
}

/// method + exact path, for the routes that capture nothing
pub fn path_is(req: Request, method: Str, path: Str) -> Bool {
    if !(method == "") { if !(req.method == method) { return false } }
    return req.path == path
}

/// path segments, dropping empties ("/a/b/" -> a, b)
fn split_segments(p: Str) -> Vec<Str> {
    var out: Vec<Str> = vec()
    var start = 0
    var i = 0
    while i <= p.len() {
        if i == p.len() || ord(p.at(i)) == 47 {
            if i > start { out.push(p.slice(start, i)) }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

// ================= static files =================

/// a Content-Type guessed from the extension; text/plain when unrecognised
pub fn content_type_for(path: Str) -> Str {
    let e = su::to_lower(copy path)
    if ends_with_str(e, ".html") { return "text/html; charset=utf-8" }
    if ends_with_str(e, ".htm") { return "text/html; charset=utf-8" }
    if ends_with_str(e, ".css") { return "text/css; charset=utf-8" }
    if ends_with_str(e, ".js") { return "text/javascript; charset=utf-8" }
    if ends_with_str(e, ".mjs") { return "text/javascript; charset=utf-8" }
    if ends_with_str(e, ".json") { return "application/json; charset=utf-8" }
    if ends_with_str(e, ".svg") { return "image/svg+xml" }
    if ends_with_str(e, ".png") { return "image/png" }
    if ends_with_str(e, ".jpg") { return "image/jpeg" }
    if ends_with_str(e, ".jpeg") { return "image/jpeg" }
    if ends_with_str(e, ".gif") { return "image/gif" }
    if ends_with_str(e, ".webp") { return "image/webp" }
    if ends_with_str(e, ".ico") { return "image/x-icon" }
    if ends_with_str(e, ".woff2") { return "font/woff2" }
    if ends_with_str(e, ".mp4") { return "video/mp4" }
    if ends_with_str(e, ".webm") { return "video/webm" }
    return "text/plain; charset=utf-8"
}

fn ends_with_str(s: Str, suf: Str) -> Bool {
    if s.len() < suf.len() { return false }
    return s.slice(s.len() - suf.len(), s.len()) == suf
}

/// Serve `rel` from under `dir`.
///
/// The path comes off the network, so it is never resolved as given: a `..` anywhere,
/// a leading `/`, or a backslash is refused rather than normalised; normalising is
/// where directory-traversal bugs live. 404 for anything that is not an existing file.
pub fn file_response(dir: Str, rel: Str) -> Response {
    if rel.len() == 0 { return not_found() }
    if hfind(rel, "..", 0) >= 0 { return response(403, "text/plain; charset=utf-8", "forbidden") }
    if ord(rel.at(0)) == 47 { return response(403, "text/plain; charset=utf-8", "forbidden") }
    var i = 0
    while i < rel.len() {
        if ord(rel.at(i)) == 92 { return response(403, "text/plain; charset=utf-8", "forbidden") }
        i = i + 1
    }
    let full = dir + ("/" + rel)
    if !os::path_exists(full) { return not_found() }
    if os::is_dir(full) { return not_found() }
    return response(200, content_type_for(rel), read_file(full))
}

// ---- sockets ----
/// the loopback address 127.0.0.1.
pub fn loopback() -> net::Ip4 { return net::ipv4(127, 0, 0, 1) }
// Named for std/net's calls, not POSIX's: `listen`/`accept`/`close` are the C functions std/net
// declares as `extern`, and an extern name is never mangled, so a program importing this module
// unaliased would collide with them.
/// bind + listen on ip:port; returns a listening fd or -1.
pub fn tcp_listen(ip: net::Ip4, port: Int) -> Int { return net::tcp_listen4(ip, port, 128) }
/// accept one connection; returns a client fd or -1.
pub fn tcp_accept(lfd: Int) -> Int { return net::tcp_accept(lfd) }
/// close a socket fd.
pub fn tcp_close(fd: Int) -> Int { return net::tcp_close(fd) }
// ---- reading a request off the wire ----
//
// A request does not arrive in one recv. Headers can be split across packets, and a
// body of any size arrives in as many pieces as the network feels like. Reading once
// and parsing whatever turned up works on loopback and truncates everything else:
// a POST larger than one segment loses its tail, and a client whose headers straddle
// a packet boundary gets a 400 for a request it sent correctly.
//
// The wait is a deadline on the whole request, not a poll() before each read. poll() is a
// plain blocking call that holds one of the scheduler's threads for as long as a slow client
// takes, so as many slow clients as there are threads would stop the server. tcp_recv parks the
// task instead; the server's watchdog (below) or recv_limited's own timer ends it at the deadline.

/// most bytes of request head (request line + headers) that will be accepted
pub fn max_head_bytes() -> Int { return 65536 }
/// most bytes of request body that will be read; larger requests are refused
pub fn max_body_bytes() -> Int { return 8388608 }
/// how long a whole request may take to arrive, in ms
pub fn read_timeout_ms() -> Int { return 15000 }

/// What `serve_limited` accepts from a client. A request over a limit is answered with
/// the status that names it (431 for the head, 413 for the body, 408 for the time)
/// and the connection closed.
pub struct Limits {
    head_max: Int = 65536,
    body_max: Int = 8388608,
    timeout_ms: Int = 15000,
}

/// the limits `serve` uses
pub fn default_limits() -> Limits {
    return Limits { head_max: max_head_bytes(), body_max: max_body_bytes(), timeout_ms: read_timeout_ms() }
}

/// Content-Length from an already-parsed head: 0 when absent, -1 when malformed.
fn head_content_length(head: Str) -> Int {
    var i = 0
    let low = su::to_lower(copy head)
    var at = hfind(low, "\r\ncontent-length:", 0)
    if at < 0 { return 0 }
    var p = at + 18
    let e = hfind(head, "\r\n", p)
    if e < 0 { return 0 }
    let v = su::trim(head.slice(p, e))
    if v.len() == 0 { return 0 - 1 }
    var n = 0
    i = 0
    while i < v.len() {
        let b = ord(v.at(i))
        if b < 48 || b > 57 { return 0 - 1 }        // not a number: refuse rather than guess
        n = n * 10 + (b - 48)
        if n > 1073741824 { return 0 - 1 }
        i = i + 1
    }
    return n
}

/// does the head carry a Transfer-Encoding? Bodies are read by Content-Length only, and a
/// chunked body nobody framed would be read as the next request.
fn head_has_transfer_encoding(head: Str) -> Bool {
    return hfind(su::to_lower(copy head), "\r\ntransfer-encoding:", 0) >= 0
}

/// How reading one request ended: its raw bytes (status 0), the status to refuse it with
/// (400, 408, 413, 431, 501), or -1 when the client went away and there is no one to tell.
pub struct Received { raw: Str, status: Int }

/// Read one complete request (the head, then exactly Content-Length bytes of body)
/// within `lim.timeout_ms` of starting.
///
/// For one read on a socket of your own (`serve` has a watchdog for all its connections instead).
/// The socket stays this task's. The read runs in a task of its own and says how it ended on a
/// channel; this task waits for that or the deadline. At the deadline it shuts the socket's
/// reading side, which ends the reader's parked recv, and waits for the reader to let go before
/// returning, so the caller can still answer 408 and close the socket, once. (Cancelling the
/// reader instead would have the scheduler close the socket under its owner: a cancelled task's
/// parked socket is closed, and the owner's later close would hit a number already reused.)
pub fn recv_limited(fd: Int, lim: Limits) -> Received {
    let hmax = lim.head_max
    let bmax = lim.body_max
    let ms = lim.timeout_ms
    let done: Channel<Str> = channel()
    spawn recv_report(fd, hmax, bmax, copy done)
    // the reader says how it ended in its first byte (0: the request follows) or as the
    // refusal's status in digits; "" is the deadline
    let got = select {
        recv r = done => r
        after ms ms => ""
    }
    if got.len() == 0 {
        net::tcp_shutdown(fd, 0)
        let _late = chan_recv(done)
        return Received { raw: "", status: 408 }
    }
    if ord(got.at(0)) == 0 { return Received { raw: got.slice(1, got.len()), status: 0 } }
    if got == "-1" { return Received { raw: "", status: 0 - 1 } }
    return Received { raw: "", status: parse_int(got) }
}

fn recv_report(fd: Int, hmax: Int, bmax: Int, done: Channel<Str>) {
    chan_send(done, recv_whole(fd, hmax, bmax))
}

/// the read itself, with no deadline of its own (`recv_limited` gives it one): chr(0) and the
/// request, or the status to refuse it with ("431"), or "-1" when the client went away
fn recv_whole(fd: Int, hmax: Int, bmax: Int) -> Str {
    // 1. the head, up to and including the blank line
    var buf = ""
    var end = 0 - 1
    var reading = true
    while reading {
        end = hfind(buf, "\r\n\r\n", 0)
        if end >= 0 { reading = false }
        else if buf.len() > hmax { return "431" }
        else {
            let r = net::tcp_recv(fd, 16384)
            if r.n <= 0 { return "-1" }   // closed mid-head
            buf = buf + r.data
        }
    }
    if end + 4 > hmax { return "431" }
    let head = buf.slice(0, end + 4)
    if head_has_transfer_encoding(head) { return "501" }

    // 2. exactly as much body as was announced: no more, and never less
    let want = head_content_length(head)
    if want < 0 { return "400" }
    if want > bmax { return "413" }
    var body = buf.slice(end + 4, buf.len())          // whatever arrived alongside the head
    if body.len() > want { body = body.slice(0, want) }   // pipelined next request: not ours
    var b = io::builder()
    io::add(b, copy body)
    var have = body.len()
    while have < want {
        let r = net::tcp_recv(fd, want - have)
        if r.n <= 0 { return "-1" }    // closed mid-body
        io::add(b, copy r.data)
        have = have + r.n
    }
    return (chr(0) + head) + io::build(b)
}

/// Read one complete request: the head, then exactly Content-Length bytes of body.
///
/// Returns a Request whose `method` is "" if the client went away, sent more than the
/// caps allow, or stopped talking mid-request; the caller should close the socket.
pub fn recv_request(fd: Int) -> Request {
    return parse_request(recv_raw(fd))
}

/// The raw bytes of one complete request, or "" if it never arrived. Kept separate
/// from parsing because a Str can cross into a task and a parsed `Request` cannot:
/// it holds Maps.
pub fn recv_raw(fd: Int) -> Str {
    return recv_raw_capped(fd, max_head_bytes(), max_body_bytes(), read_timeout_ms())
}

/// `recv_request` with explicit limits, for a server that wants different ones.
pub fn recv_request_capped(fd: Int, hmax: Int, bmax: Int, timeout_ms: Int) -> Request {
    return parse_request(recv_raw_capped(fd, hmax, bmax, timeout_ms))
}

/// `recv_raw` with explicit limits; `timeout_ms` bounds the whole request.
pub fn recv_raw_capped(fd: Int, hmax: Int, bmax: Int, timeout_ms: Int) -> Str {
    let got = recv_limited(fd, Limits { head_max: hmax, body_max: bmax, timeout_ms: timeout_ms })
    return copy got.raw
}

/// The wire form of `r` as the answer to a request made with `method`: a HEAD gets the
/// head a GET would have got (the same Content-Length) and no body.
pub fn response_bytes_for(method: Str, r: Response) -> Str {
    if method == "HEAD" { return head_bytes(r, r.body.len()) }
    return response_bytes(r)
}

/// write a Response to a client fd (head and body are sent separately so binary bodies aren't copied).
pub fn send_response(fd: Int, r: Response) -> Int {
    net::tcp_send(fd, head_bytes(r, r.body.len()))
    if r.body.len() > 0 && !no_body_status(r.status) { net::tcp_send(fd, r.body) }
    return 0
}

// ---- the server's own loop ----
//
// One task per connection reads the request, hands it to the handler and answers: nothing else is
// spawned per request. (Every finished task, channel, select and mutex keeps a little memory in
// the runtime, ~150, ~160, ~490 and ~60 bytes, so a server that made five tasks, two
// channels and a select per request would grow by a kilobyte a request. This one makes a task and a mutex.)
//
// The deadline is one watchdog for the whole server, not a timer per request. A connection tells
// it, on one channel, its socket and a mutex holding when its time is up; a ticker puts a tick on
// the same channel four times a second, and on each tick the watchdog looks at every connection
// still reading. One whose time is up has its reading side shut, which ends its parked recv, and
// its mutex set to -1 so it knows to answer 408. A connection that has finished reading sets its
// mutex to 0 first, under the same lock, and only then may close its socket, so the watchdog
// never shuts a socket number that has been closed and given to someone else.

/// a connection the watchdog keeps an eye on: its socket, and its deadline in ms (0: no longer
/// reading; -1: the watchdog ended the read). A tick is fd -1.
struct Watch { fd: Int, st: Mutex }

/// accept forever, each connection to a task of its own
fn accept_task<H: Handler>(lfd: Int, h: H, lim: Limits, watch: Channel<Watch>) {
    while true {
        let c = net::tcp_accept(lfd)
        if c >= 0 { spawn conn_task(copy h, c, copy lim, copy watch) }
    }
}

/// one connection: read the request (a client that sends its headers one byte at a time delays
/// nobody but itself), answer it or say why not, close
fn conn_task<H: Handler>(h: H, fd: Int, lim: Limits, watch: Channel<Watch>) {
    let st = mutex(time::now_ms() + lim.timeout_ms)
    chan_send(watch, Watch { fd: fd, st: st })
    let got = recv_whole(fd, lim.head_max, lim.body_max)
    var late = false
    lock st as x {
        if x < 0 { late = true }
        x = 0
    }
    if late { refuse(fd, 408) }
    else if got.len() > 0 && ord(got.at(0)) == 0 {
        net::tcp_send(fd, handled(h, got.slice(1, got.len())))
    } else if !(got == "-1") { refuse(fd, parse_int(got)) }
    net::tcp_close(fd)
}

/// say why a request is refused (400, 408, 413, 431, 501)
fn refuse(fd: Int, status: Int) {
    net::tcp_send(fd, response_bytes(response(status, "text/plain; charset=utf-8", reason(status) + "\n")))
}

/// four ticks a second
fn ticker(watch: Channel<Watch>) {
    let none = mutex(0)
    while true {
        co_sleep(250)
        chan_send(watch, Watch { fd: 0 - 1, st: none })
    }
}

/// the connections still reading; on each tick, the ones whose time is up stop being read
fn watchdog(watch: Channel<Watch>) {
    var live: Vec<Watch> = vec()
    while true {
        let w: Watch = chan_recv(watch)
        if w.fd >= 0 { live.push(copy w) }
        else {
            let now = time::now_ms()
            var still: Vec<Watch> = vec()
            foreach e in live {
                let m = e.st
                var gone = false
                lock m as x {
                    if x == 0 { gone = true }
                    else if x > 0 && x <= now { x = 0 - 1  net::tcp_shutdown(e.fd, 0)  gone = true }
                }
                if !gone { still.push(copy e) }
            }
            live = copy still
        }
    }
}

/// the handler's answer to one raw request, on the wire. The response is handed over (`sink`) to
/// `wire`, which frees it: a value a trait method returned inside a generic function would
/// otherwise never be freed (a page-sized leak per request).
fn handled<H: Handler>(h: H, raw: Str) -> Str {
    let req = parse_request(raw)
    let resp = h.handle(req)
    return wire(req.method, resp)
}

fn wire(method: Str, sink resp: Response) -> Str { return response_bytes_for(method, resp) }

/// Run the accept loop forever, dispatching each request to `h.handle`. Returns 1 if
/// the bind failed. Generic over the handler (monomorphized), so importing std/http
/// for the client alone costs nothing.
///
/// Every connection is read, handled and answered in its own task, so one slow
/// client, or one slow handler, delays nobody else. Each task gets a copy of the
/// handler (`copy h`), which is why `H` must be a struct of scalars and Strs: copying
/// is what makes it safe to hand to a task, and a Vec or Map field would still be
/// shared. Put anything mutable behind a `mutex`, or keep it in the tasks the handler
/// spawns itself.
///
/// A HEAD request is handled as a GET and answered without the body.
pub fn serve<H: Handler>(ip: net::Ip4, port: Int, h: H) -> Int {
    return serve_limited(ip, port, h, default_limits())
}

/// `serve` with the limits a request must stay within (see `Limits`).
pub fn serve_limited<H: Handler>(ip: net::Ip4, port: Int, h: H, lim: Limits) -> Int {
    let lfd = net::tcp_listen4(ip, port, 128)
    if lfd < 0 { return 1 }
    let watch: Channel<Watch> = channel()
    spawn watchdog(copy watch)
    spawn ticker(copy watch)
    accept_task(lfd, h, lim, watch)
    return 0
}
