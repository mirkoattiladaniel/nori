// std/image: WebP, streamed (anim.nori's canvas). Written from RFC 9649 §2 ("WebP Container Specification"):
//
//   §2.3-2.4  RIFF: "RIFF", a 32-bit little-endian size, "WEBP", then chunks (a FourCC, a 32-bit size, the
//             payload padded to an even length);
//   §2.5-2.6  the simple formats: one 'VP8 ' (lossy, vp8.nori) or one 'VP8L' (lossless, vp8l.nori) chunk;
//   §2.7      the extended format: 'VP8X' (flags: I L E X A; the canvas's width-1 and height-1, 24 bits each), then
//             'ANIM' (the background colour, BGRA, and the loop count, 0: for ever) and 'ANMF' frames; X/2 and
//             Y/2, width-1, height-1, a 24-bit duration in ms, the blending bit (1: do not blend) and the disposal
//             bit (1: the rectangle to the background); each holding an optional 'ALPH' and a 'VP8 ' or 'VP8L';
//             or, still, an optional 'ALPH' and the image chunk;
//   §2.7.1.2  'ALPH': the filtering method (none, horizontal, vertical, gradient, with their border rules) and the
//             compression (raw bytes, or a VP8L image stream of the frame's size whose green is the alpha);
//   §2.7.2    the canvas assembled frame by frame: the previous frame's disposal applied, the frame rendered with
//             its blending (the alpha-blending formula of §2.7.1.1), shown for its duration.
//
// Decisions. The canvas is cleared to transparent black at the start of each loop, and "dispose to the background"
// clears to transparent too (the specification lets an application choose; the background colour is "a hint",
// and transparent is what a page shows under a GIF as well). Alpha-blending is done on the 8-bit sRGB values (the
// specification's formula; the linear-light advice is a SHOULD that no viewer follows). A duration of 0 is shown
// as 100 ms, as GIF's is.
//
// A lossy frame is decoded to YUV 4:2:0 by vp8.nori and turned into RGB here (BT.601, the range VP8 uses: Y 16-235,
// chroma 16-240: RFC 6386 §9.2 names the colour space), chroma upsampled by interpolating between the four nearest
// chroma samples ("fancy" upsampling: no blocky chroma edges).

fn wp_tag(a: Anim, i: Int) -> Int { return ale32(a, i) }
fn wp4(s: Str) -> Int { return ord(s.at(0)) + ord(s.at(1)) * 256 + ord(s.at(2)) * 65536 + ord(s.at(3)) * 16777216 }

fn webp_open(inout a: Anim) {
    var end = 8 + ale32(a, 4)
    if end > a.dn { end = a.dn }
    var pos = 12
    if pos + 8 > end { a.err = "WebP: no chunks"  return }
    let t0 = wp_tag(a, pos)
    a.loops = 1
    if t0 == wp4("VP8X") {
        let d = pos + 8
        let flags = ab(a, d)
        let cw = ale24(a, d + 4) + 1
        let ch = ale24(a, d + 7) + 1
        pos = pos + 8 + ((ale32(a, pos + 4) + 1) / 2) * 2
        if (flags & 2) != 0 {
            // animated: ANIM, then the ANMF frames
            var frames = 0
            var first = 0 - 1
            while pos + 8 <= end {
                let t = wp_tag(a, pos)
                let n = ale32(a, pos + 4)
                if t == wp4("ANIM") && n >= 6 { a.bg = ale32(a, pos + 8)  a.loops = ale16(a, pos + 12) }
                if t == wp4("ANMF") && n >= 16 && pos + 8 + n <= end { if first < 0 { first = pos }  frames = frames + 1 }
                pos = pos + 8 + ((n + 1) / 2) * 2
            }
            if frames == 0 { a.err = "WebP: an animation without frames"  return }
            if !anim_canvas(a, cw, ch) { a.err = "WebP: " + a.err  return }
            a.frames = frames
            a.first = first
            a.pos = first
            a.kind = ANIM_WEBP()
            return
        }
        // still, extended: the image chunks follow (after ICCP and others)
        if !anim_canvas(a, cw, ch) { a.err = "WebP: " + a.err  return }
        a.first = pos
        a.pos = pos
        a.frames = 1
        a.loops = 0
        a.kind = ANIM_WEBP()
        return
    }
    // simple: the size from the bitstream's own header
    var w = 0
    var h = 0
    let d = pos + 8
    if t0 == wp4("VP8L") { w = ((ab(a, d + 1) | (ab(a, d + 2) << 8)) & 16383) + 1  h = (((ab(a, d + 2) >> 6) | (ab(a, d + 3) << 2) | (ab(a, d + 4) << 10)) & 16383) + 1 }
    else if t0 == wp4("VP8 ") { w = ale16(a, d + 6) & 16383  h = ale16(a, d + 8) & 16383 }
    else { a.err = "WebP: the first chunk is neither VP8, VP8L nor VP8X"  return }
    if !anim_canvas(a, w, h) { a.err = "WebP: " + a.err  return }
    a.first = pos
    a.pos = pos
    a.frames = 1
    a.loops = 0
    a.kind = ANIM_WEBP()
}

fn webp_next(inout a: Anim) -> Bool {
    var end = 8 + ale32(a, 4)
    if end > a.dn { end = a.dn }
    if wp_tag(a, a.first) != wp4("ANMF") {
        // a still picture: its chunks from a.first
        let fr = webp_frame(a, a.first, end, a.w, a.h)
        if fr == 0 { return false }
        unsafe { memcpy(a.canvas, fr, a.w * a.h * 4)  free(fr) }
        a.delay = 0
        return true
    }
    var pos = a.pos
    while pos + 8 <= end && wp_tag(a, pos) != wp4("ANMF") { pos = pos + 8 + ((ale32(a, pos + 4) + 1) / 2) * 2 }
    if pos + 24 > end { a.err = "WebP: no frame " + to_str(a.index)  return false }
    let n = ale32(a, pos + 4)
    let d = pos + 8
    let fx = ale24(a, d) * 2
    let fy = ale24(a, d + 3) * 2
    let fw = ale24(a, d + 6) + 1
    let fh = ale24(a, d + 9) + 1
    let dur = ale24(a, d + 12)
    let fl = ab(a, d + 15)
    if fx + fw > a.w || fy + fh > a.h { a.err = "WebP: frame " + to_str(a.index) + " lies outside the canvas"  return false }
    var fend = d + n
    if fend > end { fend = end }
    let fr = webp_frame(a, d + 16, fend, fw, fh)
    if fr == 0 { return false }
    anim_dispose(a)
    let blend = (fl & 2) == 0
    var y = 0
    while y < fh {
        let dst = a.canvas + ((fy + y) * a.w + fx) * 4
        let src = fr + y * fw * 4
        if !blend { unsafe { memcpy(dst, src, fw * 4) } }
        else {
            var x = 0
            while x < fw {
                var r = 0  var g = 0  var b = 0  var al = 0
                unsafe { r = peek8(src + x * 4)  g = peek8(src + x * 4 + 1)  b = peek8(src + x * 4 + 2)  al = peek8(src + x * 4 + 3) }
                blend_over(dst + x * 4, r, g, b, al)
                x = x + 1
            }
        }
        y = y + 1
    }
    unsafe { free(fr) }
    if (fl & 1) != 0 { anim_after(a, 1, fx, fy, fw, fh) } else { a.disp = 0 }
    if dur == 0 { a.delay = 100 } else { a.delay = dur }
    a.pos = pos + 8 + ((n + 1) / 2) * 2
    return true
}

/// one frame's image from the chunks in [start, end): an ALPH (optional) and a VP8 or VP8L, of fw x fh.
/// Returns fw*fh*4 bytes of straight RGBA (malloc'd), or 0 with a.err said.
fn webp_frame(inout a: Anim, start: Int, end: Int, fw: Int, fh: Int) -> Int {
    var pos = start
    var alph = 0 - 1
    var alphn = 0
    while pos + 8 <= end {
        let t = wp_tag(a, pos)
        let n = ale32(a, pos + 4)
        let d = pos + 8
        if d + n > a.dn { a.err = "WebP: frame " + to_str(a.index) + ": the file ends inside its " + (if wp_tag(a, pos) == wp4("ALPH") { "alpha" } else { "image" }) + " chunk"  return 0 }
        if t == wp4("ALPH") { alph = d  alphn = n }
        else if t == wp4("VP8L") {
            let o = vl_decode(a.dp + d, n, fw, fh, true)
            if o.px == 0 { a.err = "WebP: frame " + to_str(a.index) + ": " + o.err  return 0 }
            // ARGB words to RGBA bytes, in place
            var i = 0
            unsafe {
                while i < fw * fh {
                    let c = peek32(o.px + i * 4)
                    poke8(o.px + i * 4, (c >> 16) & 255)
                    poke8(o.px + i * 4 + 1, (c >> 8) & 255)
                    poke8(o.px + i * 4 + 2, c & 255)
                    poke8(o.px + i * 4 + 3, (c >> 24) & 255)
                    i = i + 1
                }
            }
            return o.px
        } else if t == wp4("VP8 ") {
            var yv = vp8_decode(a.dp + d, n)
            if yv.y == 0 { a.err = "WebP: frame " + to_str(a.index) + ": " + yv.err  return 0 }
            if yv.w != fw || yv.h != fh { vp8_free(yv)  a.err = "WebP: frame " + to_str(a.index) + " is not the size its frame says"  return 0 }
            var out = 0
            unsafe { out = malloc(fw * fh * 4) }
            yuv_to_rgba(yv.y, yv.u, yv.v, yv.ys, yv.uvs, fw, fh, out)
            vp8_free(yv)
            if alph >= 0 { if !webp_alpha(a, alph, alphn, out, fw, fh) { unsafe { free(out) }  return 0 } }
            return out
        }
        pos = d + ((n + 1) / 2) * 2
    }
    a.err = "WebP: frame " + to_str(a.index) + " has no image chunk"
    return 0
}

/// the ALPH chunk at `d` (n bytes) into the alpha bytes of `out` (fw x fh RGBA)
fn webp_alpha(inout a: Anim, d: Int, n: Int, out: Int, fw: Int, fh: Int) -> Bool {
    if n < 1 { a.err = "WebP: an empty ALPH chunk"  return false }
    let hdr = ab(a, d)
    let comp = hdr & 3
    let filt = (hdr >> 2) & 3
    let total = fw * fh
    // the alpha values, unfiltered below, into the output's alpha bytes
    if comp == 0 {
        if n - 1 < total { a.err = "WebP: the ALPH chunk is short"  return false }
        var i = 0
        unsafe { while i < total { poke8(out + i * 4 + 3, peek8(a.dp + d + 1 + i))  i = i + 1 } }
    } else if comp == 1 {
        let o = vl_decode(a.dp + d + 1, n - 1, fw, fh, false)
        if o.px == 0 { a.err = "WebP: the alpha: " + o.err  return false }
        var i = 0
        unsafe { while i < total { poke8(out + i * 4 + 3, (peek32(o.px + i * 4) >> 8) & 255)  i = i + 1 }  free(o.px) }
    } else { a.err = "WebP: ALPH compression " + to_str(comp)  return false }
    if filt == 0 { return true }
    // the filters undone in scan order (§2.7.1.2): A left, B above, C above-left
    var y = 0
    unsafe {
        while y < fh {
            var x = 0
            while x < fw {
                let p = out + (y * fw + x) * 4 + 3
                var pr = 0
                if x == 0 && y == 0 { pr = 0 }
                else if y == 0 { pr = peek8(p - 4) }                         // the top row: from the left
                else if x == 0 { pr = peek8(p - fw * 4) }                    // the left column: from above
                else if filt == 1 { pr = peek8(p - 4) }
                else if filt == 2 { pr = peek8(p - fw * 4) }
                else {
                    var g = peek8(p - 4) + peek8(p - fw * 4) - peek8(p - fw * 4 - 4)
                    if g < 0 { g = 0 }
                    if g > 255 { g = 255 }
                    pr = g
                }
                poke8(p, (peek8(p) + pr) & 255)
                x = x + 1
            }
            y = y + 1
        }
    }
    return true
}

/// YUV 4:2:0 (BT.601, limited range) to straight RGBA, opaque. Chroma is interpolated from the four nearest
/// chroma samples (weights 9, 3, 3, 1 sixteenths: the sample sits between four luma pixels).
fn yuv_to_rgba(yp: Int, up: Int, vp: Int, ys: Int, uvs: Int, w: Int, h: Int, out: Int) {
    let cw = (w + 1) / 2
    let ch = (h + 1) / 2
    var y = 0
    unsafe {
        while y < h {
            // the two chroma rows this row lies between, and the nearer one's weight
            let cy = y >> 1
            var cy2 = cy - 1
            if (y & 1) == 1 { cy2 = cy + 1 }
            if cy2 < 0 { cy2 = 0 }
            if cy2 >= ch { cy2 = ch - 1 }
            let ur0 = up + cy * uvs
            let ur1 = up + cy2 * uvs
            let vr0 = vp + cy * uvs
            let vr1 = vp + cy2 * uvs
            var x = 0
            while x < w {
                let cx = x >> 1
                var cx2 = cx - 1
                if (x & 1) == 1 { cx2 = cx + 1 }
                if cx2 < 0 { cx2 = 0 }
                if cx2 >= cw { cx2 = cw - 1 }
                let u = (9 * peek8(ur0 + cx) + 3 * peek8(ur0 + cx2) + 3 * peek8(ur1 + cx) + peek8(ur1 + cx2) + 8) >> 4
                let v = (9 * peek8(vr0 + cx) + 3 * peek8(vr0 + cx2) + 3 * peek8(vr1 + cx) + peek8(vr1 + cx2) + 8) >> 4
                let yy = (peek8(yp + y * ys + x) - 16) * 76309
                let r = sar(yy + 104597 * (v - 128) + 32768, 16)
                let g = sar(yy - 25675 * (u - 128) - 53279 * (v - 128) + 32768, 16)
                let b = sar(yy + 132201 * (u - 128) + 32768, 16)
                let o = out + (y * w + x) * 4
                poke8(o, clampb(r))
                poke8(o + 1, clampb(g))
                poke8(o + 2, clampb(b))
                poke8(o + 3, 255)
                x = x + 1
            }
            y = y + 1
        }
    }
}

/// a lossy WebP's picture as the codec decodes it: YUV 4:2:0 (BT.601, limited range), before any conversion to
/// RGB: for a renderer that converts on the GPU, and for checking the decoder against others bit for bit.
pub struct YuvImage { w: Int, h: Int, y: Int, u: Int, v: Int, ystride: Int, uvstride: Int, base: Int, err: Str }

/// decode a lossy WebP (simple or extended; an animation's first frame is not looked for) to its YUV planes.
/// `yuv_ok` says whether it decoded; `yuv_dispose` lets the planes go.
pub fn load_webp_yuv(data: Str) -> YuvImage {
    var a = anim_open(copy data)
    var out = YuvImage { w: 0, h: 0, y: 0, u: 0, v: 0, ystride: 0, uvstride: 0, base: 0, err: "not a lossy WebP" }
    if a.kind != ANIM_WEBP() { anim_close(a)  return out }
    var end = 8 + ale32(a, 4)
    if end > a.dn { end = a.dn }
    var pos = a.first
    while pos + 8 <= end {
        let n = ale32(a, pos + 4)
        if wp_tag(a, pos) == wp4("VP8 ") {
            var avail = n
            if pos + 8 + avail > a.dn { avail = a.dn - pos - 8 }
            let o = vp8_decode(a.dp + pos + 8, avail)
            out = YuvImage { w: o.w, h: o.h, y: o.y, u: o.u, v: o.v, ystride: o.ys, uvstride: o.uvs, base: o.base, err: copy o.err }
            anim_close(a)
            return out
        }
        pos = pos + 8 + ((n + 1) / 2) * 2
    }
    anim_close(a)
    return out
}
/// did the planes decode?
pub fn yuv_ok(im: YuvImage) -> Bool { return im.y != 0 }
/// let the planes go.
pub fn yuv_dispose(inout im: YuvImage) { if im.base != 0 { unsafe { free(im.base) } }  im.base = 0  im.y = 0 }
