//! std/json: a JSON parser and serializer. A JSON document is a `Json` value tree (null / bool /
//! number / string / array / object). `parse` builds the tree; `stringify` renders it back; the
//! `get`/`at`/`as_*` accessors read it. Numbers are stored as Float. Malformed input parses to JsNull
//! (best-effort, non-trapping). Objects preserve insertion order.
//!
//!   import "std/json" as json
//!   var v = json::parse(text)
//!   var name = json::as_str(json::field(v, "name"))
//!   var first = json::as_num(json::at(json::field(v, "scores"), 0))
//!   printl(json::stringify(v))

import "std/parse" as parse
import "std/fmt" as fmt

/// one key/value member of a JSON object.
pub struct Entry { key: Str, val: Json }

/// a JSON value: one of null, bool, number (Float), string, array, or object (ordered members).
pub enum Json {
    JsNull
    JsBool(Bool)
    JsNum(Float)
    JsStr(Str)
    JsArr(Vec<Json>)
    JsObj(Vec<Entry>)
}

// ---- parser (recursive descent over the source; `pos` is a 1-element cursor cell) ----

/// Mark the parse as failed.
///
/// The cursor is a Vec cell so it can be threaded through a recursive descent by reference; a second
/// cell carries "this input was not valid JSON". It is optional: `jp_value` and friends
/// are public and may be called with a one-cell cursor.
fn jp_err(inout pos: Vec<Int>) { if pos.len() > 1 { pos[1] = 1 } }

/// did the parse that used this cursor fail?
pub fn jp_failed(pos: Vec<Int>) -> Bool { if pos.len() > 1 { return pos[1] != 0 }  return false }

/// the byte at the cursor, or -1 at end of input.
pub fn jp_peek(s: Str, pos: Vec<Int>) -> Int { if pos[0] < s.len() { return ord(s.at(pos[0])) }  return 0 - 1 }
/// the byte at the cursor, then advance.
pub fn jp_take(s: Str, inout pos: Vec<Int>) -> Int { var c = jp_peek(s, pos)  pos[0] = pos[0] + 1  return c }
/// skip JSON whitespace (space, tab, newline, carriage return).
pub fn jp_ws(s: Str, inout pos: Vec<Int>) {
    var go = true
    while go {
        var c = jp_peek(s, pos)
        if c == 32 || c == 9 || c == 10 || c == 13 { pos[0] = pos[0] + 1 } else { go = false }
    }
}
/// true if `c` (a byte) is an ASCII digit.
pub fn jp_is_digit(c: Int) -> Bool { return c >= 48 && c <= 57 }

/// parse a JSON string literal (cursor is on the opening quote); decodes \" \\ \/ \n \t \r \b \f.
// encode a Unicode code point as UTF-8 bytes.
fn jp_cp_utf8(cp: Int) -> Str {
    var out = ""
    if cp < 128 { out = out + chr(cp)  return out }
    if cp < 2048 { out = out + chr(192 + cp / 64)  out = out + chr(128 + cp % 64)  return out }
    if cp < 65536 { out = out + chr(224 + cp / 4096)  out = out + chr(128 + (cp / 64) % 64)  out = out + chr(128 + cp % 64)  return out }
    out = out + chr(240 + cp / 262144)  out = out + chr(128 + (cp / 4096) % 64)  out = out + chr(128 + (cp / 64) % 64)  out = out + chr(128 + cp % 64)
    return out
}
fn jp_hexval(c: Int) -> Int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}
// read exactly 4 hex digits at the cursor (already past "\u") into a 16-bit value.
fn jp_hex4(s: Str, inout pos: Vec<Int>) -> Int {
    var v = 0
    var k = 0
    while k < 4 { v = v * 16 + jp_hexval(jp_take(s, pos))  k = k + 1 }
    return v
}
// decode a uXXXX escape (the backslash-u is already consumed) into UTF-8, joining a high+low
// surrogate pair into one code point; a lone/invalid surrogate becomes U+FFFD.
fn jp_unicode_escape(s: Str, inout pos: Vec<Int>) -> Str {
    var hi = jp_hex4(s, pos)
    if hi >= 55296 && hi <= 56319 {                         // high surrogate
        if jp_peek(s, pos) == 92 {                          // '\'
            pos[0] = pos[0] + 1
            if jp_peek(s, pos) == 117 {                     // 'u'
                pos[0] = pos[0] + 1
                var lo = jp_hex4(s, pos)
                if lo >= 56320 && lo <= 57343 { return jp_cp_utf8(65536 + (hi - 55296) * 1024 + (lo - 56320)) }
                return jp_cp_utf8(65533) + jp_cp_utf8(lo)   // high was lone; lo stands alone
            }
            return jp_cp_utf8(65533) + chr(117)             // consumed a '\' that wasn't "\u"
        }
        return jp_cp_utf8(65533)                            // lone high surrogate
    }
    if hi >= 56320 && hi <= 57343 { return jp_cp_utf8(65533) }   // lone low surrogate
    return jp_cp_utf8(hi)
}
/// read one JSON string literal from `s` starting at the opening quote at `pos[0]`, and leave
/// `pos[0]` just past the closing quote. Escapes are resolved, `\uXXXX` pairs included; an
/// unpaired surrogate becomes U+FFFD rather than an error, so a scan never stalls on bad input.
pub fn jp_string(s: Str, inout pos: Vec<Int>) -> Str {
    var out = ""
    pos[0] = pos[0] + 1                      // consume opening quote
    var go = true
    while go {
        var c = jp_take(s, pos)
        if c < 0 { go = false }
        else if c == 34 { go = false }            // closing quote
        else if c == 92 {                         // backslash escape
            var e = jp_take(s, pos)
            if e == 110 { out = out + chr(10) }        // \n
            else if e == 116 { out = out + chr(9) }    // \t
            else if e == 114 { out = out + chr(13) }   // \r
            else if e == 98 { out = out + chr(8) }     // \b
            else if e == 102 { out = out + chr(12) }   // \f
            else if e == 117 { out = out + jp_unicode_escape(s, pos) }   // \uXXXX -> UTF-8 (handles surrogate pairs)
            else { out = out + chr(e) }                // \" \\ \/ and anything else: literal
        }
        else { out = out + chr(c) }
    }
    return out
}

/// parse a JSON number into a Float (handles sign, fraction, and e/E exponent), correctly rounded.
///
/// The conversion itself lives in `std/parse` (`parse::scan_float`), because "decimal text -> nearest
/// double" is not a JSON question and every other reader needs the same answer. This function is only
/// the cursor plumbing.
///
/// Accumulating the fraction as `v + digit * scale` with `scale * 0.1` is not correct: 0.1 is not
/// representable, so the error compounds and most non-dyadic literals come out wrong in the last
/// bits (`0.75` would parse as 0.75000000000000016). Scaling an integer mantissa once by a power of
/// ten is not enough either for mantissas past 2^53 or net exponents past +-22. `parse::scan_float`
/// uses an exact integer long division, and is correctly rounded wherever it reports `exact`.
///
/// A malformed number leaves the cursor where it was and yields 0.0; `jp_value` only calls this when
/// the next byte is `-` or a digit, so that cannot happen through the normal entry points.
pub fn jp_number(s: Str, inout pos: Vec<Int>) -> Float {
    let r = parse::scan_float(s, pos[0])
    if !r.ok { return 0.0 }
    pos[0] = pos[0] + r.used
    return r.value
}

/// does the input match the literal `word` (e.g. "true") at the cursor? consumes it on success.
pub fn jp_lit(s: Str, inout pos: Vec<Int>, word: Str) -> Bool {
    var n = word.len()
    if pos[0] + n > s.len() { return false }
    if (s.slice(pos[0], pos[0] + n) == word) { pos[0] = pos[0] + n  return true }
    return false
}

/// parse any JSON value at the cursor (the core recursive routine).
pub fn jp_value(s: Str, inout pos: Vec<Int>) -> Json {
    jp_ws(s, pos)
    var c = jp_peek(s, pos)
    if c == 123 { return jp_object(s, pos) }          // '{'
    if c == 91 { return jp_array(s, pos) }            // '['
    if c == 34 { return Json::JsStr(jp_string(s, pos)) }   // '"'
    if c == 116 { if jp_lit(s, pos, "true") { return Json::JsBool(true) } }    // 'true'
    if c == 102 { if jp_lit(s, pos, "false") { return Json::JsBool(false) } }  // 'false'
    if c == 110 { if jp_lit(s, pos, "null") { return Json::JsNull } }          // 'null'
    if c == 45 || jp_is_digit(c) { return Json::JsNum(jp_number(s, pos)) }     // '-' or digit
    jp_err(pos)                                   // nothing here starts a JSON value
    return Json::JsNull
}

/// parse a JSON array (cursor on '[').
pub fn jp_array(s: Str, inout pos: Vec<Int>) -> Json {
    var items: Vec<Json> = vec()
    pos[0] = pos[0] + 1                          // consume '['
    jp_ws(s, pos)
    if jp_peek(s, pos) == 93 { pos[0] = pos[0] + 1  return Json::JsArr(items) }   // ']' empty
    var go = true
    while go {
        items.push(jp_value(s, pos))
        jp_ws(s, pos)
        var c = jp_peek(s, pos)
        if c == 44 { pos[0] = pos[0] + 1 }       // ',' -> another element
        else {
            if c == 93 { pos[0] = pos[0] + 1 } else { jp_err(pos) }   // ']' closes it; anything else is unterminated
            go = false
        }
    }
    return Json::JsArr(items)
}

/// parse a JSON object (cursor on '{').
pub fn jp_object(s: Str, inout pos: Vec<Int>) -> Json {
    var entries: Vec<Entry> = vec()
    pos[0] = pos[0] + 1                          // consume '{'
    jp_ws(s, pos)
    if jp_peek(s, pos) == 125 { pos[0] = pos[0] + 1  return Json::JsObj(entries) }   // '}' empty
    var go = true
    while go {
        jp_ws(s, pos)
        var key = jp_string(s, pos)                   // a key is a JSON string
        jp_ws(s, pos)
        if jp_peek(s, pos) == 58 { pos[0] = pos[0] + 1 } else { jp_err(pos) }   // ':' separates key from value
        var val = jp_value(s, pos)
        entries.push(Entry { key: key, val: val })
        jp_ws(s, pos)
        var c = jp_peek(s, pos)
        if c == 44 { pos[0] = pos[0] + 1 }       // ',' -> another member
        else {
            if c == 125 { pos[0] = pos[0] + 1 } else { jp_err(pos) }   // '}' closes it; anything else is unterminated
            go = false
        }
    }
    return Json::JsObj(entries)
}

/// Parse a JSON document, best-effort: what it could make of the input, with no way to ask whether
/// the input was valid. Use `try_parse` when that matters, which is most of the time.
///
/// This cannot report failure, and the failure does not always look like failure: `"@@@@"` gives
/// JsNull, which is also what the valid document `null` gives, and `"{"` gives an empty JsObj, which
/// is what `{}` gives. A caller cannot tell a document from a mistake.
pub fn parse(text: Str) -> Json {
    var pos: Vec<Int> = vec()
    pos.push(0)
    return jp_value(text, pos)
}

/// Parse a JSON document, reporting malformed input as Err.
///
/// Checks both halves of "valid": that the parser met nothing it could not read, and that the
/// document ends where the value ends. Trailing junk (`{"a":1} oops`) is not a document with
/// something after it; it is not a document.
pub fn try_parse(text: Str) -> Result<Json> {
    var pos: Vec<Int> = vec()
    pos.push(0)
    pos.push(0)                                   // the error cell
    let v = jp_value(text, pos)
    if jp_failed(pos) { return Result::Err("malformed JSON") }
    jp_ws(text, pos)
    if pos[0] < text.len() { return Result::Err("trailing text after the JSON document") }
    return Result::Ok(v)
}

// ---- accessors ----

/// the value for `key` in an object, or JsNull if absent / not an object.
pub fn field(v: Json, key: Str) -> view Json {
    match v {
        Json::JsObj(es) => {
            var i = 0
            while i < es.len() { if (entry_key(es[i]) == key) { return entry_val(es[i]) }  i = i + 1 }
            return json_null()
        }
        Json::JsNull => { return json_null() }
        Json::JsBool(b) => { return json_null() }
        Json::JsNum(n) => { return json_null() }
        Json::JsStr(s) => { return json_null() }
        Json::JsArr(a) => { return json_null() }
    }
}
// the one JsNull that `field` and `at` hand out for "absent": a view of a global, so it outlives
// every caller and no result of theirs owns anything
global json_null_v: Json
global json_null_ok: Int = 0
pub fn json_null() -> view Json {
    if json_null_ok == 0 { json_null_v = Json::JsNull  json_null_ok = 1 }
    return json_null_v
}
/// the i-th element of an array, or JsNull if out of range / not an array.
pub fn at(v: Json, i: Int) -> view Json {
    match v {
        Json::JsArr(a) => { if i >= 0 { if i < a.len() { return a[i] } }  return json_null() }
        Json::JsNull => { return json_null() }
        Json::JsBool(b) => { return json_null() }
        Json::JsNum(n) => { return json_null() }
        Json::JsStr(s) => { return json_null() }
        Json::JsObj(es) => { return json_null() }
    }
}
/// the number of elements (array) or members (object); 0 for scalars.
pub fn jlen(v: Json) -> Int {
    match v {
        Json::JsArr(a) => { return a.len() }
        Json::JsObj(es) => { return es.len() }
        Json::JsNull => { return 0 }
        Json::JsBool(b) => { return 0 }
        Json::JsNum(n) => { return 0 }
        Json::JsStr(s) => { return 0 }
    }
}

/// the string value, or "" if not a string.
pub fn as_str(v: Json) -> view Str { match v { Json::JsStr(s) => { return s }  Json::JsNull => { return "" }  Json::JsBool(b) => { return "" }  Json::JsNum(n) => { return "" }  Json::JsArr(a) => { return "" }  Json::JsObj(es) => { return "" } } }
/// the number value (Float), or 0.0 if not a number.
pub fn as_num(v: Json) -> Float { match v { Json::JsNum(n) => { return n }  Json::JsNull => { return 0.0 }  Json::JsBool(b) => { return 0.0 }  Json::JsStr(s) => { return 0.0 }  Json::JsArr(a) => { return 0.0 }  Json::JsObj(es) => { return 0.0 } } }
/// the bool value, or false if not a bool.
pub fn as_bool(v: Json) -> Bool { match v { Json::JsBool(b) => { return b }  Json::JsNull => { return false }  Json::JsNum(n) => { return false }  Json::JsStr(s) => { return false }  Json::JsArr(a) => { return false }  Json::JsObj(es) => { return false } } }
/// true if the value is JSON null (or absent, since `get`/`at` return JsNull).
pub fn is_null(v: Json) -> Bool { match v { Json::JsNull => { return true }  Json::JsBool(b) => { return false }  Json::JsNum(n) => { return false }  Json::JsStr(s) => { return false }  Json::JsArr(a) => { return false }  Json::JsObj(es) => { return false } } }

// accessor helpers for Entry (inline `vec[i].field` is rejected, so go through typed params).
/// the key of an object member.
pub fn entry_key(e: Entry) -> view Str { return e.key }
/// the value of an object member.
pub fn entry_val(e: Entry) -> view Json { return e.val }

// ---- serializer ----

/// escape a string for JSON output (quotes, backslash, and control chars).
pub fn js_escape(s: Str) -> Str {
    var out = ""
    var i = 0
    while i < s.len() {
        var c = ord(s.at(i))
        if c == 34 { out = out + chr(92)  out = out + chr(34) }       // \"
        else if c == 92 { out = out + chr(92)  out = out + chr(92) }  // \\
        else if c == 10 { out = out + chr(92)  out = out + chr(110) } // \n
        else if c == 9 { out = out + chr(92)  out = out + chr(116) }  // \t
        else if c == 13 { out = out + chr(92)  out = out + chr(114) } // \r
        else { out = out + chr(c) }
        i = i + 1
    }
    return out
}

/// render a JSON value back to a compact JSON string.
///
/// Numbers go through `std/fmt`'s `float_json`, i.e. the shortest decimal that reads back as the same
/// double, not the language's `"" + n`, which is a six-significant-digit `%g` and rendered
/// `0.25882354378700256` as `0.258824`. With the correctly-rounded reader on the other side, that
/// makes `parse -> stringify -> parse` lossless on the value and a fixed point on the text. An
/// integral number prints without a `.0` (JSON has one number type and so does `Json`), and the
/// three doubles JSON cannot hold (NaN and the two infinities) print as `null`.
pub fn stringify(v: Json) -> Str {
    match v {
        Json::JsNull => { return "null" }
        Json::JsBool(b) => { if b { return "true" }  return "false" }
        Json::JsNum(n) => { return fmt::float_json(n) }
        Json::JsStr(s) => { return chr(34) + (js_escape(s) + chr(34)) }
        Json::JsArr(a) => {
            var out = "["
            var i = 0
            while i < a.len() { if i > 0 { out = out + "," }  out = out + stringify(a[i])  i = i + 1 }
            return out + "]"
        }
        Json::JsObj(es) => {
            var out = "{"
            var i = 0
            while i < es.len() {
                if i > 0 { out = out + "," }
                out = out + (chr(34) + (js_escape(entry_key(es[i])) + (chr(34) + ":")))
                out = out + stringify(entry_val(es[i]))
                i = i + 1
            }
            return out + "}"
        }
    }
}
