//! std/math, mat.nori: Mat3 and Mat4.
//!
//! Convention: **column-major**, matching glam / wgpu / GLSL. A matrix is stored as its columns
//! (`x_axis`, `y_axis`, `z_axis`, `w_axis`), which is also the order `mat4_to_cols_array` writes for
//! a GPU upload: memcpy the array into a uniform buffer and `mat4x4<f32>` reads it unchanged.
//!
//! Vectors are columns and are multiplied on the right: `v' = M * v`. So `mat4_mul(a, b)` applies
//! `b` first and then `a`, and a model-view-projection is `mul(proj, mul(view, model))`. The
//! translation of an affine matrix lives in `w_axis`.
//!
//! Reading an element: `m.<col>_axis.<row>`; `m.w_axis.x` is row 0, column 3, i.e. the x
//! translation. There is no `m[i][j]`; the axis names are the indexing.

pub struct Mat3 { x_axis: Vec3, y_axis: Vec3, z_axis: Vec3 }
pub struct Mat4 { x_axis: Vec4, y_axis: Vec4, z_axis: Vec4, w_axis: Vec4 }

// ---------------- Mat3 construction ----------------
/// a 3x3 from its three columns.
pub fn mat3_from_cols(x: Vec3, y: Vec3, z: Vec3) -> Mat3 { return Mat3 { x_axis: copy x, y_axis: copy y, z_axis: copy z } }
/// the identity.
pub fn mat3_identity() -> Mat3 { return Mat3 { x_axis: vec3_x(), y_axis: vec3_y(), z_axis: vec3_z() } }
/// every element zero.
pub fn mat3_zero() -> Mat3 { return Mat3 { x_axis: vec3_zero(), y_axis: vec3_zero(), z_axis: vec3_zero() } }
/// a diagonal (non-uniform scale) matrix.
pub fn mat3_from_scale(s: Vec3) -> Mat3 { return Mat3 { x_axis: vec3(s.x, 0.0, 0.0), y_axis: vec3(0.0, s.y, 0.0), z_axis: vec3(0.0, 0.0, s.z) } }
/// the upper-left 3x3 of a 4x4: the rotation/scale part, translation dropped.
pub fn mat3_from_mat4(a: Mat4) -> Mat3 { return Mat3 { x_axis: vec4_truncate(a.x_axis), y_axis: vec4_truncate(a.y_axis), z_axis: vec4_truncate(a.z_axis) } }
/// rotation about +X by `r` radians (right-handed: +Y turns toward +Z).
pub fn mat3_from_rotation_x(r: Float) -> Mat3 {
    let c = cos(r)
    let s = sin(r)
    return Mat3 { x_axis: vec3(1.0, 0.0, 0.0), y_axis: vec3(0.0, c, s), z_axis: vec3(0.0, -s, c) }
}
/// rotation about +Y by `r` radians (right-handed: +Z turns toward +X).
pub fn mat3_from_rotation_y(r: Float) -> Mat3 {
    let c = cos(r)
    let s = sin(r)
    return Mat3 { x_axis: vec3(c, 0.0, -s), y_axis: vec3(0.0, 1.0, 0.0), z_axis: vec3(s, 0.0, c) }
}
/// rotation about +Z by `r` radians (right-handed: +X turns toward +Y).
pub fn mat3_from_rotation_z(r: Float) -> Mat3 {
    let c = cos(r)
    let s = sin(r)
    return Mat3 { x_axis: vec3(c, s, 0.0), y_axis: vec3(-s, c, 0.0), z_axis: vec3(0.0, 0.0, 1.0) }
}
/// rotation of `r` radians about a unit `axis` (Rodrigues), right-handed.
pub fn mat3_from_axis_angle(axis: Vec3, r: Float) -> Mat3 {
    let a = vec3_normalize(axis)
    let c = cos(r)
    let s = sin(r)
    let k = 1.0 - c
    return Mat3 {
        x_axis: vec3(c + a.x * a.x * k, a.y * a.x * k + a.z * s, a.z * a.x * k - a.y * s),
        y_axis: vec3(a.x * a.y * k - a.z * s, c + a.y * a.y * k, a.z * a.y * k + a.x * s),
        z_axis: vec3(a.x * a.z * k + a.y * s, a.y * a.z * k - a.x * s, c + a.z * a.z * k) }
}

// ---------------- Mat3 operations ----------------
/// `a * v`: the vector as a column on the right.
pub fn mat3_mul_vec3(a: Mat3, v: Vec3) -> Vec3 { return vec3_add(vec3_add(vec3_scale(a.x_axis, v.x), vec3_scale(a.y_axis, v.y)), vec3_scale(a.z_axis, v.z)) }
/// `a * b`: b is applied first.
pub fn mat3_mul(a: Mat3, b: Mat3) -> Mat3 { return Mat3 { x_axis: mat3_mul_vec3(a, b.x_axis), y_axis: mat3_mul_vec3(a, b.y_axis), z_axis: mat3_mul_vec3(a, b.z_axis) } }
/// every element scaled.
pub fn mat3_scale(a: Mat3, s: Float) -> Mat3 { return Mat3 { x_axis: vec3_scale(a.x_axis, s), y_axis: vec3_scale(a.y_axis, s), z_axis: vec3_scale(a.z_axis, s) } }
/// componentwise sum.
pub fn mat3_add(a: Mat3, b: Mat3) -> Mat3 { return Mat3 { x_axis: vec3_add(a.x_axis, b.x_axis), y_axis: vec3_add(a.y_axis, b.y_axis), z_axis: vec3_add(a.z_axis, b.z_axis) } }
/// rows and columns swapped. For a pure rotation this is also the inverse.
pub fn mat3_transpose(a: Mat3) -> Mat3 { return Mat3 { x_axis: vec3(a.x_axis.x, a.y_axis.x, a.z_axis.x), y_axis: vec3(a.x_axis.y, a.y_axis.y, a.z_axis.y), z_axis: vec3(a.x_axis.z, a.y_axis.z, a.z_axis.z) } }
/// the determinant: the signed volume the unit cube maps to.
pub fn mat3_determinant(a: Mat3) -> Float { return vec3_dot(a.x_axis, vec3_cross(a.y_axis, a.z_axis)) }
/// the inverse, via the adjugate. A singular matrix (|det| < 1e-30) yields the zero matrix rather than trapping.
pub fn mat3_inverse(a: Mat3) -> Mat3 {
    // the adjugate's columns are the cross products of the other two columns: the same identity
    // the determinant above is written with, so this needs no cofactor bookkeeping
    let c0 = vec3_cross(a.y_axis, a.z_axis)
    let c1 = vec3_cross(a.z_axis, a.x_axis)
    let c2 = vec3_cross(a.x_axis, a.y_axis)
    let det = vec3_dot(a.x_axis, c0)
    if fabs(det) < 1.0e-30 { return mat3_zero() }
    let d = 1.0 / det
    // cross-products give the adjugate transposed, so they land as rows
    return Mat3 { x_axis: vec3(c0.x * d, c1.x * d, c2.x * d), y_axis: vec3(c0.y * d, c1.y * d, c2.y * d), z_axis: vec3(c0.z * d, c1.z * d, c2.z * d) }
}
/// the normal matrix: inverse-transpose of the upper-left 3x3.
///
/// Normals do not transform by the model matrix: under a non-uniform scale that tilts them off the
/// surface. This is the matrix that keeps them perpendicular.
pub fn mat3_normal_matrix(a: Mat4) -> Mat3 { return mat3_transpose(mat3_inverse(mat3_from_mat4(a))) }
/// true when every element is within `eps` of the other's.
pub fn mat3_approx_eq(a: Mat3, b: Mat3, eps: Float) -> Bool { return vec3_approx_eq(a.x_axis, b.x_axis, eps) && vec3_approx_eq(a.y_axis, b.y_axis, eps) && vec3_approx_eq(a.z_axis, b.z_axis, eps) }
/// the nine elements in column-major order, ready for a GPU upload.
/// Returns a `Vec<Float>` rather than a fixed-size `[Float]`; it indexes the same way.
pub fn mat3_to_cols_array(a: Mat3) -> Vec<Float> {
    var o: Vec<Float> = vec()
    var z = 0
    while z < 9 { o.push(0.0)  z = z + 1 }
    o[0] = a.x_axis.x  o[1] = a.x_axis.y  o[2] = a.x_axis.z
    o[3] = a.y_axis.x  o[4] = a.y_axis.y  o[5] = a.y_axis.z
    o[6] = a.z_axis.x  o[7] = a.z_axis.y  o[8] = a.z_axis.z
    return o
}

// ---------------- Mat4 construction ----------------
/// a 4x4 from its four columns.
pub fn mat4_from_cols(x: Vec4, y: Vec4, z: Vec4, w: Vec4) -> Mat4 { return Mat4 { x_axis: copy x, y_axis: copy y, z_axis: copy z, w_axis: copy w } }
/// the identity.
pub fn mat4_identity() -> Mat4 { return Mat4 { x_axis: vec4(1.0, 0.0, 0.0, 0.0), y_axis: vec4(0.0, 1.0, 0.0, 0.0), z_axis: vec4(0.0, 0.0, 1.0, 0.0), w_axis: vec4(0.0, 0.0, 0.0, 1.0) } }
/// every element zero.
pub fn mat4_zero() -> Mat4 { return Mat4 { x_axis: vec4_zero(), y_axis: vec4_zero(), z_axis: vec4_zero(), w_axis: vec4_zero() } }
/// a 3x3 lifted into the upper-left of an otherwise identity 4x4.
pub fn mat4_from_mat3(a: Mat3) -> Mat4 { return Mat4 { x_axis: vec3_extend(a.x_axis, 0.0), y_axis: vec3_extend(a.y_axis, 0.0), z_axis: vec3_extend(a.z_axis, 0.0), w_axis: vec4(0.0, 0.0, 0.0, 1.0) } }
/// pure translation.
pub fn mat4_from_translation(t: Vec3) -> Mat4 { return Mat4 { x_axis: vec4(1.0, 0.0, 0.0, 0.0), y_axis: vec4(0.0, 1.0, 0.0, 0.0), z_axis: vec4(0.0, 0.0, 1.0, 0.0), w_axis: vec4(t.x, t.y, t.z, 1.0) } }
/// pure (possibly non-uniform) scale.
pub fn mat4_from_scale(s: Vec3) -> Mat4 { return Mat4 { x_axis: vec4(s.x, 0.0, 0.0, 0.0), y_axis: vec4(0.0, s.y, 0.0, 0.0), z_axis: vec4(0.0, 0.0, s.z, 0.0), w_axis: vec4(0.0, 0.0, 0.0, 1.0) } }
/// rotation about +X by `r` radians.
pub fn mat4_from_rotation_x(r: Float) -> Mat4 { return mat4_from_mat3(mat3_from_rotation_x(r)) }
/// rotation about +Y by `r` radians.
pub fn mat4_from_rotation_y(r: Float) -> Mat4 { return mat4_from_mat3(mat3_from_rotation_y(r)) }
/// rotation about +Z by `r` radians.
pub fn mat4_from_rotation_z(r: Float) -> Mat4 { return mat4_from_mat3(mat3_from_rotation_z(r)) }
/// rotation of `r` radians about a unit `axis`.
pub fn mat4_from_axis_angle(axis: Vec3, r: Float) -> Mat4 { return mat4_from_mat3(mat3_from_axis_angle(axis, r)) }

// ---------------- Mat4 operations ----------------
/// `a * v`: the vector as a column on the right.
pub fn mat4_mul_vec4(a: Mat4, v: Vec4) -> Vec4 { return vec4_add(vec4_add(vec4_scale(a.x_axis, v.x), vec4_scale(a.y_axis, v.y)), vec4_add(vec4_scale(a.z_axis, v.z), vec4_scale(a.w_axis, v.w))) }
/// alias of `mat4_mul_vec4`, spelled the way the transform functions below are.
pub fn mat4_transform_vec4(a: Mat4, v: Vec4) -> Vec4 { return mat4_mul_vec4(a, v) }
/// a point through an affine matrix: w = 1, translation applied, no perspective divide.
pub fn mat4_transform_point3(a: Mat4, p: Vec3) -> Vec3 { return vec4_truncate(mat4_mul_vec4(a, vec3_extend(p, 1.0))) }
/// a direction: w = 0, so translation is ignored.
pub fn mat4_transform_vector3(a: Mat4, v: Vec3) -> Vec3 { return vec4_truncate(mat4_mul_vec4(a, vec3_extend(v, 0.0))) }
/// a point through a projective matrix: w = 1 and then the perspective divide. Use this with a
/// projection or a view-projection, where `mat4_transform_point3` would return an undivided clip point.
pub fn mat4_project_point3(a: Mat4, p: Vec3) -> Vec3 { return vec4_project3(mat4_mul_vec4(a, vec3_extend(p, 1.0))) }
/// `a * b`: b is applied first.
pub fn mat4_mul(a: Mat4, b: Mat4) -> Mat4 { return Mat4 { x_axis: mat4_mul_vec4(a, b.x_axis), y_axis: mat4_mul_vec4(a, b.y_axis), z_axis: mat4_mul_vec4(a, b.z_axis), w_axis: mat4_mul_vec4(a, b.w_axis) } }
/// every element scaled.
pub fn mat4_scale_elems(a: Mat4, s: Float) -> Mat4 { return Mat4 { x_axis: vec4_scale(a.x_axis, s), y_axis: vec4_scale(a.y_axis, s), z_axis: vec4_scale(a.z_axis, s), w_axis: vec4_scale(a.w_axis, s) } }
/// componentwise sum.
pub fn mat4_add(a: Mat4, b: Mat4) -> Mat4 { return Mat4 { x_axis: vec4_add(a.x_axis, b.x_axis), y_axis: vec4_add(a.y_axis, b.y_axis), z_axis: vec4_add(a.z_axis, b.z_axis), w_axis: vec4_add(a.w_axis, b.w_axis) } }
/// rows and columns swapped.
pub fn mat4_transpose(a: Mat4) -> Mat4 {
    return Mat4 {
        x_axis: vec4(a.x_axis.x, a.y_axis.x, a.z_axis.x, a.w_axis.x),
        y_axis: vec4(a.x_axis.y, a.y_axis.y, a.z_axis.y, a.w_axis.y),
        z_axis: vec4(a.x_axis.z, a.y_axis.z, a.z_axis.z, a.w_axis.z),
        w_axis: vec4(a.x_axis.w, a.y_axis.w, a.z_axis.w, a.w_axis.w) }
}
// the twelve 2x2 minors an inverse and a determinant are both built from: `s*` takes its two rows
// from columns x and y, `c*` from columns z and w. Nori has no tuple return, so the two functions
// below each recompute them rather than sharing: twelve multiplies is cheaper than a struct.
/// the determinant, by Laplace expansion over complementary 2x2 minors.
pub fn mat4_determinant(a: Mat4) -> Float {
    let s0 = a.x_axis.x * a.y_axis.y - a.y_axis.x * a.x_axis.y
    let s1 = a.x_axis.x * a.y_axis.z - a.y_axis.x * a.x_axis.z
    let s2 = a.x_axis.x * a.y_axis.w - a.y_axis.x * a.x_axis.w
    let s3 = a.x_axis.y * a.y_axis.z - a.y_axis.y * a.x_axis.z
    let s4 = a.x_axis.y * a.y_axis.w - a.y_axis.y * a.x_axis.w
    let s5 = a.x_axis.z * a.y_axis.w - a.y_axis.z * a.x_axis.w
    let c5 = a.z_axis.z * a.w_axis.w - a.w_axis.z * a.z_axis.w
    let c4 = a.z_axis.y * a.w_axis.w - a.w_axis.y * a.z_axis.w
    let c3 = a.z_axis.y * a.w_axis.z - a.w_axis.y * a.z_axis.z
    let c2 = a.z_axis.x * a.w_axis.w - a.w_axis.x * a.z_axis.w
    let c1 = a.z_axis.x * a.w_axis.z - a.w_axis.x * a.z_axis.z
    let c0 = a.z_axis.x * a.w_axis.y - a.w_axis.x * a.z_axis.y
    return s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0
}
/// the inverse: the adjugate over the same twelve 2x2 minors, divided by the determinant.
///
/// A singular matrix (|det| < 1e-30) yields the zero matrix rather than trapping: a renderer that
/// hands in a degenerate transform gets a value it can test, not a frame of infinities.
pub fn mat4_inverse(a: Mat4) -> Mat4 {
    let s0 = a.x_axis.x * a.y_axis.y - a.y_axis.x * a.x_axis.y
    let s1 = a.x_axis.x * a.y_axis.z - a.y_axis.x * a.x_axis.z
    let s2 = a.x_axis.x * a.y_axis.w - a.y_axis.x * a.x_axis.w
    let s3 = a.x_axis.y * a.y_axis.z - a.y_axis.y * a.x_axis.z
    let s4 = a.x_axis.y * a.y_axis.w - a.y_axis.y * a.x_axis.w
    let s5 = a.x_axis.z * a.y_axis.w - a.y_axis.z * a.x_axis.w
    let c5 = a.z_axis.z * a.w_axis.w - a.w_axis.z * a.z_axis.w
    let c4 = a.z_axis.y * a.w_axis.w - a.w_axis.y * a.z_axis.w
    let c3 = a.z_axis.y * a.w_axis.z - a.w_axis.y * a.z_axis.z
    let c2 = a.z_axis.x * a.w_axis.w - a.w_axis.x * a.z_axis.w
    let c1 = a.z_axis.x * a.w_axis.z - a.w_axis.x * a.z_axis.z
    let c0 = a.z_axis.x * a.w_axis.y - a.w_axis.x * a.z_axis.y
    let det = s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0
    if fabs(det) < 1.0e-30 { return mat4_zero() }
    let d = 1.0 / det
    return Mat4 {
        x_axis: vec4(
            (a.y_axis.y * c5 - a.y_axis.z * c4 + a.y_axis.w * c3) * d,
            (0.0 - a.x_axis.y * c5 + a.x_axis.z * c4 - a.x_axis.w * c3) * d,
            (a.w_axis.y * s5 - a.w_axis.z * s4 + a.w_axis.w * s3) * d,
            (0.0 - a.z_axis.y * s5 + a.z_axis.z * s4 - a.z_axis.w * s3) * d),
        y_axis: vec4(
            (0.0 - a.y_axis.x * c5 + a.y_axis.z * c2 - a.y_axis.w * c1) * d,
            (a.x_axis.x * c5 - a.x_axis.z * c2 + a.x_axis.w * c1) * d,
            (0.0 - a.w_axis.x * s5 + a.w_axis.z * s2 - a.w_axis.w * s1) * d,
            (a.z_axis.x * s5 - a.z_axis.z * s2 + a.z_axis.w * s1) * d),
        z_axis: vec4(
            (a.y_axis.x * c4 - a.y_axis.y * c2 + a.y_axis.w * c0) * d,
            (0.0 - a.x_axis.x * c4 + a.x_axis.y * c2 - a.x_axis.w * c0) * d,
            (a.w_axis.x * s4 - a.w_axis.y * s2 + a.w_axis.w * s0) * d,
            (0.0 - a.z_axis.x * s4 + a.z_axis.y * s2 - a.z_axis.w * s0) * d),
        w_axis: vec4(
            (0.0 - a.y_axis.x * c3 + a.y_axis.y * c1 - a.y_axis.z * c0) * d,
            (a.x_axis.x * c3 - a.x_axis.y * c1 + a.x_axis.z * c0) * d,
            (0.0 - a.w_axis.x * s3 + a.w_axis.y * s1 - a.w_axis.z * s0) * d,
            (a.z_axis.x * s3 - a.z_axis.y * s1 + a.z_axis.z * s0) * d) }
}
/// true when every element is within `eps` of the other's.
pub fn mat4_approx_eq(a: Mat4, b: Mat4, eps: Float) -> Bool { return vec4_approx_eq(a.x_axis, b.x_axis, eps) && vec4_approx_eq(a.y_axis, b.y_axis, eps) && vec4_approx_eq(a.z_axis, b.z_axis, eps) && vec4_approx_eq(a.w_axis, b.w_axis, eps) }
/// the sixteen elements in column-major order: the layout a `mat4x4<f32>` uniform expects.
pub fn mat4_to_cols_array(a: Mat4) -> Vec<Float> {
    var o: Vec<Float> = vec()
    var z = 0
    while z < 16 { o.push(0.0)  z = z + 1 }
    o[0]  = a.x_axis.x  o[1]  = a.x_axis.y  o[2]  = a.x_axis.z  o[3]  = a.x_axis.w
    o[4]  = a.y_axis.x  o[5]  = a.y_axis.y  o[6]  = a.y_axis.z  o[7]  = a.y_axis.w
    o[8]  = a.z_axis.x  o[9]  = a.z_axis.y  o[10] = a.z_axis.z  o[11] = a.z_axis.w
    o[12] = a.w_axis.x  o[13] = a.w_axis.y  o[14] = a.w_axis.z  o[15] = a.w_axis.w
    return o
}
/// a 4x4 from sixteen elements given in column-major order (the inverse of `mat4_to_cols_array`).
pub fn mat4_from_cols_array(o: Vec<Float>) -> Mat4 { return Mat4 { x_axis: vec4(o[0], o[1], o[2], o[3]), y_axis: vec4(o[4], o[5], o[6], o[7]), z_axis: vec4(o[8], o[9], o[10], o[11]), w_axis: vec4(o[12], o[13], o[14], o[15]) } }
