use core::*
import "std/math" as math
import "std/result" as result

// ===========================================================================
// dock chrome layout (draw lists + hit-testing)
//
// Backend-agnostic: produces DrawRect + TextLabel lists and hit-test rects.
// A tab's title is its tab id unless the dock was given a title for it, so
// layout needs no host callback.
// ===========================================================================

/// height of the top menu bar.
pub fn menu_bar_height() -> Float { return 28.0 }
/// height reserved for a toolbar below the menu bar (0 by default).
pub fn toolbar_height() -> Float { return 0.0 }
/// height of a leaf's tab bar.
pub fn dock_tab_bar_height() -> Float { return 30.0 }
/// width of a splitter between panes.
pub fn splitter_width_const() -> Float { return 6.0 }
/// extra hit-test padding around a splitter.
pub fn splitter_hit_extra() -> Float { return 4.0 }

/// one rectangle to draw in the given color.
pub struct DrawRect { rect: Rect, color: Color }

/// one text label to draw. Optional features are gated by `has_*` flags / OptColor;
/// `styled_runs` empty means a single solid color.
pub struct TextLabel {
    left: Float,
    top: Float,
    text: Str,
    has_clip_bounds: Bool,
    clip_bounds: Rect,
    has_font_family: Bool,
    font_family: Str,
    has_font_size: Bool,
    font_size: Float,
    font_bold: Bool,
    font_italic: Bool,
    color: OptColor,
    outline_color: OptColor,
    outline_width_px: Float,
    has_text_gradient: Bool,
    text_gradient: TextGradientFill,
    styled_runs: Vec<StyledTextRun>
}

/// a plain text label at (left, top) with the renderer's default color/font.
pub fn text_label(left: Float, top: Float, text: Str) -> TextLabel {
    var runs: Vec<StyledTextRun> = vec()
    return TextLabel {
        left: left, top: top, text: copy text,
        has_clip_bounds: false, clip_bounds: rect_min_max(vec2_zero(), vec2_zero()),
        has_font_family: false, font_family: "",
        has_font_size: false, font_size: 0.0,
        font_bold: false, font_italic: false,
        color: no_color(), outline_color: no_color(), outline_width_px: 0.0,
        has_text_gradient: false,
        text_gradient: TextGradientFill { from: color_black(), to: color_black(), horizontal: true, bounds: rect_min_max(vec2_zero(), vec2_zero()) },
        styled_runs: runs
    }
}

/// a text label clipped to `clip` (e.g. a tab's text area).
pub fn text_label_clipped(left: Float, top: Float, text: Str, clip: Rect) -> TextLabel {
    var l = text_label(left, top, text)
    l.has_clip_bounds = true
    l.clip_bounds = rect_dup(clip)
    return l
}

// result-list entry structs
/// a menu-bar item's index and rect.
pub struct MenuRect { index: Int, rect: Rect }
/// a tab's (path, index, rect).
pub struct TabRect { path: Vec<Int>, index: Int, rect: Rect }
/// a leaf button's (path, rect).
pub struct LeafBtnRect { path: Vec<Int>, rect: Rect }

/// the full output of layout_dock_ui: draw lists + hit-test rects + splitter infos.
pub struct DockLayoutResult {
    rects: Vec<DrawRect>,
    labels: Vec<TextLabel>,
    splitter_infos: Vec<SplitterInfo>,
    menu_rects: Vec<MenuRect>,
    tab_rects: Vec<TabRect>,
    tab_close_rects: Vec<TabRect>,
    leaf_collapse_rects: Vec<LeafBtnRect>,
    leaf_close_rects: Vec<LeafBtnRect>
}

/// a dock hit-test result. `kind`: -1 none, 0 Menu, 1 Splitter, 2 SplitterExpand,
/// 3 Tab, 4 TabClose, 5 LeafCollapse, 6 LeafClose. `path`/`index` are meaningful per kind.
pub struct DockHit { kind: Int, path: Vec<Int>, index: Int }

/// a "no hit" DockHit.
pub fn dock_hit_none() -> DockHit { var p: Vec<Int> = vec()  return DockHit { kind: -1, path: p, index: 0 } }

/// a tab drop target. `kind`: 0 Append, 1 Split. For Split, `direction`/`new_pane_is_first` apply.
/// kind: 0 = append to the target leaf, 1 = split that leaf, 2 = split the whole surface (an
pub struct TabDropTarget { kind: Int, direction: SplitDirection, new_pane_is_first: Bool }
/// a drop-target resolution: present flag + leaf path + target.
pub struct DropResolve { ok: Bool, path: Vec<Int>, target: TabDropTarget }

/// the content rect (below the tab bar) of the leaf at `path`; ok=false if not a leaf / no height.
pub fn content_rect_for_leaf(tree: Tree, path: Vec<Int>, tab_bar_height: Float) -> RectOpt {
    var rects = tree_leaf_rects(tree)
    var i = 0
    while i < rects.len() {
        if path_eq(rects[i].path, path) {
            var lr = rects[i].rect
            var content_h = math::fmax(lr.height() - tab_bar_height, 0.0)
            if content_h <= 0.0 { return RectOpt { ok: false, rect: rect_min_max(vec2_zero(), vec2_zero()) } }
            return RectOpt { ok: true, rect: rect_min_size(vec2(lr.min.x, lr.min.y + tab_bar_height), vec2(lr.width(), content_h)) }
        }
        i = i + 1
    }
    return RectOpt { ok: false, rect: rect_min_max(vec2_zero(), vec2_zero()) }
}

/// a present flag + rect.
pub struct RectOpt { ok: Bool, rect: Rect }

/// expand a splitter rect horizontally for easier hit-testing.
pub fn splitter_hit_rect(split_rect: Rect) -> Rect {
    var extra = splitter_hit_extra()
    return rect_min_size(vec2(split_rect.min.x - extra, split_rect.min.y), vec2(split_rect.width() + 2.0 * extra, split_rect.height()))
}

// ---- what a right-click on a tab offers ---------------------------------------------------------
//
// This lives in the dock, not in the shell. The tabs are laid out here,
// the tab list lives in `DockState` here, and every one of these verbs is a change to that
// state, so a shell wires a right-click to `dock_tab_menu` and a chosen row to
// `dock_tab_apply`, and gets the same tabs as any other shell using this layout. Putting the
// verbs in an editor would make them that editor's tabs.

/// `term.panel#2` -> `term.panel`; anything without an instance marker is returned unchanged.
///
/// The same rule `plugin/host.nori` resolves ids by, stated in both places: the dock makes
/// these ids and the host resolves them, and the two modules do not import each other. Two lines
/// duplicated is cheaper than a dependency between the layout and the plugin loader, and the `#`
/// marker is fixed by both comments.
pub fn panel_base_id(id: Str) -> Str {
    var i = 0
    while i < id.len() { if ord(id.at(i)) == 35 { return id.slice(0, i) }  i = i + 1 }
    return copy id
}

/// the tab ids in one leaf, in the order they are drawn.
pub fn dock_leaf_tab_ids(state: DockState, surface_index: Int, leaf_path: Vec<Int>) -> Vec<Str> {
    var out: Vec<Str> = vec()
    if surface_index < 0 || surface_index >= state.surfaces.len() { return out }
    if !tree_path_ok(state.surfaces[surface_index].tree, leaf_path) { return out }
    var leaf = tree_view_at(state.surfaces[surface_index].tree, leaf_path)
    match leaf.node {
        Node::NLeaf(l) => { return path_copy_str(ld_tabs(l)) }
        Node::NSplit(sp) => { return out }
        Node::NEmpty => { return out }
    }
}

/// the action string a tab menu row carries.
pub fn DOCK_TAB_CLOSE() -> Str { return "dock/tab/close" }
pub fn DOCK_TAB_CLOSE_OTHERS() -> Str { return "dock/tab/close_others" }
pub fn DOCK_TAB_DUPLICATE() -> Str { return "dock/tab/duplicate" }

/// the rows a right-click on a tab shows.
///
/// `duplicable` comes from the panel's own declaration: a second view of a file tree is a second
/// picture of the same thing, while a second terminal is a second shell. Only the panel knows which
/// it is, so only the panel may offer it.
pub fn dock_tab_menu(ntabs: Int, duplicable: Bool) -> Menu {
    // A `Menu`, not a `Vec<MenuItem>`: that is what `context_menu_open` takes, and handing it a
    // bare Vec would produce a menu with nothing in it rather than a type error anyone could read.
    var m = menu_new("")
    menu_add(m, menu_item("Close", DOCK_TAB_CLOSE()))
    if ntabs > 1 { menu_add(m, menu_item("Close others", DOCK_TAB_CLOSE_OTHERS())) }
    if duplicable {
        menu_add(m, menu_separator())
        menu_add(m, menu_item("Duplicate", DOCK_TAB_DUPLICATE()))
    }
    return m
}

/// the id a duplicate of `id` should take: the next instance nobody is using.
///
/// `term.panel` -> `term.panel#2` -> `term.panel#3`. The number is not a count of anything, it is a
/// name: closing `#2` and duplicating again gives `#2` back, which is what a person expects from
/// something they think of as "another one".
pub fn dock_next_instance(state: DockState, id: Str) -> Str {
    let base = panel_base_id(id)
    var taken = collect_dock_tab_ids_from_state(state)
    var n = 2
    while n < 64 {
        var candidate = base + ("#" + to_str(n))
        var used = false
        var i = 0
        while i < taken.len() { if taken[i] == candidate { used = true }  i = i + 1 }
        if !used { return candidate }
        n = n + 1
    }
    return base + "#64"
}

/// perform a tab menu action. Returns the id of any tab that was created, or "".
///
/// The caller needs that id: a new tab is a panel the host has never rendered, and the shell has to
/// make it the active one so that duplicating something puts you in the copy rather than leaving you
/// looking at the original wondering whether anything happened.
pub fn dock_tab_apply(inout state: DockState, surface_index: Int, leaf_path: Vec<Int>, tab_index: Int, action: Str) -> Str {
    if action == DOCK_TAB_CLOSE() {
        let _r = state.remove_tab_from_leaf(surface_index, leaf_path, tab_index)
        return ""
    }
    if action == DOCK_TAB_CLOSE_OTHERS() {
        // Backward, so the indices ahead of the one being kept do not shift under the loop.
        var ids = dock_leaf_tab_ids(state, surface_index, leaf_path)
        var i = ids.len() - 1
        while i >= 0 {
            if !(i == tab_index) { let _r2 = state.remove_tab_from_leaf(surface_index, leaf_path, i) }
            i = i - 1
        }
        return ""
    }
    if action == DOCK_TAB_DUPLICATE() {
        var ids2 = dock_leaf_tab_ids(state, surface_index, leaf_path)
        if tab_index < 0 || tab_index >= ids2.len() { return "" }
        let fresh = dock_next_instance(state, ids2[tab_index])
        // Beside the one it came from, not at the end of the strip: a copy belongs next to its
        // original, and finding it six tabs away is a small puzzle nobody asked for.
        let _r3 = state.insert_tab_into_leaf(surface_index, leaf_path, tab_index + 1, fresh)
        state.set_leaf_active(surface_index, leaf_path, tab_index + 1)
        return fresh
    }
    return ""
}

/// the font a dock tab's title is drawn in.
pub fn tab_font_size() -> Float { return 14.0 }

/// how wide the close box is, and the smallest tab that can hold one and still show a title.
///
/// Below this a tab is just a title. A close box drawn unconditionally at `tw - 20` would, once
/// tabs were squeezed, sit on top of the name, and the title's clip floored at
/// twelve pixels would cut the name to a letter or two with the `x` printed over it.
/// Nothing is gained by a close box you cannot hit without hitting the tab.
pub fn tab_close_w() -> Float { return 20.0 }
pub fn tab_min_close_w() -> Float { return 84.0 }

/// the width a tab wants: its title, measured, plus padding and room for the close box.
///
/// Measured, not `len * 7`. Seven pixels a character is right for no font and wrong for every one:
/// too wide for `Chat`, too narrow for `Terminal 2`, and the error compounds because this number
/// decides both the width and where the title is clipped.
pub fn tab_width_for(title: Str) -> Float {
    var raw = text_measure_width(title, text_measure_style(tab_font_size())) + 12.0 * 2.0 + tab_close_w()
    return math::fclamp(raw, 60.0, 200.0)
}

/// `title` shortened with an ellipsis until it fits `w` pixels.
///
/// A hard clip cuts a glyph in half and says nothing about what was lost; an ellipsis says the name
/// continues. Walks down a character at a time: a tab title is a few words, and the alternative is
/// a binary search over a measurement that is already cheap.
pub fn tab_title_fit(title: Str, w: Float) -> Str {
    let style = text_measure_style(tab_font_size())
    if text_measure_width(title, style) <= w { return copy title }
    var n = title.len()
    while n > 1 {
        n = n - 1
        // never split a UTF-8 sequence: a half character measures as nothing and draws as a box
        while n > 1 { let b = ord(title.at(n))  if b >= 128 && b < 192 { n = n - 1 } else { n = 0 - (0 - n)  break } }
        let cut = title.slice(0, n) + "…"
        if text_measure_width(cut, style) <= w { return cut }
    }
    return "…"
}

/// lay out the dock chrome for surface `surface_index` at view size (w,h); a tab draws the title the
/// dock was given for its id, or the id itself when it was given none.
/// `exclude_content_fill_tabs`: ids whose panels render custom content (skip the content fill).
pub fn layout_dock_ui(state: DockState, surface_index: Int, view_width: Int, view_height: Int, theme: Theme, hovered_splitter_index: Int, has_hovered_menu: Bool, hovered_menu_index: Int, menu_items: Vec<Str>, exclude_content_fill_tabs: Vec<Str>) -> DockLayoutResult {
    var rects: Vec<DrawRect> = vec()
    var labels: Vec<TextLabel> = vec()
    var menu_rects: Vec<MenuRect> = vec()
    var tab_rects: Vec<TabRect> = vec()
    var tab_close_rects: Vec<TabRect> = vec()
    var leaf_collapse_rects: Vec<LeafBtnRect> = vec()
    var leaf_close_rects: Vec<LeafBtnRect> = vec()
    var w = to_float(view_width)
    var h = to_float(view_height)
    var v = theme.visuals

    rects.push(DrawRect { rect: rect_min_size(vec2_zero(), vec2(w, menu_bar_height())), color: color_dup(v.dock_menu_bar_fill) })
    var menu_x = 8.0
    var mi = 0
    while mi < menu_items.len() {
        var item = menu_items[mi]
        var item_w = math::fmax(to_float(item.len()) * 7.0 + 10.0 * 2.0, 40.0)
        var item_rect = rect_min_size(vec2(menu_x, 0.0), vec2(item_w, menu_bar_height()))
        if has_hovered_menu && hovered_menu_index == mi { rects.push(DrawRect { rect: rect_dup(item_rect), color: color_dup(v.dock_menu_item_hover_fill) }) }
        menu_rects.push(MenuRect { index: mi, rect: item_rect })
        labels.push(text_label(menu_x + 10.0, (menu_bar_height() - 16.0) / 2.0, item))
        menu_x = menu_x + item_w
        mi = mi + 1
    }
    rects.push(DrawRect { rect: rect_min_size(vec2(0.0, menu_bar_height()), vec2(w, 1.0)), color: color_dup(v.dock_menu_bar_border) })

    var dock_y = menu_bar_height() + toolbar_height()
    var dock_h = math::fmax(h - dock_y, 1.0)
    var dock_rect = rect_min_size(vec2(0.0, dock_y), vec2(w, dock_h))
    var splitter_infos = state.layout_surface(surface_index, dock_rect, splitter_width_const())

    if surface_index < 0 || surface_index >= state.surfaces.len() {
        return DockLayoutResult { rects: rects, labels: labels, splitter_infos: splitter_infos, menu_rects: menu_rects, tab_rects: tab_rects, tab_close_rects: tab_close_rects, leaf_collapse_rects: leaf_collapse_rects, leaf_close_rects: leaf_close_rects }
    }
    var tree = state.surfaces[surface_index].tree
    var active_indicator_h = 2.0
    var leaf_buttons_width = 28.0
    var leaf_rects = tree_leaf_rects(tree)
    var li = 0
    while li < leaf_rects.len() {
        var path = leaf_rects[li].path
        var rect = leaf_rects[li].rect
        var leaf_tree = tree_view_at(tree, path)
        var lnode = leaf_tree.node
        if node_is_leaf(lnode) {
                var tabs = node_leaf_tabs(lnode)
                var leaf_active = node_leaf_active(lnode)
                var n = tabs.len()
                var tab_bar_h = dock_tab_bar_height() - active_indicator_h
                var available_for_tabs = math::fmax(rect.width() - leaf_buttons_width, 0.0)
                rects.push(DrawRect { rect: rect_min_size(rect.min, vec2(rect.width(), dock_tab_bar_height())), color: color_dup(v.dock_tab_bar_fill) })
                if n == 0 {
                    var content_h0 = math::fmax(rect.height() - dock_tab_bar_height(), 1.0)
                    rects.push(DrawRect { rect: rect_min_size(vec2(rect.min.x, rect.min.y + dock_tab_bar_height()), vec2(rect.width(), content_h0)), color: color_dup(v.dock_content_fill) })
                } else {
                    var tab_widths: Vec<Float> = vec()
                    var ti = 0
                    var total_tabs_w = 0.0
                    while ti < n { var tw0 = tab_width_for(state.tab_title(tabs[ti]))  tab_widths.push(tw0)  total_tabs_w = total_tabs_w + tw0  ti = ti + 1 }
                    total_tabs_w = total_tabs_w + (to_float(n) - 1.0) * 1.0
                    if total_tabs_w > available_for_tabs && total_tabs_w > 0.0 {
                        var scale = available_for_tabs / total_tabs_w
                        var floor_w = math::fmin(60.0, available_for_tabs / to_float(n))
                        var tj = 0
                        while tj < n { tab_widths[tj] = math::fmax(tab_widths[tj] * scale, floor_w)  tj = tj + 1 }
                    }
                    var active = imin_i(leaf_active, n - 1)
                    var x = rect.min.x
                    var tk = 0
                    while tk < n {
                        var tw = tab_widths[tk]
                        var color = copy v.dock_tab_inactive_fill
                        if tk == active { color = color_dup(v.dock_tab_active_fill) }
                        var tab_rect = rect_min_size(vec2(x, rect.min.y), vec2(tw, tab_bar_h))
                        rects.push(DrawRect { rect: rect_dup(tab_rect), color: color })
                        // No close box on a tab.
                        //
                        // Drawn over the name as soon as tabs are squeezed, and every way of
                        // keeping it costs the thing the tab is for: dropping it on narrow tabs makes
                        // them uncloseable, keeping it eats the title, revealing it on hover hides it
                        // from anyone who has not learned it is there.
                        //
                        // A right-click carries the whole verb set instead (close, close others,
                        // duplicate) at no width, and it is the gesture people already try on a tab.
                        // `dock_tab_menu` is the menu and `dock_tab_apply` performs it, both here in
                        // the dock, so every shell that uses this layout gets the same tabs.
                        var text_right = x + tw - 8.0
                        tab_rects.push(TabRect { path: path_copy(path), index: tk, rect: tab_rect })
                        var title = state.tab_title(tabs[tk])
                        // ...and the title is shortened to what is left, not clipped through a glyph.
                        var avail = math::fmax(text_right - (x + 12.0), 0.0)
                        var shown = tab_title_fit(title, avail)
                        let title_clip = rect_min_max(vec2(x + 12.0, rect.min.y), vec2(math::fmax(text_right, x + 12.0), rect.min.y + tab_bar_h))
                        labels.push(text_label_clipped(x + 12.0, rect.min.y + (tab_bar_h - 16.0) / 2.0, shown, title_clip))
                        x = x + tw + 1.0
                        tk = tk + 1
                    }
                    // active-tab indicator
                    var active_x = rect.min.x
                    var ai = 0
                    while ai < active { active_x = active_x + tab_widths[ai] + 1.0  ai = ai + 1 }
                    var active_w = 0.0
                    if active < tab_widths.len() { active_w = tab_widths[active] }
                    rects.push(DrawRect { rect: rect_min_size(vec2(active_x, rect.min.y + tab_bar_h), vec2(active_w, active_indicator_h)), color: color_dup(v.dock_active_tab_indicator) })

                    // leaf buttons (collapse + close)
                    var leaf_buttons_left = rect.min.x + rect.width() - leaf_buttons_width
                    var collapse_rect = rect_min_size(vec2(leaf_buttons_left, rect.min.y), vec2(14.0, tab_bar_h))
                    var lclose_rect = rect_min_size(vec2(leaf_buttons_left + 14.0, rect.min.y), vec2(14.0, tab_bar_h))
                    leaf_collapse_rects.push(LeafBtnRect { path: path_copy(path), rect: rect_dup(collapse_rect) })
                    leaf_close_rects.push(LeafBtnRect { path: path_copy(path), rect: rect_dup(lclose_rect) })
                    var collapse_glyph = "-"
                    if tree_is_leaf_collapsed(tree, path) { collapse_glyph = ">" }
                    labels.push(text_label(collapse_rect.min.x + (14.0 - 8.0) / 2.0, rect.min.y + (tab_bar_h - 14.0) / 2.0, collapse_glyph))
                    labels.push(text_label(lclose_rect.min.x + (14.0 - 8.0) / 2.0, rect.min.y + (tab_bar_h - 14.0) / 2.0, "x"))
                    // tab bar bottom border + content fill
                    rects.push(DrawRect { rect: rect_min_size(vec2(rect.min.x, rect.min.y + dock_tab_bar_height() - 1.0), vec2(rect.width(), 1.0)), color: color_dup(v.dock_tab_bar_border) })
                    var content_h = math::fmax(rect.height() - dock_tab_bar_height(), 1.0)
                    var active_tab = tabs[0]
                    if active < n { active_tab = tabs[active] }
                    var skip_fill = str_vec_contains(exclude_content_fill_tabs, active_tab)
                    if !skip_fill {
                        rects.push(DrawRect { rect: rect_min_size(vec2(rect.min.x, rect.min.y + dock_tab_bar_height()), vec2(rect.width(), content_h)), color: color_dup(v.dock_content_fill) })
                    }
                }
        }
        li = li + 1
    }

    // splitters.
    //
    // `hovered_splitter_index` is the one splitter under the pointer, or -1. A Bool could only
    // mean "all of them": a dock with three dividers would light every divider the
    // moment the pointer touched any, so the highlight would say nothing about which one a drag would
    // move.
    var si = 0
    while si < splitter_infos.len() {
        var inf = splitter_infos[si]
        var splitter_color = copy v.dock_splitter_fill
        if si == hovered_splitter_index { splitter_color = color_dup(v.dock_splitter_hover_fill) }
        rects.push(DrawRect { rect: rect_dup(inf.splitter_rect), color: splitter_color })
        if !inf.is_collapsed_edge {
            var sr = inf.splitter_rect
            var line_rect = rect_dup(sr)   // scratch: reassigned below, and stored into `rects`, which outlives this loop
            match inf.direction {
                SplitDirection::DirHorizontal => { var cx = sr.min.x + sr.width() / 2.0 - 0.5  line_rect = rect_min_size(vec2(cx, sr.min.y), vec2(1.0, sr.height())) }
                SplitDirection::DirVertical => { var cy = sr.min.y + sr.height() / 2.0 - 0.5  line_rect = rect_min_size(vec2(sr.min.x, cy), vec2(sr.width(), 1.0)) }
            }
            rects.push(DrawRect { rect: line_rect, color: color_dup(v.dock_splitter_center_line) })
        }
        si = si + 1
    }

    return DockLayoutResult { rects: rects, labels: labels, splitter_infos: splitter_infos, menu_rects: menu_rects, tab_rects: tab_rects, tab_close_rects: tab_close_rects, leaf_collapse_rects: leaf_collapse_rects, leaf_close_rects: leaf_close_rects }
}

/// hit-test the dock at `cursor`. Checks menu bar, then leaf close/collapse, tab close/tab, splitter.
pub fn dock_hit_test(cursor: Vec2, menu_rects: Vec<MenuRect>, splitter_infos: Vec<SplitterInfo>, tab_rects: Vec<TabRect>, tab_close_rects: Vec<TabRect>, leaf_collapse_rects: Vec<LeafBtnRect>, leaf_close_rects: Vec<LeafBtnRect>) -> DockHit {
    if cursor.y >= 0.0 && cursor.y < menu_bar_height() {
        var i = 0
        while i < menu_rects.len() { if menu_rects[i].rect.contains(cursor) { return DockHit { kind: 0, path: vec(), index: menu_rects[i].index } }  i = i + 1 }
        return dock_hit_none()
    }
    var i2 = 0
    while i2 < leaf_close_rects.len() { if leaf_close_rects[i2].rect.contains(cursor) { return DockHit { kind: 6, path: path_copy(leaf_close_rects[i2].path), index: 0 } }  i2 = i2 + 1 }
    var i3 = 0
    while i3 < leaf_collapse_rects.len() { if leaf_collapse_rects[i3].rect.contains(cursor) { return DockHit { kind: 5, path: path_copy(leaf_collapse_rects[i3].path), index: 0 } }  i3 = i3 + 1 }
    var i4 = 0
    while i4 < tab_close_rects.len() { if tab_close_rects[i4].rect.contains(cursor) { return DockHit { kind: 4, path: path_copy(tab_close_rects[i4].path), index: tab_close_rects[i4].index } }  i4 = i4 + 1 }
    var i5 = 0
    while i5 < tab_rects.len() { if tab_rects[i5].rect.contains(cursor) { return DockHit { kind: 3, path: path_copy(tab_rects[i5].path), index: tab_rects[i5].index } }  i5 = i5 + 1 }
    var i6 = 0
    while i6 < splitter_infos.len() {
        var inf = splitter_infos[i6]
        if splitter_hit_rect(inf.splitter_rect).contains(cursor) {
            if inf.is_collapsed_edge { return DockHit { kind: 2, path: path_copy(inf.path), index: 0 } }
            return DockHit { kind: 1, path: path_copy(inf.path), index: 0 }
        }
        i6 = i6 + 1
    }
    return dock_hit_none()
}

/// which splitter the cursor is over, as an index into `splitter_infos`, or -1 for none. The same
/// widened hit rect `dock_hit_test` uses, so the splitter that lights up is the one a press takes.
pub fn splitter_index_at(cursor: Vec2, splitter_infos: Vec<SplitterInfo>) -> Int {
    var i = 0
    while i < splitter_infos.len() {
        if splitter_hit_rect(splitter_infos[i].splitter_rect).contains(cursor) { return i }
        i = i + 1
    }
    return -1
}

/// index of the splitter at `path`, or -1, for keeping the one being dragged lit once the pointer
/// has left its rectangle, which it does immediately on any real drag.
pub fn splitter_index_of_path(path: Vec<Int>, splitter_infos: Vec<SplitterInfo>) -> Int {
    var i = 0
    while i < splitter_infos.len() {
        if path_eq(splitter_infos[i].path, path) { return i }
        i = i + 1
    }
    return -1
}

/// how far in from the dock's outer edge a drop docks against the whole surface rather than the leaf
/// under the cursor. Wide enough to aim at, narrow enough that ordinary drops into a panel are
/// unaffected: only a drop pushed against the edge lands here.
pub fn dock_outer_margin() -> Float { return 24.0 }

/// the rectangle the whole surface occupies: the union of its leaves. `layout_tree` fills the dock
/// rect with them, so this is that rect, without having to be told it again.
pub fn dock_bounds(tree: Tree) -> RectOpt {
    var rects = tree_leaf_rects(tree)
    if rects.len() == 0 { return RectOpt { ok: false, rect: rect_min_max(vec2_zero(), vec2_zero()) } }
    var mnx = rects[0].rect.min.x
    var mny = rects[0].rect.min.y
    var mxx = rects[0].rect.max.x
    var mxy = rects[0].rect.max.y
    var i = 1
    while i < rects.len() {
        mnx = math::fmin(mnx, rects[i].rect.min.x)
        mny = math::fmin(mny, rects[i].rect.min.y)
        mxx = math::fmax(mxx, rects[i].rect.max.x)
        mxy = math::fmax(mxy, rects[i].rect.max.y)
        i = i + 1
    }
    return RectOpt { ok: true, rect: rect_min_max(vec2(mnx, mny), vec2(mxx, mxy)) }
}

/// resolve a tab drop target: the outer edge of the dock docks against the whole surface, and
/// anywhere else targets the leaf under the cursor (center=append, quadrants=split).
///
/// The outer edge is why this is not just the leaf scan. Without it every drop splits one leaf, so a
/// panel could take half of a neighbour but could never become a full-height column beside
/// everything: drag a panel to the right-hand edge of a dock whose bottom strip spans the width and
/// the strip stays spanning it, because the dragged panel never entered its row at all. `kind: 2`
/// wraps the whole tree instead, which is the only target that makes every other panel give way.
pub fn resolve_drop_target(cursor: Vec2, tree: Tree) -> DropResolve {
    var half_center = 0.125
    var db = dock_bounds(tree)
    if db.ok {
        var b = db.rect
        var m = dock_outer_margin()
        var np0: Vec<Int> = vec()
        if b.contains(cursor) {
            if cursor.x - b.min.x <= m { return DropResolve { ok: true, path: np0, target: TabDropTarget { kind: 2, direction: SplitDirection::DirHorizontal, new_pane_is_first: true } } }
            if b.max.x - cursor.x <= m { return DropResolve { ok: true, path: np0, target: TabDropTarget { kind: 2, direction: SplitDirection::DirHorizontal, new_pane_is_first: false } } }
            if cursor.y - b.min.y <= m { return DropResolve { ok: true, path: np0, target: TabDropTarget { kind: 2, direction: SplitDirection::DirVertical, new_pane_is_first: true } } }
            if b.max.y - cursor.y <= m { return DropResolve { ok: true, path: np0, target: TabDropTarget { kind: 2, direction: SplitDirection::DirVertical, new_pane_is_first: false } } }
        }
    }
    var rects = tree_leaf_rects(tree)
    var i = 0
    while i < rects.len() {
        var rect = rects[i].rect
        var content_h = math::fmax(rect.height() - dock_tab_bar_height(), 1.0)
        if content_h > 0.0 {
            var content = rect_min_size(vec2(rect.min.x, rect.min.y + dock_tab_bar_height()), vec2(rect.width(), content_h))
            if content.contains(cursor) {
                var rx = (cursor.x - content.min.x) / content.width()
                var ry = (cursor.y - content.min.y) / content.height()
                var ax = rx - 0.5
                var ay = ry - 0.5
                if math::fabs(ax) <= half_center && math::fabs(ay) <= half_center {
                    return DropResolve { ok: true, path: copy rects[i].path, target: TabDropTarget { kind: 0, direction: SplitDirection::DirVertical, new_pane_is_first: false } }
                }
                var d1 = ax - ay > 0.0
                var d2 = (0.0 - ax) - ay > 0.0
                if d1 && d2 { return DropResolve { ok: true, path: copy rects[i].path, target: TabDropTarget { kind: 1, direction: SplitDirection::DirVertical, new_pane_is_first: true } } }
                if !d1 && d2 { return DropResolve { ok: true, path: copy rects[i].path, target: TabDropTarget { kind: 1, direction: SplitDirection::DirHorizontal, new_pane_is_first: true } } }
                if d1 && !d2 { return DropResolve { ok: true, path: copy rects[i].path, target: TabDropTarget { kind: 1, direction: SplitDirection::DirHorizontal, new_pane_is_first: false } } }
                return DropResolve { ok: true, path: copy rects[i].path, target: TabDropTarget { kind: 1, direction: SplitDirection::DirVertical, new_pane_is_first: false } }
            }
        }
        i = i + 1
    }
    var np: Vec<Int> = vec()
    return DropResolve { ok: false, path: np, target: TabDropTarget { kind: 0, direction: SplitDirection::DirVertical, new_pane_is_first: false } }
}

/// the highlight rect for a drop target on the leaf at `path` (for overlay drawing); ok=false if unknown.
pub fn drop_target_highlight(tree: Tree, path: Vec<Int>, target: TabDropTarget) -> RectOpt {
    // an outer-edge drop takes a band down (or across) the whole dock, which is what it will become
    if target.kind == 2 {
        var db = dock_bounds(tree)
        if !db.ok { return RectOpt { ok: false, rect: rect_min_max(vec2_zero(), vec2_zero()) } }
        var b = db.rect
        if split_direction_tag(target.direction) == 0 {
            var hw = b.width() * 0.5
            if target.new_pane_is_first { return RectOpt { ok: true, rect: rect_min_size(b.min, vec2(hw, b.height())) } }
            return RectOpt { ok: true, rect: rect_min_size(vec2(b.min.x + hw, b.min.y), vec2(hw, b.height())) }
        }
        var hh = b.height() * 0.5
        if target.new_pane_is_first { return RectOpt { ok: true, rect: rect_min_size(b.min, vec2(b.width(), hh)) } }
        return RectOpt { ok: true, rect: rect_min_size(vec2(b.min.x, b.min.y + hh), vec2(b.width(), hh)) }
    }
    var rects = tree_leaf_rects(tree)
    var i = 0
    while i < rects.len() {
        if path_eq(rects[i].path, path) {
            var pr = rects[i].rect
            var content_h = math::fmax(pr.height() - dock_tab_bar_height(), 1.0)
            var content = rect_min_size(vec2(pr.min.x, pr.min.y + dock_tab_bar_height()), vec2(pr.width(), content_h))
            if target.kind == 0 { return RectOpt { ok: true, rect: content } }
            var is_h = split_direction_tag(target.direction) == 0
            if is_h {
                var hw = content.width() * 0.5
                if target.new_pane_is_first { return RectOpt { ok: true, rect: rect_min_size(content.min, vec2(hw, content.height())) } }
                return RectOpt { ok: true, rect: rect_min_size(vec2(content.min.x + hw, content.min.y), vec2(hw, content.height())) }
            }
            var hh = content.height() * 0.5
            if target.new_pane_is_first { return RectOpt { ok: true, rect: rect_min_size(content.min, vec2(content.width(), hh)) } }
            return RectOpt { ok: true, rect: rect_min_size(vec2(content.min.x, content.min.y + hh), vec2(content.width(), hh)) }
        }
        i = i + 1
    }
    return RectOpt { ok: false, rect: rect_min_max(vec2_zero(), vec2_zero()) }
}
// ===========================================================================
// dock-drag state helper: the tab-drag state machine a host would otherwise
// hand-roll (begin on a tab press, update to detect a real drag, commit on
// release: re-dock, or report "dropped outside" so the host can tear it off).
// ===========================================================================

pub struct DockDrag { active: Bool, tab: Str, from_path: Vec<Int>, from_index: Int, moved: Bool, press: Vec2 }
/// outcome: 0 = nothing (not an active drag), 1 = re-docked in the tree, 2 = dropped outside any leaf
/// (the tab was removed from the tree; the host should place it, e.g. tear it into a window). `tab` is
/// the moved tab id for outcomes 1 and 2.
pub struct DockDragResult { outcome: Int, tab: Str }

pub fn dock_drag_none() -> DockDrag { var p: Vec<Int> = vec()  return DockDrag { active: false, tab: "", from_path: p, from_index: 0, moved: false, press: vec2_zero() } }

/// begin a tab drag (call when a tab is pressed; `press` is the cursor position at press).
pub fn dock_drag_begin(tab: Str, path: Vec<Int>, index: Int, copy press: Vec2) -> DockDrag {
    return DockDrag { active: true, tab: copy tab, from_path: path_copy(path), from_index: index, moved: false, press: press }
}
/// mark the drag as "really moving" once the cursor leaves a small threshold from the press point.
pub fn dock_drag_update(inout d: DockDrag, cursor: Vec2, threshold: Float) -> DockDrag {
    if d.active { if !d.moved {
        var dx = cursor.x - d.press.x
        var dy = cursor.y - d.press.y
        if dx * dx + dy * dy > threshold * threshold { d.moved = true }
    } }
    return DockDrag { active: d.active, tab: copy d.tab, from_path: path_copy(d.from_path), from_index: d.from_index, moved: d.moved, press: vec2(d.press.x, d.press.y) }
}
/// commit the drag on release: remove the tab from its source leaf (collapsing an emptied leaf),
/// re-lay-out, and re-dock it where the cursor is, or report outcome 2 if the cursor is over no leaf
/// (the tab is removed; the host tears it off). `dock_rect`/`splitter_width` re-lay-out the surface.
pub fn dock_drag_commit(inout ds: DockState, surface_index: Int, d: DockDrag, cursor: Vec2, dock_rect: Rect, splitter_width: Float) -> DockDragResult {
    if !d.active { return DockDragResult { outcome: 0, tab: "" } }
    // a fast drag may never have latched `moved` mid-flight, so also treat the release as a drag if it
    // is far from the press point.
    var dx = cursor.x - d.press.x
    var dy = cursor.y - d.press.y
    if !d.moved { if dx * dx + dy * dy <= 64.0 { return DockDragResult { outcome: 0, tab: "" } } }
    if !ds.remove_tab_from_leaf(surface_index, d.from_path, d.from_index) { return DockDragResult { outcome: 0, tab: "" } }
    if tree_path_ok(ds.surface_tree(surface_index), d.from_path) {
        if node_leaf_tabs(tree_view_at(ds.surface_tree(surface_index), d.from_path).node).len() == 0 { ds.remove_leaf(surface_index, d.from_path) }
    }
    ds.layout_surface(surface_index, dock_rect, splitter_width)
    var dr = resolve_drop_target(cursor, ds.surface_tree(surface_index))
    if dr.ok {
        if dr.target.kind == 0 { ds.insert_tab_into_leaf(surface_index, dr.path, 99999, d.tab) }
        // 0.7 = the existing dock keeps 70%, so the new edge column is a sidebar rather than the
        // larger half. Both split helpers read `ratio` as the old content's share (the new pane gets
        // 1 - ratio, whichever side it is on); the leaf case passes 0.5, where it cannot be told.
        else if dr.target.kind == 2 { ds.split_surface_and_put_tab(surface_index, dr.target.direction, 0.7, dr.target.new_pane_is_first, d.tab) }
        else { ds.split_leaf_and_put_tab(surface_index, dr.path, dr.target.direction, 0.5, dr.target.new_pane_is_first, d.tab) }
        return DockDragResult { outcome: 1, tab: copy d.tab }
    }
    return DockDragResult { outcome: 2, tab: copy d.tab }
}

// ===========================================================================
// Menu-bar dropdowns.
//
// `layout_dock_ui` draws `menu_items: Vec<Str>` across the top, records a `MenuRect`
// per title, highlights `hovered_menu_index`, and `dock_hit_test` reports a click on
// one as `DockHit { kind: 0, index }`. The code below adds the item model, the list
// geometry and the state that make a title open a list.
//
// The open list is emitted through the popup layer of `ComputedOverlay`
// (`pop_prims` / `pop_hits`, flushed by `overlay_flush_popups`) rather than into
// the dock's own `DrawRect`/`TextLabel` lists, for two reasons:
//   * the dock chrome is painted first by a host (`render::dock`) and panel
//     overlays after it, so a list drawn as dock chrome would be painted under
//     the very panels it has to cover;
//   * `merge_clipped_overlay` carries the popup layer through unchanged, so if a
//     host nests this overlay inside a scroll/overflow viewport the list
//     still escapes it, and `overlay_flush_popups` appends it last so
//     `overlay_hit_test`'s backwards walk lets a row beat whatever is beneath.
// ===========================================================================

/// row height of an ordinary menu item.
pub fn menu_row_height() -> Float { return 24.0 }
/// vertical space a separator row occupies (the rule itself is 1px, centred).
pub fn menu_separator_height() -> Float { return 7.0 }
/// padding above the first row and below the last.
pub fn menu_panel_pad() -> Float { return 4.0 }
/// the narrowest an open list may be.
pub fn menu_panel_min_width() -> Float { return 150.0 }
/// left inset of a row's label.
pub fn menu_label_inset() -> Float { return 12.0 }
/// font size of a menu row's label.
pub fn menu_font_size() -> Float { return 14.0 }
/// the `HitRegion.id` every menu row carries, which is how a host tells a menu hit from a panel's.
pub fn menu_hit_id() -> Str { return "menubar" }

/// the hit id a submenu row carries. Distinct from an ordinary row so a click on it can be told
/// apart without re-deriving any geometry, which needs a view size the click handler does not
/// have.
pub fn menu_sub_hit_id() -> Str { return "menubar.sub" }

/// the glyph on a row that opens a submenu.
pub fn menu_submenu_arrow() -> Str { return "›" }
/// label colour of an enabled row.
pub fn menu_text_color() -> Color { return color_rgb(233, 236, 244) }
/// label colour of a disabled row.
pub fn menu_disabled_text_color() -> Color { return color_rgb(120, 120, 130) }
/// colour of a separator's rule.
pub fn menu_separator_color() -> Color { return color_rgb(82, 82, 94) }

/// one row of an open menu. A `separator` row draws a rule and takes no hit; an `enabled: false`
/// row draws dimmed and takes no hit. `action` is the string handed back to the host on a click.
/// One row. `sub` is a nested menu opened by hovering the row, mutually recursive with `Menu`,
/// the same shape the dock's own Tree/Node pair uses, so nesting costs nothing structurally.
///
/// A row has either an action or a submenu. A row that did both would have to decide what a click
/// on it means, and every answer to that is a surprise to somebody.
pub struct MenuItem { label: Str, action: Str, enabled: Bool, separator: Bool, has_sub: Bool, sub: Menu, checkable: Bool, checked: Bool, sticky: Bool }

/// a clickable row.
pub fn menu_item(label: Str, action: Str) -> MenuItem { return MenuItem { label: copy label, action: copy action, enabled: true, separator: false, has_sub: false, sub: menu_empty(), checkable: false, checked: false, sticky: false } }

/// a row that opens `sub` when hovered, drawn with an arrow. Disabled when `sub` is empty: a
/// submenu with nothing in it is a dead end, and drawing an arrow onto one is a small lie.
pub fn menu_submenu(label: Str, sub: Menu) -> MenuItem {
    return MenuItem { label: copy label, action: "", enabled: sub.items.len() > 0, separator: false, has_sub: true, sub: menu_dup(sub), checkable: false, checked: false, sticky: false }
}

/// true if `i` opens a submenu.
pub fn menu_item_has_sub(m: Menu, i: Int) -> Bool {
    if i < 0 || i >= m.items.len() { return false }
    return m.items[i].has_sub
}

/// the submenu on row `i`, or an empty menu.
pub fn menu_item_sub(m: Menu, i: Int) -> view Menu {
    if i < 0 || i >= m.items.len() { return menu_empty() }
    return m.items[i].sub
}
/// a row drawn dimmed and never clickable, for a command that exists but does not apply right now.
pub fn menu_item_disabled(label: Str) -> MenuItem { return MenuItem { label: copy label, action: "", enabled: false, separator: false, has_sub: false, sub: menu_empty(), checkable: false, checked: false, sticky: false } }
/// a horizontal rule between two groups of rows.
/// a row with a tick box: `checked` says whether it is on now.
///
/// Sticky, because a set of checkboxes is a set. A menu that shut on the first tick would make
/// turning three things on three round trips through the same gesture, which is not a filter, it is
/// a punishment. The menu closes on the next click outside it, on Escape, or on an ordinary item.
pub fn menu_check_item(label: Str, action: Str, checked: Bool) -> MenuItem {
    return MenuItem { label: copy label, action: copy action, enabled: true, separator: false, has_sub: false, sub: menu_empty(), checkable: true, checked: checked, sticky: true }
}

/// an ordinary row that does not close the menu: "All", "None", anything that changes the list you
/// are looking at rather than acting and leaving.
pub fn menu_sticky_item(label: Str, action: Str) -> MenuItem {
    return MenuItem { label: copy label, action: copy action, enabled: true, separator: false, has_sub: false, sub: menu_empty(), checkable: false, checked: false, sticky: true }
}

/// does acting on row `i` leave the menu open?
pub fn menu_item_sticky(m: Menu, i: Int) -> Bool {
    if i < 0 || i >= m.items.len() { return false }
    return m.items[i].sticky
}

/// is row `i` ticked?
pub fn menu_item_checked(m: Menu, i: Int) -> Bool {
    if i < 0 || i >= m.items.len() { return false }
    return m.items[i].checked
}

/// the row whose action is `action`, or -1. What a host has after a click: an action string and the
/// need to know whether it came from a sticky row.
pub fn menu_index_of_action(m: Menu, action: Str) -> Int {
    var i = 0
    while i < m.items.len() {
        if m.items[i].action == action && !m.items[i].separator { return i }
        i = i + 1
    }
    return 0 - 1
}

/// does this menu hold a tick box? If so every row is indented to leave the column clear, so labels
/// line up whether or not their own row can be ticked.
pub fn menu_has_checks(m: Menu) -> Bool {
    var i = 0
    while i < m.items.len() { if m.items[i].checkable { return true }  i = i + 1 }
    return false
}

/// the width of the tick column, or 0 for a menu with no tick boxes.
pub fn menu_check_inset(m: Menu) -> Float {
    if menu_has_checks(m) { return 14.0 }
    return 0.0
}

/// the mark a ticked row carries.
pub fn menu_check_mark() -> Str { return "✓" }

pub fn menu_separator() -> MenuItem { return MenuItem { label: "", action: "", enabled: false, separator: true, has_sub: false, sub: menu_empty(), checkable: false, checked: false, sticky: false } }

/// one top-level menu: the title drawn in the bar, plus the rows its list shows.
pub struct Menu { title: Str, items: Vec<MenuItem> }
/// a Menu of its own: every row and submenu copied.
pub fn menu_dup(m: Menu) -> Menu {
    var items: Vec<MenuItem> = vec()
    var i = 0
    while i < m.items.len() { items.push(menu_item_dup(m.items[i]))  i = i + 1 }
    return Menu { title: copy m.title, items: items }
}
/// a MenuItem of its own (its submenu copied with it).
pub fn menu_item_dup(it: MenuItem) -> MenuItem {
    return MenuItem { label: copy it.label, action: copy it.action, enabled: it.enabled, separator: it.separator, has_sub: it.has_sub, sub: menu_dup(it.sub), checkable: it.checkable, checked: it.checked, sticky: it.sticky }
}

/// an empty menu titled `title`.
pub fn menu_new(title: Str) -> Menu { var items: Vec<MenuItem> = vec()  return Menu { title: copy title, items: items } }

/// an empty menu, the "no submenu" value, so MenuItem needs no optional.
pub fn menu_empty() -> Menu { var items: Vec<MenuItem> = vec()  return Menu { title: "", items: items } }
/// append a row to `m`.
pub fn menu_add(inout m: Menu, it: MenuItem) { m.items.push(menu_item_dup(it)) }
/// how many rows a menu has, separators included; the index space `menu_row_rect` uses.
///
/// A Menu could be built but not read back, which is fine while only `menu_emit` consumes one, and not fine
/// the moment a host wants to say "click the row that says Open" without knowing the row height.
pub fn menu_item_count(m: Menu) -> Int { return m.items.len() }

/// the label of row `i`, or "" for a separator or an index off the end.
pub fn menu_item_label(m: Menu, i: Int) -> Str {
    if i < 0 || i >= m.items.len() { return "" }
    if m.items[i].separator { return "" }
    return copy m.items[i].label
}

/// the action of row `i`, or "" for a separator, a disabled row, or an index off the end.
pub fn menu_item_action(m: Menu, i: Int) -> Str {
    if i < 0 || i >= m.items.len() { return "" }
    if m.items[i].separator || !m.items[i].enabled { return "" }
    return copy m.items[i].action
}

/// the bar titles of `menus`, what `layout_dock_ui`'s `menu_items` wants.
pub fn menu_titles(menus: Vec<Menu>) -> Vec<Str> { var t: Vec<Str> = vec()  var i = 0  while i < menus.len() { t.push(copy menus[i].title)  i = i + 1 }  return t }

/// which top-level menu, if any, is open. The whole interaction state of a menu bar.
pub struct MenuBarState { open: Bool, index: Int }

/// a closed menu bar.
pub fn menu_bar_state_new() -> MenuBarState { return MenuBarState { open: false, index: 0 } }
/// close the bar without acting (Escape, a click elsewhere, a window losing focus).
pub fn menu_bar_close(inout st: MenuBarState) { st.open = false }
/// open menu `index`.
pub fn menu_bar_open_at(inout st: MenuBarState, index: Int) { st.open = true  st.index = index }
/// true while a list is showing.
pub fn menu_bar_is_open(st: MenuBarState) -> Bool { return st.open }
/// the open menu's index (meaningless while closed).
pub fn menu_bar_open_index(st: MenuBarState) -> Int { return st.index }

/// the height of `m`'s open list, padding included.
pub fn menu_panel_height(m: Menu) -> Float {
    var h = menu_panel_pad() * 2.0
    var i = 0
    while i < m.items.len() {
        if m.items[i].separator { h = h + menu_separator_height() } else { h = h + menu_row_height() }
        i = i + 1
    }
    return h
}

/// the width of `m`'s open list: the widest label, floored at `menu_panel_min_width()`.
/// Uses a 7px-per-character approximation, so layout here can
/// answer without a font.
pub fn menu_panel_width(m: Menu) -> Float {
    var w = menu_panel_min_width()
    var i = 0
    while i < m.items.len() {
        if !m.items[i].separator {
            // the label, its insets, and, on a row that opens a submenu, room for the arrow, so a
            // long label and an arrow never collide
            var iw = overlay_text_width(m.items[i].label, menu_font_size()) + menu_label_inset() * 2.0 + menu_check_inset(m)
            if m.items[i].has_sub { iw = iw + 16.0 }
            w = math::fmax(w, iw)
        }
        i = i + 1
    }
    return w
}

/// the rect of `m`'s open list, anchored to its bar item.
///
/// It opens downward from the bar item's bottom edge. If the list would run off the bottom of the
/// viewport and there is room above the bar item, it flips up. If there is room in neither
/// direction it stays downward and overflows the bottom, because a list drawn off the top edge is
/// one nothing could ever reach; the dropdown's popup follows the same rule.
/// It is also nudged left so it cannot run off the right edge of the viewport.
pub fn menu_panel_rect(m: Menu, anchor: Rect, view_w: Float, view_h: Float) -> Rect {
    var pw = menu_panel_width(m)
    var ph = menu_panel_height(m)
    var x = anchor.min.x
    if x + pw > view_w { x = math::fmax(view_w - pw, 0.0) }
    var y = anchor.max.y
    if y + ph > view_h && anchor.min.y - ph >= 0.0 { y = anchor.min.y - ph }
    return rect_min_size(vec2(x, y), vec2(pw, ph))
}

/// the rect of row `index` inside `panel`. Separator rows are counted, so an index here is an
/// index into `m.items`.
pub fn menu_row_rect(m: Menu, panel: Rect, index: Int) -> Rect {
    var y = panel.min.y + menu_panel_pad()
    var i = 0
    while i < index {
        if m.items[i].separator { y = y + menu_separator_height() } else { y = y + menu_row_height() }
        i = i + 1
    }
    var rh = menu_row_height()
    if m.items[index].separator { rh = menu_separator_height() }
    return rect_min_size(vec2(panel.min.x, y), vec2(panel.width(), rh))
}

/// the open menu's list, as a `ComputedOverlay` a host renders last (after the dock chrome and
/// after every panel overlay).
///
/// Every primitive and hit goes into the popup layer and is then flushed, so the returned overlay
/// is an ordinary flat list to any painter, with no painter change needed, while keeping the
/// escapes-a-clip / wins-the-hit-test properties the layer exists for.
///
/// Returns an empty overlay when the bar is closed, so a host can build and render it every frame
pub fn menu_overlay(menus: Vec<Menu>, st: MenuBarState, menu_rects: Vec<MenuRect>, theme: Theme, view_w: Float, view_h: Float, has_cursor: Bool, copy cursor: Vec2) -> ComputedOverlay {
    var ids: Vec<Str> = vec()
    var offs: Vec<Float> = vec()
    var out = overlay_new(ids, offs)
    menu_emit(out, menus, st, menu_rects, theme, view_w, view_h, has_cursor, cursor)
    overlay_flush_popups(out)
    return out
}

/// the same list, emitted into an existing overlay's popup layer and left there unflushed, for a
/// host that composes the menu into a document overlay it is already building. This is the form
/// that survives an enclosing clip: `merge_clipped_overlay` copies `pop_prims`/`pop_hits` through
/// unchanged, and the eventual `overlay_flush_popups` puts them last.
pub fn menu_emit(inout out: ComputedOverlay, menus: Vec<Menu>, st: MenuBarState, menu_rects: Vec<MenuRect>, theme: Theme, view_w: Float, view_h: Float, has_cursor: Bool, copy cursor: Vec2) {
    if !st.open { return }
    if st.index < 0 || st.index >= menus.len() { return }
    var anchor = rect_min_size(vec2_zero(), vec2(0.0, menu_bar_height()))
    var found = false
    var ai = 0
    while ai < menu_rects.len() { if menu_rects[ai].index == st.index { anchor = menu_rects[ai].rect  found = true }  ai = ai + 1 }
    if !found { return }
    var m = menus[st.index]
    if m.items.len() == 0 { return }
    var panel = menu_panel_rect(m, anchor, view_w, view_h)
    menu_panel_emit(out, m, panel, theme, has_cursor, cursor)
}

/// paint one open menu into `panel`: the rows, the separators, the hover, the hit regions.
///
/// Shared by the menu bar and by a context menu, which differ only in where the panel is put: under
/// a title in the bar, or at the pointer. Everything after that decision is the same list.
///
/// Into the popup layer, which is what lets a menu escape the clip of whatever it was opened over
/// and be hit-tested before it; see the note on ComputedOverlay's pop_prims.
pub fn menu_panel_emit(inout out: ComputedOverlay, m: Menu, panel: Rect, theme: Theme, has_cursor: Bool, copy cursor: Vec2) {
    var v = theme.visuals
    // Opaque: the panel is what makes the list legible over the dock content it covers.
    out.pop_prims.push(pp_rect(panel, v.dock_menu_bar_fill, 4.0))
    out.pop_prims.push(pp_border(panel, v.dock_menu_bar_border, 1.0))
    var k = 0
    while k < m.items.len() {
        var row = menu_row_rect(m, panel, k)
        if m.items[k].separator {
            var sy = row.min.y + (row.height() - 1.0) / 2.0
            out.pop_prims.push(pp_rect(rect_min_size(vec2(row.min.x + 8.0, sy), vec2(math::fmax(row.width() - 16.0, 0.0), 1.0)), menu_separator_color(), 0.0))
        } else {
            var clickable = m.items[k].enabled && m.items[k].action.len() > 0
            var hoverable = m.items[k].enabled && (clickable || m.items[k].has_sub)
            var tcol = menu_text_color()
            if !m.items[k].enabled { tcol = menu_disabled_text_color() }
            if hoverable && has_cursor && row.contains(cursor) {
                out.pop_prims.push(pp_rect(rect_min_size(vec2(row.min.x + 2.0, row.min.y), vec2(math::fmax(row.width() - 4.0, 0.0), row.height())), v.dock_menu_item_hover_fill, 3.0))
            }
            // The tick column is reserved on every row of a menu that has one, so labels line up
            // whether or not their own row can be ticked, the same reason the tree reserves a
            // chevron column for files that cannot fold.
            let cinset = menu_check_inset(m)
            if m.items[k].checkable && m.items[k].checked {
                out.pop_prims.push(pp_text(vec2(row.min.x + menu_label_inset(), row.min.y + (row.height() - 16.0) / 2.0), menu_check_mark(), tcol, menu_font_size()))
            }
            out.pop_prims.push(pp_text(vec2(row.min.x + menu_label_inset() + cinset, row.min.y + (row.height() - 16.0) / 2.0), m.items[k].label, tcol, menu_font_size()))
            // the arrow that says "there is more this way"
            if m.items[k].has_sub {
                out.pop_prims.push(pp_text(vec2(row.max.x - 14.0, row.min.y + (row.height() - 16.0) / 2.0), menu_submenu_arrow(), tcol, menu_font_size()))
            }
            if clickable { out.pop_hits.push(HitRegion { id: menu_hit_id(), on_click: copy m.items[k].action, rect: rect_dup(row) }) }
            if m.items[k].has_sub && m.items[k].enabled { out.pop_hits.push(HitRegion { id: menu_sub_hit_id(), on_click: "", rect: row }) }
        }
        k = k + 1
    }
}

// ===========================================================================
// Context menus: the same list, opened at the pointer.
//
// A right-click menu is a menu-bar dropdown that is anchored to a point rather
// than to a title. What it adds
// over the bar is only the placement and the lifecycle: it opens where it was
// asked, it closes on the next click anywhere, on Escape, and after choosing.
//
// The host supplies the items when it opens the menu, because only the host
// knows what was right-clicked. This module has no opinion about that: it is
// handed a `Menu` and gives back an action string.
// ===========================================================================

/// an open (or closed) context menu, with the items it was opened on.
///
/// `path` is the chain of expanded submenu rows: empty for just the root, `[3]` while row 3's
/// submenu is showing, `[3, 1]` for a submenu of that. A chain rather than a single index because
/// nesting has no natural depth limit, and the geometry below is the same at every level.
pub struct ContextMenu { open: Bool, at: Vec2, menu: Menu, path: Vec<Int> }

pub fn context_menu_none() -> ContextMenu { var p: Vec<Int> = vec()  return ContextMenu { open: false, at: vec2_zero(), menu: menu_new(""), path: p } }

/// open `m` at `at` (view coordinates). An empty menu opens nothing: a right-click on something
/// with no actions does nothing rather than flash an empty box.
pub fn context_menu_open(inout cm: ContextMenu, copy at: Vec2, m: Menu) {
    if m.items.len() == 0 { cm.open = false  return }
    cm.open = true
    cm.at = at
    cm.menu = menu_dup(m)
    var p: Vec<Int> = vec()
    cm.path = p
}

/// swap the items of an open menu, keeping where it is and how far into its submenus you are.
///
/// What a sticky row needs: ticking a box changes the host's state, so the list has to be rebuilt to
/// show the new tick, and reopening it would move it back to the pointer and collapse any submenu
/// the user had walked into. This is the same menu with new contents.
pub fn context_menu_replace(inout cm: ContextMenu, m: Menu) {
    if !cm.open { return }
    if m.items.len() == 0 { cm.open = false  return }
    cm.menu = menu_dup(m)
}

pub fn context_menu_close(inout cm: ContextMenu) { cm.open = false }
pub fn context_menu_is_open(cm: ContextMenu) -> Bool { return cm.open }

/// where the panel lands: at the pointer, pulled back inside the view when it would not fit.
///
/// The anchor is a zero-height rect at the cursor, so `menu_panel_rect` puts the panel's top edge
/// exactly there and flips it above the pointer near the bottom of the window, the same placement
/// the menu bar gets for free.
pub fn context_menu_rect(cm: ContextMenu, view_w: Float, view_h: Float) -> Rect {
    var anchor = rect_min_size(cm.at, vec2(0.0, 0.0))
    return menu_panel_rect(cm.menu, anchor, view_w, view_h)
}

/// where a submenu goes: beside its parent row, flipped to the other side when it will not fit.
///
/// Top-aligned with the row rather than the panel, which is what makes a chain of submenus read as
/// coming out of the rows you hovered instead of as a stack of panels.
pub fn menu_child_rect(parent: Rect, row: Rect, sub: Menu, view_w: Float, view_h: Float) -> Rect {
    var pw = menu_panel_width(sub)
    var ph = menu_panel_height(sub)
    var x = parent.max.x - 2.0
    if x + pw > view_w { x = math::fmax(parent.min.x - pw + 2.0, 0.0) }
    var y = row.min.y - menu_panel_pad()
    if y + ph > view_h { y = math::fmax(view_h - ph, 0.0) }
    return rect_min_size(vec2(x, y), vec2(pw, ph))
}

/// the panel rect of every level currently showing: [0] is the root, then one per expanded row.
pub fn context_menu_panels(cm: ContextMenu, view_w: Float, view_h: Float) -> Vec<Rect> {
    var out: Vec<Rect> = vec()
    if !cm.open { return out }
    var panel = context_menu_rect(cm, view_w, view_h)
    out.push(rect_dup(panel))
    var m = cm.menu
    var d = 0
    while d < cm.path.len() {
        let idx = cm.path[d]
        if !menu_item_has_sub(m, idx) { return out }
        if menu_item_sub(m, idx).items.len() == 0 { return out }
        let row = menu_row_rect(m, panel, idx)
        panel = menu_child_rect(panel, row, menu_item_sub(m, idx), view_w, view_h)
        out.push(rect_dup(panel))
        m = menu_item_sub(m, idx)
        d = d + 1
    }
    return out
}

/// the menu shown at depth `d`: the root at 0, then down the open path.
pub fn context_menu_at_depth(cm: ContextMenu, d: Int) -> view Menu {
    var m = cm.menu
    var i = 0
    while i < d && i < cm.path.len() {
        m = menu_item_sub(m, cm.path[i])
        i = i + 1
    }
    return m
}

/// follow the pointer: expand the submenu it is resting on, and collapse the levels it has left.
///
/// The rule that matters is what happens when the cursor is over nothing, between two panels or
/// off the menu entirely. The path is left alone, because the gap between a row and its submenu is
/// the space you cross to reach it, and a menu that collapsed there could not be used at
/// all with a mouse that does not move in perfect straight lines.
pub fn context_menu_hover(inout cm: ContextMenu, copy cursor: Vec2, view_w: Float, view_h: Float) {
    if !cm.open { return }
    var panels = context_menu_panels(cm, view_w, view_h)
    var d = panels.len() - 1
    while d >= 0 {
        if panels[d].contains(cursor) {
            var m = context_menu_at_depth(cm, d)
            var hit_row = 0 - 1
            var opens_sub = false
            var k = 0
            while k < m.items.len() {
                let row = menu_row_rect(m, panels[d], k)
                if row.contains(cursor) { hit_row = k  opens_sub = menu_item_has_sub(m, k) && m.items[k].enabled  k = m.items.len() }
                else { k = k + 1 }
            }
            // on the panel but between rows (its padding): leave the path as it is
            if hit_row < 0 { return }
            var np: Vec<Int> = vec()
            var i = 0
            while i < d { np.push(cm.path[i])  i = i + 1 }
            // a row with a submenu expands; any other row on this level collapses whatever
            // was open below it, so moving down a list closes the last one behind you
            if opens_sub { np.push(hit_row) }
            cm.path = np
            return
        }
        d = d - 1
    }
}

/// the overlay for an open context menu; an empty one when it is closed.
pub fn context_menu_overlay(cm: ContextMenu, theme: Theme, view_w: Float, view_h: Float, has_cursor: Bool, copy cursor: Vec2) -> ComputedOverlay {
    var ids: Vec<Str> = vec()
    var offs: Vec<Float> = vec()
    var out = overlay_new(ids, offs)
    if !cm.open { return out }
    var panels = context_menu_panels(cm, view_w, view_h)
    var d = 0
    // deepest last, so its rows are painted over the panel beside them and win the hit test's
    // backwards walk, the same ordering rule the popup layer itself relies on
    while d < panels.len() {
        menu_panel_emit(out, context_menu_at_depth(cm, d), panels[d], theme, has_cursor, cursor)
        d = d + 1
    }
    overlay_flush_popups(out)
    return out
}

/// route a click while a context menu is open.
///
/// `consumed` is true for any click while it is open, including one that lands outside it: that
/// click's job was to dismiss the menu, and letting it also reach whatever is underneath is how a
/// menu ends up selecting something on the way out.
pub fn context_menu_click(inout cm: ContextMenu, ov: ComputedOverlay, copy cursor: Vec2) -> MenuClick {
    if !cm.open { return MenuClick { consumed: false, action: "" } }
    var h = overlay_hit_test(ov, cursor)
    // A click on a row that opens a submenu keeps the menu open. It is the same
    // thing hovering it does, and dismissing there would make a submenu unreachable for anyone who
    // clicks their way down a menu rather than hovering.
    if h.id == menu_sub_hit_id() { return MenuClick { consumed: true, action: "" } }
    // A sticky row acts and stays. Ticking one box out of five should not be five gestures, so a
    // checkbox row, and anything else the host marked sticky, an "All" or a "None", reports its
    // action with the menu still open. Every other row closes the menu.
    if h.id == menu_hit_id() {
        let si = menu_index_of_action(cm.menu, h.on_click)
        if menu_item_sticky(cm.menu, si) { return MenuClick { consumed: true, action: sink h.on_click } }
        cm.open = false
        return MenuClick { consumed: true, action: sink h.on_click }
    }
    cm.open = false
    return MenuClick { consumed: true, action: "" }
}

/// what a mouse press did to the menu bar. `consumed` means the bar took the click and the host
/// must not also offer it to the dock or a panel; `action` is the acted item's string ("" if none).
pub struct MenuClick { consumed: Bool, action: Str }

/// route a mouse press at `cursor` through the menu bar, given the overlay `menu_overlay` produced
/// for this frame.
///
/// Order is the behaviour: an open list is tested first (its rows sit over the dock), then the bar
/// itself (the open menu's own title toggles it shut, another title switches to it), and finally
/// any other click closes an open menu without acting. A press with nothing open and nothing on
/// the bar is not consumed, so the host's normal dock/panel routing runs unchanged.
pub fn menu_bar_click(inout st: MenuBarState, menus: Vec<Menu>, menu_rects: Vec<MenuRect>, ov: ComputedOverlay, copy cursor: Vec2) -> MenuClick {
    if st.open {
        var h = overlay_hit_test(ov, cursor)
        if h.id == menu_hit_id() {
            st.open = false
            return MenuClick { consumed: true, action: sink h.on_click }
        }
    }
    var i = 0
    while i < menu_rects.len() {
        if menu_rects[i].rect.contains(cursor) {
            if st.open && st.index == menu_rects[i].index { st.open = false }
            else { st.open = true  st.index = menu_rects[i].index }
            return MenuClick { consumed: true, action: "" }
        }
        i = i + 1
    }
    if st.open { st.open = false  return MenuClick { consumed: true, action: "" } }
    return MenuClick { consumed: false, action: "" }
}

/// the index of the bar item under `cursor`, or -1. Feeds `layout_dock_ui`'s hover highlight.
pub fn menu_bar_index_at(menu_rects: Vec<MenuRect>, copy cursor: Vec2) -> Int {
    var i = 0
    while i < menu_rects.len() { if menu_rects[i].rect.contains(cursor) { return menu_rects[i].index }  i = i + 1 }
    return -1
}

/// move an open menu to whatever bar item the pointer is over, which makes a row of menus feel
/// like one menu bar rather than N independent dropdowns. A no-op while the bar is closed, so a
/// host can call it every frame with the current cursor.
pub fn menu_bar_hover(inout st: MenuBarState, menu_rects: Vec<MenuRect>, copy cursor: Vec2) {
    if !st.open { return }
    var idx = menu_bar_index_at(menu_rects, cursor)
    if idx >= 0 { st.index = idx }
}
