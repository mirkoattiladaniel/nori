/// merge `ovr` on top of `base` with field-level precision: each set field in `ovr` overrides,
/// unset fields leave `base` intact.
pub fn node_style_apply_over(base: NodeStyle, ovr: NodeStyle) -> NodeStyle {
    var acc = node_style_dup(base)
    node_style_apply_in(acc, ovr)
    return acc
}
/// node_style_apply_over in place: `ovr`'s set fields written over `acc`'s.
pub fn node_style_apply_in(inout acc: NodeStyle, ovr: NodeStyle) {
    if ovr.has_bg { acc.bg = ovr.bg  acc.has_bg = true }
    if ovr.has_text_color { acc.text_color = ovr.text_color  acc.has_text_color = true }
    if ovr.has_color { acc.color = ovr.color  acc.has_color = true }
    if ovr.has_border_color { acc.border_color = ovr.border_color  acc.has_border_color = true }
    if ovr.has_size_px { acc.size_px = ovr.size_px  acc.has_size_px = true }
    if ovr.has_radius { acc.radius = ovr.radius  acc.has_radius = true }
    if ovr.has_padding { acc.padding = ovr.padding  acc.has_padding = true }
    if ovr.has_border_w { acc.border_w = ovr.border_w  acc.has_border_w = true }
    if ovr.has_line_height_mult { acc.line_height_mult = ovr.line_height_mult  acc.has_line_height_mult = true }
    if ovr.has_letter_spacing { acc.letter_spacing = ovr.letter_spacing  acc.has_letter_spacing = true }
    if ovr.has_word_spacing { acc.word_spacing = ovr.word_spacing  acc.has_word_spacing = true }
    if ovr.has_max_width { acc.max_width = ovr.max_width  acc.has_max_width = true }
    if ovr.has_min_height { acc.min_height = ovr.min_height  acc.has_min_height = true }
    if ovr.has_font_bold { acc.font_bold = ovr.font_bold  acc.has_font_bold = true }
    if ovr.has_font_italic { acc.font_italic = ovr.font_italic  acc.has_font_italic = true }
    if ovr.has_wrap { acc.wrap = ovr.wrap  acc.has_wrap = true }
    if ovr.has_wrap_hard_break { acc.wrap_hard_break = ovr.wrap_hard_break  acc.has_wrap_hard_break = true }
    if ovr.has_line_clamp { acc.line_clamp = ovr.line_clamp  acc.has_line_clamp = true }
    if ovr.has_text_overflow { acc.text_overflow = ovr.text_overflow  acc.has_text_overflow = true }
    if ovr.has_text_transform { acc.text_transform = ovr.text_transform  acc.has_text_transform = true }
    if ovr.has_text_decoration { acc.text_decoration = ovr.text_decoration  acc.has_text_decoration = true }
    if ovr.has_overflow_x { acc.overflow_x = ovr.overflow_x  acc.has_overflow_x = true }
    if ovr.has_overflow_y { acc.overflow_y = ovr.overflow_y  acc.has_overflow_y = true }
    if ovr.has_position { acc.position = ovr.position  acc.has_position = true }
    if ovr.has_z_index { acc.z_index = ovr.z_index  acc.has_z_index = true }
    if ovr.has_top { acc.top = ovr.top  acc.has_top = true }
    if ovr.has_right { acc.right = ovr.right  acc.has_right = true }
    if ovr.has_bottom { acc.bottom = ovr.bottom  acc.has_bottom = true }
    if ovr.has_left { acc.left = ovr.left  acc.has_left = true }
    if ovr.has_hover_bg { acc.hover_bg = ovr.hover_bg  acc.has_hover_bg = true }
    if ovr.has_hover_border_color { acc.hover_border_color = ovr.hover_border_color  acc.has_hover_border_color = true }
    if ovr.has_hover_text_color { acc.hover_text_color = ovr.hover_text_color  acc.has_hover_text_color = true }
    if ovr.has_active_bg { acc.active_bg = ovr.active_bg  acc.has_active_bg = true }
    if ovr.has_opacity { acc.opacity = ovr.opacity  acc.has_opacity = true }
    if ovr.has_translate_x { acc.translate_x = ovr.translate_x  acc.has_translate_x = true }
    if ovr.has_translate_y { acc.translate_y = ovr.translate_y  acc.has_translate_y = true }
    if ovr.has_scale_x { acc.scale_x = ovr.scale_x  acc.has_scale_x = true }
    if ovr.has_scale_y { acc.scale_y = ovr.scale_y  acc.has_scale_y = true }
    if ovr.has_w { acc.w_unit = ovr.w_unit  acc.w_val = ovr.w_val  acc.has_w = true }
    if ovr.has_h { acc.h_unit = ovr.h_unit  acc.h_val = ovr.h_val  acc.has_h = true }
    if ovr.has_gap { acc.gap = ovr.gap  acc.has_gap = true }
    if ovr.has_text_dir { acc.text_dir = ovr.text_dir  acc.has_text_dir = true }
    if ovr.has_lang { acc.lang = copy ovr.lang  acc.has_lang = true }
    if ovr.has_text_align { acc.text_align = ovr.text_align  acc.align_x = ovr.align_x  acc.has_text_align = true }
    if ovr.has_font_family { acc.font_family = copy ovr.font_family  acc.has_font_family = true }
    if ovr.has_font_weight { acc.font_weight = ovr.font_weight  acc.has_font_weight = true }
    if ovr.has_font_slant { acc.font_slant = ovr.font_slant  acc.has_font_slant = true }
    if ovr.has_bg_to { acc.bg_to = ovr.bg_to  acc.has_bg_to = true }
    if ovr.has_bg_vertical { acc.bg_vertical = ovr.bg_vertical  acc.has_bg_vertical = true }
    if ovr.has_shadow_color { acc.shadow_color = ovr.shadow_color  acc.has_shadow_color = true }
    if ovr.has_shadow_blur { acc.shadow_blur = ovr.shadow_blur  acc.has_shadow_blur = true }
    if ovr.has_shadow_spread { acc.shadow_spread = ovr.shadow_spread  acc.has_shadow_spread = true }
    if ovr.has_shadow_x { acc.shadow_x = ovr.shadow_x  acc.has_shadow_x = true }
    if ovr.has_shadow_y { acc.shadow_y = ovr.shadow_y  acc.has_shadow_y = true }
}

// ---- stylesheet: tag rules + class rules (parallel Vecs) ----

/// tag rules (`"button"`/`"text"`/`"rect"`/`"surface"`) + class rules (any name).
pub struct OverlayStyleSheet {
    tag_keys: Vec<Str>
    tag_styles: Vec<NodeStyle>
    class_keys: Vec<Str>
    class_styles: Vec<NodeStyle>
}

/// an empty stylesheet.
pub fn stylesheet_new() -> OverlayStyleSheet {
    var tk: Vec<Str> = vec()
    var ts: Vec<NodeStyle> = vec()
    var ck: Vec<Str> = vec()
    var cs: Vec<NodeStyle> = vec()
    return OverlayStyleSheet { tag_keys: tk, tag_styles: ts, class_keys: ck, class_styles: cs }
}

/// index of `k` in `keys`, or -1.
fn sheet_find_idx(keys: Vec<Str>, k: Str) -> Int {
    var i = 0
    while i < keys.len() { if keys[i] == k { return i }  i = i + 1 }
    return 0 - 1
}

/// merge `style` into the tag rule `tag` (field-level; inserts wholesale when new).
pub fn sheet_merge_tag(inout sheet: OverlayStyleSheet, tag: Str, style: NodeStyle) {
    var idx = sheet_find_idx(sheet.tag_keys, tag)
    if idx >= 0 { var ts = inout sheet.tag_styles  ts[idx] = node_style_apply_over(ts[idx], style) }
    else { sheet.tag_keys.push(copy tag)  sheet.tag_styles.push(node_style_dup(style)) }
}

/// merge `style` into the class rule `cls` (field-level; inserts wholesale when new).
pub fn sheet_merge_class(inout sheet: OverlayStyleSheet, cls: Str, style: NodeStyle) {
    var idx = sheet_find_idx(sheet.class_keys, cls)
    if idx >= 0 { var cs = inout sheet.class_styles  cs[idx] = node_style_apply_over(cs[idx], style) }
    else { sheet.class_keys.push(copy cls)  sheet.class_styles.push(node_style_dup(style)) }
}

/// true if a rule exists for tag `tag`.
pub fn sheet_has_tag(sheet: OverlayStyleSheet, tag: Str) -> Bool { return sheet_find_idx(sheet.tag_keys, tag) >= 0 }
/// the tag rule (or an empty NodeStyle when absent).
pub fn sheet_tag(sheet: OverlayStyleSheet, tag: Str) -> NodeStyle {
    var i = sheet_find_idx(sheet.tag_keys, tag)
    if i < 0 { return node_style_empty() }
    return node_style_dup(sheet.tag_styles[i])
}
/// true if a rule exists for class `cls`.
pub fn sheet_has_class(sheet: OverlayStyleSheet, cls: Str) -> Bool { return sheet_find_idx(sheet.class_keys, cls) >= 0 }
/// the class rule (or an empty NodeStyle when absent).
pub fn sheet_class(sheet: OverlayStyleSheet, cls: Str) -> NodeStyle {
    var i = sheet_find_idx(sheet.class_keys, cls)
    if i < 0 { return node_style_empty() }
    return node_style_dup(sheet.class_styles[i])
}

/// merge every rule of `ovr` on top of `base` (field-level).
pub fn stylesheet_merge_over(inout base: OverlayStyleSheet, ovr: OverlayStyleSheet) {
    var i = 0
    while i < ovr.tag_keys.len() { sheet_merge_tag(base, ovr.tag_keys[i], ovr.tag_styles[i])  i = i + 1 }
    var j = 0
    while j < ovr.class_keys.len() { sheet_merge_class(base, ovr.class_keys[j], ovr.class_styles[j])  j = j + 1 }
}

/// cascade a node's style: start empty, apply the tag rule, then each class rule in order (later
/// classes win). Overflow/text/box props all resolve through this.
pub fn resolve_node_style(sheet: OverlayStyleSheet, tag: Str, classes: Vec<Str>) -> NodeStyle {
    var acc = node_style_empty()
    // the rules are read where they are (sheet_tag / sheet_class would copy each one first): this
    // runs for every node of an immediate document on every frame
    let ti = sheet_find_idx(sheet.tag_keys, tag)
    if ti >= 0 { node_style_apply_in(acc, sheet.tag_styles[ti]) }
    var i = 0
    while i < classes.len() {
        let ci = sheet_find_idx(sheet.class_keys, classes[i])
        if ci >= 0 { node_style_apply_in(acc, sheet.class_styles[ci]) }
        i = i + 1
    }
    return acc
}

/// resolve a text node's rendered content + box from a cascaded NodeStyle, using the given
/// defaults for any unset size/line-height. Pulls size/wrap/hard_break/line_clamp/text_overflow/
/// transform/max_width/min_height straight into text_render_content_and_metrics.
pub fn text_layout_from_style(style: NodeStyle, text: Str, available_w: Float, default_size: Float, default_lh_mult: Float) -> TextLayout {
    var size = default_size
    if style.has_size_px { size = style.size_px }
    var lh = default_lh_mult
    if style.has_line_height_mult { lh = style.line_height_mult }
    var max_w = 0.0
    if style.has_max_width { max_w = style.max_width }
    var min_h = 0.0
    if style.has_min_height { min_h = style.min_height }
    var wrap = false
    if style.has_wrap { wrap = style.wrap }
    var hard = false
    if style.has_wrap_hard_break { hard = style.wrap_hard_break }
    var clamp = 0
    if style.has_line_clamp { clamp = style.line_clamp }
    var ellipsis = false
    if style.has_text_overflow { ellipsis = style.text_overflow == 1 }
    var transform = 0
    if style.has_text_transform { transform = style.text_transform }
    var ls = 0.0
    if style.has_letter_spacing { ls = style.letter_spacing }
    var ws = 0.0
    if style.has_word_spacing { ws = style.word_spacing }
    return text_render_content_and_metrics_sp(text, available_w, max_w, size, wrap, hard, clamp, ellipsis, transform, lh, min_h, ls, ws)
}
