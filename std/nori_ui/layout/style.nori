use core::*
import "std/math" as math
import "std/result" as result

// ===========================================================================
// the overlay stylesheet cascade (core subset).
//
// NodeStyle (optional per-node visual props), OverlayStyleSheet (tag + class
// rules), the field-level merge (apply_over / merge_over) and the tag->classes
// cascade (resolve). NodeStyle covers the common visual + text-layout subset
// that the paint/text code consumes. Each optional field is a `has_x: Bool`
// flag + an `x` value (Nori has no Option<struct>); OverlayStyleSheet stores
// rules in parallel Vecs because Map<struct> field-access is unsupported.
// ===========================================================================

/// optional per-node visual props; an unset field (has_* == false) does not override during merge.
/// text_overflow: 0 clip / 1 ellipsis. text_transform/text_decoration use the tt_*/td_* constants.
pub struct NodeStyle {
    has_bg: Bool                bg: Int
    has_text_color: Bool        text_color: Int
    has_color: Bool             color: Int
    has_border_color: Bool      border_color: Int
    has_size_px: Bool           size_px: Float
    has_radius: Bool            radius: Float
    has_padding: Bool           padding: Float
    has_border_w: Bool          border_w: Float
    has_line_height_mult: Bool  line_height_mult: Float
    has_letter_spacing: Bool    letter_spacing: Float
    has_word_spacing: Bool      word_spacing: Float
    has_max_width: Bool         max_width: Float
    has_min_height: Bool        min_height: Float
    has_font_bold: Bool         font_bold: Bool
    has_font_italic: Bool       font_italic: Bool
    has_wrap: Bool               wrap: Bool
    has_wrap_hard_break: Bool   wrap_hard_break: Bool
    has_line_clamp: Bool        line_clamp: Int
    has_text_overflow: Bool     text_overflow: Int
    has_text_transform: Bool    text_transform: Int
    has_text_decoration: Bool   text_decoration: Int
    has_overflow_x: Bool        overflow_x: Int
    has_overflow_y: Bool        overflow_y: Int
    has_position: Bool          position: Int
    has_z_index: Bool           z_index: Int
    has_top: Bool               top: Float
    has_right: Bool             right: Float
    has_bottom: Bool            bottom: Float
    has_left: Bool              left: Float
    has_hover_bg: Bool          hover_bg: Int
    has_hover_border_color: Bool hover_border_color: Int
    has_hover_text_color: Bool  hover_text_color: Int
    has_active_bg: Bool         active_bg: Int
    // ---- the customization language's additions (retained documents animate these) ----
    has_opacity: Bool = false       opacity: Float = 1.0
    has_translate_x: Bool = false   translate_x: Float = 0.0
    has_translate_y: Bool = false   translate_y: Float = 0.0
    has_scale_x: Bool = false       scale_x: Float = 1.0
    has_scale_y: Bool = false       scale_y: Float = 1.0
    has_w: Bool = false             w_unit: Int = 0          w_val: Float = 0.0
    has_h: Bool = false             h_unit: Int = 0          h_val: Float = 0.0
    has_gap: Bool = false           gap: Float = 0.0
    // ---- text in every script ----
    has_text_dir: Bool = false      text_dir: Int = 2
    has_lang: Bool = false          lang: Str = ""
    has_text_align: Bool = false    text_align: Int = 0      align_x: Float = 0.0
    has_font_family: Bool = false   font_family: Str = ""
    has_font_weight: Bool = false   font_weight: Int = 0
    has_font_slant: Bool = false    font_slant: Int = 0
    // ---- a background that is a gradient: `bg` to `bg_to`, left to right (`bg_vertical`: top to bottom) ----
    has_bg_to: Bool = false         bg_to: Int = 0
    has_bg_vertical: Bool = false   bg_vertical: Bool = false
    // ---- a shadow: under a box (outside it, as CSS box-shadow), or behind a text's glyphs ----
    has_shadow_color: Bool = false  shadow_color: Int = 0
    has_shadow_blur: Bool = false   shadow_blur: Float = 0.0
    has_shadow_spread: Bool = false shadow_spread: Float = 0.0
    has_shadow_x: Bool = false      shadow_x: Float = 0.0
    has_shadow_y: Bool = false      shadow_y: Float = 0.0
}

// position modes: 0 relative (in flow), 1 absolute (out of flow, placed against
// the parent's padded rect via top/right/bottom/left), 2 overlay (absolute; hosts may float it above).
pub fn pm_relative() -> Int { return 0 }
pub fn pm_absolute() -> Int { return 1 }
pub fn pm_overlay() -> Int { return 2 }

// overflow modes (match core OverflowMode order: Visible/Hidden/Auto/Scroll), stored as Int since
// NodeStyle is a copy struct (enums aren't copyable). Bridge to core via overflow_mode_of.
pub fn om_visible() -> Int { return 0 }
pub fn om_hidden() -> Int { return 1 }
pub fn om_auto() -> Int { return 2 }
pub fn om_scroll() -> Int { return 3 }
/// convert a stored overflow Int to the core OverflowMode enum.
pub fn overflow_mode_of(v: Int) -> OverflowMode {
    if v == 1 { return OverflowMode::OvHidden }
    if v == 2 { return OverflowMode::OvAuto }
    if v == 3 { return OverflowMode::OvScroll }
    return OverflowMode::OvVisible
}

/// an empty NodeStyle (every field unset).
pub fn node_style_empty() -> NodeStyle {
    return NodeStyle {
        has_bg: false, bg: rgba_transparent(),
        has_text_color: false, text_color: rgba_transparent(),
        has_color: false, color: rgba_transparent(),
        has_border_color: false, border_color: rgba_transparent(),
        has_size_px: false, size_px: 0.0,
        has_radius: false, radius: 0.0,
        has_padding: false, padding: 0.0,
        has_border_w: false, border_w: 0.0,
        has_line_height_mult: false, line_height_mult: 0.0,
        has_letter_spacing: false, letter_spacing: 0.0,
        has_word_spacing: false, word_spacing: 0.0,
        has_max_width: false, max_width: 0.0,
        has_min_height: false, min_height: 0.0,
        has_font_bold: false, font_bold: false,
        has_font_italic: false, font_italic: false,
        has_wrap: false, wrap: false,
        has_wrap_hard_break: false, wrap_hard_break: false,
        has_line_clamp: false, line_clamp: 0,
        has_text_overflow: false, text_overflow: 0,
        has_text_transform: false, text_transform: 0,
        has_text_decoration: false, text_decoration: 0,
        has_overflow_x: false, overflow_x: 0,
        has_overflow_y: false, overflow_y: 0,
        has_position: false, position: 0,
        has_z_index: false, z_index: 0,
        has_top: false, top: 0.0,
        has_right: false, right: 0.0,
        has_bottom: false, bottom: 0.0,
        has_left: false, left: 0.0,
        has_hover_bg: false, hover_bg: rgba_transparent(),
        has_hover_border_color: false, hover_border_color: rgba_transparent(),
        has_hover_text_color: false, hover_text_color: rgba_transparent(),
        has_active_bg: false, active_bg: rgba_transparent()
    }
}

