// std/nori_ui/paint_gpu/__native_ui_gpu.nori: the `ui_gpu_*` seam of ui_gpu.nori, in Nori, for a program
// built with `noric --build --native` (linked when the program uses a `ui_gpu_*` symbol; see std/native_seams).
// It draws what ui_gpu_glue.c draws (the same WGSL, pipelines, instance layouts, batching cuts and
// readbacks) through the same wgpu-native C API, called with no C in between.
//
// The `__` prefix keeps this file out of what `import "std/nori_ui"` gathers from the directory. It is a
// runtime-floor module, built with `--runtime --cfg native` and linked beside the native runtime.
//
// libwgpu_native.so (wgpu_native.dll on Windows) is opened when the first canvas is made, found the way
// the system's loader finds any library (LD_LIBRARY_PATH or the executable's directory and PATH). Without it a canvas is made
// with no device, and `ui_gpu_ok` answers 0, which is what ui_gpu_glue.c answers on a machine with no GPU and
// what ui_gpu_absent.c always answers, so a CPU-only program needs neither the library nor a flag.
// Every wgpu function is called through a `CFn` pointer of its C signature; the three callback-info
// structs travel by value, and the callbacks are `cfn_addr` entries.
//
// On Linux windowed canvases answer like a machine with no GPU. A wgpu surface is made from an Xlib
// `Display*` or a libwayland `wl_display*`/`wl_surface*`, and std/window's native backends speak X11 and
// Wayland over their sockets without either library, so they hold no such object to hand over. On
// Windows a window is an HWND, which is all a surface needs: those canvases draw and present.

extern fn malloc(Int) -> Int
extern fn calloc(Int, Int) -> Int
extern fn realloc(Int, Int) -> Int
extern fn free(Int)
extern fn memcpy(Int, Int, Int) -> Int
extern fn memset(Int, Int, Int) -> Int
extern fn write(Int, Int, Int) -> Int
extern fn nori_cstr(Int) -> Int
extern fn nori_str_ptr(Int) -> Int
// the loader: dlopen on Linux, LoadLibraryA on Windows (wgpu_native.dll beside the executable or on PATH)
cfg(linux) {
extern fn dlopen(Int, Int) -> Int from "libc.so.6"
extern fn dlsym(Int, Int) -> Int from "libc.so.6"
fn ngu_lib_name() -> Str { return "libwgpu_native.so" }
fn ngu_open(path: Int) -> Int { var h = 0  unsafe { h = dlopen(path, 2) }  return h }   // RTLD_NOW
fn ngu_sym(lib: Int, name: Int) -> Int { var f = 0  unsafe { f = dlsym(lib, name) }  return f }
}
cfg(windows) {
extern fn LoadLibraryA(Int) -> Int from "kernel32.dll"
extern fn GetProcAddress(Int, Int) -> Int from "kernel32.dll"
fn ngu_lib_name() -> Str { return "wgpu_native.dll" }
fn ngu_open(path: Int) -> Int { var h = 0  unsafe { h = LoadLibraryA(path) }  return h }
fn ngu_sym(lib: Int, name: Int) -> Int { var f = 0  unsafe { f = GetProcAddress(lib, name) }  return f }
}

