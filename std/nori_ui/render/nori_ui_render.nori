//! std/nori_ui/render: the front end that drives whichever renderer is live.
//!
//!   import "std/nori_ui" as ui
//!   var r = ui::render::renderer_mode(ui::render::cpu(), win, myFont)
//!   while ... {
//!       ui::render::begin(r, bg)
//!       ui::render::dock(r, ui::layout::layout_dock_ui(...))
//!       ui::render::text(r, pos, "hello", 16.0, white)
//!       ui::render::end(r)
//!   }
//!   ui::render::release(r)
//!
//! Choose the backend yourself: `renderer_mode(cpu(), ...)` always works, and `try_renderer(gpu(),
//! ...)` returns Result so a program can ask for the GPU and decide for itself what to do when the
//! machine has no device. Nothing here falls back silently.
//! Either way every draw call below is the same, and HiDPI is handled: lay out in logical
//! coordinates (the window's logical size) and it renders at physical resolution.
use core::*
use layout::*
use paint_cpu::*
use paint_gpu::*
import "std/window" as window
import "std/font" as font
import "std/image" as image

/// The rendering mode. Choose one, once, when the program starts; every draw call afterwards is the
/// same code whichever it is.
pub fn gpu() -> Int { return 0 }
pub fn cpu() -> Int { return 1 }

pub struct Renderer {
    backend: Int, win: view window::Window, cvcpu: CpuCanvas, cvgpu: GpuCanvas,
    w: Int, h: Int, scale: Float, f: view font::Font,
    alpha: Bool = false,        // the window is translucent: the CPU canvas carries premultiplied alpha
    shadows: Bool = true        // retained_frame draws nori_ui's drop shadow under opaque rounded rects
}

// a logical size in device pixels, rounded halfway away from zero as wp_fractional_scale_v1 says the buffer's is
fn phys(v: Int, s: Float) -> Int { return to_int(to_float(v) * s + 0.5) }
fn scale_rect(r: Rect, s: Float) -> Rect {
    return rect_min_max(vec2(r.min.x * s, r.min.y * s), vec2(r.max.x * s, r.max.y * s))
}

/// Ask for a renderer on `mode`: `Ok` with it, or `Err` saying why that backend is not available.
///
/// The failed renderer is released before returning, so a caller cannot leak the one it was not
/// given. Nothing here substitutes the other backend. Which one is running is not an implementation
/// detail a library should decide quietly: a CPU renderer is a different program to write for than
/// a GPU one, with a different frame budget, a different sensible resolution and different things
/// worth drawing. A program that wants the usual "GPU, else software" asks for it in a few lines:
///
///     var r = ui::render::renderer_mode(ui::render::cpu(), win, f)
///     match ui::render::try_renderer(ui::render::gpu(), win, f) {
///         Result::Ok(g)    => { ui::render::release(r)  r = g }
///         Result::Err(why) => { printl(why + " — using software") }
///     }
///
/// A GPU backend that failed to initialise accepts every call and draws nothing, so check the
/// `Result` (or `ok`) rather than assuming a device.
pub fn try_renderer(mode: Int, inout win: window::Window, inout f: font::Font) -> Result<Renderer> {
    var r = for_window(mode, win, f)
    if ok(r) { return Result::Ok(r) }
    release(r)
    return Result::Err("no GPU device for this window")
}

/// A renderer on `mode`, unchecked; installs font metrics. Lay your UI out in logical coords
/// (win's logical size); the HiDPI scale is applied automatically. `cpu()` always works; for
/// `gpu()` this hands back a renderer that may have failed to initialise, so ask `ok()`, or use
/// `try_renderer`, which asks for you.
pub fn renderer_mode(mode: Int, inout win: window::Window, inout f: font::Font) -> Renderer {
    return for_window(mode, win, f)
}

fn for_window(backend: Int, inout win: window::Window, inout f: font::Font) -> Renderer {
    use_font_metrics(f)
    var w = window::width(win)
    var h = window::height(win)
    var sc = window::scale(win)
    if backend == 0 {
        // A GPU surface is built from different things per windowing system (a Wayland one from
        // display+surface, an X11 or Win32 one from the window handle), so this asks the window
        // which it is rather than assuming. On Linux the answer depends on the session, not the build.
        var gc = gpu_null(f)
        if window::backend(win) == window::BACKEND_SURFACE() {
            gc = gpu_new_window_wl(window::native_display(win), window::native_surface(win), phys(w, sc), phys(h, sc), f)
        } else {
            gc = gpu_new_window(window::native_display(win), window::native_handle(win), phys(w, sc), phys(h, sc), f)
        }
        window::apply_viewport(win)
        return Renderer { backend: 0, win: win, cvcpu: canvas_new_nofont(1, 1), cvgpu: gc, w: w, h: h, scale: sc, f: f }
    }
    return Renderer { backend: 1, win: win, cvcpu: canvas_new(phys(w, sc), phys(h, sc), f), cvgpu: gpu_null(f), w: w, h: h, scale: sc, f: f }
}

/// A translucent window: what is drawn keeps its alpha, and the window is shown with it, so what is
/// behind shows through where nothing (or something translucent) is drawn: a dock with rounded
/// corners over the wallpaper, a panel at 88% opacity. Clear to a transparent colour
/// (`color_rgba(0, 0, 0, 0)`) for the parts that are not there. CPU: the canvas carries premultiplied
/// alpha (`paint_cpu::canvas_alpha`) and the window presents ARGB (`window::set_alpha`); a GPU surface
/// is not changed by this (its swapchain's alpha mode is the device's).
pub fn set_alpha(inout r: Renderer, on: Bool) {
    r.alpha = on
    r.cvcpu = canvas_alpha(r.cvcpu, on)
    window::set_alpha(r.win, on)
}
/// whether `retained_frame` draws nori_ui's soft drop shadow under every opaque rounded rectangle
/// (on by default, as `overlay` always has). A desktop whose look draws its own depth turns it off.
pub fn set_shadows(inout r: Renderer, on: Bool) { r.shadows = on }

/// did the chosen backend initialize? (GPU can fail without a Vulkan device.)
pub fn ok(r: Renderer) -> Bool { if r.backend == 0 { return gpu_ok(r.cvgpu) }  return true }
/// which backend is active (render::gpu() or render::cpu()).
pub fn backend(r: Renderer) -> Int { return r.backend }
/// the logical width / height.
pub fn width(r: Renderer) -> Int { return r.w }
pub fn height(r: Renderer) -> Int { return r.h }
/// update the logical size (call on a Resized event); the framebuffer/surface resizes on next begin.
pub fn resize(inout r: Renderer, w: Int, h: Int) { r.w = w  r.h = h }

/// start a frame cleared to `bg` (ensures the framebuffer matches the window's current physical size).
pub fn begin(inout r: Renderer, bg: Color) {
    r.scale = window::scale(r.win)
    var pw = phys(r.w, r.scale)
    var ph = phys(r.h, r.scale)
    if r.backend == 0 {
        gpu_resize(r.cvgpu, pw, ph)
        window::apply_viewport(r.win)
        gpu_begin(r.cvgpu, bg)
    } else {
        if canvas_w(r.cvcpu) != pw || canvas_h(r.cvcpu) != ph { canvas_free(r.cvcpu)  r.cvcpu = canvas_alpha(canvas_new(pw, ph, r.f), r.alpha) }
        clear(r.cvcpu, bg)
    }
}
/// finish the frame: draw + present.
pub fn end(r: Renderer) {
    if r.backend == 0 { gpu_end(r.cvgpu) }
    else { window::present(r.win, canvas_ptr(r.cvcpu), canvas_w(r.cvcpu), canvas_h(r.cvcpu)) }
}

/// draw a dock's chrome (from layout_dock_ui); lay out in logical, scaling is automatic.
pub fn dock(inout r: Renderer, res: DockLayoutResult) {
    if r.backend == 0 { gpu_render_dock(r.cvgpu, res, r.scale) } else { render_dock(r.cvcpu, res, r.scale) }
}
/// draw floating-window chrome (from layout_windows).
pub fn windows(inout r: Renderer, wr: WindowLayoutResult) {
    if r.backend == 0 { gpu_render_windows(r.cvgpu, wr, r.scale) } else { render_windows(r.cvcpu, wr, r.scale) }
}
/// draw a widget overlay (from layout_overlay), with drop shadows.
pub fn overlay(inout r: Renderer, ov: ComputedOverlay) {
    if r.backend == 0 { gpu_render_overlay_into(r.cvgpu, ov, true, r.scale) } else { render_overlay_scaled(r.cvcpu, ov, true, r.scale) }
}
/// Draw a retained document's frame: begin, draw and present in one call, repainting only what
/// changed. `ov` is `layout::rdoc_overlay(doc)`, `damage`/`full` are the frame's (`rdoc_frame`).
/// Call it only when the frame `changed`: when nothing did, there is nothing to present and the
/// program can sleep until its next input.
///
/// CPU: the canvas holds the previous frame, so only the damaged rects are cleared to `bg` and
/// redrawn (`paint_cpu::render_overlay_damage`, pixel-identical to a full repaint); a `full` frame,
/// a resize or a HiDPI scale change repaints everything. The whole buffer is still handed to the
/// window: `window::present` damages the whole surface, so the compositor recomposes all of it.
///
/// GPU: the whole frame is drawn. The swapchain image a frame renders into does not hold the
/// previous frame (FIFO hands back whichever image is free), so a scissored repaint would first
/// need a persistent copy of the last frame and a full-surface copy out of it every frame, the
/// same fill a redraw costs, since a UI's primitives are a few hundred instanced quads with little
/// overdraw. What a retained document saves on the GPU is everything before the draw (no layout,
/// no primitives recorded) and every frame where nothing changed (none is drawn at all).
pub fn retained_frame(inout r: Renderer, ov: ComputedOverlay, damage: Vec<Rect>, full: Bool, bg: Color) {
    let old_scale = r.scale
    r.scale = window::scale(r.win)
    var pw = phys(r.w, r.scale)
    var ph = phys(r.h, r.scale)
    if r.backend == 0 {
        gpu_resize(r.cvgpu, pw, ph)
        window::apply_viewport(r.win)
        gpu_begin(r.cvgpu, bg)
        gpu_render_overlay_into(r.cvgpu, ov, true, r.scale)
        gpu_end(r.cvgpu)
        return
    }
    var whole = full || old_scale != r.scale
    if canvas_w(r.cvcpu) != pw || canvas_h(r.cvcpu) != ph { canvas_free(r.cvcpu)  r.cvcpu = canvas_alpha(canvas_new(pw, ph, r.f), r.alpha)  whole = true }
    if whole {
        clear(r.cvcpu, bg)
        render_overlay_scaled(r.cvcpu, ov, r.shadows, r.scale)
    } else {
        render_overlay_damage(r.cvcpu, ov, damage, r.shadows, r.scale, bg)
    }
    window::present(r.win, canvas_ptr(r.cvcpu), canvas_w(r.cvcpu), canvas_h(r.cvcpu))
}
/// fill a rect (logical coords) for host content.
pub fn fill_rect(r: Renderer, rect: Rect, col: Color) {
    var pr = scale_rect(rect, r.scale)
    if r.backend == 0 { gpu_fill(r.cvgpu, pr, col) } else { fill_rect_cl(r.cvcpu, pr, col, 0.0, clip_full(r.cvcpu)) }
}
/// fill a rect with rounded corners (logical coords), radius in logical pixels.
///
/// `radius <= 0` is the same call as fill_rect, so this can be the only one a caller uses.
pub fn fill_round(r: Renderer, rect: Rect, col: Color, radius: Float) {
    var pr = scale_rect(rect, r.scale)
    let rad = radius * r.scale
    if r.backend == 0 { gpu_fill_round(r.cvgpu, pr, col, rad) } else { fill_rect_cl(r.cvcpu, pr, col, rad, clip_full(r.cvcpu)) }
}

/// draw text at `pos` (logical; pos.y = baseline) at `size` px logical, for host content.
pub fn text(inout r: Renderer, pos: Vec2, str: Str, size: Float, col: Color) {
    var pp = vec2(pos.x * r.scale, pos.y * r.scale)
    if r.backend == 0 { gpu_text(r.cvgpu, pp, str, size * r.scale, col) } else { draw_text_cl(r.cvcpu, pp, str, size * r.scale, col, clip_full(r.cvcpu)) }
}
/// draw a decoded image (std/image) into `rect` (logical coords), scaled to fit and alpha-blended, for
/// host content. Decode once with image::load_png and reuse the Image across frames (don't re-decode).
pub fn draw_image(r: Renderer, rect: Rect, im: image::Image) {
    if !image::ok(im) { return }
    let pr = scale_rect(rect, r.scale)
    if r.backend == 0 { gpu_blit_rgba(r.cvgpu, pr, image::pixels(im), image::width(im), image::height(im)) }
    else { blit_rgba(r.cvcpu, pr, image::pixels(im), image::width(im), image::height(im)) }
}
// ---- a host-drawn hole, filled by whatever renderer produced the texture -------------
//
// `layout/surface.nori` turns a document's `surface { id: ... }` nodes into a screen rect (already
// clipped by any enclosing scroll viewport) plus, when the host bound one, an opaque texture handle.
// These three calls are how a program reaches that from behind `render`, without giving up the
// backend abstraction: on the GPU the handle is a WGPUTextureView and it is sampled straight into
// the rect; on the CPU there is no texture to sample, so only the placeholder/colour fills are
// drawn.

/// the borrowed `WGPUDevice` behind this renderer, as an Int handle: 0 on the CPU backend or when
/// the GPU one did not come up. Hand it, with `gpu_queue_of`, to a second renderer that must draw
/// into textures this one will sample. Do not release it, and do not use it after `release`.
pub fn gpu_device_of(r: Renderer) -> Int { if r.backend != 0 { return 0 }  return gpu_device(r.cvgpu) }
/// the borrowed `WGPUQueue`, on the same terms.
pub fn gpu_queue_of(r: Renderer) -> Int { if r.backend != 0 { return 0 }  return gpu_queue(r.cvgpu) }

/// draw an overlay's surface holes from the host's binding table: texture-bound holes are blitted,
/// colour-bound and unbound ones are filled. Call it after `overlay` for the same overlay: the
/// panel's own background is a primitive and belongs under the scene, and a texture-bound hole
/// emitted no primitive of its own, so nothing is drawn twice.
pub fn surface_blits(inout r: Renderer, ov: ComputedOverlay, b: SurfaceBindings) {
    let dl = surface_draw_list(ov, b, 0.0, 0.0)
    var i = 0
    while i < dl.prims.len() {
        let pr = scale_rect(dl.prims[i].rect, r.scale)
        if r.backend == 0 { gpu_fill(r.cvgpu, pr, dl.prims[i].color) } else { fill_rect_cl(r.cvcpu, pr, dl.prims[i].color, 0.0, clip_full(r.cvcpu)) }
        i = i + 1
    }
    if r.backend == 0 { gpu_blit_surfaces(r.cvgpu, dl.blits, r.scale, false) }
}

/// release resources. Not named `fill`/`free`: both are built-in names (and the C `free` an imported
/// module declares `extern` is never mangled), so a top-level function with one of those names
/// could not be called.
pub fn release(r: Renderer) {
    if r.backend == 0 { gpu_free(r.cvgpu) }
    canvas_free(r.cvcpu)
}
