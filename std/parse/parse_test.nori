import "std/parse" as parse

// ── decimal text -> nearest double (std/parse/decimal.nori) ─────────────────────────────────────
//
// Every value assertion here is `==` against the Nori literal, never a tolerance. That matters: the
// naive approach (accumulate `digit * scale` with `scale *= 0.1`) is within 1e-15 of every answer,
// so a tolerance test would pass on it.

fn test_dec_nearest_double() {
    assert_true(parse::parse_float("0.25882354378700256").value == 0.25882354378700256)
    assert_true(parse::parse_float("1.2345678901234567").value == 1.2345678901234567)
    assert_true(parse::parse_float("0.8500000238418579").value == 0.8500000238418579)
    assert_true(parse::parse_float("0.75").value == 0.75)
    assert_true(parse::parse_float("0.6").value == 0.6)
    assert_true(parse::parse_float("0.1").value == 0.1)
    assert_true(parse::parse_float("0.2").value == 0.2)
    assert_true(parse::parse_float("100.001").value == 100.001)
    assert_true(parse::parse_float("3.14159265358979").value == 3.14159265358979)
    assert_true(parse::parse_float("0.30000000000000004").value == 0.30000000000000004)
    assert_true(parse::parse_float("2.2204460492503131e-16").value == 2.2204460492503131e-16)
}

// all of the above are inside the range the algorithm can prove, so they must also say they are
fn test_dec_reports_exact() {
    assert_true(parse::parse_float("0.25882354378700256").exact)
    assert_true(parse::parse_float("1.2345678901234567").exact)
    assert_true(parse::parse_float("0.8500000238418579").exact)
    assert_true(parse::parse_float("0.1").exact)
    assert_true(parse::parse_float("123456789012345678").exact)
    assert_true(parse::parse_float("9007199254740993").exact)
    assert_true(parse::parse_float("1e26").exact)
    assert_true(parse::parse_float("1e-26").exact)
}

// more than 18 significant digits: the tail is dropped, so the answer is at best a very good guess
// and the flag must say so rather than claim an exactness it cannot back.
fn test_dec_admits_inexact() {
    assert_true(!parse::parse_float("1.2345678901234567890123").exact)
    assert_true(!parse::parse_float("123456789012345678901").exact)
    assert_true(!parse::parse_float("0.123456789012345678901234567890").exact)
    // a power of ten too large for any 5^k to absorb exactly
    assert_true(!parse::parse_float("1e300").exact)
    assert_true(!parse::parse_float("1e-300").exact)
    // subnormals are reached by halving a normal, and infinity is not a rounded value of anything
    assert_true(!parse::parse_float("5e-324").exact)
    assert_true(!parse::parse_float("1e400").exact)
    // ...but "not provably exact" is not "wrong": these still land on the right double
    assert_true(parse::parse_float("5e-324").value == 5e-324)
    assert_true(parse::parse_float("2.2250738585072014e-308").value == 2.2250738585072014e-308)
    assert_true(parse::parse_float("1e400").value > 1.7976931348623157e308)
    assert_true(parse::parse_float("1e-400").value == 0.0)
}

fn test_dec_signs_and_exponents() {
    assert_true(parse::parse_float("-0.75").value == -0.75)
    assert_true(parse::parse_float("+0.75").value == 0.75)
    assert_true(parse::parse_float("1e3").value == 1000.0)
    assert_true(parse::parse_float("1E3").value == 1000.0)
    assert_true(parse::parse_float("1e+3").value == 1000.0)
    assert_true(parse::parse_float("1E+3").value == 1000.0)
    assert_true(parse::parse_float("1e-3").value == 0.001)
    assert_true(parse::parse_float("1E-3").value == 0.001)
    assert_true(parse::parse_float("-1.5e-2").value == -0.015)
    assert_true(parse::parse_float("0.00025e4").value == 2.5)
    assert_true(parse::parse_float("2500000e-6").value == 2.5)
    assert_true(parse::parse_float("-2500000E-6").value == -2.5)
}

// zero, and the negative zero that no Nori literal can spell (`0.0 - 0.0` is `+0.0`)
fn test_dec_zero_and_negative_zero() {
    assert_true(parse::parse_float("0").value == 0.0)
    assert_true(parse::parse_float("0.0").value == 0.0)
    assert_true(parse::parse_float("-0").value == 0.0)
    assert_true(parse::parse_float("-0.000e9").value == 0.0)
    assert_true(1.0 / parse::parse_float("0").value > 0.0)
    assert_true(1.0 / parse::parse_float("-0").value < 0.0)
    assert_true(1.0 / parse::parse_float("-0.0").value < 0.0)
    assert_true(parse::parse_float("-0").exact)
}

fn test_dec_rejects_junk() {
    assert_true(!parse::parse_float("").ok)
    assert_true(!parse::parse_float("abc").ok)
    assert_true(!parse::parse_float("1.5x").ok)
    assert_true(!parse::parse_float("1.5 ").ok)
    assert_true(parse::parse_float("1.5").ok)
    assert_streq(parse::parse_float("").error, "decimal: empty string")
}

// scan_float is the cursor form: it stops at the first byte that is not part of the number and
// reports how many it ate, so a caller can drive its own cursor with it (this is what jp_number does)
fn test_dec_scan_reports_length() {
    let r = parse::scan_float("[1.5,2]", 1)
    assert_true(r.ok)
    assert_true(r.value == 1.5)
    assert_eq(r.used, 3)
    let t = parse::scan_float("-2.5e-3xyz", 0)
    assert_true(t.value == -0.0025)
    assert_eq(t.used, 7)
    let n = parse::scan_float("xyz", 0)
    assert_true(!n.ok)
    assert_eq(n.used, 0)
    // an exponent that is not followed by digits is not part of the number
    let e = parse::scan_float("1.5e+", 0)
    assert_true(e.value == 1.5)
    assert_eq(e.used, 3)
}

// the pieces underneath, exercised directly
fn test_dec_building_blocks() {
    assert_eq(parse::pow5_int(0 - 1), -1)
    assert_eq(parse::pow5_int(0), 1)
    assert_eq(parse::pow5_int(26), 1490116119384765625)
    assert_eq(parse::pow5_int(27), -1)
    assert_true(parse::float_from_ratio(1, 4, 0, false) == 0.25)
    assert_true(parse::float_from_ratio(1, 4, 2, false) == 1.0)
    assert_true(parse::float_from_ratio(1, 3, 0, false) == 1.0 / 3.0)
    assert_true(parse::float_from_ratio(0, 7, 5, false) == 0.0)
    assert_true(parse::float_scale10(false, 6, 0 - 1, false).value == 0.6)
    assert_true(parse::float_scale10(true, 15, 0 - 1, false).value == -1.5)
}
