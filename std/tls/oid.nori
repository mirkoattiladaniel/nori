// Object identifiers, as their DER content bytes.
//
// Encoded rather than dotted, because that is how they are compared: an OID in a certificate is a
// byte string, and decoding one into numbers means writing a parser for arbitrary-length integers
// that exists only to be compared against a constant. Comparing the bytes has neither the parser
// nor the integers.
//
// Generated from the dotted forms by a script; no digit here was typed by hand.

/// 1.2.840.113549.1.1.1
pub fn oid_rsa_encryption() -> Str { return (("" + chr(0x2a) + chr(0x86) + chr(0x48) + chr(0x86) + chr(0xf7) + chr(0x0d) + chr(0x01) + chr(0x01) + chr(0x01))) }
/// 1.2.840.113549.1.1.10
pub fn oid_rsassa_pss() -> Str { return (("" + chr(0x2a) + chr(0x86) + chr(0x48) + chr(0x86) + chr(0xf7) + chr(0x0d) + chr(0x01) + chr(0x01) + chr(0x0a))) }
/// 1.2.840.113549.1.1.11
pub fn oid_sha256_with_rsa() -> Str { return (("" + chr(0x2a) + chr(0x86) + chr(0x48) + chr(0x86) + chr(0xf7) + chr(0x0d) + chr(0x01) + chr(0x01) + chr(0x0b))) }
/// 1.2.840.113549.1.1.12
