/// 1.2.840.113549.1.1.4
pub fn oid_md5_with_rsa() -> Str { return (("" + chr(0x2a) + chr(0x86) + chr(0x48) + chr(0x86) + chr(0xf7) + chr(0x0d) + chr(0x01) + chr(0x01) + chr(0x04))) }
