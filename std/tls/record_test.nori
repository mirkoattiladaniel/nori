// .nori tests for the TLS 1.3 record layer, run with
//   noric --test std/tls/record_test.nori compiler/runtime.nori --import-root .
//
// Every value below is copied out of RFC 8448, "TLS 1.3 Traces", which publishes five complete
// handshakes byte for byte: every secret, every label, every derived key at every step. Nothing
// here was produced by the code it tests, and nothing here is a round-trip.
//
// The values were extracted from the RFC text by a script rather than typed by hand.
import "std/tls" as tls

fn hexv(c: Byte) -> Int {
    let o = ord(c)
    if o >= 97 { return (o - 87) }
    if o >= 65 { return (o - 55) }
    return (o - 48)
}
fn unhex(h: Str) -> Str {
    var out = ""
    var i = 0
    while i < h.len() { out = (out + chr(((hexv(h.at(i)) << 4) | hexv(h.at(i + 1)))))  i = i + 2 }
    return out
}
fn tohex(s: Str) -> Str {
    let d = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < s.len() { let b = ord(s.at(i))  out = ((out + d.at((b >> 4))) + d.at((b & 15)))  i = i + 1 }
    return out
}

// Unprotected records: the ClientHello, the first ServerHello, and the compatibility
// ChangeCipherSpec. Header, version and length, with the fragment unchanged.
fn test_plaintext_records() {
    assert_streq(tohex(tls::record_plain(22, 0x0301, unhex(""))), "")   // section 3, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"))), "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")   // section 3, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0301, unhex(""))), "")   // section 4, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex("0200005c03033ccfd2dec890222763472ae8136777c9d7358777bb66e91ea5122495f559ea2d00130100003400290002000000330024001d0020121761ee42c333e1b9e77b60dd57c2053cd94512ab47f115e86eff50942cea31002b00020304"))), "16030300600200005c03033ccfd2dec890222763472ae8136777c9d7358777bb66e91ea5122495f559ea2d00130100003400290002000000330024001d0020121761ee42c333e1b9e77b60dd57c2053cd94512ab47f115e86eff50942cea31002b00020304")   // section 4, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0301, unhex(""))), "")   // section 5, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex(""))), "")   // section 5, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex(""))), "")   // section 5, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex("020000770303bb341d847fd789c47c387172dc0c9bf147fccacb5043d86ca4c598d3ff571b9800130100004f003300450017004104583e054b7a66672ae020ad9d2686fcc85b5ad41a134a0f03ee72b893052bd85b4c8de6776f5b04ac07d83540eab3e3d9c547bc6528c4317d294686093a6cad7d002b00020304"))), "160303007b020000770303bb341d847fd789c47c387172dc0c9bf147fccacb5043d86ca4c598d3ff571b9800130100004f003300450017004104583e054b7a66672ae020ad9d2686fcc85b5ad41a134a0f03ee72b893052bd85b4c8de6776f5b04ac07d83540eab3e3d9c547bc6528c4317d294686093a6cad7d002b00020304")   // section 5, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0301, unhex(""))), "")   // section 6, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex("0200005603033b50fdf1c3d572e40e68953e7fff4e2758459c59afa0582c0ea032874255fe6e00130100002e00330024001d00206c2e50e865919a6b5a12dfaf918f92b442567b0f89bc54478c6921366658f062002b00020304"))), "160303005a0200005603033b50fdf1c3d572e40e68953e7fff4e2758459c59afa0582c0ea032874255fe6e00130100002e00330024001d00206c2e50e865919a6b5a12dfaf918f92b442567b0f89bc54478c6921366658f062002b00020304")   // section 6, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0301, unhex(""))), "")   // section 7, handshake
    assert_streq(tohex(tls::record_plain(22, 0x0303, unhex("020000760303e5dd5948c435f7a38f0f0130708dc322d9df09abd4838117c183a7bb6d994f2c20a80c165581a8e0d06c0018d54d3a06dd32cfd4051eb026fad3fd0ba99269e6ef130100002e00330024001d00203e30f0f4ba551afd62768341175f5265e4daf0c8841617aa4fafdd2142320c22002b00020304"))), "160303007a020000760303e5dd5948c435f7a38f0f0130708dc322d9df09abd4838117c183a7bb6d994f2c20a80c165581a8e0d06c0018d54d3a06dd32cfd4051eb026fad3fd0ba99269e6ef130100002e00330024001d00203e30f0f4ba551afd62768341175f5265e4daf0c8841617aa4fafdd2142320c22002b00020304")   // section 7, handshake
    assert_streq(tohex(tls::record_plain(20, 0x0303, unhex("01"))), "140303000101")   // section 7, change_cipher_spec
    assert_streq(tohex(tls::record_plain(20, 0x0303, unhex("01"))), "140303000101")   // section 7, change_cipher_spec
}

// Protected records, sealed. Every one of these is a record RFC 8448 printed in full, so a
// match is agreement with the document rather than with this implementation.
//
// The sequence numbers below are not annotations; they are the reconstructed count for that
// direction, and a record sealed under the right key at the wrong count produces a perfectly
// valid ciphertext that no peer can open.
fn test_sealed_records() {
    var k0 = tls::keys_new(unhex("3fce516009c21727d0f2e4e86ee403bc"), unhex("5d313eb2671276ee13000b30"))   // section 3, server writes
    assert_eq(k0.seq, 0)
    assert_streq(tohex(tls::record_seal(k0, 22, unhex(""))), "")   // handshake
    var k1 = tls::keys_new(unhex("dbfaa693d1762c5b666af5d950258d01"), unhex("5bd3c71b836e0b76bb73265f"))   // section 3, client writes
    assert_eq(k1.seq, 0)
    assert_streq(tohex(tls::record_seal(k1, 22, unhex("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"))), "170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546")   // handshake
    var k2 = tls::keys_new(unhex("9f02283b6c9c07efc26bb9f2ac92e356"), unhex("cf782b88dd83549aadf1e984"))   // section 3, server writes
    assert_eq(k2.seq, 0)
    assert_streq(tohex(tls::record_seal(k2, 22, unhex(""))), "")   // handshake
    var k3 = tls::keys_new(unhex("17422dda596ed5d9acd890e3c63f5051"), unhex("5b78923dee08579033e523d9"))   // section 3, client writes
    assert_eq(k3.seq, 0)
    assert_streq(tohex(tls::record_seal(k3, 23, unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))), "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4")   // application_data
    assert_eq(k2.seq, 1)
    assert_streq(tohex(tls::record_seal(k2, 23, unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))), "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d")   // application_data
    assert_eq(k3.seq, 1)
    assert_streq(tohex(tls::record_seal(k3, 21, unhex("0100"))), "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3")   // alert
    assert_eq(k2.seq, 2)
    assert_streq(tohex(tls::record_seal(k2, 21, unhex("0100"))), "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9")   // alert
    var k7 = tls::keys_new(unhex("920205a5b7bf2115e6fc5c2942834f54"), unhex("6d475f0993c8e564610db2b9"))   // section 4, client writes
    assert_eq(k7.seq, 0)
    assert_streq(tohex(tls::record_seal(k7, 23, unhex("414243444546"))), "1703030017ab1df420e75c457a7cc5d2844f76d5aee4b4edbf049be0")   // application_data
    var k8 = tls::keys_new(unhex("27c6bdc0a3dcea39a47326d79bc9e4ee"), unhex("9569ecdd4d0536705e9ef725"))   // section 4, server writes
    assert_eq(k8.seq, 0)
    assert_streq(tohex(tls::record_seal(k8, 22, unhex("080000280026000a00140012001d00170018001901000101010201030104001c0002400100000000002a00001400002048d3e0e1b3d907c6acff145e16090388c77b05c050b634ab1a88bbd0dd1a34b2"))), "1703030061dc48237b4b879f50d0d4d262ea8b4716eb40ddc1eb957e11126e8a7149c2d012d37a7115957e64ce30008b9e0323f2c05a9c1c77b4f37849a695ab255060a33fee770ca95cb8486bfd0843b87024865ca35cc41c4e515c64dcb1369f98635bc7a5")   // handshake
    assert_eq(k7.seq, 1)
    assert_streq(tohex(tls::record_seal(k7, 22, unhex("05000000"))), "1703030015aca6fc944841298df99593725f9bf9754429b12f09")   // handshake
    var k10 = tls::keys_new(unhex("b1530806f4adfeac83f1413032bbfa82"), unhex("eb50c16be7654abf99dd06d9"))   // section 4, client writes
    assert_eq(k10.seq, 0)
    assert_streq(tohex(tls::record_seal(k10, 22, unhex("140000207230a9c952c25cd6138fc5e6628308c41c5335dd81b9f96bcea50fd32bda416d"))), "170303003500f8b467d14cf22a4b3f0b6ae0d8e6cc8d08e0db3515ef5c2bdf1922eafbb70009964716d834fb70c3d2a56c5b1f5f6bdba6c333cf")   // handshake
    var k11 = tls::keys_new(unhex("3cf122f301c6358ca7989553250efd72"), unhex("ab1aec26aa78b8fc1176b9ac"))   // section 4, client writes
    assert_eq(k11.seq, 0)
    assert_streq(tohex(tls::record_seal(k11, 23, unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))), "1703030043b1cebce242aa201be9ae5e1cb2a9aa4b33d4e866af1edb068919237741aa031d7a74d491c99b9d4e232b74206bc6fbaa04fe78be44a9b4f54320a17eb76992afac3103")   // application_data
    var k12 = tls::keys_new(unhex("e857c690a34c5a9129d833619684f95e"), unhex("0685d6b561aab9ef1013faf9"))   // section 4, server writes
    assert_eq(k12.seq, 0)
    assert_streq(tohex(tls::record_seal(k12, 23, unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))), "1703030043275e9f20acff57bc000657d3867df039cccf79047884cf75771746f740b5a83f462a0954c3581393a203a25a7dd14141ef1a37900cdb62ff62dee1ba39ab2590cbf194")   // application_data
    assert_eq(k11.seq, 1)
    assert_streq(tohex(tls::record_seal(k11, 21, unhex("0100"))), "17030300130facce3246bdfc6369838d6a82ae6de5d422dc")   // alert
    assert_eq(k12.seq, 1)
    assert_streq(tohex(tls::record_seal(k12, 21, unhex("0100"))), "17030300135b18af444e8e1eec7158fb62d8f2577d37ba5d")   // alert
    var k15 = tls::keys_new(unhex("4646bfac1712c426cd78d8a24a8a6f6b"), unhex("c7d395c08d62f297d13768ea"))   // section 5, server writes
    assert_eq(k15.seq, 0)
    assert_streq(tohex(tls::record_seal(k15, 22, unhex(""))), "")   // handshake
    var k16 = tls::keys_new(unhex("2f1f918663d590e7421149a29d94b0b6"), unhex("414d5485235e1a688793bd74"))   // section 5, client writes
    assert_eq(k16.seq, 0)
    assert_streq(tohex(tls::record_seal(k16, 22, unhex("1400002023f52fdb0709a55bd7f79b991f25484087bcfd4d4380b12326a52a28b2e368e1"))), "1703030035d74f1923c662fd34137c6f502f3dd2b93d951d1b3bc97e42afe23c31abea92fe91b474999e85e3b791ce252fe8c3e9f939a4120cb2")   // handshake
    var k17 = tls::keys_new(unhex("a7eb2a0525eb4331d58fcbf9f7ca2e9c"), unhex("86e8be227c1bd2b3e39cb444"))   // section 5, client writes
    assert_eq(k17.seq, 0)
    assert_streq(tohex(tls::record_seal(k17, 21, unhex("0100"))), "17030300132ea6cdf749196023e2b3a49491695536426047")   // alert
    var k18 = tls::keys_new(unhex("f27a5d97bd25550c4823b0f3e5d29388"), unhex("0dd631f7b71cbbc797c35fe7"))   // section 5, server writes
    assert_eq(k18.seq, 0)
    assert_streq(tohex(tls::record_seal(k18, 21, unhex("0100"))), "1703030013519fc5075cb0884349759ff9ef6f011bb4c6f2")   // alert
    var k19 = tls::keys_new(unhex("6cb6e60619d8c7355c5d4c4bc2be90d5"), unhex("64f239530c3b888fde85e0be"))   // section 6, server writes
    assert_eq(k19.seq, 0)
    assert_streq(tohex(tls::record_seal(k19, 22, unhex(""))), "")   // handshake
    var k20 = tls::keys_new(unhex("916948f728d9823fa41a004d083f217f"), unhex("64153d79bac9ea10ca5a0a88"))   // section 6, client writes
    assert_eq(k20.seq, 0)
    assert_streq(tohex(tls::record_seal(k20, 22, unhex(""))), "")   // handshake
    var k21 = tls::keys_new(unhex("cdc09c806aa8f86dfcd51efc44a0c039"), unhex("6ef852e78b46d913668e53e7"))   // section 6, client writes
    assert_eq(k21.seq, 0)
    assert_streq(tohex(tls::record_seal(k21, 21, unhex("0100"))), "1703030013e4ad7d44c29245339d355962c779b89ef44c58")   // alert
    var k22 = tls::keys_new(unhex("88b3123ddecadf8c1ba298e2c18176b0"), unhex("4e0978513f9de8327c08e4f3"))   // section 6, server writes
    assert_eq(k22.seq, 0)
    assert_streq(tohex(tls::record_seal(k22, 21, unhex("0100"))), "17030300131decc5d6e64bba8a6f21b4fd077497da2a90cb")   // alert
    var k23 = tls::keys_new(unhex("041091fdab29f2c8abfb156dc5fc8d54"), unhex("7464d791685de05998fcbadb"))   // section 7, server writes
    assert_eq(k23.seq, 0)
    assert_streq(tohex(tls::record_seal(k23, 22, unhex(""))), "")   // handshake
    var k24 = tls::keys_new(unhex("62d13c13ffd7402fc1c09e3d163665cb"), unhex("7166f20028bf146dcfbd5a40"))   // section 7, client writes
    assert_eq(k24.seq, 0)
    assert_streq(tohex(tls::record_seal(k24, 22, unhex("14000020692cab155cc6c100ead60733d0617f6fb09b71aa1e8c9accbbbc9e8ed336c1dd"))), "170303003532d030e273773a8696c799981af6ced07f87482e81565e394e87c867f33df3d65b7506f1a626af91d4821d5f7a1f210ef8dd3c6d16")   // handshake
    var k25 = tls::keys_new(unhex("33d7f9709756c966488ad4438437e673"), unhex("c5f30d34b0e91b7d6c8eea65"))   // section 7, client writes
    assert_eq(k25.seq, 0)
    assert_streq(tohex(tls::record_seal(k25, 21, unhex("0100"))), "17030300130f629155382dba23c4e2c5f7f84e6f2ed3083d")   // alert
    var k26 = tls::keys_new(unhex("edc4cbd0041c28cc7167441d7ca53e6a"), unhex("bf6c7d8e0a9545b427dcf139"))   // section 7, server writes
    assert_eq(k26.seq, 0)
    assert_streq(tohex(tls::record_seal(k26, 21, unhex("0100"))), "1703030013b7257b0fecaf69d4f09e3f891e2a25d1e28845")   // alert
}

// The same records, opened. Decryption must recover both the payload and the true content
// type, which lives inside the ciphertext, because every protected record says
// `application_data` on the outside whatever it carries.
fn test_opened_records() {
    var o0 = tls::keys_new(unhex("3fce516009c21727d0f2e4e86ee403bc"), unhex("5d313eb2671276ee13000b30"))   // section 3, server
    let r0 = tls::record_open(o0, unhex(""))
    assert_streq(r0.err, "")
    assert_eq(r0.ctype, 22)
    assert_streq(tohex(r0.body), "")
    var o1 = tls::keys_new(unhex("dbfaa693d1762c5b666af5d950258d01"), unhex("5bd3c71b836e0b76bb73265f"))   // section 3, client
    let r1 = tls::record_open(o1, unhex("170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546"))
    assert_streq(r1.err, "")
    assert_eq(r1.ctype, 22)
    assert_streq(tohex(r1.body), "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61")
    var o2 = tls::keys_new(unhex("9f02283b6c9c07efc26bb9f2ac92e356"), unhex("cf782b88dd83549aadf1e984"))   // section 3, server
    let r2 = tls::record_open(o2, unhex(""))
    assert_streq(r2.err, "")
    assert_eq(r2.ctype, 22)
    assert_streq(tohex(r2.body), "")
    var o3 = tls::keys_new(unhex("17422dda596ed5d9acd890e3c63f5051"), unhex("5b78923dee08579033e523d9"))   // section 3, client
    let r3 = tls::record_open(o3, unhex("1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"))
    assert_streq(r3.err, "")
    assert_eq(r3.ctype, 23)
    assert_streq(tohex(r3.body), "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031")
    let r4 = tls::record_open(o2, unhex("17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"))
    assert_streq(r4.err, "")
    assert_eq(r4.ctype, 23)
    assert_streq(tohex(r4.body), "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031")
    let r5 = tls::record_open(o3, unhex("1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"))
    assert_streq(r5.err, "")
    assert_eq(r5.ctype, 21)
    assert_streq(tohex(r5.body), "0100")
    let r6 = tls::record_open(o2, unhex("1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"))
    assert_streq(r6.err, "")
    assert_eq(r6.ctype, 21)
    assert_streq(tohex(r6.body), "0100")
    var o7 = tls::keys_new(unhex("920205a5b7bf2115e6fc5c2942834f54"), unhex("6d475f0993c8e564610db2b9"))   // section 4, client
    let r7 = tls::record_open(o7, unhex("1703030017ab1df420e75c457a7cc5d2844f76d5aee4b4edbf049be0"))
    assert_streq(r7.err, "")
    assert_eq(r7.ctype, 23)
    assert_streq(tohex(r7.body), "414243444546")
    var o8 = tls::keys_new(unhex("27c6bdc0a3dcea39a47326d79bc9e4ee"), unhex("9569ecdd4d0536705e9ef725"))   // section 4, server
    let r8 = tls::record_open(o8, unhex("1703030061dc48237b4b879f50d0d4d262ea8b4716eb40ddc1eb957e11126e8a7149c2d012d37a7115957e64ce30008b9e0323f2c05a9c1c77b4f37849a695ab255060a33fee770ca95cb8486bfd0843b87024865ca35cc41c4e515c64dcb1369f98635bc7a5"))
    assert_streq(r8.err, "")
    assert_eq(r8.ctype, 22)
    assert_streq(tohex(r8.body), "080000280026000a00140012001d00170018001901000101010201030104001c0002400100000000002a00001400002048d3e0e1b3d907c6acff145e16090388c77b05c050b634ab1a88bbd0dd1a34b2")
    let r9 = tls::record_open(o7, unhex("1703030015aca6fc944841298df99593725f9bf9754429b12f09"))
