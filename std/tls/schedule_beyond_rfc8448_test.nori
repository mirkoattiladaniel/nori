// The parts of the TLS 1.3 key schedule that RFC 8448 does not reach, run with
//   noric --test std/tls/schedule_beyond_rfc8448_test.nori compiler/runtime.nori --import-root .
//
// RFC 8448's five handshakes are good evidence for the schedule, but they are
// still only five handshakes. None of them performs a KeyUpdate, none expands more than 48 bytes
// under a label, and none feeds the schedule an input it should refuse. Those cases are here, and
// every one was found by mutation testing: each corresponds to a defect that the RFC
// vectors alone did not catch.
//
// The computed answers come from an independent implementation of RFC 8446 7.1 that reproduces
// every SHA-256 answer in RFC 8448 before it is trusted. That is weaker
// evidence than a published trace, which is why these live in their own file rather than beside
// the RFC vectors: the two kinds should not be mistaken for one another.
import "std/tls" as tls

fn tohex(s: Str) -> Str {
    let d = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < s.len() { let b = ord(s.at(i))  out = ((out + d.at((b >> 4))) + d.at((b & 15)))  i = i + 1 }
    return out
}
// a constant-byte string, enough to pin a label, and readable in a way a hex blob is not
fn rep(b: Int, n: Int) -> Str {
    var out = ""
    var i = 0
    while i < n { out = (out + chr(b))  i = i + 1 }
    return out
}

// The HkdfLabel length is a 16-bit field. Every length TLS itself asks for (12, 16, 32, 48) fits
// in the low byte, so zeroing the high byte passes every RFC 8448 vector and is still wrong.
fn test_hkdf_label_length_is_16_bit() {
    assert_streq(tohex(tls::hkdf_label("key", "", 16)), "001009746c733133206b657900")
    assert_streq(tohex(tls::hkdf_label("key", "", 255)), "00ff09746c733133206b657900")
    assert_streq(tohex(tls::hkdf_label("key", "", 256)), "010009746c733133206b657900")
    assert_streq(tohex(tls::hkdf_label("key", "", 300)), "012c09746c733133206b657900")
    assert_streq(tohex(tls::hkdf_label("key", "", 65535)), "ffff09746c733133206b657900")
    // a context that fills its single length byte completely
    assert_streq(tohex(tls::hkdf_label("key", rep(65, 255), 32)), "")
}

// KeyUpdate. RFC 8448 never performs one, so nothing in it pins the "traffic upd" label, which
// is abbreviated in a way that invites being spelled out, and spelling it out breaks no RFC 8448
// vector at all.
fn test_key_update() {
    // SHA-256
    assert_streq(tohex(tls::key_update(32, rep(7, 32))), "e4e9fd5395b1b2c12d57c49ca803ccab1944c4b7404cffb80eae7a8737708e4c")
    // and again, because a KeyUpdate chain is meant to keep going
    assert_streq(tohex(tls::key_update(32, tls::key_update(32, rep(7, 32)))), "7f4c64e89fb7124f0c5d3f8d327b6bac8815adb33df26771bb4df02198702e12")
    // SHA-384
    assert_streq(tohex(tls::key_update(48, rep(7, 48))), "76eb5e0655ece81316ee028f0064bd573f0d57551094dd89316ce1d0f194da645649f31bf6f077cbf870aa584ca16022")
    // and again, because a KeyUpdate chain is meant to keep going
    assert_streq(tohex(tls::key_update(48, tls::key_update(48, rep(7, 48)))), "a22e25e23a82d4a4152cedd6e201a9f0f1032d2fb2475f639c65bec8740fabc93a425fe938e4c053ffbdb8b3ddf2feed")
}

// Expansions longer than one hash block, where HKDF's counter has to advance and each block is
// chained from the last. RFC 8448 asks for at most 48 bytes, which is a single block for SHA-384
// and two for SHA-256, so the counter is barely exercised there.
fn test_long_expansion() {
    assert_streq(tohex(tls::expand_label(32, rep(7, 32), "key", "", 100)), "0d875cd714c2e5b4e6cd165ca596ef05d67104b8f30f95e9f5d8f044d861d3ad43d1326ade0b0d60b45f5463a9b7430c4f962b7779cc47ed665076ee5728606bc5d95150bc11aee8789af4a0e155f8275167b72097c0c4bcfe98fb74fb5c3c5ac75b84aa")
    assert_streq(tohex(tls::expand_label(32, rep(7, 32), "key", "", 1000)), "")
    assert_streq(tohex(tls::expand_label(48, rep(7, 48), "key", "", 100)), "d0c67c7e7ed5144786961cd957b1cefb07f455adadaeabfaeb56b1efb234ac9b91c71184ffe3ea14c29c3796e067af26951c6c265659dc3fc93a873e23b9c7162ee7e61025c09dd8effb8e438a55b1d3c91e92603643b8a186c6d8fe93b0d3cd9ea5ef59")
    assert_streq(tohex(tls::expand_label(48, rep(7, 48), "key", "", 1000)), "")
}

// Refusals. A key schedule handed an unsupported hash must produce nothing; the one thing it
// must never do is quietly substitute a hash it does have, because the result is a key of exactly
// the right length that no peer will ever agree with.
fn test_refuses_unsupported_inputs() {
    // 20 would be SHA-1, 64 would be SHA-512: both real hashes, neither a TLS 1.3 suite
    assert_streq(tls::expand_label(20, rep(7, 20), "key", "", 16), "")
    assert_streq(tls::expand_label(64, rep(7, 64), "key", "", 16), "")
    assert_streq(tls::derive_secret(0, rep(7, 32), "key", ""), "")
    let s = tls::schedule_start(20, "")
    assert_streq(s.early, "")
    // a label or context too long for the single byte that describes it
    assert_streq(tls::hkdf_label("key", rep(65, 256), 32), "")
    assert_streq(tls::hkdf_label(rep(65, 250), "", 32), "")
    // a length the 16-bit field cannot describe
    assert_streq(tls::hkdf_label("key", "", 65536), "")
    assert_streq(tls::hkdf_label("key", "", 0 - 1), "")
}
