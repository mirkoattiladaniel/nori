// The transcript, and the HelloRetryRequest substitution.
//
// Section 5 is the one that matters here. When a server sends a HelloRetryRequest, the first
// ClientHello is removed from the transcript and replaced by a synthetic `message_hash`
// message holding its hash. Getting that wrong produces no error at the point of the
// mistake: the handshake fails much later, decrypting a Finished that will never match.
//
// Section 4 (0-RTT resumption) is absent: its ClientHello carries a PSK binder
// computed over a truncated copy of itself, and resumption is out of scope for this client.
fn test_transcript_simple_1rtt() {
    var t = tls::transcript_new(32)
    tls::transcript_add(t, unhex(""))   // ClientHello
    tls::transcript_add(t, unhex("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"))   // ServerHello
    assert_streq(tohex(tls::transcript_hash(t)), "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    assert_streq(tohex(tls::transcript_hash(t)), "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    tls::transcript_add(t, unhex("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"))   // EncryptedExtensions
    tls::transcript_add(t, unhex(""))   // Certificate
    tls::transcript_add(t, unhex("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"))   // CertificateVerify
    assert_streq(tohex(tls::verify_data(32, unhex("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"), tls::transcript_hash(t))), "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718")
    tls::transcript_add(t, unhex("140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::transcript_hash(t)), "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::transcript_hash(t)), "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::verify_data(32, unhex("b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"), tls::transcript_hash(t))), "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61")
    tls::transcript_add(t, unhex("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d")
    tls::transcript_add(t, unhex(""))   // NewSessionTicket
}

fn test_transcript_hello_retry_request() {
    var t = tls::transcript_new(32)
    tls::transcript_add(t, unhex(""))   // ClientHello
    assert_true(tls::is_hello_retry_request(unhex("")))
    tls::transcript_hrr(t)          // ClientHello1 -> message_hash
    tls::transcript_add(t, unhex(""))   // ServerHello
    tls::transcript_add(t, unhex(""))   // ClientHello
    tls::transcript_add(t, unhex("020000770303bb341d847fd789c47c387172dc0c9bf147fccacb5043d86ca4c598d3ff571b9800130100004f003300450017004104583e054b7a66672ae020ad9d2686fcc85b5ad41a134a0f03ee72b893052bd85b4c8de6776f5b04ac07d83540eab3e3d9c547bc6528c4317d294686093a6cad7d002b00020304"))   // ServerHello
    assert_streq(tohex(tls::transcript_hash(t)), "8aa8e828ec2f8a884fec95a3139de01c15a3daa7ff5bfc3f4bfcc21b438d7bf8")
    assert_streq(tohex(tls::transcript_hash(t)), "8aa8e828ec2f8a884fec95a3139de01c15a3daa7ff5bfc3f4bfcc21b438d7bf8")
    tls::transcript_add(t, unhex("080000180016000a0008000600170018001d001c0002400100000000"))   // EncryptedExtensions
    tls::transcript_add(t, unhex(""))   // Certificate
    tls::transcript_add(t, unhex("0f0000840804008033ab13d4462707231b5dcae6c8190b63d1dabc74f28c395370da0b07e5b83066d0246a31acd95df475bfd799a4a70d33ad93d3a317a9b2c0d237a5685b219e774112e391a247607d1aeff1bbd0a39f382ee1a5fe88ae99ec59228e6497e45d48ce275a6d5ef40d169fb6f9d33b052ed3dcdd6b5a48baafffbcb290128415bd38"))   // CertificateVerify
    assert_streq(tohex(tls::verify_data(32, unhex("3403e781e2af7b6508da28574f6e95a1abf162de83a97927c37672a4a0cef8a1"), tls::transcript_hash(t))), "8863e6bfb0420a927fa27f34336a70ae426e968e3eb884945b96856dba3976d1")
    tls::transcript_add(t, unhex("140000208863e6bfb0420a927fa27f34336a70ae426e968e3eb884945b96856dba3976d1"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "50f63cbf36b0dd049e7a0ba27d6455745ea2aaac54bb167f9950b2b7ce9509da")
    assert_streq(tohex(tls::transcript_hash(t)), "50f63cbf36b0dd049e7a0ba27d6455745ea2aaac54bb167f9950b2b7ce9509da")
    assert_streq(tohex(tls::transcript_hash(t)), "50f63cbf36b0dd049e7a0ba27d6455745ea2aaac54bb167f9950b2b7ce9509da")
    assert_streq(tohex(tls::verify_data(32, unhex("158aa7ab8855073582b41d674b4055cabcc534728f659314861b4e08e2011566"), tls::transcript_hash(t))), "23f52fdb0709a55bd7f79b991f25484087bcfd4d4380b12326a52a28b2e368e1")
    tls::transcript_add(t, unhex("1400002023f52fdb0709a55bd7f79b991f25484087bcfd4d4380b12326a52a28b2e368e1"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "0e8b349158b855fdcd0c11dbbc4e83e43caa6e483c6c65df53151888e50165f4")
}

fn test_transcript_client_auth() {
    var t = tls::transcript_new(32)
    tls::transcript_add(t, unhex(""))   // ClientHello
    tls::transcript_add(t, unhex("0200005603033b50fdf1c3d572e40e68953e7fff4e2758459c59afa0582c0ea032874255fe6e00130100002e00330024001d00206c2e50e865919a6b5a12dfaf918f92b442567b0f89bc54478c6921366658f062002b00020304"))   // ServerHello
    assert_streq(tohex(tls::transcript_hash(t)), "88ebc042bd0d5a643b22fca7a47defd4007dfe184949a6261c596c4e002a74a2")
    assert_streq(tohex(tls::transcript_hash(t)), "88ebc042bd0d5a643b22fca7a47defd4007dfe184949a6261c596c4e002a74a2")
    tls::transcript_add(t, unhex("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"))   // EncryptedExtensions
    tls::transcript_add(t, unhex("0d000027000024000d0020001e040305030603020308040805080604010501060102010402050206020202"))   // CertificateRequest
    tls::transcript_add(t, unhex(""))   // Certificate
    tls::transcript_add(t, unhex("0f00004b040300473045022100d7a4d34bd54f55fee1a89625678c3dd5e5f60dac73ec940c5c7b9304a02084a90220289f595ed488b9ac689a3d192b1a8bb38f34af7874c059c9806a1f38269353e8"))   // CertificateVerify
    assert_streq(tohex(tls::verify_data(32, unhex("8b02d3c00442a2722c4098ebe8675b23e801510f0d7ed778d8eb0b8f42a19a5e"), tls::transcript_hash(t))), "93b70cdf4781985b96345caac701b4e750d3042df1a689d8faca812251113c11")
    tls::transcript_add(t, unhex("1400002093b70cdf4781985b96345caac701b4e750d3042df1a689d8faca812251113c11"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "5177a29af5a17f9b4933e431851d128345366c1720d38f8f0465eeeae6740372")
    assert_streq(tohex(tls::transcript_hash(t)), "5177a29af5a17f9b4933e431851d128345366c1720d38f8f0465eeeae6740372")
    assert_streq(tohex(tls::transcript_hash(t)), "5177a29af5a17f9b4933e431851d128345366c1720d38f8f0465eeeae6740372")
    tls::transcript_add(t, unhex(""))   // Certificate
    tls::transcript_add(t, unhex("0f00008408040080186b2223b503a759c35dba0e9721b4b579138d5f0f5e6ec7feaaf27f3ad7f386c2c7bd7cb2be52fbf5ed8393f406ee79369692ec7ac695651d858219e672a8eb7b2a677b640b46ab630edc5f3f2f8272b9c0d906f81f84ddc5b8c7bcf955c78a3cf99e5016f73e04eb7dfcb28833f13e8f75ec2ff3581e2f098ad4157fd6d6ad"))   // CertificateVerify
    assert_streq(tohex(tls::verify_data(32, unhex("cec7a30c6872070f22a7eeb065768db67c45e29533db879908ce6dc66f5911de"), tls::transcript_hash(t))), "9afe2ba2f63a09d229d8a429e5b37ffd9fcc73bdb5911b82425972aa2892440f")
    tls::transcript_add(t, unhex("140000209afe2ba2f63a09d229d8a429e5b37ffd9fcc73bdb5911b82425972aa2892440f"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "391d004bd84c831b1582444414b4dc8064010ecc76f37f88bfeb1e88fe135c25")
}

fn test_transcript_compat_mode() {
    var t = tls::transcript_new(32)
    tls::transcript_add(t, unhex(""))   // ClientHello
    tls::transcript_add(t, unhex("020000760303e5dd5948c435f7a38f0f0130708dc322d9df09abd4838117c183a7bb6d994f2c20a80c165581a8e0d06c0018d54d3a06dd32cfd4051eb026fad3fd0ba99269e6ef130100002e00330024001d00203e30f0f4ba551afd62768341175f5265e4daf0c8841617aa4fafdd2142320c22002b00020304"))   // ServerHello
    assert_streq(tohex(tls::transcript_hash(t)), "745c55bac399310b7b5a7c81a2c130b4d56dff6f68c3ab477857601e01f1f8d1")
    assert_streq(tohex(tls::transcript_hash(t)), "745c55bac399310b7b5a7c81a2c130b4d56dff6f68c3ab477857601e01f1f8d1")
    tls::transcript_add(t, unhex("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"))   // EncryptedExtensions
    tls::transcript_add(t, unhex(""))   // Certificate
    tls::transcript_add(t, unhex("0f00008408040080a2301a68dd1ceee6938fe9d40c46b9201b34d59952a37e06523a39cf8ba6c9c8b68ae94492af780516ed7b73c82812e99dd3fabea45e09d9c6848721c2808c61501b0c75e7fcaba5f78bef68a2c2b69b19558b3e40387eea93d25c7781c1cc00e9f519f7e2e4adb73e76d66089000a2dc866c2ed30bba50a0d457f19dc6eb9f3"))   // CertificateVerify
    assert_streq(tohex(tls::verify_data(32, unhex("cace3d555cc1c577cf970cff28cf978d6a9800085442e18d695b50f3151d18c8"), tls::transcript_hash(t))), "c8c3a8f1bff5274061f4bc3a7caffbdc9616094ca625caa65f8e76ed46db74d3")
    tls::transcript_add(t, unhex("14000020c8c3a8f1bff5274061f4bc3a7caffbdc9616094ca625caa65f8e76ed46db74d3"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "0707dcac7b2fa428cc7f691694a2590c806aaa5c0cf5087ed5385012e7f96cd4")
    assert_streq(tohex(tls::transcript_hash(t)), "0707dcac7b2fa428cc7f691694a2590c806aaa5c0cf5087ed5385012e7f96cd4")
    assert_streq(tohex(tls::transcript_hash(t)), "0707dcac7b2fa428cc7f691694a2590c806aaa5c0cf5087ed5385012e7f96cd4")
    assert_streq(tohex(tls::verify_data(32, unhex("2c3cb24a1081edb59518ee6861e89a6b72b3801afe7713e4cbbc21c0795bf831"), tls::transcript_hash(t))), "692cab155cc6c100ead60733d0617f6fb09b71aa1e8c9accbbbc9e8ed336c1dd")
    tls::transcript_add(t, unhex("14000020692cab155cc6c100ead60733d0617f6fb09b71aa1e8c9accbbbc9e8ed336c1dd"))   // Finished
    assert_streq(tohex(tls::transcript_hash(t)), "a021d3a05bd418a772813875ef79b0af68c5123215427ab7333f8c27722a9fd5")
}

// An ordinary ServerHello must not be mistaken for a HelloRetryRequest. The two share a
// message type, so the Random is the only thing separating them, and treating a real
// ServerHello as an HRR would silently destroy the transcript.
fn test_ordinary_server_hello_is_not_hrr() {
    assert_true(!tls::is_hello_retry_request(unhex("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")))
    assert_true(!tls::is_hello_retry_request(unhex("0200005c03033ccfd2dec890222763472ae8136777c9d7358777bb66e91ea5122495f559ea2d00130100003400290002000000330024001d0020121761ee42c333e1b9e77b60dd57c2053cd94512ab47f115e86eff50942cea31002b00020304")))
    assert_true(!tls::is_hello_retry_request(unhex("020000770303bb341d847fd789c47c387172dc0c9bf147fccacb5043d86ca4c598d3ff571b9800130100004f003300450017004104583e054b7a66672ae020ad9d2686fcc85b5ad41a134a0f03ee72b893052bd85b4c8de6776f5b04ac07d83540eab3e3d9c547bc6528c4317d294686093a6cad7d002b00020304")))
    assert_true(!tls::is_hello_retry_request(unhex("0200005603033b50fdf1c3d572e40e68953e7fff4e2758459c59afa0582c0ea032874255fe6e00130100002e00330024001d00206c2e50e865919a6b5a12dfaf918f92b442567b0f89bc54478c6921366658f062002b00020304")))
    assert_true(!tls::is_hello_retry_request(unhex("020000760303e5dd5948c435f7a38f0f0130708dc322d9df09abd4838117c183a7bb6d994f2c20a80c165581a8e0d06c0018d54d3a06dd32cfd4051eb026fad3fd0ba99269e6ef130100002e00330024001d00203e30f0f4ba551afd62768341175f5265e4daf0c8841617aa4fafdd2142320c22002b00020304")))
    assert_true(!tls::is_hello_retry_request(""))
    assert_true(!tls::is_hello_retry_request("short"))
}

// The schedule driven end to end, as a client actually drives it, rather than one step at a
// time. Section 3's secrets must all fall out of the same three extractions.
fn test_schedule_end_to_end() {
    var s = tls::schedule_start(32, "")
    assert_streq(tohex(s.early), "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    tls::schedule_handshake(s, unhex("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"))
    assert_streq(tohex(s.handshake), "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac")
    tls::schedule_master(s)
    assert_streq(tohex(s.master), "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919")
    assert_streq(tohex(tls::client_handshake_traffic(s, unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"))), "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21")
    assert_streq(tohex(tls::server_handshake_traffic(s, unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"))), "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38")
    assert_streq(tohex(tls::client_app_traffic(s, unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"))), "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5")
    assert_streq(tohex(tls::server_app_traffic(s, unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"))), "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643")
    assert_streq(tohex(tls::exporter_master(s, unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"))), "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50")
    assert_streq(tohex(tls::resumption_master(s, unhex("209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d"))), "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c")
}
