// .nori tests for the TLS 1.3 key schedule, run with
//   noric --test std/tls/schedule_test.nori compiler/runtime.nori --import-root .
//
// Every value below is copied out of RFC 8448, "TLS 1.3 Traces", which publishes five complete
// handshakes byte for byte: every secret, every label, every derived key at every step. Nothing
// here was produced by the code it tests, and nothing here is a round-trip.
//
// That matters more for a key schedule than for almost anything else. A wrong schedule still
// returns well-formed pseudorandom bytes of exactly the right length, and every structural check
// you can write about it passes; two peers running the same wrong schedule even interoperate
// happily with each other. Only a published answer finds the bug.
//
// The `info` bytes are asserted as well as the outputs, so the label encoding is pinned directly
// rather than inferred from a matching result.
//
// The values were extracted from the RFC text by a script rather than typed by hand.
import "std/tls" as tls
import "std/crypto" as crypto

fn hexv(c: Byte) -> Int {
    let o = ord(c)
    if o >= 97 { return (o - 87) }
    if o >= 65 { return (o - 55) }
    return (o - 48)
}
fn unhex(h: Str) -> Str {
    var out = ""
    var i = 0
    while i < h.len() { out = (out + chr(((hexv(h.at(i)) << 4) | hexv(h.at(i + 1)))))  i = i + 2 }
    return out
}
fn tohex(s: Str) -> Str {
    let d = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < s.len() { let b = ord(s.at(i))  out = ((out + d.at((b >> 4))) + d.at((b & 15)))  i = i + 1 }
    return out
}

// Derive-Secret and the raw HKDF-Expand-Label under it. Both the serialised HkdfLabel
// (`info`) and the output are checked: a label that is wrong but self-consistent would
// still expand to something, and only the info bytes catch it.
fn test_expand_label_vectors() {
    // RFC 8448 section 3: "tls13 derived"
    assert_streq(tohex(tls::hkdf_label("derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_streq(tohex(tls::expand_label(32, unhex("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"), "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    // RFC 8448 section 3: "tls13 c hs traffic"
    assert_streq(tohex(tls::hkdf_label("c hs traffic", unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"), 32)), "002012746c7331332063206873207472616666696320860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    assert_streq(tohex(tls::expand_label(32, unhex("1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"), "c hs traffic", unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"), 32)), "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21")
    // RFC 8448 section 3: "tls13 s hs traffic"
    assert_streq(tohex(tls::hkdf_label("s hs traffic", unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"), 32)), "002012746c7331332073206873207472616666696320860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    assert_streq(tohex(tls::expand_label(32, unhex("1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"), "s hs traffic", unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"), 32)), "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38")
    // RFC 8448 section 3: "tls13 derived"
    assert_streq(tohex(tls::hkdf_label("derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_streq(tohex(tls::expand_label(32, unhex("1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"), "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "43de77e0c77713859a944db9db2590b53190a65b3ee2e4f12dd7a0bb7ce254b4")
    // RFC 8448 section 3: "tls13 finished"
    assert_streq(tohex(tls::hkdf_label("finished", unhex(""), 32)), "00200e746c7331332066696e697368656400")
    assert_streq(tohex(tls::expand_label(32, unhex("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"), "finished", unhex(""), 32)), "008d3b66f816ea559f96b537e885c31fc068bf492c652f01f288a1d8cdc19fc8")
    // RFC 8448 section 3: "tls13 c ap traffic"
    assert_streq(tohex(tls::hkdf_label("c ap traffic", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "002012746c73313320632061702074726166666963209608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::expand_label(32, unhex("18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"), "c ap traffic", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5")
    // RFC 8448 section 3: "tls13 s ap traffic"
    assert_streq(tohex(tls::hkdf_label("s ap traffic", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "002012746c73313320732061702074726166666963209608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::expand_label(32, unhex("18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"), "s ap traffic", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643")
    // RFC 8448 section 3: "tls13 exp master"
    assert_streq(tohex(tls::hkdf_label("exp master", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "002010746c73313320657870206d6173746572209608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    assert_streq(tohex(tls::expand_label(32, unhex("18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"), "exp master", unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"), 32)), "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50")
    // RFC 8448 section 3: "tls13 derived"
    assert_streq(tohex(tls::hkdf_label("derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_streq(tohex(tls::expand_label(32, unhex("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"), "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    // RFC 8448 section 3: "tls13 finished"
    assert_streq(tohex(tls::hkdf_label("finished", unhex(""), 32)), "00200e746c7331332066696e697368656400")
    assert_streq(tohex(tls::expand_label(32, unhex("b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"), "finished", unhex(""), 32)), "b80ad01015fb2f0bd65ff7d4da5d6bf83f84821d1f87fdc7d3c75b5a7b42d9c4")
    // RFC 8448 section 3: "tls13 res master"
    assert_streq(tohex(tls::hkdf_label("res master", unhex("209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d"), 32)), "002010746c73313320726573206d617374657220209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d")
    assert_streq(tohex(tls::expand_label(32, unhex("18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"), "res master", unhex("209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d"), 32)), "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c")
    // RFC 8448 section 3: "tls13 resumption"
    assert_streq(tohex(tls::hkdf_label("resumption", unhex("0000"), 32)), "002010746c73313320726573756d7074696f6e020000")
    assert_streq(tohex(tls::expand_label(32, unhex("7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c"), "resumption", unhex("0000"), 32)), "4ecd0eb6ec3b4d87f5d6028f922ca4c5851a277fd41311c9e62d2c9492e1c4f3")
    // RFC 8448 section 4: "tls13 c e traffic"
    assert_streq(tohex(tls::hkdf_label("c e traffic", unhex("08ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913"), 32)), "002011746c7331332063206520747261666669632008ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913")
    assert_streq(tohex(tls::expand_label(32, unhex("9b2188e9b2fc6d64d71dc329900e20bb41915000f678aa839cbb797cb7d8332c"), "c e traffic", unhex("08ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913"), 32)), "3fbbe6a60deb66c30a32795aba0eff7eaa10105586e7be5c09678d63b6caab62")
    // RFC 8448 section 4: "tls13 e exp master"
    assert_streq(tohex(tls::hkdf_label("e exp master", unhex("08ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913"), 32)), "002012746c733133206520657870206d61737465722008ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913")
    assert_streq(tohex(tls::expand_label(32, unhex("9b2188e9b2fc6d64d71dc329900e20bb41915000f678aa839cbb797cb7d8332c"), "e exp master", unhex("08ad0fa05d7c7233b1775ba2ff9f4c5b8b59276b7f227f13a976245f5d960913"), 32)), "b2026866610937d7423e5be90862ccf24c0e6091186d34f812089ff5be2ef7df")
    // RFC 8448 section 4: "tls13 derived"
    assert_streq(tohex(tls::hkdf_label("derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_streq(tohex(tls::expand_label(32, unhex("9b2188e9b2fc6d64d71dc329900e20bb41915000f678aa839cbb797cb7d8332c"), "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "5f1790bbd82c5e7d376ed2e1e52f8e6038c9346db61b43be9a52f77ef3998e80")
    // RFC 8448 section 4: "tls13 c hs traffic"
    assert_streq(tohex(tls::hkdf_label("c hs traffic", unhex("f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03"), 32)), "002012746c7331332063206873207472616666696320f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03")
    assert_streq(tohex(tls::expand_label(32, unhex("005cb112fd8eb4ccc623bb88a07c64b3ede1605363fc7d0df8c7ce4ff0fb4ae6"), "c hs traffic", unhex("f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03"), 32)), "2faac08f851d35fea3604fcb4de82dc62c9b164a70974d0462e27f1ab278700f")
    // RFC 8448 section 4: "tls13 s hs traffic"
    assert_streq(tohex(tls::hkdf_label("s hs traffic", unhex("f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03"), 32)), "002012746c7331332073206873207472616666696320f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03")
    assert_streq(tohex(tls::expand_label(32, unhex("005cb112fd8eb4ccc623bb88a07c64b3ede1605363fc7d0df8c7ce4ff0fb4ae6"), "s hs traffic", unhex("f736cb34fe25e701551bee6fd24c1cc7102a7daf9405cb15d97aafe16f757d03"), 32)), "fe927ae271312e8bf0275b581c54eef020450dc4ecffaa05a1a35d27518e7803")
    // RFC 8448 section 4: "tls13 derived"
    assert_streq(tohex(tls::hkdf_label("derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "00200d746c733133206465726976656420e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_streq(tohex(tls::expand_label(32, unhex("005cb112fd8eb4ccc623bb88a07c64b3ede1605363fc7d0df8c7ce4ff0fb4ae6"), "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 32)), "e2f16030251df0874ba19b9aba257610bc6d531c1dd206df0ca6e84ae2a26742")
    // RFC 8448 section 4: "tls13 finished"
    assert_streq(tohex(tls::hkdf_label("finished", unhex(""), 32)), "00200e746c7331332066696e697368656400")
    assert_streq(tohex(tls::expand_label(32, unhex("fe927ae271312e8bf0275b581c54eef020450dc4ecffaa05a1a35d27518e7803"), "finished", unhex(""), 32)), "4bb74cae7a5dc8914604c0bfbe2f0c062396883922bec8a15e2a9b532a5d392c")
