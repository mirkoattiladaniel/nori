    assert_streq(tohex(tls::expand_label(32, unhex("ce022e5e6e81e50736d773f2d3adfce8220d049bf510f0dbfac927ef4243b148"), "c hs traffic", unhex("8aa8e828ec2f8a884fec95a3139de01c15a3daa7ff5bfc3f4bfcc21b438d7bf8"), 32)), "158aa7ab8855073582b41d674b4055cabcc534728f659314861b4e08e2011566")
