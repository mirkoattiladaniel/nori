//! std/unicode: UTF-8 between Nori byte strings and Unicode code points. A `Str` is raw bytes (each
//! `char_at` is one byte); this module reads/writes the multi-byte UTF-8 encoding on top of that.
//!   import "std/unicode" as utf8
//!   utf8::count("héllo")            // 5 code points (6 bytes)
//!   utf8::encode(0x20AC)            // the 3 UTF-8 bytes of "€"
//!   utf8::to_codepoints(s)         // Vec<Int> of code points

pub struct CodePoint { cp: Int, next: Int }     // a decoded code point and the byte index just past it

/// encode one Unicode code point as its 1–4 UTF-8 bytes.
pub fn encode(cp: Int) -> Str {
    var out = ""
    if cp < 0x80 {
        out = (out + chr(cp))
    } else { if cp < 0x800 {
        out = (out + chr((0xc0 | (cp >> 6))))
        out = (out + chr((0x80 | (cp & 0x3f))))
    } else { if cp < 0x10000 {
        out = (out + chr((0xe0 | (cp >> 12))))
        out = (out + chr((0x80 | ((cp >> 6) & 0x3f))))
        out = (out + chr((0x80 | (cp & 0x3f))))
    } else {
        out = (out + chr((0xf0 | (cp >> 18))))
        out = (out + chr((0x80 | ((cp >> 12) & 0x3f))))
        out = (out + chr((0x80 | ((cp >> 6) & 0x3f))))
        out = (out + chr((0x80 | (cp & 0x3f))))
    } } }
    return out
}

/// decode the code point starting at byte index `i`. Malformed input yields the raw lead byte advancing 1.
pub fn decode_at(s: Str, i: Int) -> CodePoint {
    let n = s.len()
    let b0 = ord(s.at(i))
    if b0 < 0x80 { return CodePoint { cp: b0, next: i + 1 } }
    if b0 < 0xe0 {
        if i + 1 >= n { return CodePoint { cp: b0, next: i + 1 } }
        let b1 = ord(s.at(i + 1))
        return CodePoint { cp: (((b0 & 0x1f) << 6) | (b1 & 0x3f)), next: i + 2 }
    }
    if b0 < 0xf0 {
        if i + 2 >= n { return CodePoint { cp: b0, next: i + 1 } }
        let b1 = ord(s.at(i + 1))
        let b2 = ord(s.at(i + 2))
        return CodePoint { cp: ((((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6)) | (b2 & 0x3f)), next: i + 3 }
    }
    if i + 3 >= n { return CodePoint { cp: b0, next: i + 1 } }
    let b1 = ord(s.at(i + 1))
    let b2 = ord(s.at(i + 2))
    let b3 = ord(s.at(i + 3))
    return CodePoint { cp: (((((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12)) | ((b2 & 0x3f) << 6)) | (b3 & 0x3f)), next: i + 4 }
}

/// number of Unicode code points in `s`.
pub fn count(s: Str) -> Int {
    var c = 0
    var i = 0
    let n = s.len()
    while i < n { let d = decode_at(s, i)  i = d.next  c = c + 1 }
    return c
}

/// the code points of `s` as a Vec<Int>.
pub fn to_codepoints(s: Str) -> Vec<Int> {
    var out: Vec<Int> = vec()
    var i = 0
    let n = s.len()
    while i < n { let d = decode_at(s, i)  out.push(d.cp)  i = d.next }
    return out
}

/// encode a sequence of code points as a UTF-8 byte string.
pub fn from_codepoints(cps: Vec<Int>) -> Str {
    var out = ""
    var i = 0
    while i < cps.len() { out = (out + encode(cps[i]))  i = i + 1 }
    return out
}

/// is `s` well-formed UTF-8 (correct lead/continuation byte structure)?
pub fn is_valid(s: Str) -> Bool {
    var i = 0
    let n = s.len()
    while i < n {
        let b0 = ord(s.at(i))
        var extra = 0
        if b0 < 0x80 { extra = 0 }
        else { if b0 < 0xc0 { return false }                 // a lone continuation byte
        else { if b0 < 0xe0 { extra = 1 }
        else { if b0 < 0xf0 { extra = 2 }
        else { if b0 < 0xf8 { extra = 3 } else { return false } } } } }
        if i + extra >= n { return false }
        var k = 1
        while k <= extra { let bc = ord(s.at(i + k))  if bc < 0x80 || bc >= 0xc0 { return false }  k = k + 1 }
        i = i + extra + 1
    }
    return true
}

fn u_hexval(b: Int) -> Int { if b >= 48 && b <= 57 { return b - 48 }  if b >= 97 && b <= 102 { return b - 87 }  if b >= 65 && b <= 70 { return b - 55 }  return 0 }

// read a 6-hex-digit code point from packed table `t` at byte offset `off`.
fn u_hex6(t: Str, off: Int) -> Int {
    var v = 0
    var i = 0
    while i < 6 { v = (v << 4) | u_hexval(ord(t.at(off + i)))  i = i + 1 }
    return v
}

// binary-search packed table `t` (fixed 12-char [lo,hi] records, sorted) for code point `cp`.
fn u_tbl_has(t: Str, cp: Int) -> Bool {
    var lo = 0
    var hi = (t.len() / 12) - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        let base = mid * 12
        let rlo = u_hex6(t, base)
        if cp < rlo { hi = mid - 1 } else {
            let rhi = u_hex6(t, base + 6)
            if cp > rhi { lo = mid + 1 } else { return true }
        }
    }
    return false
}

// East-Asian Wide + Fullwidth code points (display width 2). Generated from Unicode 17.0.0
// EastAsianWidth.txt (classes W, F), merged into sorted [lo,hi] ranges packed as 6-hex-digit pairs.
fn wide_ranges() -> Str { return "" }

// Zero-width code points (display width 0): general categories Mn, Me, Cf plus Hangul conjoining jamo
// (U+1160..U+11FF). Generated from Unicode 17.0.0 DerivedGeneralCategory.txt, same packing as above.
fn zero_ranges() -> Str { return "" }

/// terminal display width of code point `cp`: 0 for combining/zero-width, 2 for East-Asian wide/fullwidth,
/// else 1. Follows Unicode 17.0.0 (East Asian Width W/F => 2; general category Mn/Me/Cf => 0), via
/// binary search over packed range tables.
pub fn width(cp: Int) -> Int {
    if cp < 0x20 { return 0 }                    // C0 controls (incl. NUL)
    if cp >= 0x7F && cp <= 0x9F { return 0 }     // DEL + C1 controls
    if cp < 0xAD { return 1 }                    // fast path: ASCII + Latin-1 up to soft hyphen
    if u_tbl_has(zero_ranges(), cp) { return 0 }
    if u_tbl_has(wide_ranges(), cp) { return 2 }
    return 1
}

/// total display width of `s` (sum of code-point widths), i.e. how many terminal columns it occupies.
pub fn display_width(s: Str) -> Int {
    var w = 0
    var i = 0
    let n = s.len()
    while i < n { let d = decode_at(s, i)  w = w + width(d.cp)  i = d.next }
    return w
}

// ── the lazy character iterator: yields real Unicode `Char` scalars, decoded on demand ──
/// iterate a Str's characters (Unicode scalars): `var cs = uni::chars(s)  foreach c in cs { … }`.
/// For the raw byte view use `it::bytes(s)` (std/iter); bytes are what `s.at(i)` returns.
pub struct Chars { s: view Str, i: Int }
/// a `Chars` iterator over `s`, for `foreach c in chars(s)`.
pub fn chars(s: Str) -> Chars { return Chars { s: s, i: 0 } }
impl Chars {
    fn next(inout self) -> Option<Char> {
        if self.i >= self.s.len() { return Option::None }
        let d = decode_at(self.s, self.i)
        self.i = d.next
        return Option::Some(uchr(d.cp))
    }
}
