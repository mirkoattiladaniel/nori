import "std/unicode" as utf8
fn test_encode_bytes() {
    assert_streq(utf8::encode(65), "A")                   // ASCII
    let e = utf8::encode(233)                              // U+00E9 é -> C3 A9
    assert_eq(e.len(), 2)
    assert_eq(ord(e.at(0)), 195)
    assert_eq(ord(e.at(1)), 169)
    let euro = utf8::encode(8364)                          // U+20AC € -> E2 82 AC
    assert_eq(euro.len(), 3)
    let emoji = utf8::encode(128512)                       // U+1F600 -> 4 bytes
    assert_eq(emoji.len(), 4)
}
fn test_roundtrip() {
    var cps: Vec<Int> = vec()  cps.push(65)  cps.push(233)  cps.push(8364)  cps.push(128512)
    let s = utf8::from_codepoints(cps)
    assert_eq(utf8::count(s), 4)
    let back = utf8::to_codepoints(s)
    assert_eq(back.len(), 4)
    assert_eq(back[0], 65)
    assert_eq(back[1], 233)
    assert_eq(back[2], 8364)
    assert_eq(back[3], 128512)
    assert_true(utf8::is_valid(s))
}
fn test_invalid() {
    assert_false(utf8::is_valid(utf8::encode(233) + chr(255)))   // lone 0xFF
}

// ---- laws: UTF-8 round-trip invariants (fuzzed by `noric --fuzz-laws` / `roll law`) ----
// (guarded to valid UTF-8; the generator produces arbitrary bytes, many of them invalid.)
law utf8_codepoints_roundtrip(s: Str) {
    if utf8::is_valid(s) {
        assert(utf8::from_codepoints(utf8::to_codepoints(s)) == s)
    }
}
law utf8_count_equals_codepoint_len(s: Str) {
    if utf8::is_valid(s) {
        assert(utf8::count(s) == (utf8::to_codepoints(s)).len())
    }
}
