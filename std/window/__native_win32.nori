fn nori_win_clipboard_set(s: Int, text: Int) {
    if s == 0 || text == 0 { return }
    let n = MultiByteToWideChar(65001, 0, text, 0 - 1, 0, 0) & 4294967295
    if n == 0 { return }
    let g = GlobalAlloc(2, n * 2)                          // GMEM_MOVEABLE
    if g == 0 { return }
    let p = GlobalLock(g)
    if p == 0 { let _f = GlobalFree(g)  return }
    let _m = MultiByteToWideChar(65001, 0, text, 0 - 1, p, n)
    let _u = GlobalUnlock(g)
