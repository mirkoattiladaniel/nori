/// ask the window to close (only its own thread may destroy it) and wait for that thread to end
fn nori_win_close(s: Int) {
    if s == 0 { return }
    if peek(s + 128) != 0 { let _u = ClipCursor(0)  let _v = ShowCursor(1)  poke(s + 128, 0) }
    if peek(s) != 0 { let _p = PostMessageW(peek(s), 16, 0, 0) }
    if peek(s + 168) != 0 { let _w = WaitForSingleObject(peek(s + 168), 2000)  let _c = CloseHandle(peek(s + 168)) }
    let _r = CloseHandle(peek(s + 176))
    let _k = CloseHandle(peek(s + 184))
    if peek(s + 112) != 0 { free(peek(s + 112)) }
    free(peek(s + 104))
    free(peek(s + 216))
    free(s)
}

// The desktop shell's half (window_shell.nori) is Wayland's: Windows has no layer surfaces or foreign-toplevel
