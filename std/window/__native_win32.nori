    let _e = EmptyClipboard()
    if SetClipboardData(13, g) == 0 { let _f3 = GlobalFree(g) }    // CF_UNICODETEXT; the clipboard owns it now
    let _c = CloseClipboard()
}
fn nori_win_clipboard_get(s: Int) -> Int {
    if s == 0 { return 0 }
    if !nw32_ok(IsClipboardFormatAvailable(13)) { return 0 }
    if !nw32_ok(OpenClipboard(peek(s))) { return 0 }
    var out = 0
    let g = GetClipboardData(13)
    if g != 0 {
        let p = GlobalLock(g)
        if p != 0 { out = nw32_u8(p)  let _u = GlobalUnlock(g) }
